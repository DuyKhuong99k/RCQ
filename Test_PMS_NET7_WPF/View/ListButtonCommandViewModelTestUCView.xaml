<UserControl
    x:Class="Test_PMS_NET7_WPF.View.ListButtonCommandViewModelTestUCView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Test_PMS_NET7_WPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Test_PMS_NET7_WPF.ViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding Source={x:Static viewModel:MainViewModel.Ins}}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Button
            Grid.Row="0"
            Grid.Column="0"
            Command="{Binding CommandShow.XiNghiep_Command}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Content="Xí Nghiệp" />
        <Button
            Grid.Row="0"
            Grid.Column="1"
            Command="{Binding CommandShow.ViTriFillet_Command}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Content="Vị trí Fillet" />
        <Button
            Grid.Row="1"
            Grid.Column="0"
            Command="{Binding CommandShow.TChiTietVoXo_Command}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Content="Chi Tiet Vo Xo" />
        <Button
            Grid.Row="1"
            Grid.Column="1"
            Command="{Binding CommandShow.BanCatTiet_Command}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Content="Bàn cắt tiết" />
    </Grid>
</UserControl>

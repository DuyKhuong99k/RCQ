<UserControl
    x:Class="Test_PMS_NET7_WPF.View.XiNghiep.XiNghiepTestUCView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvr="clr-namespace:Test_PMS_NET7_WPF.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Test_PMS_NET7_WPF.View.XiNghiep"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewItem="clr-namespace:Test_PMS_NET7_WPF.View.XiNghiep"
    xmlns:viewModel="clr-namespace:Test_PMS_NET7_WPF.ViewModel"
    Width="800"
    Height="450"
    DataContext="{Binding Source={x:Static viewModel:MainViewModel.Ins}}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <ResourceDictionary>
            <cvr:BoolToVisible x:Key="BoolToVisible" />
        </ResourceDictionary>

    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewKeyUp">
            <i:InvokeCommandAction Command="{Binding VmXiNghiep.ForceRaseCanExcuteCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewMouseUp">
            <i:InvokeCommandAction Command="{Binding VmXiNghiep.ForceRaseCanExcuteCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <DataGrid ItemsSource="{Binding VmXiNghiep.Items}" SelectedItem="{Binding VmXiNghiep.SelectedItem}" />
            </Grid>
            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1">
                <Grid>
                    <!--  // Border Control //  -->
                    <Border Visibility="{Binding VmApp.IsPanelVisible, Converter={StaticResource BoolToVisible}}">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Width" Value="400" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </Border.Style>
                        <viewItem:XiNghiepItemUCView />
                    </Border>
                </Grid>
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Width" Value="88" />
                            <Setter Property="Height" Value="50" />
                        </Style>
                        <Style x:Key="localButtonPms" TargetType="Button">
                            <Setter Property="Height" Value="50" />
                            <Setter Property="Width" Value="88" />
                            <Setter Property="Margin" Value="4" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Command="{Binding VmXiNghiep.Reload_Command}" Content="Tải Lại" />
                    <Button Command="{Binding CommandShowThem.XiNghiep2_Command}" Content="Thêm" />
                    <Button
                        Command="{Binding CommandShowSua.XiNghiep2_Command}"
                        CommandParameter="{Binding VmXiNghiep.SelectedItem}"
                        Content="Sửa" />
                    <Button
                        Command="{Binding VmXiNghiep.Delete_Command}"
                        CommandParameter="{Binding VmXiNghiep.SelectedItem}"
                        Content="Xóa" />
                </StackPanel>
            </Grid>
        </Grid>



    </Grid>
</UserControl>

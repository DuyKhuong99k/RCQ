<UserControl
    x:Class="Test_PMS_NET7_WPF.View.XiNghiep.XiNghiepItemUCView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvr="clr-namespace:Test_PMS_NET7_WPF.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Test_PMS_NET7_WPF.View.XiNghiep"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Test_PMS_NET7_WPF.ViewModel"
    Name="wd"
    Width="auto"
    Height="auto"
    DataContext="{Binding Source={x:Static viewModel:MainViewModel.Ins}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <cvr:BoolToVisible x:Key="BoolToVisible" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Mã" />
            <TextBox IsReadOnly="{Binding VmXiNghiep.IdItemIsReadOnly}" Text="{Binding VmXiNghiep.Item.Ma, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Tên" />
            <TextBox Text="{Binding VmXiNghiep.Item.Ten, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                VerticalContentAlignment="Center"
                Content="Sử Dụng"
                IsChecked="{Binding VmXiNghiep.Item.SuDung, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="CodeId" />
            <TextBox Text="{Binding VmXiNghiep.Item.CodeId, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="Width" Value="88" />
                        <Setter Property="Height" Value="50" />
                    </Style>
                    <Style x:Key="localButtonPms" TargetType="Button">
                        <Setter Property="Height" Value="50" />
                        <Setter Property="Width" Value="88" />
                        <Setter Property="Margin" Value="4" />
                    </Style>
                </StackPanel.Resources>
                <Button
                    Command="{Binding VmXiNghiep.Insert_Command}"
                    CommandParameter="{Binding VmXiNghiep.Item}"
                    Content="Thêm"
                    Visibility="{Binding VmXiNghiep.IsAdd, Converter={StaticResource BoolToVisible}}" />
                <Button
                    Command="{Binding VmXiNghiep.Update_Command}"
                    CommandParameter="{Binding VmXiNghiep.Item}"
                    Content="Sửa"
                    Visibility="{Binding VmXiNghiep.IsEdit, Converter={StaticResource BoolToVisible}}" />
                <!--<Button
                    Command="{Binding VmApp.CloseWindow}"
                    CommandParameter="{Binding ElementName=wd}"
                    Content="Thoát" />-->
                <!--  // Hide Panel Button //  -->
                <Button Command="{Binding VmApp.HidePanel_Command}" Content="Thoát" />

            </StackPanel>
        </Grid>


    </Grid>
</UserControl>

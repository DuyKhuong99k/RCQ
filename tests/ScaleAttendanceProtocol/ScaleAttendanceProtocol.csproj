<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dùng bản PMSHub đã build; không restore lại các project sản xuất. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Services"><HintPath>../../PMSHub/bin/Debug/net8.0/Services.dll</HintPath></Reference>
    <Reference Include="Vars"><HintPath>../../PMSHub/bin/Debug/net8.0/Vars.dll</HintPath></Reference>
    <Reference Include="ViewModels"><HintPath>../../PMSHub/bin/Debug/net8.0/ViewModels.dll</HintPath></Reference>
    <Reference Include="Models"><HintPath>../../PMSHub/bin/Debug/net8.0/Models.dll</HintPath></Reference>
    <Content Include="../../PMSHub/bin/Debug/net8.0/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

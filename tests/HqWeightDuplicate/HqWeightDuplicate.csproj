<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HubBuildConfiguration Condition="'$(HubBuildConfiguration)' == ''">Debug</HubBuildConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Services"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Services.dll</HintPath></Reference>
    <Reference Include="Models"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Models.dll</HintPath></Reference>
    <Reference Include="Dao"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Dao.dll</HintPath></Reference>
    <Reference Include="Dapper"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Dapper.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Microsoft.EntityFrameworkCore.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Relational"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Microsoft.EntityFrameworkCore.Relational.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.SqlServer"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Microsoft.EntityFrameworkCore.SqlServer.dll</HintPath></Reference>
    <Reference Include="Microsoft.Data.SqlClient"><HintPath>../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/runtimes/win/lib/net8.0/Microsoft.Data.SqlClient.dll</HintPath></Reference>
    <Content Include="../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/*.dll" Exclude="../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/Microsoft.Data.SqlClient.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../PMSHub/bin/$(HubBuildConfiguration)/net8.0/runtimes/win-x64/native/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<input type="hidden" id="idNVTCHQRowSelected" />
<script>

    function onfiltering(e) {
        var query = new ej.data.Query().select(['Name', 'MaNhanVien', 'DeptName0']); // Chỉ lấy 100 phần tử đầu tiên
        var predicateQuery = query.where(new ej.data.Predicate('MaNhanVien', 'contains', e.text, true).or('Name', 'contains', e.text, true));
        query = (e.text !== '') ? predicateQuery : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(@ViewBag.DataNhanVien)), query);
        isCheckScroll.call(this);
    }

    function onComboBoxOpen(args) {
        var comboBox = args.popup; // Lấy popup của combobox
        if (comboBox) {
            // Kiểm tra nếu dataSource tồn tại
            if (comboBox.dataSource) {
                // Chỉ hiển thị 10 phần tử đầu tiên
                comboBox.dataSource = comboBox.dataSource.slice(0, 10);
            }
        }
    }

    function isCheckScroll() {
        if (this.popupObj && this.popupObj.element && this.liCollections.length > 0) {
            var offsetHeight = this.popupObj.element.querySelector('.e-content').offsetHeight;
            var contentHeight = offsetHeight < this.liCollections[0].offsetHeight * this.liCollections.length;
            if (contentHeight || offsetHeight === 0) {
                this.popupObj.element.classList.add('e-scroller');
            } else {
                this.popupObj.element.classList.remove('e-scroller');
            }
        }
    }



    function onfilteringNhom(e) {
        var query = new ej.data.Query().select(['Id', 'Ten', 'SuDung']); // Chỉ lấy 100 phần tử đầu tiên
        var predicateQuery = query.where(new ej.data.Predicate('Id', 'contains', e.text, true).or('Ten', 'contains', e.text, true));
        query = (e.text !== '') ? predicateQuery : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(@ViewBag.DataNhanVien)), query);
        isCheckScroll.call(this);
    }

    function onComboBoxOpenNhom(args) {
        var comboBox = args.popup; // Lấy popup của combobox
        if (comboBox) {
            // Kiểm tra nếu dataSource tồn tại
            if (comboBox.dataSource) {
                // Chỉ hiển thị 10 phần tử đầu tiên
                comboBox.dataSource = comboBox.dataSource.slice(0, 10);
            }
        }
    }

    function isCheckScrollNhom() {
        if (this.popupObj && this.popupObj.element && this.liCollections.length > 0) {
            var offsetHeight = this.popupObj.element.querySelector('.e-content').offsetHeight;
            var contentHeight = offsetHeight < this.liCollections[0].offsetHeight * this.liCollections.length;
            if (contentHeight || offsetHeight === 0) {
                this.popupObj.element.classList.add('e-scroller');
            } else {
                this.popupObj.element.classList.remove('e-scroller');
            }
        }
    }

</script>
<script>
    function setCurrentDateTime() {
        const now = new Date();

        // Lấy từng phần ngày và giờ của giờ địa phương
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0 nên cần +1
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const milliseconds = String(now.getMilliseconds()).padStart(3, '0'); // Thêm phần mili giây

        // Định dạng theo 'YYYY-MM-DDTHH:MM:SS.fff'
        const formattedDateTime = `${year}-${month}-${day}T${hours}:${minutes}:${seconds}.${milliseconds}`;
        const dateTimeInput = document.getElementById("dateTimeHQNhanVien");
        dateTimeInput.value = formattedDateTime;
        return formattedDateTime;
        //.value = formattedDateTime;
    }


    $(document).ready(function () {
        setCurrentDateTime();
        //loadGridData();
        //reloadData();
    });
    let selectedIdsString = ""; // Khai báo một chuỗi để lưu trữ MaNhanVien đã chọn
    let numRowSelect = 0;
    var grid;
    function loadGridData() {
        var dateTime = setCurrentDateTime();
        $.ajax({
            url: '/HQ_NhanVienTheoCa/GetAllsNewFullField',
            data: {
                dateTime: dateTime
            },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    // var contextMenuItems = [
                    //     { text: 'Chuyển Ca', id: 'chuyenCa' }
                    // ];

                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        //rowSelected: onRowSelected,
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionChanged,
                        rowDeselected: unSelectionChanged,
                        allowGrouping: true,
                        groupSettings: { showDropArea: false, columns: ['CaName'] },
                        height: 400,
                        // contextMenuItems: contextMenuItems,
                        // contextMenuClick: contextMenuClickHandler,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        columns: [
                            { type: 'checkbox', width: '50' },
                            //{ field: 'Id', headerText: 'Id', width: 150 },
                            { field: 'NhanVienId', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                            { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'NhomName', headerText: 'Nhóm', width: 150 },
                            //{ field: 'CaId', headerText: 'Mã Ca', width: 150 },
                            { field: 'CaName', headerText: 'Ca', width: 150 },
                            //{ field: 'NgayGio', headerText: 'Ngày Giờ Cài Đặt', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                        if (args.item.id === 'Grid_excelexport') {
                              grid.excelExport();
                        }
                    };
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    //loadGridData();
    function reloadData() {
        loadGridData();
    }

    function contextMenuClickHandler(args) {
        var rowData = args.rowInfo.rowData;
        if (rowData) {
            switch (args.item.id) {
                case 'chuyenCa':
                $.ajax({
                        url: "/HQ_NhanVienTheoCa/CheckQuyenHQ",
                        data: { typeOption: "CHUYENNHANVIEN" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển nhân viên của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                             $('#modalChuyenCa').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });



                    break;
                default:
                    break;
            }
        }
    }


    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                //alert(selectedIdsString);
                document.getElementById("selection-info").innerText = `Đang chọn: ${numRowSelect}`;
                 checkButtonVisibility();
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                //let deselectedIds = deselectedRecords[i].Id;
                let deselectedNhanVienId = deselectedRecords[i].NhanVienId;
                let deselectedId = deselectedNhanVienId;

                // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedId)) {
                    selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                    numRowSelect--; // Giảm số dòng đã chọn
                     checkButtonVisibility();
                }
            }
        } else {
            // Nếu deselectedRecords không phải là một mảng
            let deselectedNhanVienId = deselectedRecords.NhanVienId
            let deselectedId = deselectedNhanVienId;

            // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedId)) {
                selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                numRowSelect--; // Giảm số dòng đã chọn
                 checkButtonVisibility();
            }
            //alert(selectedIdsString);
        }
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
        // Cập nhật nội dung hiển thị
        document.getElementById("selection-info").innerText = `Đang chọn: ${numRowSelect}`;
         checkButtonVisibility();
    }

    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
            filteredRecords.forEach(record => {
                selectedIdsString += record.NhanVienId + "|"; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
            });

            // Loại bỏ dấu | cuối cùng
            //selectedIdsString = selectedIdsString.slice(0, -1);
            //alert(selectedIdsString);
            //alert(numRowSelect);
            document.getElementById("selection-info").innerText = `Đang chọn: ${numRowSelect}`;
             checkButtonVisibility();
            return;
        }
        let selectedNhanVienId = selectedRecords.NhanVienId;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedNhanVienId)) {
            selectedIdsString += selectedNhanVienId + "|";
            numRowSelect++; // Tăng số dòng đã chọn
            //alert(selectedIdsString);
        }

        // Cập nhật nội dung hiển thị
        document.getElementById("selection-info").innerText = `Đang chọn: ${numRowSelect}`;
         checkButtonVisibility();
        // Loại bỏ dấu | cuối cùng
        //selectedIdsString = selectedIdsString.slice(0, -1);
        //alert(selectedIdsString);
        // Hiển thị số dòng đã chọn nếu cần
        ////alert(numRowSelect);
    }




    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Id = selectedRecord.Id;

        $('#idNVTCHQRowSelected').val(Id);
    }
</script>

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themHQ_QuyCachNguyenLieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Quy Cách Nguyên Liệu HQ" && x.Func == "Thêm Quy Cách Nguyên Liệu HQ" && x.Status == 1).FirstOrDefault();
                            if (themHQ_QuyCachNguyenLieu != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaHQ_QuyCachNguyenLieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Quy Cách Nguyên Liệu HQ" && x.Func == "Sửa Quy Cách Nguyên Liệu HQ" && x.Status == 1).FirstOrDefault();
                            if (suaHQ_QuyCachNguyenLieu != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaHQ_QuyCachNguyenLieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Quy Cách Nguyên Liệu HQ" && x.Func == "Xóa Quy Cách Nguyên Liệu HQ" && x.Status == 1).FirstOrDefault();
                            if (xoaHQ_QuyCachNguyenLieu != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            // var importHQ_QuyCachNguyenLieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Quy Cách Nguyên Liệu HQ" && x.Func == "Import Quy Cách Nguyên Liệu HQ" && x.Status == 1).FirstOrDefault();
                            // if (importHQ_QuyCachNguyenLieu != null)
                            // {
                            //     <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            // }
                            // var exportHQ_QuyCachNguyenLieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Quy Cách Nguyên Liệu HQ" && x.Func == "Export Quy Cách Nguyên Liệu HQ" && x.Status == 1).FirstOrDefault();
                            // if (exportHQ_QuyCachNguyenLieu != null)
                            // {
                            //     <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            // }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

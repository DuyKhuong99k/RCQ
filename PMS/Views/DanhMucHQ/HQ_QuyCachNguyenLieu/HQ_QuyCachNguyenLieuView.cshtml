<input type="hidden" id="idQCNLHQRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/HQ_QuyCachNguyenLieu/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        height: 400,
                        columns: [
                            { field: 'MaNguyenLieu', headerText: 'Mã Nguyên Liệu', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'Index', headerText: 'Index', width: 150 },
                            { field: 'DonViTinh', headerText: 'Đơn Vị Tính', width: 150 },
                            { field: 'NhomQuyCach', headerText: 'Nhóm Quy Cách', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                        if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                        }
                    };
               }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Id = selectedRecord.Id;

        $('#idQCNLHQRowSelected').val(Id);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/HQ_QuyCachNguyenLieu/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {

                    $('#suDungQCNLHQ').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {

        var ten = $('#tenQCNLHQ').val();

        var suDung = $('#suDungQCNLHQ').prop('checked');
        var index = $('#indexQCNLHQ').val();
        var nhomQuyCach = $('#nhomQuyCachQCNLHQ').val();
        var maNguyenLieu = $('#maNguyenLieuQCNLHQ').val();
        var donViTinh = $('#donViTinhQCNLHQ').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/HQ_QuyCachNguyenLieu/DoInsert',
            data: {

                ten: ten,
                suDung: suDung,
                index :index,
                nhomQuyCach : nhomQuyCach,
                maNguyenLieu : maNguyenLieu,
                donViTinh: donViTinh
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var id = $('#idQCNLHQRowSelected').val();
        $.ajax({
            url: "/HQ_QuyCachNguyenLieu/GetsByMa",
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#idQCNLHQSua').val(rs.Id);
                    $('#tenQCNLHQSua').val(rs.Ten);
                    $('#indexQCNLHQSua').val(rs.Index);
                    $('#nhomQuyCachQCNLHQSua').val(rs.NhomQuyCach);
                    $('#maNguyenLieuQCNLHQSua').val(rs.MaNguyenLieu);
                    $('#donViTinhQCNLHQSua').val(rs.DonViTinh);
                    $('#suDungQCNLHQSua').prop('checked', rs.SuDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var id = $('#idQCNLHQRowSelected').val();
        var ten = $('#tenQCNLHQSua').val();
        var index = $('#indexQCNLHQSua').val();
        var nhomQuyCach = $('#nhomQuyCachQCNLHQSua').val();
        var maNguyenLieu = $('#maNguyenLieuQCNLHQSua').val();
        var donViTinh = $('#donViTinhQCNLHQSua').val();
        var suDung = $('#suDungQCNLHQSua').prop('checked');
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/HQ_QuyCachNguyenLieu/DoUpdate',
            data: {
                id: id,
                ten: ten,
                suDung: suDung,
                index :index,
                nhomQuyCach : nhomQuyCach,
                maNguyenLieu : maNguyenLieu,
                donViTinh: donViTinh
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var id = $('#idQCNLHQRowSelected').val();
        $.ajax({
            url: "/HQ_QuyCachNguyenLieu/GetsByMa",
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/HQ_QuyCachNguyenLieu/DoDelete',
                                    data: { id: id },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>


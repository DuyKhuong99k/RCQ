<script>
    function setCurrentDateTime() {
        const dateTimeInput = document.getElementById("dateTimeHQNhanVien");
        const now = new Date();

        // Lấy từng phần ngày và giờ của giờ địa phương
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0 nên cần +1
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');

        // Định dạng theo 'YYYY-MM-DDTHH:MM'
        const formattedDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
        dateTimeInput.value = formattedDateTime;
    }
    function setCurrentDateTime2() {
        const dateTimeInput = document.getElementById("ngayGioBatDauNVTNHQ");
        const now = new Date();

        // Lấy từng phần ngày và giờ của giờ địa phương
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0 nên cần +1
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');

        // Định dạng theo 'YYYY-MM-DDTHH:MM'
        const formattedDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
        dateTimeInput.value = formattedDateTime;
    }

    $(document).ready(function () {
        setCurrentDateTime();
        setCurrentDateTime2();
        //loadGridData();
        
    });
    var grid;
    function loadGridData() {
        var dateTime = $('#dateTimeHQNhanVien').val();
        $.ajax({
            url: '/HQ_NhanVienTheoNhom/GetAllsNewFullField',
            data: {
                dateTime: dateTime
            },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        allowGrouping: true,
                        groupSettings: { showDropArea: false, columns: ['NhomName'] },
                        height: 400,
                        columns: [
                            //{ field: 'Id', headerText: 'Id', width: 150 },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                            { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'NhomGoc', headerText: 'Nhóm Gốc', width: 150 },
                            //{ field: 'MaNhom', headerText: 'Mã Nhóm', width: 150 },
                            { field: 'NhomName', headerText: 'Nhóm', width: 150 },
                            //{ field: 'NgayGioBatDau', headerText: 'Ngày Giờ Bất Đầu', width: 150 },
                            { field: 'NgayGioBatDau', headerText: 'Ngày Giờ Bất Đầu', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                            { field: 'HeSo', headerText: 'Hệ Số', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    //loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Id = selectedRecord.Id;

        $('#idNVTNHQRowSelected').val(Id);
    }
</script>
<script>
    function showInsert() {
        setCurrentDateTime2();
        $('#heSoNVTNHQ').val(1);
        $.ajax({
            type: "GET",
            url: "/HQ_NhanVienTheoNhom/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#idNVTNHQ').val(rs.Id);
                    // $('#maNhanVienNVTNHQ').val(rs.MaNhanVien);
                    // $('#maNhomNVTNHQ').val(rs.MaNhom);
                    // $('#ngayNguyenLieuNVTNHQ').val();
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var id = $('#idNVTNHQ').val();
        //var maNhanVien = $('#maNhanVienNVTNHQ').val();
        var comboboxNhanVien = document.getElementById('maNhanVienNVTNHQ').ej2_instances[0];
        var maNhanVien = comboboxNhanVien.value;
        //var maNhom = $('#maNhomNVTNHQ').val();
        var comboboxNhom = document.getElementById('maNhomNVTNHQ').ej2_instances[0];
        var maNhom = comboboxNhom.value;
        var ngayGioBatDau = $('#ngayGioBatDauNVTNHQ').val();
        var heSo = $('#heSoNVTNHQ').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({

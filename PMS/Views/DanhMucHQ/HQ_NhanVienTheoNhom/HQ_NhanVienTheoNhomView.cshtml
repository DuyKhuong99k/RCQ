                                                  cssClass="e-multi-column"
                                                  filtering="onfilteringNhom"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhóm"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Id</th><th>Tên</th><th>Sử Dụng</th></tr></table>")"

@using Newtonsoft.Json
@{
    ViewData["Title"] = "HQ_NhanVienTheoNhomView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);

    var DataNhanVien = ViewBag.DataNhanVien;
    var Nhoms = ViewBag.Nhoms;
}

<style>

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: 1px solid #d9dee3 !important;
        color: #697a8d !important;
        /*   font-weight: 400 !important;
                                                                                line-height: 1.53 !important; */
        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }
</style>
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Nhân Viên Theo Nhóm</h2>
                    <div class="d-flex align-items-center">
                        <label class="form-label text-center mb-0 me-2">Ngày:</label>
                        <input type="datetime-local" id="dateTimeHQNhanVien" class="form-control" style="width: auto;"/>
                        @{
                            var taiHQ_NhanVienTheoNhom = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên Theo Nhóm HQ" && x.Func == "Xem Nhân Viên Theo Nhóm HQ" && x.Status == 1).FirstOrDefault();
                            if (taiHQ_NhanVienTheoNhom != null)
                            {
                                <button onclick="reloadData()" style="margin-left:5px" class="btn btn-primary">Tải</button>
                            }
                            
                        }
                    </div>
                    

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themHQ_NhanVienTheoNhom = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên Theo Nhóm HQ" && x.Func == "Thêm Nhân Viên Theo Nhóm HQ" && x.Status == 1).FirstOrDefault();
                            if (themHQ_NhanVienTheoNhom != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaHQ_NhanVienTheoNhom = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên Theo Nhóm HQ" && x.Func == "Sửa Nhân Viên Theo Nhóm HQ" && x.Status == 1).FirstOrDefault();
                            if (suaHQ_NhanVienTheoNhom != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaHQ_NhanVienTheoNhom = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên Theo Nhóm HQ" && x.Func == "Xóa Nhân Viên Theo Nhóm HQ" && x.Status == 1).FirstOrDefault();
                            if (xoaHQ_NhanVienTheoNhom != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importHQ_NhanVienTheoNhom = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên Theo Nhóm HQ" && x.Func == "Import Nhân Viên Theo Nhóm HQ" && x.Status == 1).FirstOrDefault();
                            if (importHQ_NhanVienTheoNhom != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportHQ_NhanVienTheoNhom = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên Theo Nhóm HQ" && x.Func == "Export Nhân Viên Theo Nhóm HQ" && x.Status == 1).FirstOrDefault();
                            if (exportHQ_NhanVienTheoNhom != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">
                                        Nhóm
                                    </label>
                                    <ejs-combobox id="maNhomNVTNHQ"

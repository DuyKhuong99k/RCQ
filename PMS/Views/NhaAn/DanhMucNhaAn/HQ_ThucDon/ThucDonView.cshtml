<script>
    function getCurrentDate() {
        let now = new Date();

        // Lấy các thành phần ngày, tháng, năm
        let day = String(now.getDate()).padStart(2, '0');
        let month = String(now.getMonth() + 1).padStart(2, '0');
        let year = now.getFullYear();

        // Định dạng ngày tháng năm theo yyyy-MM-dd
        let currentDate = `${year}-${month}-${day}`;

        return currentDate;
    }

    function setFormattedTime(timeString) {
        // Chuyển đổi chuỗi thời gian sang đối tượng Date
        var time = new Date("1970-01-01T" + timeString);

        // Lấy giờ và phút
        var hours = time.getHours().toString().padStart(2, '0');
        var minutes = time.getMinutes().toString().padStart(2, '0');
        var seconds = time.getSeconds().toString().padStart(2, '0');

        // Định dạng lại chuỗi thời gian
        var formattedTime = hours + ":" + minutes;

        return formattedTime;
    }
     function setFormattedDate(dateString) {
        // Kiểm tra nếu dateString không hợp lệ thì trả về rỗng
        if (!dateString) return '';

        // Nếu chỉ có `T` mà không có thời gian, thêm `00:00:00`
        if (dateString.endsWith('T')) {
            dateString += '00:00:00';
        }

        var date = new Date(dateString);

        // Kiểm tra nếu không phải là ngày hợp lệ
        if (isNaN(date.getTime())) return '';

        var day = date.getDate().toString().padStart(2, '0');
        var month = (date.getMonth() + 1).toString().padStart(2, '0');
        var year = date.getFullYear();

        return `${year}-${month}-${day}`;
    }
    function getDeviceInfo() {
      const userAgent = navigator.userAgent;

      let device = "Unknown Device";

      if (/android/i.test(userAgent)) {
        device = "Android Device";
      } else if (/iPhone|iPad|iPod/i.test(userAgent)) {
        device = "iOS Device";
      } else if (/windows phone/i.test(userAgent)) {
        device = "Windows Phone";
      } else if (/Macintosh/i.test(userAgent)) {
        device = "Mac";
      } else if (/Windows/i.test(userAgent)) {
        device = "Windows PC";
      } else if (/Linux/i.test(userAgent)) {
        device = "Linux Device";
      }

      return device;
    }

    console.log(getDeviceInfo());

    let selectedIdsString = "";
    let numRowSelect = 0;
    let isTaoThucDon = 1;
    var selectedIds = [];
    let listIdThucDonChiTiet = "";
    var gridMonAn;
    function loadGridMonAnData(rs, containerId) {
        //var gridMonAn;
        selectedIds = rs && rs.thucDonChiTiet ? rs.thucDonChiTiet.map(item => item.MonAnId) : [];
        listIdThucDonChiTiet = rs && rs.thucDonChiTiet? rs.thucDonChiTiet.map(item => item.Id).join('|') + '|' : '';
        let oldGrid = $('#' + containerId).data('gridInstance');
        if (oldGrid) {
            oldGrid.destroy();
            $('#' + containerId).empty(); // Xóa DOM cũ
        }
        $.ajax({
            url: '/HQ_MonAn/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                    gridMonAn = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        allowResizing: true,
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionChanged,
                        rowDeselected: unSelectionChanged,
                        height: 250,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'LoaiMonAnName', headerText: 'Món Ăn', width: 150 },
                            { field: 'GhiChu', headerText: 'Ghi Chú', width: 150 },
                        ],
                        rowDataBound: function (args) {
                            if (selectedIds.includes(args.data.Id)) {
                                setTimeout(() => {
                                    let rowIndex = $(args.row).index();
                                    if (rowIndex >= 0) {
                                        gridMonAn.selectRow(rowIndex);
                                    }
                                }, 0);
                            }
                        }
                    });

                    gridMonAn.appendTo('#' + containerId);
                    // Lưu tham chiếu grid mới vào container
                    $('#' + containerId).data('gridInstance', gridMonAn);
            }
        });
    }

    function ClearData(GridId) {
        try {
            var gridElement = document.getElementById(GridId);
            if (!gridElement) return;  // Nếu không tìm thấy phần tử thì thoát luôn

            var gridObj = gridElement.ej2_instances[0];
            if (gridObj && gridObj.dataSource) {
                gridObj.dataSource = [];
            }
        } catch (e) {
            console.log(e);
        }
    }
    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                //alert(selectedIdsString);
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselectedId = deselectedRecords[i].Id;


                // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedId)) {
                    selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                    numRowSelect--; // Giảm số dòng đã chọn
                }
            }
        } else {
            let deselectedId = deselectedRecords.Id;

            // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedId)) {
                selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                numRowSelect--; // Giảm số dòng đã chọn
            }
            //alert(selectedIdsString);
        }
        //$('#idXLPCRCXKHHidden').val("");
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
        //alert(selectedIdsString);
    }

    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = gridMonAn.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
            filteredRecords.forEach(record => {
                selectedIdsString += record.Id + "|";
            });

            // Loại bỏ dấu | cuối cùng
            selectedIdsString = selectedIdsString.slice(0, -1);
            //alert(selectedIdsString);
            //alert(numRowSelect);
            return;
        }


        let selectedId = selectedRecords.Id;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedId)) {
            selectedIdsString += selectedId + "|";
            numRowSelect++; // Tăng số dòng đã chọn
        }
        // Loại bỏ dấu | cuối cùng
        //selectedIdsString = selectedIdsString.slice(0, -1);
        console.log(selectedIdsString);
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }

</script>

<script>
    $(document).ready(function () {
        loadGridData();
        loadDanhSachThucDonGanNhat();
    });
    var grid;
    function loadGridData() {

        $.ajax({
            url: '/HQ_ThucDon/GetDanhSachTrangThaiThucDonTungNgay',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        height: 400,
                        columns: [
                            { field: 'NgayThucDon', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy' },
                            { field: 'TrangThaiThucDon', headerText: 'Trạng Thái', width: 150, template: '#statusTemplate' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                        if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                        }
                    };
                }
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        var selectedRecord = args.data;
        var ngay = selectedRecord.NgayThucDon;
        $('#ngayTDHQRowSelected').val(setFormattedDate(ngay));
        var ngayConvert = setFormattedDate(ngay);
        const ngaydangchon = document.getElementById('ngaydangchon');
        ngaydangchon.innerHTML = `Bạn đang xem thực đơn ngày ${ngayConvert}`;
        var ngayAlert = $('#ngayTDHQRowSelected').val();
        //alert(ngayAlert);
        fetchAndRenderDanhSachThucDon(ngay);
    }
</script>

<script>
    //THÊM THỰC ĐƠN
    function showInsert() {

        $('#ngayTDHQ').val(getCurrentDate());
        var rs = [];
        loadGridMonAnData(rs, 'GridMonAn');
        //getDeviceInfo();
        $('#modalTaoThucDon').modal('show');

    }
    function insert() {
        var ngay = $('#ngayTDHQ').val();
        var ten = $('#tenTDHQ').val();
        var listMonAnId = selectedIdsString;
        var ghiChu = $('#ghiChuTDHQ').val();
        document.getElementById("txtTaoThucDon").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/HQ_ThucDon/DoInsert',
            data: {
                ngay: ngay,
                ten:ten,
                listMonAnId: listMonAnId,
                ghiChu: ghiChu
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalTaoThucDon').modal('hide');
                    reloadData();
                    fetchAndRenderDanhSachThucDon(ngay);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtTaoThucDon").style.visibility = "visible";
            }
        });
    }


    document.getElementById('modalTaoThucDon').addEventListener('hidden.bs.modal', function () {
        ClearData("GridMonAn");
        selectedIdsString = "";
        numRowSelect = 0;
    });
    document.getElementById('modalSua').addEventListener('hidden.bs.modal', function () {
        ClearData("GridMonAnSua");
        selectedIdsString = "";
        numRowSelect = 0;
        //listIdThucDonChiTiet = "";
    });
    document.getElementById('modalTaoThucDon').addEventListener('shown.bs.modal', function () {
        isTaoThucDon = 1;
        // ClearData("GridMonAnSua");
        // ClearData("GridMonAn");
        selectedIdsString = "";
        numRowSelect = 0;
    });

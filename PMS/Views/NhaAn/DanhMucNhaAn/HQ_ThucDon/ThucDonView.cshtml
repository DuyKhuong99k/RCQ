    function showUpdate(thucDonId) {
        $.ajax({
            url: "/HQ_ThucDon/GetChiTietThucDonByThucDonId",
            data: { thucDonId: thucDonId },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {

                    $('#modalSua').modal('show');
                    $('#ngayTDHQSua').val(setFormattedDate(rs.NgayThucDon));
                    $('#tenTDHQSua').val(rs.TenThucDon);
                    $('#thucDonIdHidden').val(rs.ThucDonId);
                    $('#ghiChuTDHQSua').val(rs.GhiChu);
                    loadGridMonAnData(rs, 'GridMonAnSua');

                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ngay = $('#ngayTDHQSua').val();
        var thucDonId = $('#thucDonIdHidden').val();
        var ten = $('#tenTDHQSua').val();
        var listMonAnId = selectedIdsString;
        var listIdThucDonChiTietRs = listIdThucDonChiTiet;
        var ghiChu = $('#ghiChuTDHQSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/HQ_ThucDon/DoUpdate',
            data: {
                thucDonId: thucDonId,
                ten: ten,
                listMonAnId:listMonAnId,
                listIdThucDonChiTietRs:listIdThucDonChiTietRs,
                ghiChu: ghiChu
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    fetchAndRenderDanhSachThucDon(ngay);
                    $('#thucDonIdHidden').val('');
                    listIdThucDonChiTiet = "";
                    selectedIds = [];
                    selectedIdsString = "";
                    numRowSelect = 0;
                    isTaoThucDon = 0;
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    //XÓA CHI TIẾT THỰC ĐƠN
    function showDelete(thucDonId) {
        var ngay = $('#ngayTDHQRowSelected').val();
        $.ajax({
            url: "/HQ_ThucDon/GetChiTietThucDonByThucDonId",
            data: { thucDonId: thucDonId },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    listIdThucDonChiTiet = rs && rs.thucDonChiTiet? rs.thucDonChiTiet.map(item => item.Id).join('|') + '|' : '';
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.TenThucDon,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/HQ_ThucDon/DoDelete',
                                    data: { thucDonId: thucDonId,listIdThucDonChiTietRs:listIdThucDonChiTiet },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            fetchAndRenderDanhSachThucDon(ngay);
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>
<script>
    function renderDanhSachThucDon(danhSachThucDon) {
        const listThucDon = document.getElementById('listThucDon');
        listThucDon.innerHTML = '';

        danhSachThucDon.forEach(thucDon => {
            const thucDonCard = document.createElement('div');
            thucDonCard.className = 'col-12 col-sm-6 col-lg-4';

            thucDonCard.innerHTML = `
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="card-title" id="tenThucDon">Thực đơn : ${thucDon.TenThucDon}</h6>
                        <p class="small text-muted" id="ghiChuThucDon">${thucDon.GhiChu || 'Không có ghi chú.'}</p>
                        <div class="d-flex justify-content-between px-3 py-2 bg-light border-bottom mb-0">
                            <h6 class="mb-0">Món ăn</h6>
                            <span id="totalMonAn">${thucDon.MonAn?.length || 0} món</span>
                        </div>
                        <ul class="list-group list-group-flush overflow-auto" style="max-height: 200px;min-height:200px">
                            ${thucDon.MonAn?.map(mon => `<li class="list-group-item">${mon}</li>`).join('') || '<li class="list-group-item">Không có món ăn.</li>'}
                        </ul>
                        <div class="px-3 py-2 mt-2 text-center" style="margin-bottom:-2.5rem">
                            <span class="badge ${thucDon.TrangThaiThucDon === 1 ? 'bg-primary' : thucDon.TrangThaiThucDon === 2 ? 'bg-danger' : 'bg-secondary'}">
                                ${thucDon.TrangThaiThucDon === 1 ? 'Đã duyệt' : thucDon.TrangThaiThucDon === 2 ? 'Bị hủy' : 'Chưa duyệt'}
                            </span>
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-2 justify-content-center">
                        <button onclick="DuyetThucDon(${thucDon.ThucDonId})" ${thucDon.TrangThaiThucDon === 1 || thucDon.TrangThaiThucDon === 2 ? 'class="btn btn-secondary btn-sm"' : 'class="btn btn-success btn-sm"'}  ${thucDon.TrangThaiThucDon === 1 || thucDon.TrangThaiThucDon === 2 ? 'disabled' : ''}>Duyệt</button>
                        <button onclick="HuyThucDon(${thucDon.ThucDonId})" ${thucDon.TrangThaiThucDon === 0 || thucDon.TrangThaiThucDon === 2 ? 'class="btn btn-secondary btn-sm"' : 'class="btn btn-danger btn-sm"'}  ${thucDon.TrangThaiThucDon === 0 || thucDon.TrangThaiThucDon === 2 ? 'disabled' : ''}>Hủy</button>
                        <button onclick="KhoiPhucThucDon(${thucDon.ThucDonId})" ${thucDon.TrangThaiThucDon === 0 || thucDon.TrangThaiThucDon === 1 ? 'class="btn btn-secondary btn-sm"' : 'class="btn btn-warning btn-sm"'} ${thucDon.TrangThaiThucDon === 0 || thucDon.TrangThaiThucDon === 1 ? 'disabled' : ''}>Khôi Phục</button>
                        <button onclick="showUpdate(${thucDon.ThucDonId})" class="btn btn-outline-warning btn-sm"><i class='bx bx-edit-alt'></i>Sửa</button>
                        <button onclick="showDelete(${thucDon.ThucDonId})" class="btn btn-outline-danger btn-sm"><i class='bx bx-edit-alt'></i>Xóa</button>
                    </div>
                </div>
            `;

            listThucDon.appendChild(thucDonCard);
        });
    }

    function fetchAndRenderDanhSachThucDon(ngay) {

        $.ajax({
            type: 'POST',
            url: '/HQ_ThucDon/GetThucDonByDate',
            data: {
                ngay : ngay
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    renderDanhSachThucDon(rs.danhSachThucDon);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }

    function loadDanhSachThucDonGanNhat(){
        $.ajax({
            type: 'POST',
            url: '/HQ_ThucDon/GetNgayThucDonGanNhat',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    var ngayConvert = setFormattedDate(rs.NgayThucDon);
                    const ngaydangchon = document.getElementById('ngaydangchon');
                    ngaydangchon.innerHTML = `Bạn đang xem thực đơn ngày ${ngayConvert}`;
                    $('#ngayTDHQRowSelected').val(ngayConvert);
                    fetchAndRenderDanhSachThucDon(rs.NgayThucDon);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }


    function DuyetThucDon(thucDonId) {
        var ngay = $('#ngayTDHQRowSelected').val();
        $.ajax({
            type: 'POST',
            url: '/HQ_DuyetThucDon/DoInsert',
            data: {
                thucDonId: thucDonId
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    reloadData();
                    fetchAndRenderDanhSachThucDon(ngay);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function HuyThucDon(thucDonId) {
        var ngay = $('#ngayTDHQRowSelected').val();
        $.ajax({
            type: 'POST',
            url: '/HQ_HuyThucDon/DoInsert',
            data: {
                thucDonId: thucDonId
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $.ajax({
                        type: 'POST',
                        url: '/HQ_DuyetThucDon/DoDelete',
                        data: {
                            id: thucDonId
                        },
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                toastOptionNotyfi();
                                toastr["success"]("Hủy Thành Công", "Thông báo");
                                reloadData();
                                fetchAndRenderDanhSachThucDon(ngay);
                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function KhoiPhucThucDon(thucDonId) {
        var ngay = $('#ngayTDHQRowSelected').val();
        $.ajax({
            type: 'POST',
            url: '/HQ_HuyThucDon/DoDelete',
            data: {
                id: thucDonId
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                                toastr["success"]("Khôi Phục Thành Công", "Thông báo");
                                reloadData();
                                fetchAndRenderDanhSachThucDon(ngay);
                    // $.ajax({
                    //     type: 'POST',
                    //     url: '/HQ_DuyetThucDon/DoDelete',
                    //     data: {
                    //         id: thucDonId
                    //     },
                    //     success: function (rs) {
                    //         if (rs.isSuccess === true) {
                    //             toastOptionNotyfi();
                    //             toastr["success"]("Khôi Phục Thành Công", "Thông báo");
                    //             reloadData();
                    //             fetchAndRenderDanhSachThucDon(ngay);
                    //         } else {
                    //             toastOptionNotyfi();
                    //             toastr["warning"](rs.Messages, "Thông báo");
                    //         }
                    //     },
                    //     error: function (error) {
                    //         toastOptionNotyfi();
                    //         toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                    //     }
                    // });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }


</script>


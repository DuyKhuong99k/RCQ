    <!-- Syncfusion ASP.NET Core Script Manager -->



    <ejs-scripts></ejs-scripts>

    <script src="~/notifytion/bootstrap-notify.js"></script>
    <script src="~/notifytion/bootstrap-notify.min.js"></script>

    <script src="~/notifytion/bootbox.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
    <script src="~/js/toastoptionnotyfi.js"></script>
    <script src="~/js/covertjs.js"></script>
    <script src="~/assets/js/ui-popover.js"></script>
    <script>
        // Lấy ngày hiện tại
        var today = new Date();

        // Định dạng ngày thành yyyy-MM-dd (định dạng của trường input date)
        var formattedDate = today.toISOString().substr(0, 10);

        // Gán giá trị vào trường input
        document.getElementById("dateTimeXLPC").value = formattedDate;
        document.getElementById("dateTimeTL").value = formattedDate;
    </script>
    <script>
        // (function () {
        //     const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
        //     const popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
        //         // added { html: true, sanitize: false } option to render button in content area of popover
        //         return new bootstrap.Popover(popoverTriggerEl, { html: true, sanitize: false });
        //     });
        // })();


        function getPath() {
            var url = window.location.href;
            var path = new URL(url).pathname;

            // Sử dụng setTimeout để gán giá trị sau 2 giây
            setTimeout(function () {
                $('#pathQuickSearch').val(path);
            }, 100); // 2000 milliseconds = 2 seconds
        }
        function getCurrentDomain() {
            var url = window.location.href;
            var domain;

            // Find & remove protocol (http, ftp, etc.) and get domain
            if (url.indexOf("://") > -1) {
                domain = url.split('/')[2];
            } else {
                domain = url.split('/')[0];
            }

            // Find & remove port number
            domain = domain.split(':')[0];

            // Add protocol and port
            domain = url.match(/^https?:\/\/[^\/]+/)[0]; // Lấy giao thức, tên miền và số cổng từ URL

            return domain;
        }

        function insertQuickSearch() {

            var userId = @userId;
            var path = $('#pathQuickSearch').val();
            var name = $('#nameQuickSearch').val();
            if (name == null || name == "" || name == undefined) {
                toastOptionNotyfi();
                toastr["warning"]("Bạn chưa đặt tên cho Tìm Kiếm!", "Thông báo");
                return;
            }
            // document.getElementById("txtThem").style.visibility = "hidden";
            // document.getElementById("loadingIndicator").style.display = "block";
            $.ajax({
                type: 'POST',
                url: '/Utilities/DoInsertQuickSearchMenu',
                data: {
                    name: name,
                    path: path,
                    userId: userId
                },
                success: function (rs) {
                    if (rs.isSuccess === true) {
                        toastOptionNotyfi();
                        toastr["success"](rs.Messages, "Thông báo");
                    } else {
                        toastOptionNotyfi();
                        toastr["warning"](rs.Messages, "Thông báo");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                },
                complete: function () {
                    // document.getElementById("loadingIndicator").style.display = "none";
                    // document.getElementById("txtThem").style.visibility = "visible";
                }
            });
        }

        function openModalQuickSearchMenu() {
            // Ẩn tất cả các popover trước khi hiển thị modal
            $('[data-bs-toggle="popover"]').popover('hide');
            $('#modalQuickSearchMenu').modal('show');
            loadGridDataQuickSearchMenu();
        };
        $('#modalQuickSearchMenu').on('hidden.bs.modal', function () {
            // Hiển thị lại popover khi modal được đóng
            showPopoverQuickSearch();
        });
        function showPopoverQuickSearch() {
            $('[data-bs-toggle="popover"]').popover('show');
        }
        function closePopoverQuickSearch() {
            $('[data-bs-toggle="popover"]').popover('hide');
        }
        var gridQuickSearchMenu;
        function loadGridDataQuickSearchMenu() {
            var userId = @userId;
            $.ajax({
                url: '/Utilities/GetAllQuickSearchMenuByUser',
                data: {
                    userId: userId
                },
                type: 'GET',
                success: function (data) {
                    var dataManager = new ej.data.DataManager({
                        json: data,
                        adaptor: new ej.data.JsonAdaptor()
                    });
                    if (gridQuickSearchMenu) {
                        gridQuickSearchMenu.dataSource = dataManager;
                        gridQuickSearchMenu.refresh();
                    } else {
                        gridQuickSearchMenu = new ej.grids.Grid({
                            dataSource: dataManager,
                            allowPaging: true,
                            pageSettings: { pageSize: 50 },
                            allowFiltering: true,
                            allowSorting: true,
                            //frozenColumns: 3,
                            allowResizing: true,
                            rowSelected: onRowSelectedQS,
                            height: 300,
                            columns: [
                                { field: 'Name', headerText: 'Tên', width: 150 },
                                { field: 'Path', headerText: 'Path', width: 150 },
                                { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            ]
                        });
                        // Hiển thị Grid trên trang web
                        gridQuickSearchMenu.appendTo('#GridQuickSearchMenu');
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                }
            });
        }
        function reloadDataQuickSearchMenu() {
            loadGridDataQuickSearchMenu();
        }
        function onRowSelectedQS(args) {
            // Lấy dữ liệu của hàng được chọn
            var selectedRecord = args.data;
            // Lấy giá trị Id từ dữ liệu của hàng được chọn
            var Id = selectedRecord.Id;

            $('#idQSMRowSelected').val(Id);
        }
        function showDeleteQuickSearchMenu() {
            var id = $('#idQSMRowSelected').val();
            $.ajax({
                url: "/Utilities/GetsByMaQuickSearchMenu",
                data: { id: id },

                                                    <small class="text-muted">@userRoles</small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/SettingWebApp/Account">
                                            <i class="bx bx-user me-2"></i>
                                            <span class="align-middle">Hồ Sơ Cá Nhân</span>
                                        </a>
                                    </li>
                                    @{
                                        var caidat2 = rolePermistions.Where(x => x.Fu.Contains("Cài Đặt")).FirstOrDefault();
                                        if (caidat2 != null)
                                        {
                                            <li>
                                                <a class="dropdown-item" href="#">
                                                    <i class="bx bx-cog me-2"></i>
                                                    <span class="align-middle">Cài Đặt</span>
                                                </a>
                                            </li>
                                        }

                                    }
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:void(0);" id="logoutLink">
                                            <i class="bx bx-power-off me-2"></i>
                                            <span class="align-middle">Đăng Xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <!--/ User -->
                        </ul>
                    </div>
                </nav>

                <!-- / Navbar -->
                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <!-- Spinner chung -->
                    @* <div id="loading"> *@
                    @*     <img src="~/assets/img/logo/PhanBachLogo.png" alt="Logo" /> *@
                    @*     <div class="progress-container"> *@
                    @*         <div class="progress-bar" id="progressBar"></div> *@
                    @*     </div> *@
                    @* </div> *@
                    <!-- Content -->
                    <div class="container-fluid flex-grow-1 container-p-y">
                        <div class=" mt-1">
                            <div class="row @(Context.Request.Path.StartsWithSegments("/BaoCao") ? "" : "d-none")">
                                <div class="col-12">
                                    <div class="d-flex justify-content-end align-items-center flex-wrap">
                                        @{
                                            if (!Context.Request.Path.StartsWithSegments("/BaoCao/DinhHinh/TP/TongHopNhanVienKhongLamViec") == true)
                                            {
                                                <div class="mb-2 me-2" style="display: inline-flex;">
                                                    <label for="datepicker1" class="form-label text-center">Từ Ngày:</label>
                                                    @Html.EJS().DatePicker("datepicker1").CssClass("e-input").Placeholder("Chọn Ngày").Value(DateTime.Now).Format("dd/MM/yyyy").Render()
                                                </div>
                                            }
                                        }

                                        <div class="mb-2 me-2" style="display: inline-flex;">
                                            <label for="datepicker2" class="form-label text-center">Đến Ngày:</label>
                                            @Html.EJS().DatePicker("datepicker2").CssClass("e-input").Placeholder("Chọn Ngày").Value(DateTime.Now).Format("dd/MM/yyyy").Render()
                                        </div>
                                        <div class="mb-2 me-2">
                                            <a href="#" class="text-decoration-none">
                                                @Html.EJS().Button("RefreshButton").Content("<i class='bx bx-cloud-download mb-1'></i> Tải Dữ Liệu").CssClass("btn btn-outline-primary").IsPrimary(true).Render()
                                            </a>
                                        </div>
                                        <div class="mb-2">
                                            <button class="btn btn-outline-primary"
                                                    type="button"
                                                    data-bs-toggle="offcanvas"
                                                    data-bs-target="#offcanvasBackdrop"
                                                    aria-controls="offcanvasBackdrop">
                                                <i class='bx bxs-file-export mb-1'></i>
                                                Xuất Báo Cáo
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

    <script>
        $('#searchInput').on('input', function () {
            var userId = @userId;
            var searchText = this.value.trim();

            // Kiểm tra xem ô nhập liệu có dữ liệu hay không
            if (searchText.length > 0) {
                // Gọi API để lấy dữ liệu tìm kiếm
                $.ajax({
                    url: '/Utilities/Search',
                    method: 'GET',
                    data: { search: searchText, userId: userId },
                    success: function (data) {
                        // Xóa hết các gợi ý cũ
                        clearSuggestions();

                        // Hiển thị gợi ý mới dựa trên dữ liệu từ API
                        data.forEach(function (item) {
                            addSuggestion(item.Name, item.Path, item.SuDung);
                        });
                    },
                    error: function (error) {
                        console.error('Error fetching controllers:', error);
                    }
                });
            } else {
                // Xóa hết các gợi ý nếu ô nhập liệu rỗng
                clearSuggestions();
            }
        });
        // Hàm để xóa hết các gợi ý
        function clearSuggestions() {
            var suggestionList = document.getElementById('suggestionList');
            suggestionList.innerHTML = '';
        }
        // Hàm để thêm một gợi ý mới
        function addSuggestion(name, path, sudung) {
            var suggestionList = document.getElementById('suggestionList');
            var suggestionItem = document.createElement('li');
            suggestionItem.textContent = name;
            suggestionItem.title = path;
            // Lưu đường dẫn vào thuộc tính "data-path"
            suggestionItem.setAttribute('data-path', path);
            //khi sử dụng == fales không cho chọn
            if (sudung === false) {
                suggestionItem.style.pointerEvents = "none";
                suggestionItem.classList.add('disabledItemSearch');
            }

            suggestionList.appendChild(suggestionItem);
        }
        document.getElementById('suggestionList').addEventListener('click', function (event) {
            var target = event.target;
            if (target && target.matches('li')) {
                // Lấy đường dẫn từ thuộc tính "data-path" của mục được chọn
                var selectedPath = target.getAttribute('data-path');

                // Nếu có đường dẫn, chuyển hướng tới trang tương ứng
                if (selectedPath) {
                    var selectedUrl = getCurrentDomain() + selectedPath;
                    window.location.href = selectedUrl;
                }
            }
        });
    </script>

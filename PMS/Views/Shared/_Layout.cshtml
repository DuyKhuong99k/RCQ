                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                    <!-- Added modal-lg class -->
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="pdfModalLabel">Hướng Dẫn Sử Dụng</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <canvas id="pdfCanvas"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <!-- / Menu -->
            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->

                <nav class="layout-navbar navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                            <i class="bx bx-menu bx-sm"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <!-- Search -->
                        <div class="navbar-nav align-items-center">
                            <div class="nav-item d-flex align-items-center">
                                <button onclick="getPath()" style="background:none; border:none;box-shadow:none;padding: 0;margin-left: 0px;margin-right: 22px;"
                                        type="button"
                                        class="btn btn-primary text-nowrap"
                                        data-bs-toggle="popover"
                                        data-bs-offset="0,14"
                                        data-bs-placement="right"
                                        data-bs-html="true"
                                        data-bs-content="
                                <p>Nhấn xác nhận để lưu tìm kiếm nhanh trang này!</p>
                                <div class='row'>
                                <div class='col-md-12 mb-12 '>
                                <div class='form-outline'>
                                <label class='form-label'>Đặt Tên</label>
                                <input type='text' id='nameQuickSearch' class='form-control form-control-sm' autocomplete='off' />
                                </div>
                                </div>
                                </div>
                                <div class='row'>
                                <div class='col-md-12 mb-12 '>
                                <div class='form-outline'>
                                <label class='form-label'>Path</label>
                                <input type='text' id='pathQuickSearch' class='form-control form-control-sm' autocomplete='off' disabled />
                                </div>
                                </div>
                                </div>
                                <div style='margin-top:15px' class='d-flex justify-content-between'>
                                <button onclick='openModalQuickSearchMenu()' type='button' class='btn btn-sm btn-outline-secondary'>Quản lý tìm kiếm</button>
                                <button onclick='insertQuickSearch()' type='button' class='btn btn-sm btn-primary'>Xác nhận</button>

                                </div>"
                                title="Tạo tìm kiếm nhanh <span style='float: right;'><i onclick='closePopoverQuickSearch()' class='bx bx-x'></i></span>">
                                    <i class='bx bxs-zap' style="color:#0e3f7b;"></i>
                                </button>

                                <i class="bx bx-search fs-4 lh-0" id="iconSearch"></i>
                                <input id="searchInput" type="text"
                                       class="form-control border-0 shadow-none"
                                       placeholder="Tìm Kiếm..."
                                       aria-label="Search~."
                                       autocomplete="off" />
                                <ul id="suggestionList"></ul>

                            </div>
                        </div>

                        <!-- /Search -->

                        <ul class="navbar-nav flex-row align-items-center ms-auto">
                            <!-- Place this tag where you want the button to render. -->
                            <li class="nav-item lh-1 me-3" style="position: relative; display: inline-block;">
                                @* <select id="xuongs" name="xuongs" *@
                                @*         style="appearance:none;-webkit-appearance:none;-moz-appearance:none; *@
                                @*            padding:0px 0px 0px 15px; *@
                                @*            border:0px solid #d03227; *@
                                @*            border-radius:0px; *@
                                @*            background:#fff; *@
                                @*            color:#d03227; *@
                                @*            font-weight:600; *@
                                @*            cursor:pointer; *@
                                @*            min-width:100px;"> *@
                                @*     <option selected value="@XuongId">@XuongName</option> *@
                                @* </select> *@
                                <select id="xuongs" name="xuongs" class="form-control" ng-class="{'no-border': border}" style="border: none;width: 87px;color:#696cff">
                                    <option selected value="@XuongId">@XuongName</option>
                                </select>
                                <!-- icon mũi tên -->
                                @* <span style="position:absolute; right:10px; top:50%; transform:translateY(-50%); *@
                                @*         font-size:0.7rem; color:#d03227; pointer-events:none;">▼</span> *@
                                <span style="position:absolute; right:10px; top:50%; transform:translateY(-50%);
                                        font-size:0.7rem; color:#696cff; pointer-events:none;">▼</span>
                            </li>
                            <!-- User -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <img src="~/authentication/images/defautavatar.png" class="w-px-40 rounded-circle" id="avatarLayout" />
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a id="infoLink" class="dropdown-item" href="#">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0 me-3">
                                                    <div class="avatar avatar-online">
                                                        <img src="~/authentication/images/defautavatar.png" class="w-px-40 rounded-circle" id="avatarLayout2" />
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">

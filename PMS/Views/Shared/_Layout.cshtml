        function openPDFViewer(pdfUrl) {
            var pdfModal = new bootstrap.Modal(document.getElementById('pdfModal'));
            pdfModal.show();

            // Đường dẫn tương đối tới file PDF
            var absoluteUrl = pdfUrl;

            // Asynchronously download PDF
            pdfjsLib.getDocument(absoluteUrl).promise.then(function (pdfDoc) {
                var modalBody = document.querySelector('.modal-body');
                var totalHeight = 0;

                // Render từng trang và tính toán vị trí y của trang tiếp theo
                var promises = [];
                for (var pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
                    promises.push(pdfDoc.getPage(pageNum).then(function (pageNum, page) {
                        var viewport = page.getViewport({ scale: 1 });
                        var canvas = document.createElement('canvas');
                        canvas.classList.add('pdf-canvas'); // Add a class to the canvas
                        canvas.height = viewport.height;
                        canvas.width = viewport.width;
                        modalBody.appendChild(canvas);
                        var context = canvas.getContext('2d');
                        var renderContext = {
                            canvasContext: context,
                            viewport: viewport
                        };
                        return page.render(renderContext).then(function () {
                            totalHeight += viewport.height;
                            return Promise.resolve();
                        });
                    }.bind(null, pageNum))); // binding pageNum to ensure it retains the correct value
                }

                // Khi đã tính toán xong tổng chiều cao của tất cả các trang, thiết lập kích thước modal
                Promise.all(promises).then(function () {
                    modalBody.style.height = totalHeight + 'px';
                });
            });
        }

    </script>

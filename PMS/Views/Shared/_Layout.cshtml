@using Syncfusion.EJ2
@using Vars

@{
    var userName = @Context.Session.GetString("Username");
    var userId = @Context.Session.GetString("Id");
    var userRoles = @Context.Session.GetString("Roles");
    var accessToken = @Context.Session.GetString("JWTToken");
    var refreshToken = @Context.Session.GetString("RefreshJWTToken");
    var expiresToken = @Context.Session.GetString("ExpiresJWTToken");
    var IdToken = @Context.Session.GetString("Id");
    var XuongId = @Context.Session.GetString("XuongId");
    var XuongName = @Context.Session.GetString("XuongName");

    string baseAddress = @AppViewModels.AppViewModel.Instance.ApiHostUrl;
    string comName = @AppViewModels.AppViewModel.Instance.ComName ?? "";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);

    var listHubmayCan = AppViewModels.AppViewModel.Instance.GetAllHubsUrlJsonData();
    if (listHubmayCan == null)
    {
        listHubmayCan = null;
    }
    var listKhuVucTL = await PMS.Middlewares.AuthenticationHelpers.GetKhuVucs(Context);
    if (listKhuVucTL == null)
    {
        listKhuVucTL = new List<Models.Repos.A_Model.KhuVuc>
    {
        new Models.Repos.A_Model.KhuVuc
        {
            Id = "Null",
            Name = "Không có dữ liệu"
        }
    };
    }

}

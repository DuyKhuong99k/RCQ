                alertBox.style.width = "100%";
                alertBox.style.backgroundColor = "#ff4d4f";
                alertBox.style.color = "white";
                alertBox.style.textAlign = "center";
                alertBox.style.padding = "15px";
                alertBox.style.fontSize = "18px";
                alertBox.style.fontWeight = "bold";
                alertBox.style.zIndex = "9999";
                alertBox.style.boxShadow = "0 -2px 8px rgba(0,0,0,0.2)";

                let closeBtn = document.createElement("button");
                closeBtn.innerHTML = "×";
                closeBtn.style.background = "none";
                closeBtn.style.border = "none";
                closeBtn.style.color = "white";
                closeBtn.style.fontWeight = "bold";
                closeBtn.style.fontSize = "20px";
                closeBtn.style.marginLeft = "20px";
                closeBtn.style.cursor = "pointer";
                closeBtn.onclick = function () {
                    alertBox.remove();
                };

                let textSpan = document.createElement("span");
                textSpan.id = "alert-text";
                alertBox.appendChild(textSpan);
                alertBox.appendChild(closeBtn);
                document.body.appendChild(alertBox);
            }

            document.getElementById("alert-text").innerHTML = `Thông báo: ${message}`;
        }


        let baseUrl = window.location.origin;
     
        const connection = new signalR.HubConnectionBuilder()
            .withUrl(baseUrl + "/progressHub")
            .build();

        connection.on("ReceiveMessage", function (data) {
                pushAlerExpityNotetice(data.content);
               // toastr["error"](data.title, "Thông báo");
        });
        connection.start().then(() => {
            console.log("SignalR connected");
        }).catch(function (err) {
            console.error("SignalR error: ", err.toString());
        });
    </script>
    <script>
        const body = document.body;
        const toggleBtn = document.getElementById('darkModeToggle');

        // Kiểm tra preference hệ thống + localStorage
        function initTheme() {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme) {
            body.classList.toggle("dark-mode", savedTheme === "dark");
          } else {
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
              body.classList.add("dark-mode");
              localStorage.setItem("theme", "dark");
            }
          }
          updateBtnText();
        }

        // Cập nhật text trên nút
        function updateBtnText() {
          if (body.classList.contains("dark-mode")) {
            toggleBtn.textContent = "☀️ Light Mode";
          } else {
            toggleBtn.textContent = "🌙 Dark Mode";
          }
        }

        // Bấm nút để toggle
        toggleBtn.addEventListener("click", () => {
          body.classList.toggle("dark-mode");
          const newTheme = body.classList.contains("dark-mode") ? "dark" : "light";
          localStorage.setItem("theme", newTheme);
          updateBtnText();
        });

        initTheme();
    </script>
</body>
</html>
@using System.Web
@{
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);

    var listHubmayCan = AppViewModels.AppViewModel.Instance.GetAllHubsUrlJsonData();
    if (listHubmayCan == null)
    {
        listHubmayCan = null;
    }
    var listKhuVucTL = await PMS.Middlewares.AuthenticationHelpers.GetKhuVucs(Context);
    if (listKhuVucTL == null)
    {
        listKhuVucTL = new List<Models.Repos.A_Model.KhuVuc>
    {
        new Models.Repos.A_Model.KhuVuc
        {
            Id = "Null",
            Name = "Không có dữ liệu"
        }
    };
    }

    var path = Context.Request.Path;

    bool isDanhMucHQ = path.StartsWithSegments("/DanhMucHQ");

    bool isSpecificHQ =
        path.StartsWithSegments("/DanhMucHQ/HQ_ChatLuongNguyenLieu") ||
        path.StartsWithSegments("/DanhMucHQ/HQ_DonViTinh") ||
        path.StartsWithSegments("/DanhMucHQ/HQ_KhoNguyenLieu") ||
        path.StartsWithSegments("/DanhMucHQ/HQ_SanPhamNguyenLieu") ||
        path.StartsWithSegments("/DanhMucHQ/HQ_QuyCachNguyenLieu") ||
        path.StartsWithSegments("/DanhMucHQ/HQ_PhuongTienNguyenLieu") ||
        path.StartsWithSegments("/DanhMucHQ/HQ_NhaCungCapNguyenLieu");
}

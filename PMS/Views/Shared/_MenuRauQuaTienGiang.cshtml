                var hubsmaycan = rolePermistions.Where(x => x.Fu == "Hubs" && x.Func == "Máy Cân" && x.Status == 1).FirstOrDefault();
                if (hubsmaycan != null)
                {
                    <li class="menu-item">

                        <a onclick="navigateHubsMayCan('@Html.Raw(HttpUtility.JavaScriptStringEncode(item.NameMayCanHubs))')"
                           href="javascript:void(0);" class="menu-link">
                            <i class='menu-icon tf-icons bx bx-laptop'></i>
                            <div data-i18n="Support">@item.NameMayCanHubs</div>
                        </a>
                        <input id="hubsMayCanHidden" type="text" value="@item.NameMayCanHubs" hidden/>

                    </li>
                }
            }
        }
        else
        {
            <div hidden></div>
        }


    }


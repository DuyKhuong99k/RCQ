@{
    ViewData["Title"] = "KhoiLuongXuatLoTheoXuongXLNHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listLo = ViewBag.listLo;
}

<div class="container-fluid mt-4">

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h3>Khối Lượng Xuất Xưởng Theo Lô</h3>
        </div>

        <div class="card-body">

            <!-- FILTER -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Chọn Lô</label>
                    <input id="MaLoBCHQ" class="form-control" />
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <button id="RefreshButtonBCHQ" class="btn btn-primary">
                        Tải dữ liệu
                    </button>
                </div>
            </div>

            <!-- GRID -->
            <div id="Grid"></div>

        </div>

    </div>

</div>


<script>

    var grid;
    var comboLo;

    // ================= COMBOBOX =================
    var listLo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listLo ?? new List<object>()));

    comboLo = new ej.dropdowns.ComboBox({
        dataSource: listLo,
        fields: { text: 'MaLo', value: 'MaLo' },
        placeholder: "Chọn Lô",
        allowFiltering: true,
        popupHeight: "250px"
    });

    comboLo.appendTo("#MaLoBCHQ");


    // ================= GRID FUNCTION =================
    function loadGridData(data) {

        var dataManager = new ej.data.DataManager({
            json: data || [],
            adaptor: new ej.data.JsonAdaptor()
        });

        if (grid) {
            grid.dataSource = dataManager;
            grid.refresh();
            return;
        }

        ej.grids.Grid.Inject(ej.grids.Filter, ej.grids.Page, ej.grids.Toolbar, ej.grids.ExcelExport);

        grid = new ej.grids.Grid({

            dataSource: dataManager,

            editSettings: { allowEditing: true, mode: 'Batch', allowAdding: false, allowDeleting: false },
            cellSave: function (args) { if (args.columnName !== "KhoiLuongNhap") return; $.ajax({ url: "/BaoCaoCanNguyenLieuHQ/UpdateKhoiLuong", type: "POST", data: { soPhieuCanNhap: args.rowData.SoPhieuCanNhap, maQuyCach: args.rowData.MaQuyCach, khoiLuongNhap: args.value }, success: function (res) { if (res.success) { toastr.success("Cập nhật thành công"); } else { toastr.error(res.message); } } }); },

            allowPaging: true,
            pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
            allowFiltering: true,
            allowSorting: true,
            allowExcelExport: true,
            toolbar: ['ExcelExport'],
            height: 450,

            // ================= CELL SAVE =================
            cellSave: function (args) {

                if (args.columnName !== "KhoiLuongNhap") return;

                var row = args.rowData;

                $.ajax({
                    url: "/BaoCaoCanNguyenLieuHQ/UpdateKhoiLuong",
                    type: "POST",
                    data: {
                        maLo: comboLo.value,
                        tenSanPham: row.TenSanPham,
                        khoiLuongNhap: args.value,
                        khoiLuongXuat: row.KhoiLuongXuat
                    },

                    success: function (res) {
                        if (res.success) {
                            toastr.success("Cập nhật thành công");
                        } else {
                            toastr.error(res.message || "Cập nhật thất bại");
                        }
                    },

                    error: function () {
                        toastr.error("Lỗi server khi update");
                    }
                });
            },

            columns: [
                { field: 'SoPhieuCanNhap', visible: false },
                { field: 'MaQuyCach', visible: false },

                { field: 'TenSanPham', headerText: 'Tên sản phẩm', width: 180, allowEditing: false },
                { field: 'TenQuyCach', headerText: 'Quy cách', width: 150, allowEditing: false },

                { field: 'KhoiLuongNhap', headerText: 'Khối lượng nhập', width: 140, type: 'number', allowEditing: true },
                { field: 'KhoiLuongXuat', headerText: 'Khối lượng xuất', width: 140, type: 'number', allowEditing: false },
                { field: 'TongHuKho', headerText: 'Hư kho', width: 120, allowEditing: false },
                { field: 'KhoiLuongHaoHut', headerText: 'Hao hụt', width: 120, allowEditing: false }
            ],

            aggregates: [{
                columns: [
                    {
                        field: 'KhoiLuongNhap',
                        type: 'Sum',
                        footerTemplate: 'Tổng nhập: ${Sum}'
                    },
                    {
                        field: 'KhoiLuongXuat',
                        type: 'Sum',
                        footerTemplate: 'Tổng xuất: ${Sum}'
                    }
                ]
            }]
        });

        grid.appendTo('#Grid');
    }


    // ================= LOAD DATA =================
    document.getElementById("RefreshButtonBCHQ").addEventListener("click", function () {

        $.ajax({
            url: "/BaoCaoCanNguyenLieuHQ/ReloadKhoiLuongXuatLoTheoXuong",
            type: "POST",
            data: { maLo: comboLo.value },

            success: function (res) {

                if (res.Success) {
                    loadGridData(res.Data);
                } else {
                    loadGridData([]);
                    toastr.error(res.Messages);
                }
            },

            error: function () {
                toastr.error("Không load được dữ liệu");
            }
        });
    });


    // INIT EMPTY GRID
    loadGridData([]);

</script>
    @{
        ViewData["Title"] = "KhoiLuongXuatLoTheoXuongXLNHQView";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="mb-0 fw-bold">Khối Lượng Xuất Xưởng Theo Lô</h5>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div style="min-width: 260px;">
                                <input id="MaLoBCHQ" />
                            </div>

                            <button id="RefreshButtonBCHQView" type="button" class="btn btn-outline-primary">
                                <i class='bx bx-cloud-download mb-1'></i> Tải Dữ Liệu
                            </button>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="Grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var listLo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.listLo));
        var comboLo = new ej.dropdowns.ComboBox({
            dataSource: listLo,
            fields: {
                text: 'MaLo',
                value: 'MaLo'
            },
            placeholder: 'Chọn Lô',
            allowFiltering: true,
            popupHeight: '250px'
        });
        comboLo.appendTo('#MaLoBCHQ');

        var grid;
        var datalength = 0;
        var editingField = null;

        function toNumber(value) {
            var parsed = parseFloat(value);
            return Number.isFinite(parsed) ? parsed : 0;
        }

        // function getQuantityColumnConfig(field) {
        //     if (field === 'KhoiLuongXuat') {
        //         return {
        //             valueField: 'KhoiLuongXuat',
        //             url: '@Url.Action("UpdateKhoiLuongXuat", "BaoCaoCanNguyenLieuHQ")',
        //             successMessage: 'Cập nhật khối lượng xuất thành công.'
        //         };
        //     }

        //     return {
        //         valueField: 'KhoiLuongNhap',
        //         url: '@Url.Action("UpdateKhoiLuong", "BaoCaoCanNguyenLieuHQ")',
        //         successMessage: 'Cập nhật khối lượng nhập thành công.'
        //     };
        // }

        function getQuantityColumnConfig(field, rowData) {

        const tenSanPham = (rowData?.TenSanPham || "")
            .trim()
            .toLowerCase();
const isKhomDuaOrThanhLong =
    (tenSanPham.includes("khóm") && tenSanPham.includes("dứa")) ||
    tenSanPham.includes("thanh long");
        if (field === 'KhoiLuongXuat') {

            if (isKhomDuaOrThanhLong) {
                return {
                    valueField: 'KhoiLuongXuat',
                    url: '@Url.Action("UpdateKhoiLuongXuatKhomDua", "BaoCaoCanNguyenLieuHQ")',
                    successMessage: 'Cập nhật khối lượng xuất Khóm, dứa thành công.'
                };
            }

            return {
                valueField: 'KhoiLuongXuat',
                url: '@Url.Action("UpdateKhoiLuongXuat", "BaoCaoCanNguyenLieuHQ")',
                successMessage: 'Cập nhật khối lượng xuất thành công.'
            };
        }

        return {
            valueField: 'KhoiLuongNhap',
            url: '@Url.Action("UpdateKhoiLuong", "BaoCaoCanNguyenLieuHQ")',
            successMessage: 'Cập nhật khối lượng nhập thành công.'
        };
    }

        function reloadGridFromServer() {
            var button = document.getElementById('RefreshButtonBCHQView');
            var originalContent = button.innerHTML;
            button.innerHTML = 'Đang Tải ...';

            var maLo = comboLo.value || null;

            return $.ajax({
                url: '@Url.Action("ReloadKhoiLuongXuatLoTheoXuong", "BaoCaoCanNguyenLieuHQ")',
                type: 'POST',
                data: { maLo: maLo },
                success: function (response) {
                    if (response.Success) {
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }
            }).always(function () {
                button.innerHTML = originalContent;
            });
        }

        function loadGridData(data) {
            var normalizedData = (Array.isArray(data) ? data : []).map(function (row) {
                var khoiLuongNhap = toNumber(row.KhoiLuongNhap);
                var khoiLuongXuat = toNumber(row.KhoiLuongXuat);
                var tongXuatThuong = toNumber(row.TongXuatThuong);
                var tongXuatHu = toNumber(row.TongXuatHu);
                var tongNhapLuyKeThuong = toNumber(row.TongNhapLuyKeThuong);
                var tongNhapThuong = toNumber(row.TongNhapThuong);
                var maSanPham = row.MaSanPham;
                var thuTu = toNumber(row.Index);

                return Object.assign({}, row, {
                    KhoiLuongNhap: khoiLuongNhap,
                    KhoiLuongXuat: khoiLuongXuat,
                    TongXuatThuong: tongXuatThuong,
                    TongXuatHu: tongXuatHu,
                    TongNhapLuyKeThuong: tongNhapLuyKeThuong,
                    TongNhapThuong: tongNhapThuong,
                    MaSanPham: maSanPham,
                    Index: thuTu,
                    KhoiLuongHaoHut: Math.round((khoiLuongNhap - khoiLuongXuat) * 10) / 10
                });
            });

            var dataManager = new ej.data.DataManager({
                json: normalizedData,
                adaptor: new ej.data.JsonAdaptor()
            });

            datalength = normalizedData.length;

            if (grid) {
                grid.dataSource = dataManager;
                grid.refresh();
                return;
            }

            ej.grids.Grid.Inject(ej.grids.Filter, ej.grids.ExcelExport, ej.grids.Edit, ej.grids.Toolbar, ej.grids.Selection);

            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { mode: 'Both', type: 'Single' },
                allowResizing: true,
                allowExcelExport: true,
                allowEditOnDblClick: false,
                toolbar: ['ExcelExport'],
                height: 400,
                editSettings: {
                    allowEditing: true,
                    allowAdding: false,
                    allowDeleting: false,
                    mode: 'Normal'
                },
                actionBegin: function (args) {
                    if (args.requestType === 'filterchoicerequest' || args.requestType === 'filtersearchbegin') {
                        args.filterChoiceCount = datalength;
                    }
                },
    recordClick: function (args) {

        var column = grid.getColumnByIndex(args.cellIndex);

        if (!column) {
            return;
        }

        if (column.field !== 'KhoiLuongNhap'
            && column.field !== 'KhoiLuongXuat') {
            return;
        }

    editingField = column.field;

    var tr = args.row;

    if (!tr) {
        return;
    }

    tr.classList.add('e-editedrow');
    tr.setAttribute('aria-selected', 'true');

    grid.selectRow(args.rowIndex);

    grid.startEdit();
    },
                    cellEdit: function (args) {

        if (!args.column) {
            console.log('args.column null');
            return;
        }

        editingField = args.column.field;

        console.log('cellEdit editingField', editingField);

        if (args.column.field !== 'KhoiLuongNhap'
            && args.column.field !== 'KhoiLuongXuat') {

            args.cancel = true;
            return;
        }

        try {

            var input =
                args.container &&
                (
                    args.container.querySelector('input')
                    || args.container.querySelector('input.e-input')
                );

            if (!input) return;

            var saveHandler = function (ev) {

                if (ev.type === 'blur'
                    || ev.key === 'Enter') {

                    input.removeEventListener('blur', saveHandler);
                    input.removeEventListener('keydown', saveHandler);

                    try {
                        grid.saveCell();
                    }
                    catch (e) {
                        console.error(e);
                    }
                }
            };

            input.addEventListener('blur', saveHandler);
            input.addEventListener('keydown', saveHandler);
        }
        catch (e) {
            console.error(e);
        }
    },
                actionComplete: async function (args) {

    if (args.requestType !== 'save') {
        return;
    }
    console.log('args.columnName', args.columnName);
    console.log('editingField cuối', editingField);
    var field = editingField;
    var row = args.data || args.rowData; // ✅ Khai báo row TRƯỚC
    console.log('field cuối', field);
    if (!row) return;
    var config = getQuantityColumnConfig(field, row);
    console.log('url', config.url);
                    try {
                        if (args.requestType === 'save') {
                            var row = args.data || args.rowData;
                            if (!row) return;
                            if (!row.SoPhieuCanNhap || !row.MaQuyCach) {
                                toastOptionNotyfi();
                                toastr['error']('Thiếu dữ liệu định danh, không thể lưu.', 'Thông báo');
                                return;
                            }

                            var payload = {
                                soPhieuCanNhap: row.SoPhieuCanNhap,
                                        maQuyCach: row.MaQuyCach,
                                        maLo: row.MaLo,
                                        maSanPham: row.MaSanPham,
                                        thuTu: row.Index,
                                        tongXuatThuong: row.TongXuatThuong,
                                        tongXuatHu: row.TongXuatHu,
                                        tongNhapLuyKeThuong: row.TongNhapLuyKeThuong,
                                        tongNhapThuong: row.TongNhapThuong,
                                        khoiLuongNhap: row.KhoiLuongNhap
                            };

                                    if (config.valueField === 'KhoiLuongXuat') {
                                        payload.khoiLuongXuat = row.KhoiLuongXuat;
                                    } else {
                                        payload.khoiLuongNhap = row.KhoiLuongNhap;
                                    }

                            var response = await $.ajax({
                                url: config.url,
                                type: 'POST',
                                data: payload
                            });

                            if (response && response.success === false) {
                                throw new Error(response.message || 'Cập nhật thất bại.');
                            }

                            toastOptionNotyfi();
                            toastr['success'](config.successMessage, 'Thông báo');
                            await reloadGridFromServer();
                        }
                    } catch (error) {
                        console.error(error);
                        toastOptionNotyfi();
                        toastr['error'](error?.message || 'Cập nhật thất bại.', 'Thông báo');
                        await reloadGridFromServer();
                    } finally {
                        editingField = null;
                    }
                },
                columns: [
                    { field: 'SoPhieuCanNhap', visible: false },
                    { field: 'MaLo', visible: false },
                    { field: 'MaQuyCach', visible: true },
                    { field: 'TenSanPham', headerText: 'Tên sản phẩm', width: 180, allowEditing: false },
                    { field: 'TenQuyCach', headerText: 'Quy cách', width: 180, allowEditing: false },
                    {
                        field: 'KhoiLuongNhap',
                        headerText: 'Khối lượng nhập',
                        width: 180,
                        type: 'number',
                        editType: 'numericedit',
                        format: 'N1',
                        textAlign: 'Right',
                        allowEditing: true
                    },
                    {
                        field: 'KhoiLuongXuat',
                        headerText: 'Khối lượng xuất',
                        width: 180,
                        type: 'number',
                        editType: 'numericedit',
                        format: 'N1',
                        textAlign: 'Right',
                        allowEditing: true
                    },
                    {
                        field: 'TongHuKho',
                        headerText: 'Hư kho',
                        width: 180,
                        type: 'number',
                        format: 'N1',
                        textAlign: 'Right',
                        allowEditing: false
                    },
                    {
                        field: 'KhoiLuongHaoHut',
                        headerText: 'Hao hụt',
                        width: 180,
                        type: 'number',
                        format: 'N1',
                        textAlign: 'Right',
                        allowEditing: false
                    }
                ],
                aggregates: [
                    {
                        columns: [
                            {
                                type: 'Sum',
                                field: 'KhoiLuongNhap',
                                format: 'N1',
                                footerTemplate: 'Tổng Nhập: ${Sum} Kg'
                            },
                            {
                                type: 'Sum',
                                field: 'KhoiLuongXuat',
                                format: 'N1',
                                footerTemplate: 'Tổng Xuất: ${Sum} Kg'
                            }
                        ]
                    }
                ]
            });

            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
                if (args.item.id === 'Grid_excelexport') {
                    grid.excelExport();
                }
            };

            grid.refresh();
        }

        document.getElementById('RefreshButtonBCHQView').addEventListener('click', function () {
            reloadGridFromServer();
        });

        loadGridData();
    </script>

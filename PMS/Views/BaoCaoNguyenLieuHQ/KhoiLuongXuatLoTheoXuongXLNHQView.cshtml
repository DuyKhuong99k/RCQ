@{
    ViewData["Title"] = "KhoiLuongXuatLoTheoXuongXLNHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listLo = ViewBag.ListLo;
}

<div class="container-fluid mt-4">

    <div class="card">

        <div class="card-header">
            <h3>Khối Lượng Xuất Theo Lô</h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">

                    <label>Chọn Lô</label>

                    <input id="MaLoBCHQ" />

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button id="btnLoad"
                            class="btn btn-primary w-100">
                        Tải Dữ Liệu
                    </button>

                </div>

            </div>

            <div id="Grid"></div>

        </div>

    </div>

</div>

<script>

    //-------------------------------------------------------
    // COMBOBOX
    //-------------------------------------------------------

    var listLo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ListLo));

    var comboLo = new ej.dropdowns.ComboBox({

        dataSource: listLo,

        fields: {
            text: 'MaLo',
            value: 'MaLo'
        },

        placeholder: 'Chọn Lô',

        allowFiltering: true,

        popupHeight: '250px'

    });

    comboLo.appendTo('#MaLoBCHQ');

    //-------------------------------------------------------
    // GRID
    //-------------------------------------------------------

    var grid;

    function loadGrid(data) {

        var dataManager = new ej.data.DataManager({

            json: data || [],

            adaptor: new ej.data.JsonAdaptor()

        });

        //---------------------------------------------------
        // GRID EXISTS
        //---------------------------------------------------

        if (grid) {

            grid.dataSource = dataManager;

            grid.refresh();

            return;
        }

        //---------------------------------------------------
        // INJECT
        //---------------------------------------------------

        ej.grids.Grid.Inject(
            ej.grids.Page,
            ej.grids.Sort,
            ej.grids.Filter,
            ej.grids.Edit,
            ej.grids.Toolbar,
            ej.grids.Aggregate
        );

        //---------------------------------------------------
        // GRID
        //---------------------------------------------------

        grid = new ej.grids.Grid({

            dataSource: dataManager,

            height: 500,

            allowPaging: true,

            allowSorting: true,

            allowFiltering: true,

            allowExcelExport: true,

            toolbar: ['ExcelExport'],

            pageSettings: {

                pageSize: 50

            },

            filterSettings: {

                type: 'Excel'

            },

            //------------------------------------------------
            // EDIT
            //------------------------------------------------

            editSettings: {

                allowEditing: true,
                allowAdding: false,
                allowDeleting: false,
                mode: 'Normal'

            },

            //------------------------------------------------
            // SAVE EVENT
            //------------------------------------------------

            actionComplete: function (args) {

                //--------------------------------------------
                // SAVE
                //--------------------------------------------

                if (args.requestType === 'save') {

                    //----------------------------------------
                    // XÁC NHẬN
                    //----------------------------------------

                    var confirmUpdate = confirm(
                        "Bạn có muốn cập nhật khối lượng nhập không?"
                    );

                    //----------------------------------------
                    // KHÔNG ĐỒNG Ý
                    //----------------------------------------

                    if (!confirmUpdate) {

                        //------------------------------------
                        // LOAD LẠI GRID CŨ
                        //------------------------------------

                        grid.refresh();

                        return;
                    }


                    var row = args.data;

                    $.ajax({

                        url: '@Url.Action("UpdateKhoiLuong", "BaoCaoCanNguyenLieuHQ")',

                        type: 'POST',

                        data: {

                            soPhieuCanNhap: row.SoPhieuCanNhap,
                            maQuyCach: row.MaQuyCach,
                            khoiLuongNhap: row.KhoiLuongNhap

                        },

                           success: function (res) {

        if (res.success) {

            toastr.success("Cập nhật thành công");

            //----------------------------------------
            // LOAD LẠI GRID
            //----------------------------------------

            var maLo = comboLo.value;

            $.ajax({

                url: '@Url.Action("ReloadKhoiLuongXuatLoTheoXuong", "BaoCaoCanNguyenLieuHQ")',

                type: 'POST',

                data: {
                    maLo: maLo
                },

                success: function (reloadRes) {

                    if (reloadRes.Success) {

                        //--------------------------------
                        // UPDATE DATASOURCE
                        //--------------------------------

                        grid.dataSource = reloadRes.Data;

                        //--------------------------------
                        // REFRESH GRID
                        //--------------------------------

                        grid.refresh();

                    }

                }

            });

        }
        else {

            toastr.error(res.message);

        }

    },

                        error: function () {

                            toastr.error("Lỗi hệ thống");

                        }

                    });

                }

            },

            //------------------------------------------------
            // COLUMNS
            //------------------------------------------------

            columns: [

                {
                field: 'SoPhieuCanNhap',
                visible: false
                },

                {
                    field: 'MaLo',
                    visible: false
                },

                {
                    field: 'MaQuyCach',
                    visible: false
                },

                {
                    field: 'TenSanPham',
                    headerText: 'Tên sản phẩm',
                    width: 180,
                    allowEditing: false
                },

                {
                    field: 'TenQuyCach',
                    headerText: 'Quy cách',
                    width: 180,
                    allowEditing: false
                },

                //------------------------------------------------
                // CHỈ CỘT NÀY CHO NHẬP
                //------------------------------------------------

                {
                    field: 'KhoiLuongNhap',
                    headerText: 'Khối lượng nhập',
                    width: 180,
                    type: 'number',
                    editType: 'numericedit',
                    format: 'N3',
                    textAlign: 'Right',
                    allowEditing: true
                },

                {
                    field: 'KhoiLuongXuat',
                    headerText: 'Khối lượng xuất',
                    width: 180,
                    type: 'number',
                    format: 'N3',
                    textAlign: 'Right',
                    allowEditing: false
                },

                {
                    field: 'TongHuKho',
                    headerText: 'Hư kho',
                    width: 180,
                    type: 'number',
                    format: 'N3',
                    textAlign: 'Right',
                    allowEditing: false
                },

                {
                    field: 'KhoiLuongHaoHut',
                    headerText: 'Hao hụt',
                    width: 180,
                    type: 'number',
                    format: 'N3',
                    textAlign: 'Right',
                    allowEditing: false
                }

            ],

            //------------------------------------------------
            // FOOTER TOTAL
            //------------------------------------------------

            aggregates: [

                {

                    columns: [

                        {

                            type: 'Sum',

                            field: 'KhoiLuongNhap',

                            format: 'N3',

                            footerTemplate: 'Tổng Nhập: ${Sum} Kg'

                        },

                        {

                            type: 'Sum',

                            field: 'KhoiLuongXuat',

                            format: 'N3',

                            footerTemplate: 'Tổng Xuất: ${Sum} Kg'

                        }

                    ]

                }

            ]

        });

        grid.appendTo('#Grid');

    }

    //-------------------------------------------------------
    // LOAD DATA
    //-------------------------------------------------------

    $('#btnLoad').click(function () {

        var maLo = comboLo.value;

        $.ajax({

            url: '@Url.Action("ReloadKhoiLuongXuatLoTheoXuong", "BaoCaoCanNguyenLieuHQ")',

            type: 'POST',

            data: {

                maLo: maLo

            },

            success: function (res) {

                if (res.Success) {

                    loadGrid(res.Data);

                }
                else {

                    loadGrid([]);

                    toastr.error(res.Messages);

                }

            },

            error: function () {

                toastr.error("Lỗi hệ thống");

            }

        });

    });

    //-------------------------------------------------------
    // LOAD EMPTY
    //-------------------------------------------------------

    loadGrid([]);

</script>
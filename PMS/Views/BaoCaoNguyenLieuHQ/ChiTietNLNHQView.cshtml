
@{
    ViewData["Title"] = "ChiTietNLNHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Chi Tiết</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {
        let fromDate = document.getElementById("fromDateBCHQ");
        let toDate = document.getElementById("toDateBCHQ");

        if (fromDate) {
            fromDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 00:00:00
            fromDate.value = `${year}-${month}-${day}T00:00:00`;
        }

        if (toDate) {
            toDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 23:59:59
            toDate.value = `${year}-${month}-${day}T23:59:59`;
        }
    });


    var grid;
    var datalength = 0;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }
        if (grid != null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            ej.grids.Grid.Inject(ej.grids.Filter);
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                allowResizing: true,
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    { field: 'LoNguyenLieu', headerText: 'Lô', width: 150 },
                    { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'NgayNguyenLieu', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                    { field: 'ThoiGian', headerText: 'Ngày Giờ', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                    { field: 'SoPhieu', headerText: 'Số Phiếu', width: 150 },
                    { field: 'SoLanSuaDoi', headerText: 'Số Lần Sửa Đổi', width: 150 },
                    { field: 'DiaDiem', headerText: 'Địa Điểm', width: 150 },
                    { field: 'NguoiGiao', headerText: 'Người Giao', width: 150 },
                    { field: 'TaiXe', headerText: 'Tài Xế', width: 150 },
                    { field: 'SoXe', headerText: 'Số Xe', width: 150 },
                    { field: 'CCCD', headerText: 'CCCD', width: 150 },
                    { field: 'NoiDungGiaoNhan', headerText: 'Nội Dung', width: 150 },
                    { field: 'TenHang', headerText: 'Tên Hàng', width: 150 },
                    { field: 'QuyCachSanPham', headerText: 'Quy Cách', width: 150 },
                    { field: 'DonViTinh', headerText: 'Đơn Vị Tính', width: 150 },
                    { field: 'ChatLuong', headerText: 'Chất Lượng', width: 150 },
                    { field: 'CanHang', headerText: 'Cân Hàng', width: 150 },
                    { field: 'TruBi', headerText: 'Trừ Bì', width: 150 },
                    { field: 'PhanLoaiNguyenLieu', headerText: 'Phân Loại', width: 150 },
                    { field: 'NhanXet', headerText: 'Nhận Xét', width: 150 },
                    { field: 'TrongLuongHang', headerText: 'Trọng Lượng Hàng', type: 'number', width: 150 },
                    { field: 'TrongLuongXe', headerText: 'Trọng Lượng Xe', type: 'number', width: 150 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuongHang',
                            format: '####.000',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'TrongLuongXe',
                            format: '####.000',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        },
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};

            grid.refresh();
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    document.getElementById('RefreshButtonBCHQ').addEventListener("click",
        function () {
            var btn = document.getElementById('RefreshButtonBCHQ').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var fromDate =$('#fromDateBCHQ').val();
            var toDate = $('#toDateBCHQ').val();
            var xuongId = @XuongId;
            $.ajax({
                url: "@Url.Action("Reload", "BaoCaoCanNguyenLieuHQ")",
                type: "POST",
                data: { "fromDate": fromDate, "toDate": toDate, xuongId: xuongId },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        ClearData("Grid");
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>



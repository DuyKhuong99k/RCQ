
@{
    ViewData["Title"] = "ChiTietNLNHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Chi Tiết Nguyên Liệu</h5>

                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0 small text-muted">Loại Giao Dịch:</label>

                        <select id="loaiGiaoDich"
                                class="form-select form-select-sm"
                                style="width:160px;">
                            <option value="">Tất cả</option>
                            <option value="Nhập">🟢 Nhập</option>
                            <option value="Xuất">🔴 Xuất</option>
                        </select>
                    </div>
                </div>

                <!-- BODY -->
                <div class="card-body">
                    <div id="Grid"></div>
                </div>

            </div>
        </div>
    </div>
</div>
</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {
        let fromDate = document.getElementById("fromDateBCHQ");
        let toDate = document.getElementById("toDateBCHQ");

        if (fromDate) {
            fromDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 00:00:00
            fromDate.value = `${year}-${month}-${day}T00:00:00`;
        }

        if (toDate) {
            toDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 23:59:59
            toDate.value = `${year}-${month}-${day}T23:59:59`;
        }
    });


    var grid;
    var datalength = 0;
    var originalTenNhaCC = null;

    function escapeHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function confirmUpdateTenKhachHang(tenCu, tenMoi) {
        var isUsingFixedName = Boolean(String(tenMoi || '').trim());
        var message = isUsingFixedName
            ? 'Bạn có chắc muốn dùng tên khách hàng cố định <b>' + escapeHtml(tenMoi) + '</b> thay cho <b>' + escapeHtml(tenCu) + '</b>?'
            : 'Bạn có chắc muốn bỏ tên khách hàng cố định và dùng lại tên từ danh mục nhà cung cấp?';

        return new Promise(function (resolve) {
            if (typeof bootbox !== 'undefined' && bootbox.confirm) {
                bootbox.confirm({
                    title: 'Xác nhận cập nhật',
                    message: message,
                    buttons: {
                        confirm: {
                            label: 'Đồng ý',
                            className: 'btn-primary'
                        },
                        cancel: {
                            label: 'Hủy',
                            className: 'btn-secondary'
                        }
                    },
                    callback: function (result) {
                        resolve(result === true);
                    }
                });
            } else {
                resolve(window.confirm(message.replace(/<[^>]*>/g, '')));
            }
        });
    }

    function reloadGridFromServer() {
        var button = document.getElementById('RefreshButtonBCHQ');
        var btn = button.ej2_instances[0];
        var content = btn.content;
        btn.content = 'Đang Tải ...';
        var fromDate = $('#fromDateBCHQ').val();
        var toDate = $('#toDateBCHQ').val();
        var xuongId = @XuongId;

        return $.ajax({
            url: '@Url.Action("Reload", "BaoCaoCanNguyenLieuHQ")',
            type: 'POST',
            data: { fromDate: fromDate, toDate: toDate, xuongId: xuongId },
            success: function (response) {
                if (response.Success) {
                    ClearData('Grid');
                    loadGridData(response.Data);
                } else {
                    loadGridData(response.Data);
                    console.error(response.Messages);
                    toastOptionNotyfi();
                    toastr['error'](response.Messages, 'Không có dữ liệu!');
                }
            },
            error: function (error) {
                console.error(error);
                toastOptionNotyfi();
                toastr['error']('Không thể tải lại dữ liệu.', 'Thông báo');
            }
        }).always(function () {
            btn.content = content;
        });
    }

    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }
        if (grid != null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            ej.grids.Grid.Inject(ej.grids.Filter, ej.grids.Edit, ej.grids.Toolbar, ej.grids.ExcelExport);
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }

                    if (args.requestType === 'beginEdit'
                        && args.columnName
                        && args.columnName !== 'TenNhaCC') {
                        args.cancel = true;
                    }
                },
                allowResizing: true,
                allowExcelExport: true,
                allowEditOnDblClick: true,
                toolbar: ['ExcelExport'],
                height: 400,
                editSettings: {
                    allowEditing: true,
                    allowAdding: false,
                    allowDeleting: false,
                    mode: 'Normal'
                },
                cellEdit: function (args) {
                    if (!args.column || args.column.field !== 'TenNhaCC') {
                        args.cancel = true;
                        return;
                    }

                    originalTenNhaCC = args.rowData ? args.rowData.TenNhaCC : null;

                    setTimeout(function () {
                        var input = args.container
                            && (args.container.querySelector('input') || args.container.querySelector('input.e-input'));

                        if (!input) {
                            return;
                        }

                        var isSaving = false;
                        var saveHandler = function (event) {
                            if (isSaving) {
                                return;
                            }

                            if (event.type === 'blur' || event.key === 'Enter') {
                                isSaving = true;
                                input.removeEventListener('blur', saveHandler);
                                input.removeEventListener('keydown', saveHandler);

                                try {
                                    grid.endEdit();
                                } catch (error) {
                                    console.error(error);
                                }
                            }
                        };

                        input.addEventListener('blur', saveHandler);
                        input.addEventListener('keydown', saveHandler);
                    }, 0);
                },
                actionComplete: async function (args) {
                    if (args.requestType !== 'save') {
                        return;
                    }

                    var row = args.data || args.rowData;
                    if (!row) {
                        originalTenNhaCC = null;
                        return;
                    }

                    var tenMoi = String(row.TenNhaCC || '').trim();
                    var tenCu = String(originalTenNhaCC || '').trim();

                    if (tenMoi.length > 500) {
                        toastOptionNotyfi();
                        toastr['error']('Tên khách hàng không được vượt quá 500 ký tự.', 'Thông báo');
                        await reloadGridFromServer();
                        originalTenNhaCC = null;
                        return;
                    }

                    if (tenMoi === tenCu) {
                        originalTenNhaCC = null;
                        return;
                    }

                    var confirmed = await confirmUpdateTenKhachHang(tenCu, tenMoi);
                    if (!confirmed) {
                        toastOptionNotyfi();
                        toastr['warning']('Đã hủy cập nhật tên khách hàng.', 'Thông báo');
                        await reloadGridFromServer();
                        originalTenNhaCC = null;
                        return;
                    }

                    try {
                        var response = await $.ajax({
                            url: '@Url.Action("UpdateTenKhachHangCoDinh", "BaoCaoCanNguyenLieuHQ")',
                            type: 'POST',
                            data: {
                                idPhieuCanNhapNguyenLieu: row.IdPhieuCanNhapNguyenLieu,
                                tenKhachHangCoDinh: tenMoi
                            }
                        });

                        if (!response || response.success !== true) {
                            throw new Error(response && response.message
                                ? response.message
                                : 'Cập nhật tên khách hàng thất bại.');
                        }

                        toastOptionNotyfi();
                        toastr['success'](response.message, 'Thông báo');
                        await reloadGridFromServer();
                    } catch (error) {
                        console.error(error);
                        toastOptionNotyfi();
                        toastr['error'](error && error.message
                            ? error.message
                            : 'Cập nhật tên khách hàng thất bại.', 'Thông báo');
                        await reloadGridFromServer();
                    } finally {
                        originalTenNhaCC = null;
                    }
                },
                columns: [
                    { field: 'IdPhieuCanNhapNguyenLieu', visible: false, allowEditing: false },
                    { field: 'NgayGio', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss', allowEditing: false },
                    { field: 'MaNguyenLieu', headerText: 'Mã', width: 150, allowEditing: false },
                    { field: 'TenQuyCach', headerText: 'Tên Nguyên Liệu', width: 200, allowEditing: false },
                    { field: 'DonViTinh', headerText: 'Đơn Vị Tính', width: 150, allowEditing: false },
                    { field: 'MaLo', headerText: 'Lô', width: 150, allowEditing: false },
                    { field: 'TyLe', headerText: 'Tỷ Lệ %', width: 150, allowEditing: false },
                    { field: 'KhoiLuongNhap', headerText: 'Số Lượng', width: 150, allowEditing: false },
                    { field: 'LoaiGiaoDich', headerText: 'Loại Giao Dịch', width: 150, allowEditing: false },
                    { field: 'MaPhuongTien', headerText: 'Biển Số Xe', width: 150, allowEditing: false },
                    { field: 'TenNhaCC', headerText: 'Tên Khách Hàng', width: 150, allowEditing: true },
                    { field: 'CCCDNCC', headerText: 'CCCD/MST', width: 150, allowEditing: false },
                    { field: 'TaiXe', headerText: 'Tài Xế', width: 150, allowEditing: false },
                    { field: 'SDT', headerText: 'SĐT Tài Xế', width: 150, allowEditing: false },
                    { field: 'CCCD', headerText: 'CCCD Tài Xế', width: 150, allowEditing: false },
                    { field: 'NoiDungGiaoNhan', headerText: 'Nội Dung', width: 300, allowEditing: false },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'KhoiLuongNhap',
                            format: '####.0',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.refresh();
            grid.toolbarClick = function (args) {
                if (args.item.id === 'Grid_excelexport') {
                    grid.excelExport();
                }
            };
            document.getElementById("loaiGiaoDich").addEventListener("change", function () {
                let value = this.value;

                if (!grid) return;

                if (!value) {
                    grid.clearFiltering();
                } else {
                    grid.filterByColumn("LoaiGiaoDich", "equal", value);
                }
            });
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    document.getElementById('RefreshButtonBCHQ').addEventListener("click", function () {
        reloadGridFromServer();
    });
</script>




@{
    ViewData["Title"] = "ChiTietNLNHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Chi Tiết Nguyên Liệu</h5>

                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0 small text-muted">Loại Giao Dịch:</label>

                        <select id="loaiGiaoDich"
                                class="form-select form-select-sm"
                                style="width:160px;">
                            <option value="">Tất cả</option>
                            <option value="Nhập">🟢 Nhập</option>
                            <option value="Xuất">🔴 Xuất</option>
                        </select>
                    </div>
                </div>

                <!-- BODY -->
                <div class="card-body">
                    <div id="Grid"></div>
                </div>

            </div>
        </div>
    </div>
</div>
</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {
        let fromDate = document.getElementById("fromDateBCHQ");
        let toDate = document.getElementById("toDateBCHQ");

        if (fromDate) {
            fromDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 00:00:00
            fromDate.value = `${year}-${month}-${day}T00:00:00`;
        }

        if (toDate) {
            toDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 23:59:59
            toDate.value = `${year}-${month}-${day}T23:59:59`;
        }
    });


    var grid;
    var datalength = 0;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }
        if (grid != null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            ej.grids.Grid.Inject(ej.grids.Filter);
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                allowResizing: true,
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    
                    { field: 'NgayGio', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                    { field: 'MaLo', headerText: 'Lô', width: 150 },  
                    { field: 'MaQuyCach', headerText: 'Mã', width: 150 },
                    { field: 'TenQuyCach', headerText: 'Tên Nguyên Liệu', width: 200 },
                    { field: 'TyLe', headerText: 'Tỷ Lệ %', width: 150 },
                    { field: 'KhoiLuongNhap', headerText: 'Số Lượng', width: 150 },                 
                    { field: 'DonViTinh', headerText: 'Đơn Vị Tính', width: 150 }, 
                    { field: 'LoaiGiaoDich', headerText: 'Loại Giao Dịch', width: 150},
                    { field: 'MaPhuongTien', headerText: 'Biển Số Xe', width: 150 },                 
                    { field: 'TenNhaCC', headerText: 'Tên Khách Hàng', width: 150 },
                    { field: 'CCCDNCC', headerText: 'CCCD/MST', width: 150 },
                    { field: 'TaiXe', headerText: 'Tài Xế', width: 150 },
                    { field: 'SDT', headerText: 'SĐT Tài Xế', width: 150 },
                    { field: 'CCCD', headerText: 'CCCD Tài Xế', width: 150 },                   
                    { field: 'NoiDungGiaoNhan', headerText: 'Nội Dung', width: 300 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'KhoiLuongNhap',
                            format: '####.0',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};

            grid.refresh();
            document.getElementById("loaiGiaoDich").addEventListener("change", function () {
                let value = this.value;

                if (!grid) return;

                if (!value) {
                    grid.clearFiltering();
                } else {
                    grid.filterByColumn("LoaiGiaoDich", "equal", value);
                }
            });
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    document.getElementById('RefreshButtonBCHQ').addEventListener("click",
        function () {
            var btn = document.getElementById('RefreshButtonBCHQ').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var fromDate =$('#fromDateBCHQ').val();
            var toDate = $('#toDateBCHQ').val();
            var xuongId = @XuongId;
            $.ajax({
                url: "@Url.Action("Reload", "BaoCaoCanNguyenLieuHQ")",
                type: "POST",
                data: { "fromDate": fromDate, "toDate": toDate, xuongId: xuongId },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        ClearData("Grid");
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>



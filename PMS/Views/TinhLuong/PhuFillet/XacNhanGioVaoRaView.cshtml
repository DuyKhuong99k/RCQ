<script>
    let intervalId;
    let isRunning = true;

    function updateTime() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const currentTime = `${hours}:${minutes}:${seconds}`;
        document.getElementById('timeInput').value = currentTime;
    }

    function startTime() {
        intervalId = setInterval(updateTime, 1000);
        updateTime();
        isRunning = true;
        document.getElementById('toggleButton').textContent = 'Dừng';
    }

    function stopTime() {
        clearInterval(intervalId);
        isRunning = false;
        document.getElementById('toggleButton').textContent = 'Chạy';
    }

    function toggleTime() {
        if (isRunning) {
            stopTime();
        } else {
            startTime();
        }
    }
    startTime();
</script>

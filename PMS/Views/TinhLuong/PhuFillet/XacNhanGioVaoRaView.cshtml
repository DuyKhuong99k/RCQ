<script>
    function layGioTuDate() {
        // Khởi tạo một đối tượng Date từ chuỗi ngày
        var date = new Date();

        // Lấy giờ, phút và giây từ đối tượng Date
        var gio = date.getHours();
        var phut = date.getMinutes();
        var giay = date.getSeconds();

        // Định dạng lại chuỗi kết quả
        var gioPhutGiayString = pad(gio, 2) + ":" + pad(phut, 2) + ":" + pad(giay, 2);

        // Trả về chuỗi kết quả
        return gioPhutGiayString;
    }

    // Hàm pad để thêm số 0 vào trước nếu cần
    function pad(number, length) {
        var str = '' + number;
        while (str.length < length) {
            str = '0' + str;
        }
        return str;
    }
    function showKhungGioVaoRa() {
        $('#modalShowKhungGioVaoRa').modal('show');
        $('#timeIn').val(layGioTuDate());
        $('#timeOut').val(layGioTuDate());
    }
    function setGioVaoRaMacDinh() {
        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        var gioVao = $('#timeIn').val();
        var gioRa = $('#timeOut').val();
        var thanhPham = $('#listThanhPhamPhuFillet').val();
        var maNhanVien = $('#manhanvienhidden').val();

        if (gioVao >= gioRa) {
            toastOptionNotyfi();
            toastr["warning"]("Thời gian không hợp lệ!", "Giờ Vào Lớn Hơn Hoặc Bằng Giờ Ra!");
        }
        else {
            bootbox.confirm({
                title: "Thông báo!",
                message: "Thao tác sẽ xóa toàn bộ các ghi nhận của các nhân viên đã chọn và thay thế bằng ghi nhận mặc định đã chọn!",
                buttons: {
                    confirm: {
                        label: 'OK',
                        className: 'btn btn-primary'
                    }
                },
                callback: function (result) {
                    if (result) {
                        $.ajax({
                            url: '/ChinhPhuFillet/SetGioVaoRaMacDinh',
                            data: {
                                dateTime: dateTime,
                                xuongId: xuongId,
                                gioVao: gioVao,
                                gioRa: gioRa,
                                thanhPham: thanhPham,
                                listPhanBoNhanVienPhuFilletSelectedItems: selectedIdsStringCaiDatNhanVienDatThanhTo
                            },
                            type: 'POST',
                            dataType: 'json',
                            success: function (response) {
                                if (response.isSuccess) {
                                    //loadGridGioRaVaoFillet(response.Data);
                                    reloadGridGioRaVaoFilletSelectedNhanVien(maNhanVien);
                                    $('#modalShowKhungGioVaoRa').modal('hide');
                                    toastOptionNotyfi();
                                    toastr["success"](rs.Messages, "Thông báo");
                                } else {
                                    toastOptionNotyfi();
                                    toastr["warning"](rs.Messages, "Thông báo");
                                }
                            },
                            error: function (error) {
                                toastOptionNotyfi();
                                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                            }
                        });
                    }
                }
            });
        }
    }
    function clearFind(){
        var thanhPham = $('#listThanhPhamPhuFillet').val();

        reloadGridPhanBoNhanVienPhuFillet(thanhPham);
    }
</script>


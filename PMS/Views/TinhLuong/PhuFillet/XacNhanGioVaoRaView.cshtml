    let selectedIdsStringCaiDatNhanVienDatThanhTo = "";
    let numRowSelectCaiDatNhanVienDaiThanhTo = 0;
    function unSelectionChangedCaiDatNhanVienDaiThanhTo(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsStringCaiDatNhanVienDatThanhTo = "";
                numRowSelectCaiDatNhanVienDaiThanhTo = 0; // Reset số dòng đã chọn
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselected = deselectedRecords[i];
                let deselectedString = JSON.stringify(deselected);

                // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsStringCaiDatNhanVienDatThanhTo.includes(deselectedString)) {
                    // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                    selectedIdsStringCaiDatNhanVienDatThanhTo = selectedIdsStringCaiDatNhanVienDatThanhTo.replace("|" + deselectedString, "");
                    numRowSelectCaiDatNhanVienDaiThanhTo--; // Giảm số dòng đã chọn
                }
            }
            selectedIdsStringCaiDatNhanVienDatThanhTo = selectedIdsStringCaiDatNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');

            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        } else {
            // Trường hợp chỉ có một bản ghi được bỏ chọn
            let deselectedString = JSON.stringify(deselectedRecords);

            // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsStringCaiDatNhanVienDatThanhTo.includes(deselectedString)) {
                // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                selectedIdsStringCaiDatNhanVienDatThanhTo = selectedIdsStringCaiDatNhanVienDatThanhTo.replace("|" + deselectedString, "");
                numRowSelectCaiDatNhanVienDaiThanhTo--; // Giảm số dòng đã chọn
            }
            selectedIdsStringCaiDatNhanVienDatThanhTo = selectedIdsStringCaiDatNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');

            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        }
        // alert(selectedIdsStringCaiDatNhanVien);
    }
    function selectionChangedCaiDatNhanVienDaiThanhTo(args) {
        let selectedRecords = Array.isArray(args.data) ? args.data : (args.data ? [args.data] : []);

        if (selectedRecords.length === 0) {
            // Lấy toàn bộ danh sách từ grid vào selectedIdsString
            let allDataRecords = gridPhanBoNhanVienPhuFillet.dataSource instanceof ej.data.DataManager ? gridPhanBoNhanVienPhuFillet.dataSource.dataSource.json : gridPhanBoNhanVienPhuFillet.dataSource; // Lấy toàn bộ dữ liệu
            selectedIdsStringCaiDatNhanVienDatThanhTo = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelectCaiDatNhanVienDaiThanhTo = allDataRecords.length; // Cập nhật số dòng đã chọn
            allDataRecords.forEach(record => {
                // Chuyển đổi đối tượng thành chuỗi JSON
                selectedIdsStringCaiDatNhanVienDatThanhTo += "|" + JSON.stringify(record);
            });
            // Loại bỏ dấu ' | ' cuối cùng
            selectedIdsStringCaiDatNhanVienDatThanhTo = selectedIdsStringCaiDatNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');
            return;
        }

        selectedRecords.forEach(record => {
            // Chuyển đổi đối tượng thành chuỗi JSON và kiểm tra xem đã tồn tại chưa
            let recordString = JSON.stringify(record);
            if (!selectedIdsStringCaiDatNhanVienDatThanhTo.includes(recordString)) {
                selectedIdsStringCaiDatNhanVienDatThanhTo += "|" + recordString;
                numRowSelectCaiDatNhanVienDaiThanhTo++; // Tăng số dòng đã chọn
            }
        });

        // Loại bỏ dấu ' | ' cuối cùng
        selectedIdsStringCaiDatNhanVienDatThanhTo = selectedIdsStringCaiDatNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');
        // alert(selectedIdsStringCaiDatNhanVien);

        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaNhanVien = selectedRecord.MaNhanVien;
        $('#manhanvienhidden').val(MaNhanVien);
        reloadGridGioRaVaoFilletSelectedNhanVien(MaNhanVien);
    }

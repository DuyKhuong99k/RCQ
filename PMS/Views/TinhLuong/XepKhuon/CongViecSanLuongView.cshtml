@{
    ViewData["Title"] = "CongViecSanLuongView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var CongViecs = ViewBag.CongViecs;
    var Cass = ViewBag.Cass;
    var XuongId = @Context.Session.GetString("XuongId");


}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Công Việc Tính Lương Sản Lượng</h2>


                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">

                        <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>

                        <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>

                        <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>

                        <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Công Việc Sản Lượng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Công Việc</label>
                                    <select id="maCongViecCVSLTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn công việc.</option>
                                        @foreach (var item in CongViecs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ca</label>
                                    <select id="maCaCVSLTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn ca.</option>
                                        @foreach (var item in Cass)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Sản Lượng</label>
                                    <input type="number" id="sanLuongCVSLTL" class="form-control form-control-lg" placeholder="Nhập sản lượng..." />
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="MaCongViecRowSelected" />
<input type="hidden" id="MaCaRowSelected" />
<input type="hidden" id="NgayRowSelected" />
<input type="hidden" id="MaXuongRowSelected" />

<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/GianTiep/GetAllCongViecSanLuongs',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'CongViecName', headerText: 'Công Việc', width: 150 },
                            { field: 'CaName', headerText: 'Ca', width: 150 },
                            { field: 'SanLuong', headerText: 'Sản Lượng', width: 150 },

                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaCongViec = selectedRecord.MaCongViec;
        var MaCa = selectedRecord.MaCa;

        var MaXuong = selectedRecord.MaXuong;


        $('#MaCongViecRowSelected').val(MaCongViec);
        $('#MaCaRowSelected').val(MaCa);

        $('#MaXuongRowSelected').val(MaXuong);

    }
</script>
<script>
    function showInsert() {

        $('#modalThem').modal('show');

    }
    function insert() {
        var maCongViec = $('#maCongViecCVSLTL').val();
        var maCa = $('#maCaCVSLTL').val();
        var maXuong = @XuongId;
        var sanLuong = $('#sanLuongCVSLTL').val();


        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/GianTiep/DoInsertCongViecSanLuong',
            data: {
                maCongViec: maCongViec,
                maCa: maCa,
                maXuong: maXuong,
                sanLuong: sanLuong,

            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>

<script>
    function showDelete() {
        var maCongViec = $('#MaCongViecRowSelected').val();
        var maCa = $('#MaCaRowSelected').val();
        var maXuong = $('#MaXuongRowSelected').val();
        $.ajax({
            url: "/GianTiep/GetsByMaCongViecSanLuong",
            data: {
                maCongViec: maCongViec,
                maCa: maCa,
                maXuong: maXuong

            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá item đã chọn,
                                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/GianTiep/DoDeleteCongViecSanLuong',
                                    data: {
                                        maCongViec: maCongViec,
                                        maCa: maCa,
                                        maXuong: maXuong
                                    },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>






@{
    ViewData["Title"] = "SanLuongNhanVienTheoLuotRaCoiView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    var nhomXepKhuons = ViewBag.NhomXepKhuon;
    var jsonNhomXepKhuons = Newtonsoft.Json.JsonConvert.SerializeObject(nhomXepKhuons);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Nhóm Tính Lương</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        <button onclick="reloadGrids()" type="button" class="btn btn-primary">Tải Dữ Liệu</button>
                        <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                        <button onclick="showDeleteAll()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá Tất Cả</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập Nhật Nhóm Sản Lượng Lượt Ra Cối</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Nhóm Xếp Khuôn</label>
                                    <select id="maNhomSLNVLRCTL" class="form-control">
                                        <option>Chọn nhóm xếp khuôn</option>
                                        @foreach (var item in nhomXepKhuons)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Xác Nhận</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="sttSLNVLRCTLRowSelected" />
<input type="hidden" id="maMayCanSLNVLRCTLRowSelected" />

<script>

    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 500 },
                allowFiltering: true,
                allowSorting: true,
                //frozenColumns: 3,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                allowResizing: true,
                rowSelected: onRowSelected,
                height: 400,
               // allowGrouping: true,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'CoiName', headerText: 'Cối', width: 150 },
                    { field: 'LuotRaCoi', headerText: 'Lượt Ra Cối', width: 200 },
                    { field: 'GioRaCoi', headerText: 'GioRaCoi', width: 200 },
                    { field: 'NhomName', headerText: 'Nhóm', type: 'number', width: 150 },
                    { field: 'TrongLuong', headerText: 'Sản Lượng', type: 'number', width: 150 },
                ]
            });
            grid.appendTo('#Grid');
            // Hiển thị Grid trên trang web

        }

    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var STT = selectedRecord.STT;
        var MaMayCan = selectedRecord.MaMayCan;

        $('#maSLNVLRCTLRowSelected').val(STT);
        $('#maMayCanSLNVLRCTLRowSelected').val(MaMayCan);
    }
    function reloadGrids() {
        var dateTime = $('#dateTimeTL').val();
        var maXuong = @XuongId;
        $.ajax({
            url: "@Url.Action("GetAllSanLuongLuotRaCois", "GianTiep")",
            type: "GET",
            data: { dateTime: dateTime, maXuong: maXuong },
            success: function (response) {
                if (response.Success) {
                    loadGridData(response.Data);
                } else {
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        });
        // reloadDataNhanVienKiem(dateTime, xuongId)
    }
</script>

<script>
    function showUpdate() {
        //$('#modalSua').modal('show');
        var stt = $('#maSLNVLRCTLRowSelected').val();
        var ngay = $('#dateTimeTL').val();
        var maXuong = @XuongId;
        var maMayCan = $('#maMayCanSLNVLRCTLRowSelected').val();
        $.ajax({
            url: "/GianTiep/GetsBySTTSanLuongLuotRaCoi",
            data: { stt: stt, ngay: ngay, maXuong: maXuong, maMayCan: maMayCan },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maNhomSLNVLRCTL').val(rs.MaNhom);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var stt = $('#maSLNVLRCTLRowSelected').val();
        var ngay = $('#dateTimeTL').val();
        var maXuong = @XuongId;
        var maMayCan = $('#maMayCanSLNVLRCTLRowSelected').val();
        var maNhom = $('#maNhomSLNVLRCTL').val();

        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/GianTiep/DoUpDateSanLuongLuotRaCoi',
            data: {
                stt: stt, ngay: ngay, maXuong: maXuong, maMayCan: maMayCan, maNhom: maNhom
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadGrids();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDeleteAlls() {
        var dateTime = $('#dateTimeTL').val();
        var maXuong = @XuongId;

        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn xóa toàn bộ dữ liệu cài đặt đã lưu của ngày" + dateTime + "hay không? HÀNH ĐỘNG NÀY KHÔNG THỂ HOÀN TÁC!",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/GianTiep/DoDeleteAllsSanLuongLuotRaCoi',
                        data: { dateTime: dateTime, maXuong: maXuong },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                reloadGrids();
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");
                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        }
                    });
                }
            }
        });
    }
</script>



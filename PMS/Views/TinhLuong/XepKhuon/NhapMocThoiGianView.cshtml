@{
    ViewData["Title"] = "NhapMocThoiGianView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    var Id = @Context.Session.GetString("Id");
    var nguoiDungs = ViewBag.listNguoiDung;
    var jsonNguoiDungs = Newtonsoft.Json.JsonConvert.SerializeObject(nguoiDungs);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Mốc Thời Gian Phân Ca</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        <div class="row">
                            <div class="col-sm-4">
                                <input class="form-control" type="time" id="timeInputTGPC" />
                            </div>
                            <div class="col-sm-8">
                                <button onclick="insert()" class="btn btn-primary  position-relative" type="submit" id="btnThem">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                                <button onclick="update()" class="btn btn-primary  position-relative" type="submit" id="btnSua">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="GioTGPCRowSelected" />
<script>
    var nguoiDungs = @Html.Raw(jsonNguoiDungs);
</script>
<script type="text/x-template" id="CreateByNguoiDungTemplate">
    <div>
        <span>${covertCreateByToHoTen(data)}</span>
    </div>
</script>
<script type="text/x-template" id="ModifyByNguoiDungTemplate">
    <div>
        <span>${covertModifyByToHoTen(data)}</span>
    </div>
</script>
<script>
    function covertCreateByToHoTen(data) {
        var ten = "";
        try {
            var userName = data.CreateBy;
            var hoTen = nguoiDungs.find(u => u.Id === parseInt(userName));
            if (hoTen) {
                ten = hoTen.HoTen;
            }
        } catch (error) {
            console.error(error);
        }
        if (ten == "" || ten == undefined) {
            ten = "Chưa xác định";
        }
        return ten;
    }
    function covertModifyByToHoTen(data) {
        var ten = "";
        try {
            var userName = data.ModifyBy;
            var hoTen = nguoiDungs.find(u => u.Id === parseInt(userName));
            if (hoTen) {
                ten = hoTen.HoTen;
            }
        } catch (error) {
            console.error(error);
        }
        if (ten == "" || ten == undefined) {
            ten = "Chưa xác định";
        }
        if (ten == "Chưa xác định") {
            ten = "#"
        }
        return ten;
    }
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var dateTime = $('#dateTimeTL').val();
        $.ajax({
            url: '/GianTiep/GetAllMocThoiGianPhanCas',
            type: 'GET',
            data: { dateTime: dateTime, maXuong: @XuongId},
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'Gio', headerText: 'Giờ', width: 150 },
                            { field: 'CreateBy', headerText: 'Người Tạo', width: 150, template: '#CreateByNguoiDungTemplate' },
                            { field: 'ModifyBy', headerText: 'Người Sửa', width: 150, template: '#ModifyByNguoiDungTemplate' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
                // Kiểm tra dữ liệu của grid và ẩn/hiện các nút
                if (data.length > 0) {
                    $('#btnThem').hide();
                    $('#btnSua').show();
                } else {
                    $('#btnThem').show();
                    $('#btnSua').hide();
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Gio = selectedRecord.Gio;

        $('#GioTGPCRowSelected').val(Gio);
    }
</script>
<script>
    function insert() {
        var gio = $('#timeInputTGPC').val();
        var userName = '@Id';
        var maXuong = @XuongId;
        if (gio == null || gio == "" || gio == undefined) {
            toastOptionNotyfi();
            toastr["warning"]("Vui lòng nhập mốc thời gian", "Thông báo");
            return;
        }
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/GianTiep/DoInsertMocThoiGianPhanCa',
            data: {
                gio: gio,
                userName: userName,
                maXuong: maXuong,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>

    function update() {
        var gio = $('#timeInputTGPC').val();
        var gioGoc = $('#GioTGPCRowSelected').val();
        var userName = '@Id';
        var maXuong = @XuongId;
        if (gio == null || gio == "" || gio == undefined) {
            toastOptionNotyfi();
            toastr["warning"]("Vui lòng nhập mốc thời gian", "Thông báo");
            return;
        }
        if (gioGoc == null || gioGoc == "" || gioGoc == undefined) {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn item cần sửa", "Thông báo");
            return;
        }
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/GianTiep/DoUpDateMocThoiGianPhanCa',
            data: {
                gio: gio,
                gioGoc: gioGoc,
                userName: userName,
                maXuong: maXuong
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>





@{
    ViewData["Title"] = "CongViecLoaiThanhPhamView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var CongViecs = ViewBag.CongViecs;
    var listThanhPhamDHs = ViewBag.listThanhPhamDHs;
    var ThanhPhamPhuXepKhuons = ViewBag.ThanhPhamPhuXepKhuons;
    var ThanhPhamChinhXepKhuons = ViewBag.ThanhPhamChinhXepKhuons;
    var ThanhPhamBlockXepKhuons = ViewBag.ThanhPhamBlockXepKhuons;
    var ThanhPhamKHCXepKhuons = ViewBag.ThanhPhamKHCXepKhuons;
    var ThanhPhamTaiChes = ViewBag.ThanhPhamTaiChes;
    var ThanhPhamSoChes = ViewBag.ThanhPhamSoChes;
    var ThanhPhamCongViecTaiChes = ViewBag.ThanhPhamCongViecTaiChes;
    var ThanhPhamCongDoans = ViewBag.ThanhPhamCongDoans;
    var ThanhPhamChieuXaXepKhuons = ViewBag.ThanhPhamChieuXaXepKhuons;


}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Công Việc Tính Lương Theo Thành Phẩm</h2>


                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">

                        <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>

                        <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>

                        <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>

                        <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Công Việc Theo Thành Phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Công Việc</label>
                                    <select id="maCongViecCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in CongViecs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Định Hình</label>
                                    <select id="maThanhPhamDinhHinhCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in listThanhPhamDHs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Phụ Xếp Khuôn</label>
                                    <select id="maThanhPhamPhuXepKhuonCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamPhuXepKhuons)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Chính Xếp Khuôn</label>
                                    <select id="maThanhPhamChinhXepKhuonCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamChinhXepKhuons)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Chiếu Xạ Xếp Khuôn</label>
                                    <select id="maThanhPhamChieuXaXepKhuonCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamChieuXaXepKhuons)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Block Xếp Khuôn</label>
                                    <select id="maThanhPhamBlockXepKhuonCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamBlockXepKhuons)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Công Đoạn Block Xếp Khuôn</label>
                                    <select id="maCongDoanCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamCongDoans)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">KXL Xếp Khuôn</label>
                                    <select id="maThanhPhamKHCXepKhuonCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamKHCXepKhuons)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tái Chế</label>
                                    <select id="maThanhPhamTaiCheCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamTaiChes)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Công Việc Tái Chế</label>
                                    <select id="maThanhPhamCongViecTaiCheCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamCongViecTaiChes)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Sơ Chế</label>
                                    <select id="maThanhPhamSoCheCVTPTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn thành phẩm</option>
                                        @foreach (var item in ThanhPhamSoChes)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="MaCongViecRowSelected" />
<input type="hidden" id="MaThanhPhamDinhHinhRowSelected" />
<input type="hidden" id="MaThanhPhamPhuXepKhuonRowSelected" />
<input type="hidden" id="MaThanhPhamChinhXepKhuonRowSelected" />
<input type="hidden" id="MaThanhPhamBlockXepKhuonRowSelected" />
<input type="hidden" id="MaThanhPhamKHCXepKhuonRowSelected" />
<input type="hidden" id="MaThanhPhamTaiCheRowSelected" />
<input type="hidden" id="MaThanhPhamSoCheRowSelected" />
<input type="hidden" id="MaCongViecTaiCheRowSelected" />
<input type="hidden" id="MaCongDoanRowSelected" />
<input type="hidden" id="MaChieuXaChinhXepKhuonRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/GianTiep/GetAllCongViecTheoThanhPhams',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'CongViecName', headerText: 'Công Việc', width: 150 },
                            { field: 'ThanhPhamDinhHinhName', headerText: 'Định Hình', width: 150 },
                            { field: 'ThanhPhamPhuXepKhuonName', headerText: 'Phụ Xếp Khuôn', width: 150 },
                            { field: 'ThanhPhamChinhXepKhuonName', headerText: 'Chính Xếp Khuôn', width: 150 },
                            { field: 'BlockXepKhuonName', headerText: 'Block Xếp Khuôn', width: 150 },
                            { field: 'KHCXepKhuonName', headerText: 'KXL Xếp Khuôn', width: 150 },
                            { field: 'TaiCheName', headerText: 'Tái Chế', width: 150 },
                            { field: 'SoCheName', headerText: 'Sơ Chế', width: 150 },
                            { field: 'CongViecTaiCheName', headerText: 'Công Việc Tái Chế', width: 150 },
                            { field: 'CongDoanName', headerText: 'Công Đoạn Block Xếp Khuôn', width: 150 },
                            { field: 'ChieuXaName', headerText: 'Chiếu Xạ Xếp Khuôn', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaCongViec = selectedRecord.MaCongViec;
        var MaThanhPhamDinhHinh = selectedRecord.MaThanhPhamDinhHinh;
        var MaThanhPhamPhuXepKhuon = selectedRecord.MaThanhPhamPhuXepKhuon;
        var MaThanhPhamChinhXepKhuon = selectedRecord.MaThanhPhamChinhXepKhuon;
        var MaThanhPhamBlockXepKhuon = selectedRecord.MaThanhPhamBlockXepKhuon;
        var MaThanhPhamKHCXepKhuon = selectedRecord.MaThanhPhamKHCXepKhuon;
        var MaThanhPhamTaiChe = selectedRecord.MaThanhPhamTaiChe;
        var MaThanhPhamSoChe = selectedRecord.MaThanhPhamSoChe;
        var MaCongViecTaiChe = selectedRecord.MaCongViecTaiChe;
        var MaCongDoan = selectedRecord.MaCongDoan;
        var MaChieuXaChinhXepKhuon = selectedRecord.MaChieuXaChinhXepKhuon;

        $('#MaCongViecRowSelected').val(MaCongViec);
        $('#MaThanhPhamDinhHinhRowSelected').val(MaThanhPhamDinhHinh);
        $('#MaThanhPhamPhuXepKhuonRowSelected').val(MaThanhPhamPhuXepKhuon);
        $('#MaThanhPhamChinhXepKhuonRowSelected').val(MaThanhPhamChinhXepKhuon);
        $('#MaThanhPhamBlockXepKhuonRowSelected').val(MaThanhPhamBlockXepKhuon);
        $('#MaThanhPhamKHCXepKhuonRowSelected').val(MaThanhPhamKHCXepKhuon);
        $('#MaThanhPhamTaiCheRowSelected').val(MaThanhPhamTaiChe);
        $('#MaThanhPhamSoCheRowSelected').val(MaThanhPhamSoChe);
        $('#MaCongViecTaiCheRowSelected').val(MaCongViecTaiChe);
        $('#MaCongDoanRowSelected').val(MaCongDoan);
        $('#MaChieuXaChinhXepKhuonRowSelected').val(MaChieuXaChinhXepKhuon);
    }
</script>
<script>
    function showInsert() {

        $('#modalThem').modal('show');

    }
    function insert() {
        var maCongViec = $('#maCongViecCVTPTL').val();
        var maThanhPhamDinhHinh = $('#maThanhPhamDinhHinhCVTPTL').val();
        var maThanhPhamPhuXepKhuon = $('#maThanhPhamPhuXepKhuonCVTPTL').val();
        var maThanhPhamChinhXepKhuon = $('#maThanhPhamChinhXepKhuonCVTPTL').val();
        var maThanhPhamBlockXepKhuon = $('#maThanhPhamBlockXepKhuonCVTPTL').val();
        var maThanhPhamKHCXepKhuon = $('#maThanhPhamKHCXepKhuonCVTPTL').val();
        var maThanhPhamTaiChe = $('#maThanhPhamTaiCheCVTPTL').val();
        var maThanhPhamSoChe = $('#maThanhPhamSoCheCVTPTL').val();
        var maCongViecTaiChe = $('#maThanhPhamCongViecTaiCheCVTPTL').val();
        var maCongDoan = $('#maCongDoanCVTPTL').val();
        var maChieuXaChinhXepKhuon = $('#maThanhPhamChieuXaXepKhuonCVTPTL').val();

        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/GianTiep/DoInsertCongViecTheoThanhPham',
            data: {
                maCongViec: maCongViec,
                maThanhPhamDinhHinh: maThanhPhamDinhHinh,
                maThanhPhamPhuXepKhuon: maThanhPhamPhuXepKhuon,
                maThanhPhamChinhXepKhuon: maThanhPhamChinhXepKhuon,
                maThanhPhamBlockXepKhuon: maThanhPhamBlockXepKhuon,
                maThanhPhamKHCXepKhuon: maThanhPhamKHCXepKhuon,
                maThanhPhamTaiChe: maThanhPhamTaiChe,
                maThanhPhamSoChe: maThanhPhamSoChe,
                maCongViecTaiChe: maCongViecTaiChe,
                maCongDoan: maCongDoan,
                maChieuXaChinhXepKhuon: maChieuXaChinhXepKhuon,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>

<script>
    function showDelete() {
        var maCongViec = $('#MaCongViecRowSelected').val();
        var maThanhPhamDinhHinh = $('#MaThanhPhamDinhHinhRowSelected').val();
        var maThanhPhamPhuXepKhuon = $('#MaThanhPhamPhuXepKhuonRowSelected').val();
        var maThanhPhamChinhXepKhuon = $('#MaThanhPhamChinhXepKhuonRowSelected').val();
        var maThanhPhamBlockXepKhuon = $('#MaThanhPhamBlockXepKhuonRowSelected').val();
        var maThanhPhamKHCXepKhuon = $('#MaThanhPhamKHCXepKhuonRowSelected').val();
        var maThanhPhamTaiChe = $('#MaThanhPhamTaiCheRowSelected').val();
        var maThanhPhamSoChe = $('#MaThanhPhamSoCheRowSelected').val();
        var maCongViecTaiChe = $('#MaCongViecTaiCheRowSelected').val();
        var maCongDoan = $('#MaCongDoanRowSelected').val();
        var maChieuXaChinhXepKhuon = $('#MaChieuXaChinhXepKhuonRowSelected').val();
        $.ajax({
            url: "/GianTiep/GetsByMaCongViecTheoThanhPham",
            data: {
                maCongViec: maCongViec,
                maThanhPhamDinhHinh: maThanhPhamDinhHinh,
                maThanhPhamPhuXepKhuon: maThanhPhamPhuXepKhuon,
                maThanhPhamChinhXepKhuon: maThanhPhamChinhXepKhuon,
                maThanhPhamBlockXepKhuon: maThanhPhamBlockXepKhuon,
                maThanhPhamKHCXepKhuon: maThanhPhamKHCXepKhuon,
                maThanhPhamTaiChe: maThanhPhamTaiChe,
                maThanhPhamSoChe: maThanhPhamSoChe,
                maCongViecTaiChe: maCongViecTaiChe,
                maCongDoan: maCongDoan,
                maChieuXaChinhXepKhuon: maChieuXaChinhXepKhuon,
            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá item đã chọn,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/GianTiep/DoDeleteCongViecTheoThanhPham',
                                    data: {
                                        maCongViec: maCongViec,
                                        maThanhPhamDinhHinh: maThanhPhamDinhHinh,
                                        maThanhPhamPhuXepKhuon: maThanhPhamPhuXepKhuon,
                                        maThanhPhamChinhXepKhuon: maThanhPhamChinhXepKhuon,
                                        maThanhPhamBlockXepKhuon: maThanhPhamBlockXepKhuon,
                                        maThanhPhamKHCXepKhuon: maThanhPhamKHCXepKhuon,
                                        maThanhPhamTaiChe: maThanhPhamTaiChe,
                                        maThanhPhamSoChe: maThanhPhamSoChe,
                                        maCongViecTaiChe: maCongViecTaiChe,
                                        maCongDoan: maCongDoan,
                                        maChieuXaChinhXepKhuon: maChieuXaChinhXepKhuon,
                                    },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>




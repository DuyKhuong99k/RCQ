@{
    ViewData["Title"] = "CongViecView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var LoaiDuLieus = ViewBag.LoaiDuLieus;
    var jsonLoaiDuLieus = Newtonsoft.Json.JsonConvert.SerializeObject(LoaiDuLieus);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Công Việc Tính Lương</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                        <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Công Việc Tính Lương</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã</label>
                                    <input type="text" id="maCVTLXK" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã..." style="text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tên</label>
                                    <input type="text" id="tenCVTLXK" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã Bravo</label>
                                    <input type="text" id="bravoIdCVTLXK" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Bravo..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã Bravo Đêm</label>
                                    <input type="text" id="bravoIdDemCVTLXK" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Bravo Đêm..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Loại Dữ Liệu</label>
                                    <select id="loaiDuLieuCVSLTL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn loại công việc.</option>
                                        @foreach (var item in LoaiDuLieus)
                                        {
                                            <option value="@item.Id">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="suDungCVTLXK" />
                                        Sử Dụng
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Loại Sản Phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã</label>
                                    <input type="text" id="maCVTLXKSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã..." style="text-transform: uppercase;" disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tên</label>
                                    <input type="text" id="tenCVTLXKSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã Bravo</label>
                                    <input type="text" id="bravoIdCVTLXKSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Bravo..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã Bravo Đêm</label>
                                    <input type="text" id="bravoIdDemCVTLXKSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Bravo Đêm..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Loại Dữ Liệu</label>
                                    <select id="loaiDuLieuCVSLTLSua" class="form-control form-control-lg">
                                        <option disabled selected>Chọn loại công việc.</option>
                                        @foreach (var item in LoaiDuLieus)
                                        {
                                            <option value="@item.Id">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="suDungCVTLXKSua" />
                                        Sử Dụng
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="maCVTLXKRowSelected" />
<script>
    var loaiDuLieus = @Html.Raw(jsonLoaiDuLieus);
</script>
<script type="text/x-template" id="LoaiDuLieuNameTemplate">
    <div>
        <span>${covertIdToTenLoaiDuLieu(data)}</span>
    </div>
</script>
<script>
    function covertIdToTenLoaiDuLieu(data) {
        var ten = "";
        try {
            var id = data.LoaiDuLieu;
            var loaiDuLieu = loaiDuLieus.find(l => l.Id === id);
            if (loaiDuLieu) {
                ten = loaiDuLieu.Ten;
            }
        } catch (error) {
            console.error(error);
        }
        if (ten == "" || ten == undefined) {
            ten = "Chưa xác định";
        }
        return ten;
    }
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/GianTiep/GetAllCongViecs',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'BravoId', headerText: 'Mã Bravo', width: 150 },
                            { field: 'BravoIdDem', headerText: 'Mã Bravo Đêm', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'LoaiDuLieu', headerText: 'Loại Dữ Liệu', width: 150, template: '#LoaiDuLieuNameTemplate' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;

        $('#maCVTLXKRowSelected').val(Ma);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/GianTiep/CreatDefautNewCongViec",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maCVTLXK').val(rs.Ma);
                    $('#suDungCVTLXK').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maCVTLXK').val();
        var ten = $('#tenCVTLXK').val();
        var bravoId = $('#bravoIdCVTLXK').val();
        var bravoIdDem = $('#bravoIdDemCVTLXK').val();
        var suDung = $('#suDungCVTLXK').prop('checked');
        var loaiDuLieu = $('#loaiDuLieuCVSLTL').val();

        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/GianTiep/DoInsertCongViec',
            data: {
                ma: ma,
                ten: ten,
                bravoId: bravoId,
                bravoIdDem: bravoIdDem,
                suDung: suDung,
                loaiDuLieu: loaiDuLieu
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ma = $('#maCVTLXKRowSelected').val();
        $.ajax({
            url: "/GianTiep/GetsByMaCongViec",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maCVTLXKSua').val(rs.Ma);
                    $('#tenCVTLXKSua').val(rs.Ten);
                    $('#bravoIdCVTLXKSua').val(rs.BravoId);
                    $('#bravoIdDemCVTLXKSua').val(rs.BravoIdDem);
                    $('#suDungCVTLXKSua').prop('checked', rs.SuDung);
                    $('#loaiDuLieuCVSLTLSua').val(rs.LoaiDuLieu);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ma = $('#maCVTLXKSua').val();
        var ten = $('#tenCVTLXKSua').val();
        var bravoId = $('#bravoIdCVTLXKSua').val();
        var bravoIdDem = $('#bravoIdDemCVTLXKSua').val();
        var suDung = $('#suDungCVTLXKSua').prop('checked');
        var loaiDuLieu = $('#loaiDuLieuCVSLTLSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/GianTiep/DoUpDateCongViec',
            data: {
                ma: ma,
                ten: ten,
                bravoId: bravoId,
                bravoIdDem: bravoIdDem,
                suDung: suDung,
                loaiDuLieu: loaiDuLieu
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var ma = $('#maCVTLXKRowSelected').val();
        $.ajax({
            url: "/GianTiep/GetsByMaCongViec",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/GianTiep/DoDeleteCongViec',
                                    data: { ma: ma },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>



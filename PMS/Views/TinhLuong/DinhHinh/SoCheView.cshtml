<script>
    $(document).ready(function () {
        $('#khuVucTL').val("DH");
    });
    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid && data != null && data != "") {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50 },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                rowSelected: selectionChanged,
                rowDeselected: unSelectionChanged,
                allowGrouping: true,
                groupSettings: { showDropArea: false, columns: ['MaNhomSoChe'] },
                //toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'MaNhomSoChe', headerText: 'Nhóm', width: 150 },
                    { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                    { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                    { field: 'IsChamCong', headerText: 'Chấm Công', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'TenSanPham', headerText: 'Công Việc', width: 150 },
                    { field: 'MaSanPham', headerText: 'Sản Phẩm', width: 150 },
                    { field: 'TrongLuongTrenGio', headerText: 'Trọng Lượng/ Giờ', type: 'number', width: 150 },
                    { field: 'SoGio', headerText: 'Số Giờ', type: 'number', width: 150 },
                    { field: 'TyLeHuong', headerText: 'Tỷ Lệ Hưởng', type: 'number', width: 150 },
                    { field: 'TyLeTru', headerText: 'Tỷ Lệ Trừ', type: 'number', width: 150 },
                    { field: 'TrongLuongHuong', headerText: 'TL Hưởng', type: 'number', width: 150 },
                    { field: 'DonGia', headerText: 'Đơn Giá', type: 'number', width: 150 },
                    { field: 'ThanhTien', headerText: 'Thành Tiền', type: 'number', width: 150 },
                ],
                aggregates: [{
                    columns: [{
                        type: 'Sum',
                        field: 'TrongLuongTrenGio',
                        //format: '0,000',
                        footerTemplate: 'Tổng SL : ${Sum} Kg'
                    },
                    {
                        type: 'Sum',
                        field: 'SoGio',
                        //format: '0,000',
                        footerTemplate: 'Tổng Giờ: ${Sum}'
                    },
                    {
                        type: 'Sum',
                        field: 'TrongLuongHuong',
                        //format: '0,000',
                        footerTemplate: 'Tổng Hưởng: ${Sum} Kg'
                    },
                    {
                        type: 'Sum',
                        field: 'ThanhTien',
                        format: 'N2', // Format số
                        footerTemplate: 'Tổng Thành Tiền: ${Sum}'
                    }]
                }]
            });
            // Hiển thị Grid trên trang web
            grid.appendTo('#Grid');
        }
    }
    loadGridData();

    let selectedIdsString = "";
    let numRowSelect = 0;
    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselected = deselectedRecords[i];
                let deselectedString = JSON.stringify(deselected);

                // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedString)) {
                    // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                    selectedIdsString = selectedIdsString.replace("|" + deselectedString, "");
                    numRowSelect--; // Giảm số dòng đã chọn
                }
            }
            // Loại bỏ dấu ' | ' cuối cùng nếu có
            selectedIdsString = selectedIdsString.replace(/^\|+|\|+$/g, '');

            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        } else {
            // Trường hợp chỉ có một bản ghi được bỏ chọn
            let deselectedString = JSON.stringify(deselectedRecords);

            // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedString)) {
                // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                selectedIdsString = selectedIdsString.replace("|" + deselectedString, "");
                numRowSelect--; // Giảm số dòng đã chọn
            }
            selectedIdsString = selectedIdsString.replace(/^\|+|\|+$/g, '');
            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        }
    }
    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn

        if (selectedRecords.length === 0) {
            // Lấy toàn bộ danh sách từ grid vào selectedIdsString
            let allDataRecords = grid.dataSource instanceof ej.data.DataManager ? grid.dataSource.dataSource.json : grid.dataSource; // Lấy toàn bộ dữ liệu
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = allDataRecords.length; // Cập nhật số dòng đã chọn
            allDataRecords.forEach(record => {
                // Chuyển đổi đối tượng thành chuỗi JSON
                selectedIdsString += "|" + JSON.stringify(record);
            });
            // Loại bỏ dấu ' | ' cuối cùng
            selectedIdsString = selectedIdsString.replace(/^\|+|\|+$/g, '');
            return;
        }

        selectedRecords.forEach(record => {
            // Chuyển đổi đối tượng thành chuỗi JSON và kiểm tra xem đã tồn tại chưa
            let recordString = JSON.stringify(record);
            if (!selectedIdsString.includes(recordString)) {
                selectedIdsString += "|" + recordString;
                numRowSelect++; // Tăng số dòng đã chọn
            }
        });

        // Loại bỏ dấu ' | ' cuối cùng
        selectedIdsString = selectedIdsString.replace(/^\|+|\|+$/g, '');
    }
    // function selectionChanged(args) {
    //     let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn

    //     if (selectedRecords.length == 0) {
    //         // Lấy toàn bộ danh sách từ grid vào selectedIdsString
    //         let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
    //         selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
    //         numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
    //         filteredRecords.forEach(record => {
    //             // Chuyển đổi đối tượng thành chuỗi JSON
    //             selectedIdsString += JSON.stringify(record) + "|";
    //         });
    //         // Loại bỏ dấu ' | ' cuối cùng
    //         //selectedIdsString = selectedIdsString.slice(0, -3);
    //         return;
    //     }

    //     selectedRecords.forEach(record => {
    //         // Chuyển đổi đối tượng thành chuỗi JSON và kiểm tra xem đã tồn tại chưa
    //         let recordString = JSON.stringify(record);
    //         if (!selectedIdsString.includes(recordString)) {
    //             selectedIdsString += recordString + "|";
    //             numRowSelect++; // Tăng số dòng đã chọn
    //         }
    //     });

    //     // Loại bỏ dấu ' | ' cuối cùng
    //     //selectedIdsString = selectedIdsString.slice(0, -3);
    // }
    function exportExcelTLDH() {

        grid.showSpinner();
        grid.excelExport();

        grid.excelExportComplete = () => {
            grid.hideSpinner();
        }
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        alert(selectedRecord);

    }
    function reloadData() {
        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        var typeReload = "ReloadSanLuongSoChe";
        $.ajax({
            url: "@Url.Action("Reload", "SoChe")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeReload: typeReload },
            success: function (response) {
                if (response.Success) {
                    loadGridData(response.Data);
                } else {
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        });
    }
</script>

<script>
    var gridNhanVienKiem;
    function loadGridDataNhanVienKiem(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (gridNhanVienKiem) {
            gridNhanVienKiem.dataSource = dataManager;
            gridNhanVienKiem.refresh();
        } else {
            gridNhanVienKiem = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 500 },
                allowFiltering: true,
                allowSorting: true,
                //frozenColumns: 3,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                allowResizing: true,
                rowSelected: selectionChangedCaiDatNhanVien,
                rowDeselected: unSelectionChangedCaiDatNhanVien,
                height: 400,
                allowGrouping: true,
                groupSettings: { showDropArea: false, columns: ['Name'] },
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'Name', headerText: 'Tổ', width: 150 },
                    { field: 'NhanVienDaiThanh.MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'NhanVienDaiThanh.MaHoSo', headerText: 'Mã Số', width: 200 },

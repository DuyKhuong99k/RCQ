    var gridThemNhanVienDaiThanhTo;
    function loadGridDataNhanVienThemDaiThanhTo(callback) {
        $.ajax({
            url: '/Staff/GetAllNhanViens',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (gridThemNhanVienDaiThanhTo) {
                    gridThemNhanVienDaiThanhTo.dataSource = dataManager;
                    gridThemNhanVienDaiThanhTo.refresh();
                } else {
                    gridThemNhanVienDaiThanhTo = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 1000 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        filterSettings: { type: 'Excel' },
                        allowResizing: true,
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionChangedThemNhanVienDaiThanhTo,
                        rowDeselected: unSelectionChangedThemNhanVienDaiThanhTo,
                        height: 400,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'FirstWorkingDate', headerText: 'Ngày Bắt Đầu Làm Việc', width: 150 },
                            { field: 'Xuong', headerText: 'Xưởng', width: 150 }
                        ]
                    });
                    gridThemNhanVienDaiThanhTo.appendTo('#gridThemNhanVienDaiThanhTo');
                }
                // Gọi callback sau khi xử lý dữ liệu xong
                if (typeof callback === 'function') {
                    callback();
                }
            },
            error: function (error) {
                console.error(error);
                // Gọi callback để báo lỗi nếu cần
                if (typeof callback === 'function') {
                    callback(error);
                }
            }
        });
    }



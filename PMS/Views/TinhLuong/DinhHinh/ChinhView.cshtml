@using Newtonsoft.Json
@{
    ViewData["Title"] = "ChinhView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    var listKhuVucs = ViewBag.listKhuVucs;
    var listThanhPhams = ViewBag.listThanhPhams;
    var listThanhPhamFLs = ViewBag.listThanhPhamFLs;
    var listMaLos = ViewBag.listMaLos;

    var token = @Context.Session.GetString("JWTTokenEncry");
    var url = AppViewModels.AppViewModel.Instance.ApiWssHostUrl + "/progressHub";
    var encryptedUrl = Security.Crypt.ED.EncryptString(url);
    //var tokenDecry = Security.Crypt.ED.DecryptString(token);
    //var token = @Context.Session.GetString("JWTToken");
}
<style>
    /* CSS */
    #modalPhanBoSL .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }
</style>
<input type="hidden" id="TokenTL" value="@token" />
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tính Lương Chính</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div id="progressStatus">Initializing...</div>
                    <div style="margin-top:20px;">
                        @{
                            var xemChinhTLDH = rolePermistions.Where(x => x.Fu == "Tính Lương / Định Hình / Chính" && x.Func == "Xem / Tính Lương / Định Hình / Chính" && x.Status == 1).FirstOrDefault();
                            if (xemChinhTLDH != null)
                            {
                                <button onclick="reloadData()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-cloud'></i>Tải dữ liệu</button>
                            }
                            var phanBoSLChinhTLDH = rolePermistions.Where(x => x.Fu == "Tính Lương / Định Hình / Chính" && x.Func == "Phân Bổ Sản Lượng / Tính Lương / Định Hình / Chính" && x.Status == 1).FirstOrDefault();
                            if (phanBoSLChinhTLDH != null)
                            {
                                <button onclick="phanBoSLShow()" style="margin-right:5px" class="btn btn-outline-secondary">Phân Bổ SL</button>
                            }
                            var dongBoDLTPSChinhTLDH = rolePermistions.Where(x => x.Fu == "Tính Lương / Định Hình / Chính" && x.Func == "Đồng Bộ Dữ Liệu TPSoft / Tính Lương / Định Hình / Chính" && x.Status == 1).FirstOrDefault();
                            if (dongBoDLTPSChinhTLDH != null)
                            {
                                <button onclick="tpSoftAction()" style="margin-right:5px" class="btn btn-outline-secondary">TPSoft</button>
                            }
                            var ketChuyenDLChinhTLDH = rolePermistions.Where(x => x.Fu == "Tính Lương / Định Hình / Chính" && x.Func == "Kết Chuyển Dữ Liệu / Tính Lương / Định Hình / Chính" && x.Status == 1).FirstOrDefault();
                            if (ketChuyenDLChinhTLDH != null)
                            {
                                <button onclick="ketChuyen()" style="margin-right:5px" class="btn btn-outline-secondary">Kết Chuyển</button>
                            }
                            var exportChinhTLDH = rolePermistions.Where(x => x.Fu == "Tính Lương / Định Hình / Chính" && x.Func == "Xuất Excel / Tính Lương / Định Hình / Chính" && x.Status == 1).FirstOrDefault();
                            if (exportChinhTLDH != null)
                            {
                                <button onclick="exportExcelTLDH()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Xuất Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalPhanBoSL" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Phân Bố Sản Lượng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div id="GridPhanBoSL"></div>

                        <div style="margin-top: 20px; display: flex; align-items: center;">
                            <select id="maKhuVucPhanBoSL" class="form-control form-control-lg" style="margin-right: 10px;">
                                <option value="">Chọn khu vực</option>
                                @foreach (var item in listKhuVucs)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <button onclick="showInsertPhanBoSL()" style="margin-right: 5px;" class="btn btn-primary">
                                <i class='bx bx-plus'></i> Thêm
                            </button>
                            <button onclick="showUpdatePhanBoSL()" style="margin-right: 5px;" class="btn btn-outline-warning">
                                <i class='bx bx-edit-alt'></i> Sửa
                            </button>
                            <button onclick="showDeletePhanBoSL()" style="margin-right: 5px;" class="btn btn-outline-danger">
                                <i class='bx bx-trash'></i> Xoá
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

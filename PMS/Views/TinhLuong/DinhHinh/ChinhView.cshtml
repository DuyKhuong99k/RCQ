    function reloadData() {
        grid.showSpinner();
        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        var khuVucId = $('#khuVucTL').val();
        $.ajax({
            url: "@Url.Action("Reload", "Chinh")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, khuVucId: khuVucId },
            success: function (response) {
                if (response.Success) {
                    grid.hideSpinner();
                    loadGridData(response.Data);
                } else {
                    grid.hideSpinner();
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        });
    }
</script>
<script>
    var dateTime2 = $('#dateTimeTL').val();
    var gridPhanBoSL;
    function loadGridDataPhanBoSL(dateTime, maKhuVuc) {
        $.ajax({
            url: '/Chinh/GetAllWithKhuVucThanhPhamPhoiTrons',
            data: { dateTime: dateTime, maKhuVuc: maKhuVuc },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (gridPhanBoSL) {
                    gridPhanBoSL.dataSource = dataManager;
                    gridPhanBoSL.refresh();
                } else {
                    gridPhanBoSL = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelectedPhanBoSL,
                        //height: 400,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'ThanhPhamOrgName', headerText: maKhuVuc + ' Thành Phẩm Org', width: 150 },
                            { field: 'ThanhPhamDesName', headerText: maKhuVuc + ' Thành Phẩm Des', width: 150 },
                            { field: 'MaKhuVuc', headerText: 'Mã Khu Vực', width: 150 },
                            { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                            { field: 'MaLo', headerText: 'Lô', width: 150 },
                            { field: 'TyLe', headerText: 'Tỷ Lệ', type: 'number', width: 150 },
                        ]
                    });
                    gridPhanBoSL.appendTo('#GridPhanBoSL');


                    // Hiển thị Grid trên trang web

                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridDataPhanBoSL(dateTime2, "DH");
    function reloadDataPhanBoSL(dateTime, maKhuVuc) {
        loadGridDataPhanBoSL(dateTime, maKhuVuc);
    }
    function onRowSelectedPhanBoSL(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ngay = selectedRecord.Ngay;
        var MaThanhPhamOrg = selectedRecord.MaThanhPhamOrg;
        var MaThanhPhamDes = selectedRecord.MaThanhPhamDes;
        var MaKhuVuc = selectedRecord.MaKhuVuc;
        var MaXuong = selectedRecord.MaXuong;
        var MaLo = selectedRecord.MaLo;
        $('#rowSelectedPhanBoSL').val(Ngay + "," + MaThanhPhamOrg + "," + MaThanhPhamDes + "," + MaKhuVuc + "," + MaXuong + "," + MaLo);
        var l = $('#rowSelectedPhanBoSL').val();
        //alert(l);
    }

    $('#maKhuVucPhanBoSL').on('change', function () {
        var selectedValue = $(this).val();
        if (selectedValue === 'DH') {
            $('.flTppbsl').hide();
            $('.dhTppbsl').show();
        } else {
            $('.flTppbsl').show();
            $('.dhTppbsl').hide();
        }
        var dateTime = $('#dateTimeTL').val();
        reloadDataPhanBoSL(dateTime, selectedValue);
    });
    function phanBoSLShow() {
        $('#maKhuVucPhanBoSL').val("DH");
        $('#modalPhanBoSL').modal('show');
    }
    function showInsertPhanBoSL() {
        var maKhuVucPhanBoSL = $('#maKhuVucPhanBoSL').val();
        if (maKhuVucPhanBoSL == null || maKhuVucPhanBoSL == undefined || maKhuVucPhanBoSL == "") {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn khu vực", "Thông báo");
            return;
        }
        $('#modalThemPhanBoSL').modal('show');
    }
    function insertPhanBoSL() {
        var dateTime = $('#dateTimeTL').val();
        var maXuong = @XuongId;
        var maKhuVuc = $('#maKhuVucPhanBoSL').val();
        var maThanhPhamOrg = "";
        var maThanhPhamDes = "";
        if (maKhuVuc == "DH") {
            maThanhPhamOrg = $('#maThanhPhamOrgPhanBoSL').val();
            maThanhPhamDes = $('#maThanhPhamDesPhanBoSL').val();

        } else if (maKhuVuc == "FL") {
            maThanhPhamOrg = $('#maThanhPhamFLOrgPhanBoSL').val();
            maThanhPhamDes = $('#maThanhPhamFLDesPhanBoSL').val();
        }
        var maLo = $('#maLoPhanBoSL').val();
        var tyLe = $('#tyLePhanBoSL').val();
        document.getElementById("txtThemPhanBoSL").style.visibility = "hidden";
        document.getElementById("loadingIndicatorPhanBoSL").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/Chinh/DoInsertThanhPhamPhoiTron',
            data: {
                dateTime: dateTime,
                maXuong: maXuong,
                maKhuVuc: maKhuVuc,
                maThanhPhamOrg: maThanhPhamOrg,
                maThanhPhamDes: maThanhPhamDes,
                maLo: maLo,
                tyLe: tyLe
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThemPhanBoSL').modal('hide');
                    reloadDataPhanBoSL(dateTime, maKhuVuc);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorPhanBoSL").style.display = "none";
                document.getElementById("txtThemPhanBoSL").style.visibility = "visible";
            }
        });
    }
    function showUpdatePhanBoSL() {
        var listKeyPhanBoSL = $('#rowSelectedPhanBoSL').val();

        $.ajax({
            url: "/Chinh/GetsByMaThanhPhamPhoiTron",
            data: { listKeyPhanBoSL: listKeyPhanBoSL },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    if (rs.MaKhuVuc == "DH") {
                        $('#maThanhPhamOrgPhanBoSLSua').val(rs.MaThanhPhamOrg);
                        $('#maThanhPhamDesPhanBoSLSua').val(rs.MaThanhPhamDes);
                    } else {
                        $('#maThanhPhamFLOrgPhanBoSLSua').val(rs.MaThanhPhamOrg);
                        $('#maThanhPhamFLDesPhanBoSLSua').val(rs.MaThanhPhamDes);
                    }
                    $('#maLoPhanBoSLSua').val(rs.MaLo);
                    $('#tyLePhanBoSLSua').val(rs.TyLe);
                    $('#modalSuaPhanBoSL').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function updatePhanBoSL() {
        var dateTime = $('#dateTimeTL').val();
        var maXuong = @XuongId;
        var maKhuVuc = $('#maKhuVucPhanBoSL').val();
        var maThanhPhamOrg = "";
        var maThanhPhamDes = "";
        if (maKhuVuc == "DH") {
            maThanhPhamOrg = $('#maThanhPhamOrgPhanBoSLSua').val();
            maThanhPhamDes = $('#maThanhPhamDesPhanBoSLSua').val();

        } else if (maKhuVuc == "FL") {
            maThanhPhamOrg = $('#maThanhPhamFLOrgPhanBoSLSua').val();
            maThanhPhamDes = $('#maThanhPhamFLDesPhanBoSLSua').val();
        }
        var maLo = $('#maLoPhanBoSLSua').val();
        var tyLe = $('#tyLePhanBoSLSua').val();
        document.getElementById("txtSuaPhanBoSL").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSuaPhanBoSL").style.display = "block";
        $.ajax({
            url: '/Chinh/DoUpDateThanhPhamPhoiTron',
            data: {
                dateTime: dateTime,
                maXuong: maXuong,
                maKhuVuc: maKhuVuc,
                maThanhPhamOrg: maThanhPhamOrg,
                maThanhPhamDes: maThanhPhamDes,
                maLo: maLo,
                tyLe: tyLe
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSuaPhanBoSL').modal('hide');
                    reloadDataPhanBoSL(dateTime, maKhuVuc);
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSuaPhanBoS").style.display = "none";
                document.getElementById("txtSuaPhanBoS").style.visibility = "visible";
            }
        });
    }
    function showDeletePhanBoSL() {
        var listKeyPhanBoSL = $('#rowSelectedPhanBoSL').val();
        $.ajax({
            url: "/Chinh/GetsByMaThanhPhamPhoiTron",
            data: { listKeyPhanBoSL: listKeyPhanBoSL },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.MaThanhPhamOrg,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/Chinh/DoDeleteThanhPhamPhoiTron',
                                    data: {
                                        dateTime: rs.Ngay,
                                        maThanhPhamOrg: rs.MaThanhPhamOrg,
                                        maThanhPhamDes: rs.MaThanhPhamDes,
                                        maKhuVuc: rs.MaKhuVuc,
                                        maXuong: rs.MaXuong,
                                        maLo: rs.MaLo,
                                    },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs2) {
                                        if (rs2.isSuccess === true) {
                                            reloadDataPhanBoSL(rs.Ngay, rs.MaKhuVuc);
                                            toastOptionNotyfi();
                                            toastr["success"](rs2.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs2.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }

    function tpSoftAction() {
        // Lấy giá trị dateTime từ input và maXuong từ biến Razor
        var dateTime = $('#dateTimeTL').val();
        var maXuong = '@XuongId';
        const token = document.getElementById('TokenTL').value;
        $.ajax({
            url: '/Chinh/GetSignalRConnectionInfo',
            type: 'POST',
            dataType: "json",
            success: function (response) {

                const connection = new signalR.HubConnectionBuilder().withUrl("@AppViewModels.AppViewModel.Instance.ApiHostUrl" + "/progressHub", {
                    accessTokenFactory: () => token
                }).build();

                connection.on("ReceiveProgress", function (message) {
                    document.getElementById("progressStatus").innerText = message;
                });

                connection.start().then(function () {
                    console.log("SignalR Connected.");

                    $.ajax({
                        url: '/Chinh/ExecuteTPSoftAction',
                        data: {
                            dateTime: dateTime,
                            maXuong: maXuong
                        },
                        type: 'POST',
                        dataType: "json",
                        success: function () {
                            console.log('Request sent successfully.');
                        },
                        error: function (error) {
                            console.error('Error:', error);
                        }
                    });
                }).catch(function (err) {
                    console.error('SignalR Connection Error:', err.toString());
                });
            },
            error: function (error) {
                console.error('Error fetching SignalR connection info:', error);
            }
        });
    }
    function ketChuyen() {
        if (selectedIdsString != "") {
            var dateTime = $('#dateTimeTL').val();
            var maXuong = '@XuongId';
            bootbox.confirm({
                title: "Thông báo!",
                message: "Xác nhận chuyển dữ liệu lên CSDL tính lương trên " + numRowSelect + " dòng dữ liệu!",
                buttons: {
                    confirm: {
                        label: 'OK',
                        className: 'btn btn-primary'
                    }
                },
                callback: function (result) {
                    if (result) {
                        //Người dùng đã bấm OK, Gọi API xóa ở đây
                        $.ajax({
                            url: '/Chinh/KetChuyen',
                            data: { dateTime: dateTime, maXuong: maXuong, listPhieuCanTongHopDinhHinh: selectedIdsString },
                            type: 'POST',
                            dataType: 'json',
                            success: function (rs) {
                                if (rs.isSuccess === true) {
                                    reloadData();
                                    toastOptionNotyfi();
                                    toastr["success"](rs.Messages, "Thông báo");
                                } else {
                                    toastOptionNotyfi();
                                    toastr["warning"](rs.Messages, "Thông báo");
                                }
                            },
                            error: function (error) {
                                toastOptionNotyfi();
                                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");

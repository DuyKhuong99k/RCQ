    var gridThemNhanVienDaiThanhTo;
    function loadGridDataNhanVienThemDaiThanhTo(callback) {
        $.ajax({
            url: '/Staff/GetAllNhanViens',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (gridThemNhanVienDaiThanhTo) {
                    gridThemNhanVienDaiThanhTo.dataSource = dataManager;
                    gridThemNhanVienDaiThanhTo.refresh();
                } else {
                    gridThemNhanVienDaiThanhTo = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 1000 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        filterSettings: { type: 'Excel' },
                        allowResizing: true,
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionChangedThemNhanVienDaiThanhTo,
                        rowDeselected: unSelectionChangedThemNhanVienDaiThanhTo,
                        height: 400,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'FirstWorkingDate', headerText: 'Ngày Bắt Đầu Làm Việc', width: 150 },
                            { field: 'Xuong', headerText: 'Xưởng', width: 150 }
                        ]
                    });
                    gridThemNhanVienDaiThanhTo.appendTo('#gridThemNhanVienDaiThanhTo');
                }
                // Gọi callback sau khi xử lý dữ liệu xong
                if (typeof callback === 'function') {
                    callback();
                }
            },
            error: function (error) {
                console.error(error);
                // Gọi callback để báo lỗi nếu cần
                if (typeof callback === 'function') {
                    callback(error);
                }
            }
        });
    }


    let selectedIdsStringThemNhanVienDatThanhTo = "";
    let numRowSelectThemNhanVienDaiThanhTo = 0;
    function unSelectionChangedThemNhanVienDaiThanhTo(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsStringThemNhanVienDatThanhTo = "";
                numRowSelectThemNhanVienDaiThanhTo = 0; // Reset số dòng đã chọn
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselected = deselectedRecords[i];
                let deselectedString = JSON.stringify(deselected);

                // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsStringThemNhanVienDatThanhTo.includes(deselectedString)) {
                    // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                    selectedIdsStringThemNhanVienDatThanhTo = selectedIdsStringThemNhanVienDatThanhTo.replace("|" + deselectedString, "");
                    numRowSelectThemNhanVienDaiThanhTo--; // Giảm số dòng đã chọn
                }
            }
            selectedIdsStringThemNhanVienDatThanhTo = selectedIdsStringThemNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');

            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        } else {
            // Trường hợp chỉ có một bản ghi được bỏ chọn
            let deselectedString = JSON.stringify(deselectedRecords);

            // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsStringThemNhanVienDatThanhTo.includes(deselectedString)) {
                // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                selectedIdsStringThemNhanVienDatThanhTo = selectedIdsStringThemNhanVienDatThanhTo.replace("|" + deselectedString, "");
                numRowSelectThemNhanVienDaiThanhTo--; // Giảm số dòng đã chọn
            }
            selectedIdsStringThemNhanVienDatThanhTo = selectedIdsStringThemNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');

            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        }
        // alert(selectedIdsStringCaiDatNhanVien);
    }
    function selectionChangedThemNhanVienDaiThanhTo(args) {
        let selectedRecords = Array.isArray(args.data) ? args.data : (args.data ? [args.data] : []);

        if (selectedRecords.length === 0) {
            // Lấy toàn bộ danh sách từ grid vào selectedIdsString
            let allDataRecords = grid.dataSource instanceof ej.data.DataManager ? grid.dataSource.dataSource.json : grid.dataSource; // Lấy toàn bộ dữ liệu
            selectedIdsStringThemNhanVienDatThanhTo = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelectThemNhanVienDaiThanhTo = allDataRecords.length; // Cập nhật số dòng đã chọn
            allDataRecords.forEach(record => {
                // Chuyển đổi đối tượng thành chuỗi JSON
                selectedIdsStringThemNhanVienDatThanhTo += "|" + JSON.stringify(record);
            });
            // Loại bỏ dấu ' | ' cuối cùng
            selectedIdsStringThemNhanVienDatThanhTo = selectedIdsStringThemNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');
            return;
        }

        selectedRecords.forEach(record => {
            // Chuyển đổi đối tượng thành chuỗi JSON và kiểm tra xem đã tồn tại chưa
            let recordString = JSON.stringify(record);
            if (!selectedIdsStringThemNhanVienDatThanhTo.includes(recordString)) {
                selectedIdsStringThemNhanVienDatThanhTo += "|" + recordString;
                numRowSelectThemNhanVienDaiThanhTo++; // Tăng số dòng đã chọn
            }
        });

        // Loại bỏ dấu ' | ' cuối cùng
        selectedIdsStringThemNhanVienDatThanhTo = selectedIdsStringThemNhanVienDatThanhTo.replace(/^\|+|\|+$/g, '');
        // alert(selectedIdsStringCaiDatNhanVien);

    }

    function ShowDanhSachNhanVien() {
        var nhomKiem = $('#listPhucVu').val();
        if (nhomKiem == "Chọn nhóm kiểm") {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn nhóm kiểm", "Thông báo");
            return;
        }
        document.getElementById("txtThemNhanVienDaiThanhToBtn").style.visibility = "hidden";
        document.getElementById("loadingIndicatorNhanVienDaiThanhToBtn").style.display = "block";
        loadGridDataNhanVienThemDaiThanhTo(function (error) {
            if (!error) {
                document.getElementById("loadingIndicatorNhanVienDaiThanhToBtn").style.display = "none";
                document.getElementById("txtThemNhanVienDaiThanhToBtn").style.visibility = "visible";
                $('#modalShowDanhSachNhanVien').modal('show');
            } else {
                console.error('Failed to load data:', error);
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi khi tải danh sách nhân viên: ' + error, "Thông báo");
                document.getElementById("loadingIndicatorNhanVienDaiThanhToBtn").style.display = "none";
                document.getElementById("txtThemNhanVienDaiThanhToBtn").style.visibility = "visible";
                // Xử lý lỗi nếu cần
            }
        });
    }
    function addNhanVienDaiThanhTo() {

        var nhomKiem = $('#listPhucVu').val();
        $.ajax({
            url: '/PhucVu/AddNhanVienDaiThanhTo',
            data: {
                nhomKiem: nhomKiem,
                listNhanVienToSelectedItems: selectedIdsStringThemNhanVienDatThanhTo
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalShowDanhSachNhanVien').modal('hide');

                    if (type == 0) {
                        reloadDataNhanVienDaiThanhTo(nhomKiem);
                    }
                    else if (type == 1) {
                        reloadDataNhanVienDaiThanhTo2(nhomKiem)
                    }
                    reloadGridNhanVienKiems2();
                    selectedIdsStringThemNhanVienDatThanhTo = "";

                    numRowSelectThemNhanVienDaiThanhTo = 0;

                    $('#typeCheck').val("");
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });
    }
</script>



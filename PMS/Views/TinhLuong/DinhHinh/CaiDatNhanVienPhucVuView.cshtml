<script>
    var gridNhanVienKiem;
    function loadGridDataNhanVienKiem(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (gridNhanVienKiem) {
            gridNhanVienKiem.dataSource = dataManager;
            gridNhanVienKiem.refresh();
        } else {
            gridNhanVienKiem = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 500 },
                allowFiltering: true,
                allowSorting: true,
                //frozenColumns: 3,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                allowResizing: true,
                rowSelected: selectionChangedCaiDatNhanVien,
                rowDeselected: unSelectionChangedCaiDatNhanVien,
                height: 400,
                allowGrouping: true,
                groupSettings: { showDropArea: false, columns: ['Name'] },
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'Name', headerText: 'Tổ', width: 150 },
                    { field: 'NhanVienDaiThanh.MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'NhanVienDaiThanh.MaHoSo', headerText: 'Mã Số', width: 200 },
                    { field: 'NhanVienDaiThanh.Name', headerText: 'Tên Nhân Viên', width: 200 },
                    { field: 'SoGio', headerText: 'Số Giờ', type: 'number', width: 150 },
                    { field: 'TyLe', headerText: 'Tỷ Lệ', type: 'number', width: 150 },
                    { field: 'TyLeTru', headerText: 'Tỷ Lệ Trừ', type: 'number', width: 150 },

                ]
            });
            gridNhanVienKiem.appendTo('#GridNhanVienKiem');
            // Hiển thị Grid trên trang web

        }

    }
    loadGridDataNhanVienKiem();

    let selectedIdsStringCaiDatNhanVien = "";
    let numRowSelectCaiDatNhanVien = 0;
    function unSelectionChangedCaiDatNhanVien(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsStringCaiDatNhanVien = "";
                numRowSelectCaiDatNhanVien = 0; // Reset số dòng đã chọn
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselected = deselectedRecords[i];
                let deselectedString = JSON.stringify(deselected);

                // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsStringCaiDatNhanVien.includes(deselectedString)) {
                    // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                    selectedIdsStringCaiDatNhanVien = selectedIdsStringCaiDatNhanVien.replace("|" + deselectedString, "");
                    numRowSelectCaiDatNhanVien--; // Giảm số dòng đã chọn
                }
            }
            selectedIdsStringCaiDatNhanVien = selectedIdsStringCaiDatNhanVien.replace(/^\|+|\|+$/g, '');

            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        } else {
            // Trường hợp chỉ có một bản ghi được bỏ chọn
            let deselectedString = JSON.stringify(deselectedRecords);

            // Kiểm tra xem bản ghi đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsStringCaiDatNhanVien.includes(deselectedString)) {
                // Loại bỏ chuỗi JSON của bản ghi và dấu " | " theo sau
                selectedIdsStringCaiDatNhanVien = selectedIdsStringCaiDatNhanVien.replace("|" + deselectedString, "");
                numRowSelectCaiDatNhanVien--; // Giảm số dòng đã chọn
            }
            selectedIdsStringCaiDatNhanVien = selectedIdsStringCaiDatNhanVien.replace(/^\|+|\|+$/g, '');

            // Loại bỏ dấu ' | ' cuối cùng nếu có
            // if (selectedIdsString.endsWith("|")) {
            //     selectedIdsString = selectedIdsString.slice(0, -3);
            // }
        }
        // alert(selectedIdsStringCaiDatNhanVien);
    }
    function selectionChangedCaiDatNhanVien(args) {
        let selectedRecords = Array.isArray(args.data) ? args.data : (args.data ? [args.data] : []);

        if (selectedRecords.length === 0) {
            // Lấy toàn bộ danh sách từ grid vào selectedIdsString
            let allDataRecords = gridNhanVienKiem.dataSource instanceof ej.data.DataManager ? gridNhanVienKiem.dataSource.dataSource.json : gridNhanVienKiem.dataSource; // Lấy toàn bộ dữ liệu
            selectedIdsStringCaiDatNhanVien = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelectCaiDatNhanVien = allDataRecords.length; // Cập nhật số dòng đã chọn
            allDataRecords.forEach(record => {
                // Chuyển đổi đối tượng thành chuỗi JSON
                selectedIdsStringCaiDatNhanVien += "|" + JSON.stringify(record);
            });
            // Loại bỏ dấu ' | ' cuối cùng
            selectedIdsStringCaiDatNhanVien = selectedIdsStringCaiDatNhanVien.replace(/^\|+|\|+$/g, '');
            return;
        }

        selectedRecords.forEach(record => {
            // Chuyển đổi đối tượng thành chuỗi JSON và kiểm tra xem đã tồn tại chưa
            let recordString = JSON.stringify(record);
            if (!selectedIdsStringCaiDatNhanVien.includes(recordString)) {
                selectedIdsStringCaiDatNhanVien += "|" + recordString;
                numRowSelectCaiDatNhanVien++; // Tăng số dòng đã chọn
            }
        });

        // Loại bỏ dấu ' | ' cuối cùng
        selectedIdsStringCaiDatNhanVien = selectedIdsStringCaiDatNhanVien.replace(/^\|+|\|+$/g, '');
        // alert(selectedIdsStringCaiDatNhanVien);

    }

    function reloadDataNhanVienKiem(dateTime, xuongId) {
        loadGridDataNhanVienKiem(dateTime, xuongId);
    }
    function reloadGridNhanVienKiems() {
        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        var typeReload = "ReloadDanhSachMacDinhCaiDatNhanVienTL";
        $.ajax({
            url: "@Url.Action("Reload", "PhucVu")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeReload: typeReload },
            success: function (response) {
                if (response.Success) {
                    loadGridDataNhanVienKiem(response.Data);

                } else {
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        });
        // reloadDataNhanVienKiem(dateTime, xuongId)
    }
    function reloadGridNhanVienKiems2() {
        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        var typeReload = "ReloadDanhSachMacDinhCaiDatNhanVienTL2";
        var type = 0;
        $.ajax({
            url: "@Url.Action("Reload", "PhucVu")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeReload: typeReload },
            success: function (response) {
                if (response.Success) {
                    loadGridDataNhanVienKiem(response.Data);
                } else {
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        });
        // reloadDataNhanVienKiem(dateTime, xuongId)
    }
</script>

@{
    ViewData["Title"] = "CaiDatNhanVienPhucVuView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listNhomKiem = ViewBag.listNhomKiem;
    var XuongId = @Context.Session.GetString("XuongId");
}

<style>
    .vertical-buttons {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

        .vertical-buttons button {
            margin-bottom: 5px; /* Khoảng cách giữa các nút */
        }

    @@media (max-width: 767px) {
        .vertical-buttons {
            margin-top: 5px;
            flex-direction: row;
        }
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Cài Đặt Nhân Viên Phục Vụ</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-7">
                            <h6>Danh sách mặc định</h6>
                            <div id="GridNhanVienKiem"></div>
                            <div style="margin-top:5px">
                                <button onclick="reloadGridNhanVienKiems()" style="margin-right:5px" class="btn btn-outline-secondary">Tải Dữ Liệu</button>
                                <button onclick="saveGridNhanVienKiems()" style="margin-right:5px" class="btn btn-outline-secondary">Lưu Danh Sách</button>
                            </div>
                        </div>
                        <div class="col-sm-1">
                            <div class="vertical-buttons">
                                <button onclick="moveTo()" class="btn btn-primary w-100 position-relative" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem"><i class='bx bxs-chevrons-right'></i></span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="row">
                                <div class="col-sm-7">
                                    <h6>Danh sách nhân viên theo nhóm</h6>
                                </div>
                                <div class="col-sm-3">
                                    <select id="listPhucVu" class="form-control-sm">
                                        <option>Chọn nhóm kiểm</option>
                                        @foreach (var item in listNhomKiem)
                                        {
                                            <option value="@item">@item</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div id="GridNhanVienDaiThanhTo"></div>
                            <div style="margin-top:5px">
                                <button onclick="ShowDanhSachNhanVien()" style="margin-right:5px" class="btn btn-outline-secondary">
                                    <div class=" align-items-center">
                                        <span id="txtThemNhanVienDaiThanhToBtn">Thêm</span>
                                        <div id="loadingIndicatorNhanVienDaiThanhToBtn" class=" spinner-border text-primary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                                <button onclick="deleteNhanVienDaiThanhTo()" style="margin-right:5px" class="btn btn-outline-secondary">Loại Bỏ</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalShowDanhSachNhanVien" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Danh sách nhân viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

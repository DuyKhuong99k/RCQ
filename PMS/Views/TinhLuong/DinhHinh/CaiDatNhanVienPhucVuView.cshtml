        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        reloadDataNhanVienDaiThanhTo(selectedValue);
    });

    function moveTo() {
        var nhomKiem = $('#listPhucVu').val();
        if (nhomKiem == "" || nhomKiem == undefined || nhomKiem == "Chọn nhóm kiểm" || numRowSelectCaiDatNhanVien == 0) {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn Nhóm Kiểm hoặc Nhân Viên Kiểm", "Thông báo");
            return;
        }
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn sắp xếp lại nhóm của : " + numRowSelectCaiDatNhanVien + " nhân viên?",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/PhucVu/MoveTo',
                        data: {
                            nhomKiem: nhomKiem,
                            listNhanVienKiemSelectedItems: selectedIdsStringCaiDatNhanVien
                        },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                if (type == 0) {
                                    reloadDataNhanVienDaiThanhTo(nhomKiem);
                                }
                                else if (type == 1) {
                                    reloadDataNhanVienDaiThanhTo2(nhomKiem)
                                }
                                reloadGridNhanVienKiems2();
                                selectedIdsStringCaiDatNhanVien = "";
                                numRowSelectCaiDatNhanVien = 0;
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");
                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        }
                    });
                }
            }
        });
    }

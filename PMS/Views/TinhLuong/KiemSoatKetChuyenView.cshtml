    //     let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn

    //     if (selectedRecords.length == 0) {
    //         // Lấy toàn bộ danh sách từ grid vào selectedIdsString
    //         let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
    //         selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
    //         numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
    //         filteredRecords.forEach(record => {
    //             // Chuyển đổi đối tượng thành chuỗi JSON
    //             selectedIdsString += JSON.stringify(record) + "|";
    //         });
    //         // Loại bỏ dấu ' | ' cuối cùng
    //         //selectedIdsString = selectedIdsString.slice(0, -3);
    //         return;
    //     }

    //     selectedRecords.forEach(record => {
    //         // Chuyển đổi đối tượng thành chuỗi JSON và kiểm tra xem đã tồn tại chưa
    //         let recordString = JSON.stringify(record);
    //         if (!selectedIdsString.includes(recordString)) {
    //             selectedIdsString += recordString + "|";
    //             numRowSelect++; // Tăng số dòng đã chọn
    //         }
    //     });

    //     // Loại bỏ dấu ' | ' cuối cùng
    //     //selectedIdsString = selectedIdsString.slice(0, -3);
    // }
    function exportExcelTLDH() {

        grid.showSpinner();
        grid.excelExport();

        grid.excelExportComplete = () => {
            grid.hideSpinner();
        }
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        alert(selectedRecord);

    }
    function reloadData() {
        var dateTime = $('#dateTimeTL').val();
        var xuongId = @XuongId;
        var typeReload = "LoadKhuVucKetChuyen";
        $.ajax({
            url: "@Url.Action("Reload", "QuanLyKetChuyen")",
            type: "GET",
            data: { dateTime: dateTime, typeReload: typeReload },
            success: function (response) {
                if (response.Success) {
                    loadGridData(response.Data);
                } else {
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        });
    }

    function removeKhuVucKetChuyen() {
        if (selectedIdsString != "") {
            var dateTime = $('#dateTimeTL').val();
            var maXuong = '@XuongId';
            bootbox.confirm({
                title: "Thông báo!",
                message: "Thực hiện thao tác xóa dữ liệu kết chuyển của các khu vực đã chọn? " + numRowSelect + " khu vực!",
                buttons: {
                    confirm: {
                        label: 'OK',
                        className: 'btn btn-primary'
                    }
                },
                callback: function (result) {
                    if (result) {
                        //Người dùng đã bấm OK, Gọi API xóa ở đây
                        $.ajax({
                            url: '/QuanLyKetChuyen/XoaKhuVucKetChuyen',
                            data: { dateTime: dateTime, xuongId: maXuong, listSanLuongPhuFillet: selectedIdsString },
                            type: 'POST',
                            dataType: 'json',
                            success: function (rs) {
                                if (rs.isSuccess === true) {
                                    reloadData();
                                    toastOptionNotyfi();
                                    toastr["success"](rs.Messages, "Thông báo");
                                } else {
                                    toastOptionNotyfi();
                                    toastr["warning"](rs.Messages, "Thông báo");
                                }
                            },
                            error: function (error) {
                                toastOptionNotyfi();
                                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                            }
                        });
                    }
                }
            });
        }
        else {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn khu vực để xoá!", "Thông báo");
        }
    }
</script>


<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân Chính Xếp Khuôn</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanChinhXepKhuon = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Chính Xếp Khuôn" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Chính Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanChinhXepKhuon != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanChinhXepKhuon = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Chính Xếp Khuôn" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Chính Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanChinhXepKhuon != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanChinhXepKhuon = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Chính Xếp Khuôn" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Chính Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanChinhXepKhuon != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

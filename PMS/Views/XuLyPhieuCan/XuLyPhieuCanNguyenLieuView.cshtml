<script>
    // $(document).ready(function () {
    //     loadGridData();
    // });
    let selectedIdsString = ""; // Khai báo một chuỗi để lưu trữ MaNhanVien đã chọn
    let numRowSelect = 0;
    var grid;
    var datalength = 0;
    function creatTable(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }
        if (grid!= null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {

            var contextMenuItems = [
                { text: 'Xem ghi chú', id: 'viewNote' },
                { text: 'Chuyển xưởng', id: 'changeDepartment' },
                { text: 'Chuyển size', id: 'changeSize' },
                { text: 'Chuyển thành phẩm', id: 'changeThanhPham' },
            ];
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowSelection: true,
                allowFiltering: true,
                allowSorting: true,
                allowResizing: true,
                //enableVirtualization: true,
                //loadingIndicator: { indicatorType: 'Shimmer' },
                filterSettings: { type: 'Excel' },
                //selectionSettings: { persistSelection: true, type: "Multiple", checkboxOnly: true },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                rowSelected: selectionChanged,
                rowDeselected: unSelectionChanged,
                height: 400,
                contextMenuItems: contextMenuItems,
                contextMenuClick: contextMenuClickHandler,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'ThoiGianCan', headerText: 'Giờ', width: 150 , type: 'date', format: 'HH:mm:ss'},
                    { field: 'NhaCCName', headerText: 'Nhà Cung Cấp', width: 150 },
                    { field: 'MSL', headerText: 'Mã Lô', width: 150 },
                    { field: 'MaAo', headerText: 'Ao', width: 150 },
                    { field: 'PhuongTienName', headerText: 'Phương Tiện', width: 150 },
                    { field: 'LoaiCaName', headerText: 'Loại Cá', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'SizeName', headerText: 'Size', width: 150 },
                    { field: 'MauName', headerText: 'Mau', width: 150 },
                    //{ field: 'BanCatTietName', headerText: 'Bàn Cắt Tiết', width: 150 },
                    //{ field: 'Pheu', headerText: 'Phễu', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                    { field: 'TrongLuongTare', headerText: 'Trọng Lượng Tare', type: 'number', width: 150 },
                    //{ field: 'TrongLuongOgr', headerText: 'Trọng Lượng Gốc', type: 'number', width: 150 },
                    { field: 'TyLeNuoc', headerText: 'Tỷ Lệ Nước', type: 'number', width: 150 },
                    { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'MaMayTinhCan', headerText: 'Máy Cân', width: 150 },
                ],
                aggregates: [{
                    columns: [{
                        type: 'Sum',
                        field: 'TrongLuong',
                        format: 'N2',
                        footerTemplate: 'Tổng TL: ${Sum} Kg'
                    }]
                }]
            });
            grid.appendTo('#Grid');
        }
    }

    creatTable();
    function contextMenuClickHandler(args) {
        var rowData = args.rowInfo.rowData;
        if (rowData) {
            switch (args.item.id) {
                case 'viewNote':
                    var ghiChu = rowData.GhiChu;
                    if (ghiChu) {
                        // Thay thế dấu phẩy bằng thẻ <br> để tạo xuống hàng
                        ghiChu = ghiChu.replace(/,/g, '<br>');
                        bootbox.alert({
                            title: "Ghi chú",
                            message: ghiChu,
                            callback: function () { }
                        });
                    } else {
                        bootbox.alert("Không có ghi chú nào cho hàng này.");
                    }
                    break;
                case 'changeDepartment':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenNguyenLieu",
                        data: { typeOption: "CHUYENXUONG" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển xưởng của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenXuong').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });

                    break;
                case 'changeSize':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenNguyenLieu",
                        data: { typeOption: "CHUYENSIZE" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển sỉze của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenSize').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });

                    break;
                case 'changeThanhPham':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenNguyenLieu",
                        data: { typeOption: "CHUYENTHANHPHAM" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển thành phẩm của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenThanhPham').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });

                    break;
                default:
                    break;
            }
        }
    }


    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                //alert(selectedIdsString);
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselectedMaMayTinhCan = deselectedRecords[i].MaMayTinhCan;
                let deselectedMaUserCan = deselectedRecords[i].MaUserCan;
                let deselectedThoiGianCan = deselectedRecords[i].ThoiGianCan;
                let deselectedTrongLuong = deselectedRecords[i].TrongLuong;
                let deselectedId = deselectedMaMayTinhCan + "," + deselectedMaUserCan + "," + deselectedThoiGianCan + "," + deselectedTrongLuong;

                // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedId)) {
                    selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                    numRowSelect--; // Giảm số dòng đã chọn
                }
            }
        } else {
            // Nếu deselectedRecords không phải là một mảng
            let deselectedMaMayTinhCan = deselectedRecords.MaMayTinhCan;
            let deselectedMaUserCan = deselectedRecords.MaUserCan;
            let deselectedThoiGianCan = deselectedRecords.ThoiGianCan;
            let deselectedTrongLuong = deselectedRecords.TrongLuong;
            let deselectedId = deselectedMaMayTinhCan + "," + deselectedMaUserCan + "," + deselectedThoiGianCan + "," + deselectedTrongLuong;

            // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedId)) {
                selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                numRowSelect--; // Giảm số dòng đã chọn
            }
            //alert(selectedIdsString);
        }
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }

    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
            filteredRecords.forEach(record => {
                selectedIdsString += record.MaMayTinhCan + ","; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.MaUserCan + ","; // Thêm MayTP vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.ThoiGianCan + ",";
                selectedIdsString += record.TrongLuong + "|";
            });

            // Loại bỏ dấu | cuối cùng
            selectedIdsString = selectedIdsString.slice(0, -1);
            //alert(selectedIdsString);
            //alert(numRowSelect);
            return;
        }
        let selectedMaMayTinhCan = selectedRecords.MaMayTinhCan;
        let selectedMaUserCan = selectedRecords.MaUserCan;
        let selectedThoiGianCan = selectedRecords.ThoiGianCan;
        let selectedTrongLuong = selectedRecords.TrongLuong;

        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedThoiGianCan)) {
            selectedIdsString += selectedMaMayTinhCan + ","; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedMaUserCan + ","; // Thêm MayTP vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedThoiGianCan + ","; // Thêm MaXuong vào chuỗi, phân tách bằng dấu chấm than, ngăn cách các bản ghi bằng dấu |
            selectedIdsString += selectedTrongLuong + "|"; // Thêm MaXuong vào chuỗi, phân tách bằng dấu chấm than, ngăn cách các bản ghi bằng dấu |

            numRowSelect++; // Tăng số dòng đã chọn
        }
        // Loại bỏ dấu | cuối cùng
        //selectedIdsString = selectedIdsString.slice(0, -1);
        //alert(selectedIdsString);
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    function reloadDataXLPCNL() {
        var btnEle = document.getElementById('RefreshButtonXLPC');
        var btn = btnEle.ej2_instances[0];

        if (btnEle.classList.contains("loading")) return;
        btnEle.classList.add("loading");

        ClearData("Grid");

        var originalContent = btn.content;

        var dots = 0;
        btn.content = "Đang tải";
        var loadingInterval = setInterval(function () {
            dots = (dots + 1) % 4;
            btn.content = "Đang tải" + ".".repeat(dots);
        }, 500);


        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        var typeValue = "@khuVuc";
        $.ajax({
            url: "@Url.Action("Reload", "XuLyPhieuCan")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeValue: typeValue },
            success: function (response) {
                if (response.Success) {
                    creatTable(response.Data);
                } else {
                    creatTable();
                    console.error(response.Messages);
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        }).always(function () {
            clearInterval(loadingInterval);
            btn.content = originalContent;
            // btn.disabled = false;
            btnEle.classList.remove("loading");
        });
    }
    document.getElementById('RefreshButtonXLPC').addEventListener("click", function () {
        reloadDataXLPCNL();
    });
</script>
<script>
    function getCurrentDateTime() {
        let now = new Date();

        // Lấy các thành phần giờ, phút, giây và mili giây
        let year = now.getFullYear();
        let month = String(now.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0
        let day = String(now.getDate()).padStart(2, '0');
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');

        // Định dạng thời gian theo yêu cầu của input datetime-local
        let currentTime = `${year}-${month}-${day}T${hours}:${minutes}:${seconds}`;

        return currentTime;
    }
    function setDateTimeInput(date) {
        // Định dạng lại chuỗi ngày giờ cho phù hợp với <input type="datetime-local">
        var formattedDate = date.slice(0, 16);

        return formattedDate;
    }

    function showInsert() {
        $('#thoiGianCanXLPCNL').val(getCurrentDateTime());
        $.ajax({
            type: "GET",
            url: "/XuLyPhieuCan/CreatDefautNewNguyenLieu",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maMayCanXLPCNL').val(rs.MaMayCan);
                    $('#suDungXLPCNL').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        var thoiGianCan = $('#thoiGianCanXLPCNL').val();
        var maLoaiCa = $('#maLoaiCaXLPCNL').val();
        var nhaCC = $('#nhaCCXLPCNL').val();
        var maThanhPham = $('#maThanhPhamXLPCNL').val();
        var maLo = $('#maLoXLPCNL').val();
        var maSize = $('#maSizeXLPCNL').val();
        var maPhuongTien = $('#maPhuongTienXLPCNL').val();
        var maMau = $('#maMauXLPCNL').val();
        var maAo = $('#maAoXLPCNL').val();
        var maBanCatTiet = $('#maBanCatTietXLPCNL').val();
        var suDung = $('#suDungXLPCNL').prop('checked');
        var trongLuong = $('#trongLuongXLPCNL').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/XuLyPhieuCan/DoInsert_NguyenLieu',
            data: {
                dateTime: dateTime,
                xuongId: xuongId,
                thoiGianCan: thoiGianCan,
                maLoaiCa: maLoaiCa,
                nhaCC: nhaCC,
                maThanhPham: maThanhPham,
                maLo: maLo,
                maSize: maSize,
                maPhuongTien: maPhuongTien,
                maMau: maMau,
                maAo: maAo,
                maBanCatTiet: maBanCatTiet,
                suDung: suDung,
                trongLuong: trongLuong,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadDataXLPCNL();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>

    function showUpdate() {
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        $.ajax({
            url: "/XuLyPhieuCan/GetsByMa_NguyenLieu",

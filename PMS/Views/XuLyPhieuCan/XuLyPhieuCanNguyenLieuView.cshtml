@using Newtonsoft.Json
@{
    ViewData["Title"] = "XuLyPhieuCanNguyenLieuView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    string khuVuc = "NGUYENLIEU";
    var XuongId = @Context.Session.GetString("XuongId");
    var listMaLoaiCas = ViewBag.listMaLoaiCas;
    var listNhaCCs = ViewBag.listNhaCCs;
    var listThanhPhams = ViewBag.listThanhPhams;
    var listMaLos = ViewBag.listMaLos;
    var listSFLs = ViewBag.listSFLs;
    var listPhuongTiens = ViewBag.listPhuongTiens;
    var listMaMaus = ViewBag.listMaMaus;
    var listMaAos = ViewBag.listMaAos;
    var BanCatTiets = ViewBag.BanCatTiets;
    var listXuongs = ViewBag.listXuongs;

}
<style>
    .displayValueNV {
        width: 100%; /* Thiết lập chiều rộng của combobox bằng 100% để nó lớn hơn và mở rộng ra toàn bộ kích thước của phần tử cha */
    }
    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: #d9dee3 !important;
        color: #697a8d !important;
        /*   font-weight: 400 !important;
                                                                                                                line-height: 1.53 !important; */
        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân Nguyên Liệu</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanNguyenLieu = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Nguyên Liệu" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanNguyenLieu != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanNguyenLieu = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Nguyên Liệu" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanNguyenLieu != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanNguyenLieu = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Nguyên Liệu" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanNguyenLieu != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Phiếu Cân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Thời Gian Cân</label>
                                    <input type="datetime-local" id="thoiGianCanXLPCNL" class="form-control form-control-lg" placeholder="Chọn ngày giờ..." />
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Loại Cá</label>
                                    <select id="maLoaiCaXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn loại cá</option>
                                        @foreach (var item in listMaLoaiCas)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhà Cung Cấp</label>
                                    <select id="nhaCCXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn nhà Cung Cấp</option>
                                        @foreach (var item in listNhaCCs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn thành phẩm</option>
                                        @foreach (var item in listThanhPhams)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Lô</label>
                                    <select id="maLoXLPCNL" class="form-control form-control-lg">

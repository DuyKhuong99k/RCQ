                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Phương Tiện</label>
                                    <select id="maPhuongTienXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn phương tiện</option>
                                        @foreach (var item in listPhuongTiens)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Màu</label>
                                    <select id="maMauXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn màu</option>
                                        @foreach (var item in listMaMaus)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Ao</label>
                                    <select id="maAoXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn ao</option>
                                        @foreach (var item in listMaAos)
                                        {
                                            <option value="@item.Item1">@item.Item1</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Bàn Cắt Tiết</label>
                                    <select id="maBanCatTietXLPCNL" class="form-control form-control-lg">
                                        <option value="">Chọn bàn cắt tiết</option>
                                        @foreach (var item in BanCatTiets)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4 ">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="suDungXLPCNL" />
                                        Sử Dụng
                                    </label>
                                </div>

                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng</label>
                                    <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongXLPCNL" placeholder="0.000" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

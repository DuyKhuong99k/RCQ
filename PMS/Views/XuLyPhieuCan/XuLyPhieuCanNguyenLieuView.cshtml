        var maAo = $('#maAoXLPCNLSua').val();
        var maBanCatTiet = $('#maBanCatTietXLPCNLSua').val();
        var suDung = $('#suDungXLPCNLSua').prop('checked');
        var trongLuong = $('#trongLuongXLPCNLSua').val();
        var maMayTinhCan = $('#maMayTinhCanXLPCNLHHidden').val();
        var maUserCan = $('#maUserCanXLPCNLHHidden').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/XuLyPhieuCan/DoUpDate_NguyenLieu',
            data: {
                dateTime: dateTime,
                xuongId: xuongId,
                thoiGianCan: thoiGianCan,
                maLoaiCa: maLoaiCa,
                nhaCC: nhaCC,
                maThanhPham: maThanhPham,
                maLo: maLo,
                maSize: maSize,
                maPhuongTien: maPhuongTien,
                maMau: maMau,
                maAo: maAo,
                maBanCatTiet: maBanCatTiet,
                suDung: suDung,
                trongLuong: trongLuong,
                maMayTinhCan: maMayTinhCan,
                maUserCan: maUserCan
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadDataXLPCNL();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn xoá " + numRowSelect + " phiếu cân đang chọn!",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/XuLyPhieuCan/DoDelete_NguyenLieu',
                        data: { listInfoPhieuCan: selectedIdsString, dateTime: dateTime, xuongId: xuongId },
                        type: 'POST',
                        dataType: 'json',

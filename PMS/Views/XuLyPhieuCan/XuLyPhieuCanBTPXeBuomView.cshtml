                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanBTPXeBuom = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân BTP Xẻ Bướm" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân BTP Xẻ Bướm" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanBTPXeBuom != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanBTPXeBuom = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân BTP Xẻ Bướm" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân BTP Xẻ Bướm" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanBTPXeBuom != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanBTPXeBuom = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân BTP Xẻ Bướm" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân BTP Xẻ Bướm" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanBTPXeBuom != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

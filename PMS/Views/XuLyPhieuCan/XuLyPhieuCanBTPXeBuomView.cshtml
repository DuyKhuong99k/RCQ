    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                //alert(selectedIdsString);
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselectedMaMayTinhCan = deselectedRecords[i].MaMayTinhCan;
                let deselectedMaUserCan = deselectedRecords[i].MaUserCan;
                let deselectedThoiGianCan = deselectedRecords[i].ThoiGianCan;
                let deselectedTrongLuong = deselectedRecords[i].TrongLuong;
                //let deselectedNgay = deselectedRecords[i].Ngay;
                let deselectedId = deselectedMaMayTinhCan + "," + deselectedMaUserCan + "," + deselectedThoiGianCan + "," + deselectedTrongLuong;

                // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedId)) {
                    selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                    numRowSelect--; // Giảm số dòng đã chọn
                }
            }
        } else {
            // Nếu deselectedRecords không phải là một mảng
            let deselectedMaMayTinhCan = deselectedRecords.MaMayTinhCan;
            let deselectedMaUserCan = deselectedRecords.MaUserCan;
            let deselectedThoiGianCan = deselectedRecords.ThoiGianCan;
            let deselectedTrongLuong = deselectedRecords.TrongLuong;
            //let deselectedNgay = deselectedRecords.Ngay;
            let deselectedId = deselectedMaMayTinhCan + "," + deselectedMaUserCan + "," + deselectedThoiGianCan + "," + deselectedTrongLuong;

            // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedId)) {
                selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                numRowSelect--; // Giảm số dòng đã chọn
            }
            //alert(selectedIdsString);
        }
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
        //alert(selectedIdsString);
    }

    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
            filteredRecords.forEach(record => {
                selectedIdsString += record.MaMayTinhCan + ","; 
                selectedIdsString += record.MaUserCan + ","; 
                selectedIdsString += record.ThoiGianCan + ",";
                selectedIdsString += record.TrongLuong + "|";
                //selectedIdsString += record.Ngay + "|";
            });

            // Loại bỏ dấu | cuối cùng
            selectedIdsString = selectedIdsString.slice(0, -1);
            //alert(selectedIdsString);
            //alert(numRowSelect);
            return;
        }
        let selectedMaMayTinhCan = selectedRecords.MaMayTinhCan;
        let selectedMaUserCan = selectedRecords.MaUserCan;
        let selectedThoiGianCan = selectedRecords.ThoiGianCan;
        let selectedTrongLuong = selectedRecords.TrongLuong;
        //let selectedNgay = selectedRecords.Ngay;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedThoiGianCan)) {
            selectedIdsString += selectedMaMayTinhCan + ","; 
            selectedIdsString += selectedMaUserCan + ","; 
            selectedIdsString += selectedThoiGianCan + ",";
            selectedIdsString += selectedTrongLuong + "|";
            //selectedIdsString += selectedNgay + "|";

            numRowSelect++; // Tăng số dòng đã chọn
        }
        // Loại bỏ dấu | cuối cùng
        //selectedIdsString = selectedIdsString.slice(0, -1);
        //alert(selectedIdsString);
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    function reloadDataXLPCBTPXB() {
        var btnEle = document.getElementById('RefreshButtonXLPC');
        var btn = btnEle.ej2_instances[0];

        if (btnEle.classList.contains("loading")) return;
        btnEle.classList.add("loading");

        ClearData("Grid");

        var originalContent = btn.content;

        var dots = 0;
        btn.content = "Đang tải";
        var loadingInterval = setInterval(function () {
            dots = (dots + 1) % 4;
            btn.content = "Đang tải" + ".".repeat(dots);
        }, 500);


        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        var typeValue = "@khuVuc";
        $.ajax({
            url: "@Url.Action("Reload", "XuLyPhieuCan")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeValue: typeValue },
            success: function (response) {
                if (response.Success) {
                    creatTable(response.Data);
                } else {
                    creatTable();
                    console.error(response.Messages);
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        }).always(function () {
            clearInterval(loadingInterval);
            btn.content = originalContent;
            // btn.disabled = false;
            btnEle.classList.remove("loading");
        });
    }
    document.getElementById('RefreshButtonXLPC').addEventListener("click", function () {
        reloadDataXLPCBTPXB();
    });
</script>
<script>

    function onfiltering(e) {
        var query = new ej.data.Query().select(['Name', 'MaNhanVien', 'DeptName0']); // Chỉ lấy 100 phần tử đầu tiên
        var predicateQuery = query.where(new ej.data.Predicate('MaNhanVien', 'contains', e.text, true).or('Name', 'contains', e.text, true));
        query = (e.text !== '') ? predicateQuery : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(@ViewBag.DataNhanVien)), query);
        isCheckScroll.call(this);
    }

    function onComboBoxOpen(args) {
        var comboBox = args.popup; // Lấy popup của combobox
        if (comboBox) {
            // Kiểm tra nếu dataSource tồn tại
            if (comboBox.dataSource) {
                // Chỉ hiển thị 10 phần tử đầu tiên
                comboBox.dataSource = comboBox.dataSource.slice(0, 10);
            }
        }
    }

    function isCheckScroll() {
        if (this.popupObj && this.popupObj.element && this.liCollections.length > 0) {
            var offsetHeight = this.popupObj.element.querySelector('.e-content').offsetHeight;
            var contentHeight = offsetHeight < this.liCollections[0].offsetHeight * this.liCollections.length;
            if (contentHeight || offsetHeight === 0) {
                this.popupObj.element.classList.add('e-scroller');
            } else {
                this.popupObj.element.classList.remove('e-scroller');
            }
        }
    }

</script>
<script>
    function getCurrentTime() {
        let now = new Date();

        // Lấy các thành phần giờ, phút, giây và mili giây
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');
        let milliseconds = String(now.getMilliseconds()).padStart(7, '0');

        // Định dạng thời gian theo yêu cầu
        let currentTime = `${hours}:${minutes}:${seconds}.${milliseconds}`;

        return currentTime;
    }
    function setFormattedTime(timeString) {
        // Chuyển đổi chuỗi thời gian sang đối tượng Date
        var time = new Date("1970-01-01T" + timeString);

        // Lấy giờ và phút
        var hours = time.getHours().toString().padStart(2, '0');
        var minutes = time.getMinutes().toString().padStart(2, '0');
        var seconds = time.getSeconds().toString().padStart(2, '0');

        // Định dạng lại chuỗi thời gian
        var formattedTime = hours + ":" + minutes + ":" + seconds;

        return formattedTime;
    }

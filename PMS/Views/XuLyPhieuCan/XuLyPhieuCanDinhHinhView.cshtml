@using Newtonsoft.Json
@{
    ViewData["Title"] = "XuLyPhieuCanDinhHinhView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    string khuVuc = "DINHHINH";
    var listMaLos = ViewBag.listMaLos;
    var listMaLoaiCas = ViewBag.listMaLoaiCas;
    var listThanhPhams = ViewBag.listThanhPhams;
    var listSFLs = ViewBag.listSFLs;
    var listMaMaus = ViewBag.listMaMaus;
    var listMayLangDas = ViewBag.listMayLangDas;
    var listXuongs = ViewBag.listXuongs;
}
<style>
    /* CSS */
    #modalThem .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    #modalSua .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    .displayValueNV {
        width: 100%; /* Thiết lập chiều rộng của combobox bằng 100% để nó lớn hơn và mở rộng ra toàn bộ kích thước của phần tử cha */
    }
    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: 1px solid #d9dee3 !important;
        color: #697a8d !important;
        /*   font-weight: 400 !important;
                                                    line-height: 1.53 !important; */
        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân Định Hình</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanDinhHinh = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanDinhHinh != null)
                            {
                                    <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanDinhHinh = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanDinhHinh != null)
                            {
                                    <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanDinhHinh = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanDinhHinh != null)
                            {
                                    <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importPhieuCanDinhHinh = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Func == "Import Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Status == 1).FirstOrDefault();
                            if (importPhieuCanDinhHinh != null)
                            {
                                    <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportPhieuCanDinhHinh = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Func == "Export Xử Lý Phiếu Cân / Phiếu Cân Định Hình" && x.Status == 1).FirstOrDefault();
                            if (exportPhieuCanDinhHinh != null)
                            {
                                    <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Phiếu Cân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Giờ</label>
                                    <input type="time" id="gioXLPCDH" class="form-control form-control-lg" placeholder="Chọn giờ..." />
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Lô</label>
                                    <select id="maLoXLPCDH" class="form-control form-control-lg">
                                        <option value="">Chọn lô</option>
                                        @foreach (var item in listMaLos)
                                        {
                                            <option value="@item.Item2">@item.Item2</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Loại Cá</label>
                                    <select id="maLoaiCaXLPCDH" class="form-control form-control-lg">
                                        <option value="">Chọn loại cá</option>
                                        @foreach (var item in listMaLoaiCas)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamXLPCDH" class="form-control form-control-lg">
                                        <option value="">Chọn thành phẩm</option>
                                        @foreach (var item in listThanhPhams)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Size</label>
                                    <select id="maSizeXLPCDH" class="form-control form-control-lg">
                                        <option value="">Chọn size</option>
                                        @foreach (var item in listSFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Màu</label>
                                    <select id="maMauXLPCDH" class="form-control form-control-lg">
                                        <option value="">Chọn màu</option>
                                        @foreach (var item in listMaMaus)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên</label>
                                    @* <input type="text" class="form-control form-control-lg displayValueNV" id="displayValueNV" /> *@
                                    <ejs-combobox id="employees"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@ViewBag.DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 75px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên Phục Vụ</label>
                                    @* <input class="form-control form-control-lg" id="maNhanVienXLPCDH" placeholder="Chọn nhân viên PV" /> *@
                                    <ejs-combobox id="maNhanVienXLPCDH"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@ViewBag.DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 75px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                            

                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng Nhận</label>
                                    <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongNhanXLPCDH" placeholder="0.000" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Định Mức</label>
                                    <input type="number" min="0" step=".001" class="form-control form-control-lg" id="dinhMucXLPCDH" placeholder="0.000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4 list-group">
                                <label class="">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="caTraXLPCDH" />
                                    Cá Trả
                                </label>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Máy Lạng Da</label>
                                    <select id="maMayLangDaXLPCDH" class="form-control form-control-lg">
                                        <option>Chọn máy lạng da</option>
                                        @foreach (var item in listMayLangDas)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

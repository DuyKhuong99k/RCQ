    var grid;
    function creatTable(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
           
            var contextMenuItems = [ 
                { text: 'Xem ghi chú', id: 'viewNote' },
                { text: 'Chuyển xưởng', id: 'changeDepartment' },
                { text: 'Chuyển size', id: 'changeSize' },
                { text: 'Chuyển thành phẩm', id: 'changeThanhPham' },
            ];
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 500 },
                allowSelection: true,
                allowFiltering: true,
                allowSorting: true,
                allowResizing: true,
                //enableVirtualization: true,
                //loadingIndicator: { indicatorType: 'Shimmer' },
                filterSettings: { type: 'Excel' },
                //selectionSettings: { persistSelection: true, type: "Multiple", checkboxOnly: true },
                selectionSettings: { persistSelection: true },
                rowSelected: selectionChanged,
                rowDeselected: unSelectionChanged,
                height: 400,
                contextMenuItems: contextMenuItems,
                contextMenuClick: contextMenuClickHandler,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'STT', headerText: 'STT_TP', width: 150 },
                    { field: 'Gio', headerText: 'Giờ_TP', width: 150 },
                    { field: 'STTBTP', headerText: 'STT_BTP', width: 150 },
                    { field: 'GioBTP', headerText: 'Giờ_BTP', width: 150 },
                    { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                    { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                    { field: 'MaNhanVienPhucVuBtp', headerText: 'Mã NV PV', width: 150 },
                    { field: 'MaHoSoPhucVuBtp', headerText: 'Mã Số PV', width: 150 },
                    { field: 'NhanVienNamePhucVuBtp', headerText: 'Tên Nhân Viên PV', width: 150 },
                    { field: 'XuongName', headerText: 'Xưởng Gốc', width: 150 },
                    { field: 'MaThe', headerText: 'Mã Thẻ', width: 150 },
                    { field: 'TrongLuongNhan', headerText: 'Trọng Lượng Nhận', type: 'number', width: 150 },
                    { field: 'TrongLuongTra', headerText: 'Trọng Lượng Trả', type: 'number', width: 150 },
                    { field: 'TrongLuongTare', headerText: 'TL Tare TP', type: 'number', width: 150 },
                    { field: 'TrongLuongBu', headerText: 'TL Bù', type: 'number', width: 150 },
                    { field: 'DinhMucThucTe', headerText: 'ĐM Thực', type: 'number', width: 150 },
                    { field: 'DinhMucYeuCau', headerText: 'ĐM Yêu Cầu', type: 'number', width: 150 },
                    { field: 'LoName', headerText: 'Lô', width: 150 },
                    { field: 'LoaiCaName', headerText: 'Loại Cá', width: 150 },
                    { field: 'SizeName', headerText: 'Size', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'MaMayLangDa', headerText: 'Máy Lạng Da', width: 150 },
                    { field: 'MayTP', headerText: 'Máy TP', width: 150 },
                    { field: 'MayBTP', headerText: 'Máy BTP', width: 150 },
                    { field: 'CaTra', headerText: 'Cá Trả', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'ChiSanLuong', headerText: 'Chỉ SL', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    //{ field: 'GhiChu', headerText: 'Ghi Chú', width: 150 },
                ],
                aggregates: [{
                    columns: [{
                        type: 'Sum',
                        field: 'TrongLuongNhan',
                        //format: '0,000',
                        footerTemplate: 'Tổng TL Nhận: ${Sum} Kg'
                    },
                    {
                        type: 'Sum',
                        field: 'TrongLuongTra',
                        format: 'N2', // Format số
                        footerTemplate: 'Tổng TL Trả: ${Sum} Kg'
                    }]
                }]
            });
            grid.appendTo('#Grid');
        }
    }

    creatTable();
    function contextMenuClickHandler(args) {
        var rowData = args.rowInfo.rowData;
        if (rowData) {
            switch (args.item.id) {
                case 'viewNote':
                    var ghiChu = rowData.GhiChu;
                    if (ghiChu) {
                        // Thay thế dấu phẩy bằng thẻ <br> để tạo xuống hàng
                        ghiChu = ghiChu.replace(/,/g, '<br>');
                        bootbox.alert({
                            title: "Ghi chú",
                            message: ghiChu,
                            callback: function () { }
                        });
                    } else {
                        bootbox.alert("Không có ghi chú nào cho hàng này.");
                    }
                    break;
                case 'changeDepartment':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenXLPC",
                        data: { typeOption: "CHUYENXUONG" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển xưởng của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenXuong').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });
                    
                    break;
                case 'changeSize':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenXLPC",
                        data: { typeOption: "CHUYENSIZE" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển sỉze của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenSize').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });
                    
                    break;
                case 'changeThanhPham':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenXLPC",
                        data: { typeOption: "CHUYENTHANHPHAM" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển thành phẩm của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenThanhPham').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });
                   
                    break;
                default:
                    break;
            }
        }
    }


    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                //alert(selectedIdsString);
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselectedSTT = deselectedRecords[i].STT;
                let deselectedMaNhanVien = deselectedRecords[i].MaNhanVien;
                let deselectedMaMayCan = deselectedRecords[i].MayTP;
                let deselectedMaXuong = deselectedRecords[i].MaXuong;
                let deselectedSTTBTP = deselectedRecords[i].STTBTP;
                let deselectedMayBTP = deselectedRecords[i].MayBTP;
                let deselectedId = deselectedMaNhanVien + "," + deselectedSTT + "," + deselectedMaMayCan + "," + deselectedMaXuong + "," + deselectedSTTBTP + "," + deselectedMayBTP;

                // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedId)) {
                    selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                    numRowSelect--; // Giảm số dòng đã chọn
                }
            }
        } else {
            // Nếu deselectedRecords không phải là một mảng
            let deselectedSTT = deselectedRecords.STT;
            let deselectedMaNhanVien = deselectedRecords.MaNhanVien;
            let deselectedMaMayCan = deselectedRecords.MayTP;
            let deselectedMaXuong = deselectedRecords.MaXuong;
            let deselectedSTTBTP = deselectedRecords.STTBTP;
            let deselectedMayBTP = deselectedRecords.MayBTP;
            let deselectedId = deselectedMaNhanVien + "," + deselectedSTT + "," + deselectedMaMayCan + "," + deselectedMaXuong + "," + deselectedSTTBTP + "," + deselectedMayBTP;

            // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedId)) {
                selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                numRowSelect--; // Giảm số dòng đã chọn
            }
            //alert(selectedIdsString);
        }
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }

    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
            filteredRecords.forEach(record => {
                selectedIdsString += record.MaNhanVien + ","; // Thêm Mã Nhân viên vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.STT + ","; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.MayTP + ","; // Thêm MayTP vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.MaXuong + ",";
                selectedIdsString += record.STTBTP + ",";
                selectedIdsString += record.MayBTP + "|";// Thêm MaXuong vào chuỗi, phân tách bằng dấu chấm than, ngăn cách các bản ghi bằng dấu |
            });

            // Loại bỏ dấu | cuối cùng
            selectedIdsString = selectedIdsString.slice(0, -1);
            //alert(selectedIdsString);
            //alert(numRowSelect);
            return;
        }
        let selectedSTT = selectedRecords.STT;
        let selectedMaNhanVien = selectedRecords.MaNhanVien;
        let selectedMaMayCan = selectedRecords.MayTP;
        let selectedMaXuong = selectedRecords.MaXuong;
        let selectedSTTBTP = selectedRecords.STTBTP;
        let selectedMayBTP = selectedRecords.MayBTP;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedMaNhanVien)) {
            selectedIdsString += selectedMaNhanVien + ","; // Thêm MaNhanVien mới vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedSTT + ","; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedMaMayCan + ","; // Thêm MayTP vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedMaXuong + ","; // Thêm MaXuong vào chuỗi, phân tách bằng dấu chấm than, ngăn cách các bản ghi bằng dấu |
            selectedIdsString += selectedSTTBTP + ",";
            selectedIdsString += selectedMayBTP + "|";
            numRowSelect++; // Tăng số dòng đã chọn
        }
        // Loại bỏ dấu | cuối cùng
        //selectedIdsString = selectedIdsString.slice(0, -1);

        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }
    function reloadDataXLPCDH() {
        var btn = document.getElementById('RefreshButtonXLPC').ej2_instances[0];
        var content = btn.content;
        btn.content = "Đang Tải ...";
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        var typeValue = "@khuVuc";
        $.ajax({
            url: "@Url.Action("Reload", "XuLyPhieuCan")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeValue: typeValue },
            success: function (response) {
                if (response.Success) {
                    creatTable(response.Data);
                } else {
                    creatTable(response.Data);
                    console.error(response.Messages);
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        }).always(function () {
            btn.content = content;
        });
    }
    document.getElementById('RefreshButtonXLPC').addEventListener("click", function () {
        reloadDataXLPCDH();
    });
</script>
<script>

    function onfiltering(e) {
        var query = new ej.data.Query().select(['Name', 'MaNhanVien', 'DeptName0']); // Chỉ lấy 100 phần tử đầu tiên
        var predicateQuery = query.where(new ej.data.Predicate('MaNhanVien', 'equal', e.text, true).or('Name', 'equal', e.text, true));
        query = (e.text !== '') ? predicateQuery : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(@ViewBag.DataNhanVien)), query);
        isCheckScroll.call(this);
    }

    function onComboBoxOpen(args) {
        var comboBox = args.popup; // Lấy popup của combobox
        if (comboBox) {
            // Kiểm tra nếu dataSource tồn tại
            if (comboBox.dataSource) {
                // Chỉ hiển thị 10 phần tử đầu tiên
                comboBox.dataSource = comboBox.dataSource.slice(0, 10);
            }
        }
    }

    function isCheckScroll() {
        if (this.popupObj && this.popupObj.element && this.liCollections.length > 0) {
            var offsetHeight = this.popupObj.element.querySelector('.e-content').offsetHeight;
            var contentHeight = offsetHeight < this.liCollections[0].offsetHeight * this.liCollections.length;
            if (contentHeight || offsetHeight === 0) {
                this.popupObj.element.classList.add('e-scroller');
            } else {
                this.popupObj.element.classList.remove('e-scroller');
            }
        }
    }

</script>
<script>
    function getCurrentTime() {
        let now = new Date();

        // Lấy các thành phần giờ, phút, giây và mili giây
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');
        let milliseconds = String(now.getMilliseconds()).padStart(7, '0');

        // Định dạng thời gian theo yêu cầu
        let currentTime = `${hours}:${minutes}:${seconds}.${milliseconds}`;

        return currentTime;
    }
    function setFormattedTime(timeString) {
        // Chuyển đổi chuỗi thời gian sang đối tượng Date
        var time = new Date("1970-01-01T" + timeString);

        // Lấy giờ và phút
        var hours = time.getHours().toString().padStart(2, '0');
        var minutes = time.getMinutes().toString().padStart(2, '0');
        var seconds = time.getSeconds().toString().padStart(2, '0');

        // Định dạng lại chuỗi thời gian
        var formattedTime = hours + ":" + minutes;

        return formattedTime;
    }

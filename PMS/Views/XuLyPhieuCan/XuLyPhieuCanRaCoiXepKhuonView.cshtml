                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Chất Lượng</label>
                                    <select id="maChatLuongXLPCRCXK" class="form-control form-control-lg">
                                        <option value="">Chọn chất lượng</option>
                                        @foreach (var item in listChatLuongs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Cối</label>
                                    <select id="maCoiXLPCRCXK" class="form-control form-control-lg">
                                        <option value="">Chọn cối</option>
                                        @foreach (var item in listCoiChinhs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>


                        </div>
                        <div class="row">

                            <div class="col-md-8 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên</label>
                                    @* <input class="form-control form-control-lg" id="maNhanVienXLPCRCXK" placeholder="Chọn nhân viên" /> *@
                                    <ejs-combobox id="maNhanVienXLPCRCXK"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 150px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 150px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng</label>
                                    <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongXLPCRCXK" placeholder="0.000" />
                                </div>
                            </div>
                        </div>
                        <div class="row"> 
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Phụ Trội</label>
                                    <input type="number" min="0" step=".01" class="form-control form-control-lg" id="thamSoTangTrongXLPCRCXK" placeholder="0.00" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

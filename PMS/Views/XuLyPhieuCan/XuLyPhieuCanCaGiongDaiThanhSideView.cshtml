                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        var ngayTai = $('#ngayTaiXLPCCGVNDTS').val();
        var gioTai = $('#gioTaiXLPCCGVNDTS').val();
        var trongLuong = $('#trongLuongXLPCCGVNDTS').val();
        var tenAo = $('#tenAoXLPCCGVNDTS').val();
        var tenChuAo = $('#tenChuAoXLPCCGVNDTS').val();
        var tenCongDoan = $('#tenCongDoanXLPCCGVNDTS').val();
        var tenThongKeDauAo = $('#tenThongKeDauAoXLPCCGVNDTS').val();
        var maLoaiCaVungNuoi = $('#maLoaiCaVungNuoiXLPCCGVNDTS').val();
        var tenLoaiCa = $('#maLoaiCaVungNuoiXLPCCGVNDTS option:selected').text();
        var maGhe = $('#maGheXLPCCGVNDTS').val();
        var maMayCan = $('#maMayCanXLPCCGVNDTS').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/XuLyPhieuCan/DoInsert_CaGiongVungNuoiDaiThanhSide',
            data: {
                dateTime: dateTime,
                xuongId: xuongId,
                ngayTai: ngayTai,
                gioTai: gioTai,
                trongLuong: trongLuong,
                tenAo: tenAo,
                tenChuAo: tenChuAo,
                tenCongDoan: tenCongDoan,
                tenThongKeDauAo: tenThongKeDauAo,
                maLoaiCaVungNuoi: maLoaiCaVungNuoi,
                tenLoaiCa: tenLoaiCa,
                maGhe: maGhe,
                maMayCan: maMayCan,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadDataXLPCCGVNDTS();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>

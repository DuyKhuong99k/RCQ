@using Newtonsoft.Json
@{
    ViewData["Title"] = "XuLyPhieuCanCaGiongDaiThanhSideView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    string khuVuc = "CAGIONGVUNGNUOIDAITHANHSIDE";
    var listMaLos = ViewBag.listMaLos;
    var listMaLoaiCas = ViewBag.listMaLoaiCas;
    var listPhuongTiens = ViewBag.listPhuongTiens;
}

<style>
    .displayValueNV {
        width: 100%; /* Thiết lập chiều rộng của combobox bằng 100% để nó lớn hơn và mở rộng ra toàn bộ kích thước của phần tử cha */
    }
    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: #d9dee3 !important;
        color: #697a8d !important;
        /*   font-weight: 400 !important;
                                                                                                            line-height: 1.53 !important; */
        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân Cá Giống Vùng Nuôi Đại Thành Side</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanCaGiongVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanCaGiongVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanCaGiongVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanCaGiongVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanCaGiongVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanCaGiongVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importPhieuCanCaGiongVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Import Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (importPhieuCanCaGiongVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportPhieuCanCaGiongVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Export Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (exportPhieuCanCaGiongVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

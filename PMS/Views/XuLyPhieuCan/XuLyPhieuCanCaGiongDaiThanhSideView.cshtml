<script>
    // $(document).ready(function () {
    //     loadGridData();
    // });
    let selectedIdsString = ""; // Khai báo một chuỗi để lưu trữ MaNhanVien đã chọn
    let numRowSelect = 0;
    var grid;
    function creatTable(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {

            var contextMenuItems = [
                { text: 'Xem ghi chú', id: 'viewNote' },
                // { text: 'Chuyển xưởng', id: 'changeDepartment' },
                // { text: 'Chuyển size', id: 'changeSize' },
                // { text: 'Chuyển thành phẩm', id: 'changeThanhPham' },
            ];
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 500 },
                allowSelection: true,
                allowFiltering: true,
                allowSorting: true,
                allowResizing: true,
                //enableVirtualization: true,
                //loadingIndicator: { indicatorType: 'Shimmer' },
                filterSettings: { type: 'Excel' },
                //selectionSettings: { persistSelection: true, type: "Multiple", checkboxOnly: true },
                selectionSettings: { persistSelection: true },
                rowSelected: selectionChanged,
                rowDeselected: unSelectionChanged,
                height: 400,
                contextMenuItems: contextMenuItems,
                contextMenuClick: contextMenuClickHandler,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150 },
                    { field: 'Gio', headerText: 'Giờ', width: 150 },
                    { field: 'NgayTai', headerText: 'Ngày Tải', width: 150 },
                    { field: 'GioTai', headerText: 'Giờ Tải', width: 150 },
                    { field: 'MaUserCan', headerText: 'Người Cân', width: 150 },
                    { field: 'LoaiCaVungNuoiName', headerText: 'Loại Cá', width: 150 },
                    { field: 'PhuongTienName', headerText: 'Ghe', width: 150 },
                    { field: 'TenAo', headerText: 'Ao', width: 150 },
                    { field: 'TenChuAo', headerText: 'Chủ Ao', width: 150 },
                    { field: 'TenCongDoan', headerText: 'Công Đoạn', width: 150 },
                    { field: 'TenThongKeDauAo', headerText: 'Thống Kê', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                    { field: 'MaMayCan', headerText: 'Mã Máy Cân', width: 150 },
                    { field: 'BiosId', headerText: 'BiosId', width: 150 },
                ],
                aggregates: [{
                    columns: [{
                        type: 'Sum',
                        field: 'TrongLuong',
                        format: 'N2',
                        footerTemplate: 'Tổng TL: ${Sum} Kg'
                    }]
                }]
            });
            grid.appendTo('#Grid');
        }
    }

    creatTable();
    function contextMenuClickHandler(args) {
        var rowData = args.rowInfo.rowData;
        if (rowData) {
            switch (args.item.id) {
                case 'viewNote':
                    var ghiChu = rowData.GhiChu;
                    if (ghiChu) {
                        // Thay thế dấu phẩy bằng thẻ <br> để tạo xuống hàng
                        ghiChu = ghiChu.replace(/,/g, '<br>');
                        bootbox.alert({
                            title: "Ghi chú",
                            message: ghiChu,
                            callback: function () { }
                        });
                    } else {
                        bootbox.alert("Không có ghi chú nào cho hàng này.");
                    }
                    break;
                case 'changeDepartment':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenFillet",
                        data: { typeOption: "CHUYENXUONG" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển xưởng của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenXuong').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });

                    break;
                case 'changeSize':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenFillet",
                        data: { typeOption: "CHUYENSIZE" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển sỉze của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenSize').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });

                    break;
                case 'changeThanhPham':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenFillet",
                        data: { typeOption: "CHUYENTHANHPHAM" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển thành phẩm của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenThanhPham').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });

                    break;
                default:
                    break;
            }
        }
    }


    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được bỏ chọn

        // Kiểm tra xem deselectedRecords có phải là một mảng không
        if (Array.isArray(deselectedRecords)) {
            // Nếu là một mảng rỗng hoặc không tồn tại
            if (deselectedRecords.length === 0) {
                selectedIdsString = "";
                numRowSelect = 0; // Reset số dòng đã chọn
                //alert(selectedIdsString);
                return;
            }
            // Lặp qua từng bản ghi được bỏ chọn
            for (let i = 0; i < deselectedRecords.length; i++) {
                let deselectedSTT = deselectedRecords[i].STT;
                let deselectedMaMayCan = deselectedRecords[i].MaMayCan;
                let deselectedBiosId = deselectedRecords[i].BiosId;
                let deselectedId = deselectedSTT + "," + deselectedMaMayCan + "," + deselectedBiosId;

                // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
                if (selectedIdsString.includes(deselectedId)) {
                    selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                    numRowSelect--; // Giảm số dòng đã chọn
                }
            }
        } else {
            // Nếu deselectedRecords không phải là một mảng
            let deselectedSTT = deselectedRecords.STT;
            let deselectedMaMayCan = deselectedRecords.MaMayCan;
            let deselectedBiosId = deselectedRecords.BiosId;
            let deselectedId = deselectedSTT + "," + deselectedMaMayCan + "," + deselectedBiosId;

            // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
            if (selectedIdsString.includes(deselectedId)) {
                selectedIdsString = selectedIdsString.replace(deselectedId + "|", ""); // Loại bỏ MaNhanVien khỏi chuỗi
                numRowSelect--; // Giảm số dòng đã chọn
            }
            //alert(selectedIdsString);
        }
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }

    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            numRowSelect = filteredRecords.length; // Cập nhật số dòng đã chọn
            filteredRecords.forEach(record => {
                selectedIdsString += record.STT + ","; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.MaMayCan + ","; // Thêm MayTP vào chuỗi, phân tách bằng dấu phẩy
                selectedIdsString += record.BiosId + "|";
            });

            // Loại bỏ dấu | cuối cùng
            selectedIdsString = selectedIdsString.slice(0, -1);
            //alert(selectedIdsString);
            //alert(numRowSelect);
            return;
        }
        let selectedSTT = selectedRecords.STT;
        let selectedMaMayCan = selectedRecords.MaMayCan;
        let selectedBiosId = selectedRecords.BiosId;

        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedSTT)) {
            selectedIdsString += selectedSTT + ","; // Thêm STT vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedMaMayCan + ","; // Thêm MayTP vào chuỗi, phân tách bằng dấu phẩy
            selectedIdsString += selectedBiosId + "|"; // Thêm MaXuong vào chuỗi, phân tách bằng dấu chấm than, ngăn cách các bản ghi bằng dấu |

            numRowSelect++; // Tăng số dòng đã chọn
        }
        // Loại bỏ dấu | cuối cùng
        //selectedIdsString = selectedIdsString.slice(0, -1);
        //alert(selectedIdsString);
        // Hiển thị số dòng đã chọn nếu cần
        //alert(numRowSelect);
    }
    function reloadDataXLPCCGVNDTS() {
        var btn = document.getElementById('RefreshButtonXLPC').ej2_instances[0];
        var content = btn.content;
        btn.content = "Đang Tải ...";
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        var typeValue = "@khuVuc";
        $.ajax({
            url: "@Url.Action("Reload", "XuLyPhieuCan")",
            type: "GET",
            data: { dateTime: dateTime, xuongId: xuongId, typeValue: typeValue },
            success: function (response) {
                if (response.Success) {
                    creatTable(response.Data);
                } else {
                    creatTable(response.Data);
                    console.error(response.Messages);
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }
        }).always(function () {
            btn.content = content;
        });
    }
    document.getElementById('RefreshButtonXLPC').addEventListener("click", function () {
        reloadDataXLPCCGVNDTS();
    });
</script>
<script>
    function getCurrentTime() {
        let now = new Date();

        // Lấy các thành phần giờ, phút, giây và mili giây
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');
        let milliseconds = String(now.getMilliseconds()).padStart(7, '0');

        // Định dạng thời gian theo yêu cầu
        let currentTime = `${hours}:${minutes}:${seconds}.${milliseconds}`;

        return currentTime;
    }
    function setFormattedTime(timeString) {
        // Chuyển đổi chuỗi thời gian sang đối tượng Date
        var time = new Date("1970-01-01T" + timeString);

        // Lấy giờ và phút
        var hours = time.getHours().toString().padStart(2, '0');
        var minutes = time.getMinutes().toString().padStart(2, '0');
        var seconds = time.getSeconds().toString().padStart(2, '0');

        // Định dạng lại chuỗi thời gian
        var formattedTime = hours + ":" + minutes;

        return formattedTime;
    }
    function getCurrentDate() {
        let now = new Date();

        // Lấy các thành phần ngày, tháng, năm
        let year = now.getFullYear();
        let month = String(now.getMonth() + 1).padStart(2, '0'); // Tháng bắt đầu từ 0
        let day = String(now.getDate()).padStart(2, '0');

        // Định dạng ngày theo yêu cầu
        let currentDate = `${year}-${month}-${day}`;

        return currentDate;
    }
    function setDateInput(datestring) {
        // Chuyển đổi datestring thành định dạng yyyy-mm-dd
        let date = new Date(datestring);
        let year = date.getFullYear();
        let month = ("0" + (date.getMonth() + 1)).slice(-2); // Tháng bắt đầu từ 0 nên cần +1
        let day = ("0" + date.getDate()).slice(-2);

        // Tạo chuỗi ngày theo định dạng yyyy-mm-dd
        let formattedDate = `${year}-${month}-${day}`;

        // Gán giá trị này cho input
        return formattedDate;
    }


                    <h2 class="mb-0">Phiếu Cân Phụ Phẩm v2</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanPhuPhamv2 = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanPhuPhamv2 != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanPhuPhamv2 = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanPhuPhamv2 != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanPhuPhamv2 = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanPhuPhamv2 != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importPhieuCanPhuPhamv2 = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Func == "Import Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Status == 1).FirstOrDefault();
                            if (importPhieuCanPhuPhamv2 != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportPhieuCanPhuPhamv2 = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Func == "Export Xử Lý Phiếu Cân / Phiếu Cân Phụ Phẩm v2" && x.Status == 1).FirstOrDefault();
                            if (exportPhieuCanPhuPhamv2 != null)
                            {

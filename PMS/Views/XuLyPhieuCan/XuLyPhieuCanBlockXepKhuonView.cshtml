                                    <label class="form-label">Màu</label>
                                    <select id="maMauXLPCXKBL" class="form-control form-control-lg">
                                        <option value="">Chọn màu</option>
                                        @foreach (var item in listMaus)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }

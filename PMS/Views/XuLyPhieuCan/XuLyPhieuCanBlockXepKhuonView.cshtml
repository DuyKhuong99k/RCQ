@using Newtonsoft.Json
@{
    ViewData["Title"] = "XuLyPhieuCanBlockXepKhuonView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    string khuVuc = "XEPKHUONBLOCK";
    var listMaLos = ViewBag.listMaLos;
    var listThanhPhams = ViewBag.listThanhPhams;
    var listSFLs = ViewBag.listSFLs;
    var listMaKhachHangs = ViewBag.listMaKhachHangs;
    var listChatLuongs = ViewBag.listChatLuongs;
    var listNets = ViewBag.listNets;
    var listChieuXas = ViewBag.listChieuXas;
    var listMaus = ViewBag.listMaus;
    var listCongDoans = ViewBag.listCongDoans;
    var DataNhanVien = ViewBag.DataNhanVien;
    var listXuongs = ViewBag.listXuongs;
}
<style>
    /* CSS */
    #modalThem .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    #modalSua .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    .displayValueNV {
        width: 100%; /* Thiết lập chiều rộng của combobox bằng 100% để nó lớn hơn và mở rộng ra toàn bộ kích thước của phần tử cha */
    }
    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: 1px solid #d9dee3 !important;
        color: #697a8d !important;
        /*   font-weight: 400 !important;
                                                                                                                                                line-height: 1.53 !important; */
        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }

    div#inputpicker-wrapped-list.inputpicker-wrapped-list {
        width: 500px !important;
        max-height: 400px !important;
    }

    @@media (max-width: 768px) {
        div#inputpicker-wrapped-list.inputpicker-wrapped-list {
            width: 244px !important;
            max-height: 400px !important;
        }
    }

    .inputpicker-wrapped-list .inputpicker-active {
        background-color: #C0C0C0 !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân Block Xếp Khuôn</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanXepKhuonBlock = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanXepKhuonBlock != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanXepKhuonBlock = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanXepKhuonBlock != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanXepKhuonBlock = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanXepKhuonBlock != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importPhieuCanXepKhuonBlock = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Func == "Import Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (importPhieuCanXepKhuonBlock != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportPhieuCanXepKhuonBlock = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Func == "Export Xử Lý Phiếu Cân / Phiếu Cân Block Xếp Khuôn" && x.Status == 1).FirstOrDefault();
                            if (exportPhieuCanXepKhuonBlock != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Phiếu Cân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">STT</label>
                                    <input type="text" id="sttXLPCXKBL" class="form-control form-control-lg" disabled />
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Giờ</label>
                                    <input type="time" id="gioXLPCXKBL" class="form-control form-control-lg" placeholder="Chọn giờ..." disabled />
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Lô</label>
                                    <select id="maLoXLPCXKBL" class="form-control form-control-lg">
                                        <option value="">Chọn lô</option>
                                        @foreach (var item in listMaLos)
                                        {
                                            <option value="@item.Item2">@item.Item2</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamXLPCXKBL" class="form-control form-control-lg">
                                        <option value="">Chọn thành phẩm</option>
                                        @foreach (var item in listThanhPhams)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Size</label>
                                    <select id="maSizeXLPCXKBL" class="form-control form-control-lg">
                                        <option value="">Chọn size</option>
                                        @foreach (var item in listSFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Chất Lượng</label>
                                    <select id="maChatLuongXLPCXKBL" class="form-control form-control-lg">
                                        <option value="">Chọn chất lượng</option>
                                        @foreach (var item in listChatLuongs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">

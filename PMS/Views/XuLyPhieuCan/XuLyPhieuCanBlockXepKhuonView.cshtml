                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Công Đoạn</label>
                                    <select id="maCongDoanXLPCXKBL" class="form-control form-control-lg">
                                        <option value="">Chọn công đoạn</option>
                                        @foreach (var item in listCongDoans)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Mã Máy Cân</label>
                                    <input type="text" class="form-control form-control-lg" id="maMayCanXLPCXKBL" placeholder="Nhập mã máy cân" disabled />
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên</label>
                                    @* <input class="form-control form-control-lg" id="maNhanVienXLPCXKBL" placeholder="Chọn nhân viên" /> *@
                                    <ejs-combobox id="maNhanVienXLPCXKBL"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 75px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng</label>
                                    <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongXLPCXKBL" placeholder="0.000" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

            //alert(selectedIdsString);
            //alert(numRowSelect);
            return;
        }
        let selectedSTT = selectedRecords.STT;
        let selectedMaMayCan = selectedRecords.MaMayCan;
        let selectedMaXuong = selectedRecords.MaXuong;
        let selectedSTTBTP = selectedRecords.STTBTP;
        let selectedMaMayCanBTP = selectedRecords.MaMayCanBTP;
        let selectedThePhieuSanLuongId = selectedRecords.ThePhieuSanLuongId;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedThePhieuSanLuongId)) {

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân TP Fillet</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanTPFillet = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanTPFillet != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanTPFillet = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanTPFillet != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanTPFillet = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanTPFillet != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importPhieuCanTPFillet = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Func == "Import Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Status == 1).FirstOrDefault();
                            if (importPhieuCanTPFillet != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportPhieuCanTPFillet = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Func == "Export Xử Lý Phiếu Cân / Phiếu Cân Fillet" && x.Status == 1).FirstOrDefault();
                            if (exportPhieuCanTPFillet != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('maBanXLPCTPFLSua').addEventListener('change', function () {
        var maBan = this.value;
        loadDataNhanVienBanSua(maBan);
    });

    function loadDataNhanVienBanSua(maBan, idThePhieuSLFillet) {
        var maXuong = @XuongId;
        loadGridDataDeskStaffSua(maBan, idThePhieuSLFillet);
    }
    var gridDeskStaffSua;

    function loadGridDataDeskStaffSua(maBan, idThePhieuSLFillet) {
        $.ajax({
            url: '/XuLyPhieuCan/GetDanhSachNhanVienBanTrongLuongByThePhieuSLFillet',
            type: 'GET',
            data: {
                maBan: maBan,
                idThePhieuSLFillet: idThePhieuSLFillet
            },
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                // Kiểm tra xem Grid đã được tạo chưa
                if (gridDeskStaffSua) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    gridDeskStaffSua.dataSource = dataManager;
                    gridDeskStaffSua.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    gridDeskStaffSua = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 500 },
                        allowSelection: true,
                        allowFiltering: true,
                        allowSorting: true,
                        allowResizing: true,
                        filterSettings: { type: 'Excel' },
                        height: 200,
                        columns: [
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 100 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 70 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'BanName', headerText: 'Bàn', width: 70 },
                            {
                                // field: 'TrongLuongTra', headerText: 'TL Trả', width: 80, valueAccessor: function (field, data, column) {
                                //     var value = data[field];
                                //     return value != null && value !== '' ? value.toFixed(3) : '0.000';
                                // }
                                field: 'TrongLuongTra', headerText: 'TL Trả', width: 80, valueAccessor: function (field, data, column) {
                                    var value = data[field];
                                    return value != null && value !== '' ? parseFloat(value).toFixed(3) : '0.000';
                                }
                            }
                            // , // Chỉ cột này có thể chỉnh sửa
                            // {
                            //     headerText: 'Thay đổi TL Trả', width: 150,
                            //     template: '<input type="number" min = "0" step = ".001" class="e-input itemTrongLuongSua" style="width:100%" oninput="tongTrongLuongRaSua()" placeholder = "0.000"/>',
                            //     allowFiltering: false,
                            //     allowSorting: false
                            // }
                        ],

                        aggregates: [{
                            columns: [
                                // {
                                //     type: 'Custom',
                                //     footerTemplate: '<span id="totalFooterSua">Tổng: 0</span>'
                                // },
                                {
                                    type: 'Sum',
                                    field: 'TrongLuongTra',
                                    format: 'N2', // Format số
                                    footerTemplate: 'Tổng TL Trả: ${Sum}'
                                }
                            ]
                        }],
                        dataBound: function () {
                            // Lặp qua các hàng
                            for (var i = 0; i < this.getRows().length; i++) {
                                var rowData = this.getCurrentViewRecords()[i];
                                // Kiểm tra nếu giá trị TrongLuongTra không phải null hoặc rỗng
                                if (rowData.TrongLuongTra !== null && rowData.TrongLuongTra !== '') {
                                    // Lấy DOM element của hàng
                                    var rowElement = this.getRows()[i];
                                    // Đặt màu nền xám
                                    rowElement.style.backgroundColor = '#edea47'; // Hoặc màu xám khác tuỳ thích
                                }
                            }
                        },
                        actionComplete: function (args) {
                            if (args.requestType === 'save') {
                                // Cập nhật aggregates sau khi dữ liệu được lưu
                                this.aggregateModule.refresh(this);
                            }
                        }
                    });

                    gridDeskStaffSua.appendTo('#GridNhanVienTheoBanAndSetTrongLuongSua');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridDataDeskStaffSua();

    function tongTrongLuongRaSua() {
        // Lấy giá trị của input tổng
        const trongLuongYeuCauXLPCTPFL = parseFloat(document.getElementById('trongLuongYeuCauXLPCTPFLSua').value);
        const dinhMucXLPCTPFL = parseFloat(document.getElementById('dinhMucXLPCTPFLSua').value);
        if (dinhMucXLPCTPFL <= 0 || dinhMucXLPCTPFL == "" || dinhMucXLPCTPFL == undefined || dinhMucXLPCTPFL == null || isNaN(dinhMucXLPCTPFL)) {
            toastOptionNotyfi();
            toastr["warning"]("Bạn Chưa Nhập Định Mức!", "Thông báo");
            return;
        }
        // Lấy tất cả các phần tử input có class itemTrongLuong
        const inputElements = document.querySelectorAll('.itemTrongLuongSua');
        let total = 0;

        // Lặp qua các phần tử input và tính tổng các giá trị
        inputElements.forEach(inputElement => {
            const value = inputElement.value;
            const number = parseFloat(value);

            if (!isNaN(number)) {
                total += number;
            }
        });
        // Kiểm tra nếu tổng lớn hơn giá trị của input tổng
        if (total > trongLuongYeuCauXLPCTPFL) {
            document.getElementById('totalFooterSua').innerText = 'TTL Trả Thay Đổi: ' + total + ' > TL Yêu Cầu';
            document.getElementById('trongLuongNhanXLPCTPFLSua').style.color = 'red';
            document.getElementById('totalFooterSua').style.color = 'red';

        } else {
            document.getElementById('totalFooterSua').innerText = 'TTL Trả Thay Đổi: ' + total;
            document.getElementById('trongLuongNhanXLPCTPFLSua').style.color = 'black';
            document.getElementById('totalFooterSua').style.color = 'black';
        }
    }
</script>

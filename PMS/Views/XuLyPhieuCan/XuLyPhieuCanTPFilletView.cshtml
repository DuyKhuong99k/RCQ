<script>
    // Lấy các phần tử DOM
    const inputElement = document.getElementById('dinhMucXLPCTPFL');
    const fixedValueElement = document.getElementById('trongLuongNhanXLPCTPFL');
    const resultElement = document.getElementById('trongLuongYeuCauXLPCTPFL');

    // Lắng nghe sự kiện input
    inputElement.addEventListener('input', function (event) {
        // Lấy giá trị người dùng nhập vào
        const inputValue = parseFloat(event.target.value);

        // Lấy giá trị cố định
        const fixedValue = parseFloat(fixedValueElement.value);

        // Kiểm tra nếu giá trị nhập vào hợp lệ và khác 0
        if (!isNaN(inputValue) && inputValue !== 0) {
            // Thực hiện phép chia và gán kết quả vào trường đầu ra
            const result = fixedValue / inputValue;
            resultElement.value = result.toFixed(3); // Làm tròn kết quả đến 3 chữ số thập phân
        } else {
            // Nếu giá trị nhập vào không hợp lệ hoặc bằng 0, xóa kết quả
            resultElement.value = '';
        }
    });


    // Lấy các phần tử DOM
    const inputElementSua = document.getElementById('dinhMucXLPCTPFLSua');
    const fixedValueElementSua = document.getElementById('trongLuongNhanXLPCTPFLSua');
    const resultElementSua = document.getElementById('trongLuongYeuCauXLPCTPFLSua');

    // Hàm tính toán và cập nhật kết quả
    function tinhTongTLYeuCau() {
        // Lấy giá trị người dùng nhập vào
        const inputValue = parseFloat(inputElementSua.value);

        // Lấy giá trị cố định
        const fixedValue = parseFloat(fixedValueElementSua.value);

        // Kiểm tra nếu giá trị nhập vào hợp lệ và khác 0
        if (!isNaN(inputValue) && inputValue !== 0) {
            // Thực hiện phép chia và gán kết quả vào trường đầu ra
            const result = fixedValue / inputValue;
            resultElementSua.value = result.toFixed(3); // Làm tròn kết quả đến 3 chữ số thập phân
        } else {
            // Nếu giá trị nhập vào không hợp lệ hoặc bằng 0, xóa kết quả
            resultElementSua.value = '';
        }
    }

    // Lắng nghe sự kiện input
    inputElementSua.addEventListener('input', tinhTongTLYeuCau);
</script>
<script>
    document.getElementById('maBanXLPCTPFL').addEventListener('change', function () {
        var maBan = this.value;
        loadData(maBan);
    });

    function loadData(maBan) {
        var maXuong = @XuongId;
        loadGridDataDeskStaff(maBan, maXuong);
    }
    var gridDeskStaff;

    function loadGridDataDeskStaff(maBan, maXuong) {
        $.ajax({
            url: '/NhanVienTheoBanFillet/GetAllsFullField',
            type: 'GET',
            data: {
                maBan: maBan,
                maXuong: maXuong
            },
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                // Kiểm tra xem Grid đã được tạo chưa
                if (gridDeskStaff) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    gridDeskStaff.dataSource = dataManager;
                    gridDeskStaff.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    gridDeskStaff = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 500 },
                        allowSelection: true,
                        allowFiltering: true,
                        allowSorting: true,
                        allowResizing: true,
                        filterSettings: { type: 'Excel' },
                        height: 200,
                        columns: [
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 100 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 70 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'BanName', headerText: 'Bàn', width: 70 },
                            {
                                headerText: 'Nhập TL Ra', width: 150,
                                template: '<input type="number" min = "0" step = ".001" class="e-input itemTrongLuong" style="width:100%" oninput="tongTrongLuongRa()" placeholder = "0.000"/>',
                                allowFiltering: false,
                                allowSorting: false
                            }
                        ],
                        aggregates: [{
                            columns: [
                                {
                                    type: 'Custom',
                                    footerTemplate: '<span id="totalFooter">Tổng: 0</span>'
                                }
                            ]
                        }],
                    });

                    gridDeskStaff.appendTo('#GridNhanVienTheoBanAndSetTrongLuong');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridDataDeskStaff();

    function tongTrongLuongRa() {
        // Lấy giá trị của input tổng
        const trongLuongYeuCauXLPCTPFL = parseFloat(document.getElementById('trongLuongYeuCauXLPCTPFL').value);
        const dinhMucXLPCTPFL = parseFloat(document.getElementById('dinhMucXLPCTPFL').value);
        if (dinhMucXLPCTPFL <= 0 || dinhMucXLPCTPFL == "" || dinhMucXLPCTPFL == undefined || dinhMucXLPCTPFL == null || isNaN(dinhMucXLPCTPFL)) {
            toastOptionNotyfi();
            toastr["warning"]("Bạn Chưa Nhập Định Mức!", "Thông báo");
            return;
        }
        // Lấy tất cả các phần tử input có class itemTrongLuong
        const inputElements = document.querySelectorAll('.itemTrongLuong');
        let total = 0;

        // Lặp qua các phần tử input và tính tổng các giá trị
        inputElements.forEach(inputElement => {
            const value = inputElement.value;
            const number = parseFloat(value);

            if (!isNaN(number)) {
                total += number;
            }
        });
        // Kiểm tra nếu tổng lớn hơn giá trị của input tổng
        if (total > trongLuongYeuCauXLPCTPFL) {
            document.getElementById('totalFooter').innerText = 'Tổng TL Ra: ' + total + ' > TL Yêu Cầu';
            document.getElementById('trongLuongNhanXLPCTPFL').style.color = 'red';
            document.getElementById('totalFooter').style.color = 'red';

        } else {
            document.getElementById('totalFooter').innerText = 'Tổng TL Ra: ' + total;
            document.getElementById('trongLuongNhanXLPCTPFL').style.color = 'black';
            document.getElementById('totalFooter').style.color = 'black';
        }
    }
</script>

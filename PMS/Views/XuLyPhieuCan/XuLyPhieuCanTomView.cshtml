    <script>

        function updateTemplate() {
            var numeric;
            var grid = document.getElementById("Grid").ej2_instances[0];
            numeric = new ej.inputs.NumericTextBox({
                min: 1,
                max: 3,
                step: 1,

                format: '###.##',
                change: function (args) {
                    let value = args.value;
                    grid.goToPage(value);
                }
            });
            numeric.appendTo('#currentPage');
        };
        var flag = true;
        function dataBound() {
            if (flag) {
                flag = false;
                updateTemplate();
            }
        }
        function actionComplete(args) {
            if (args.requestType === 'paging') {
                updateTemplate();
            }
        }
        function toolbarClick(args) {
            var gridObj = document.getElementById("Grid").ej2_instances[0];
            if (args.item.id === 'Grid_excelexport') {
                gridObj.excelExport();
            }
        }
    </script>
    <script>
        document.getElementById('RefreshButtonXLPC').addEventListener("click",
            function () {
                var btn = document.getElementById('RefreshButtonXLPC').ej2_instances[0];
                var content = btn.content;
                btn.content = "Đang Tải ...";
                var grid = document.getElementById("Grid").ej2_instances[0]; // ej2-grid instance
                var dateTime = document.getElementById("datepickerXLPC").ej2_instances[0];
                $.ajax({
                    url: "@Url.Action("Reload", "XuLyPhieuCanTom")",
                    type: "GET",
                    data: { dateTime: dateTime.value.toDateString() },
                    success: function (response) {
                        // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                        if (response.Success) {
                            grid.dataSource = response.Data; // Cập nhật dữ liệu trong grid
                            grid.refresh(); // Refresh grid để hiển thị dữ liệu mới
                        } else {
                            console.error(response.Messages);
                            toastOptionNotyfi();
                            toastr["error"](response.Messages, "Không có dữ liệu!");
                        }
                    },
                    error: function (error) {
                        toastOptionNotyfi();
                        toastr["error"](error, "Thông báo");
                    }

                }).always(function () {
                    btn.content = content;
                });
            });
    </script>

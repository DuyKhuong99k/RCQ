    <script>
        function loadDataNhanVien() {
            $.ajax({
                type: "GET",
                url: "/Staff/GetAllNhanViens",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // Khởi tạo ComboBox khi dữ liệu được tải
                    initializeComboBoxNhanVien(response);
                    //initializeComboBoxSanPhamSua(response);
                },
                error: function (xhr, status, error) {
                    console.error(status, error);
                }
            });
        }
        function initializeComboBoxNhanVien(data) {
            var comboBoxObject = new ej.dropdowns.ComboBox({
                dataSource: data,
                fields: { value: 'MaNhanVien', text: 'Name', tooltip: 'DeptName0' },
                placeholder: "Chọn Nhân Viên",
                sortOrder: 'Ascending',
                headerTemplate: "<span class='head'><span class='ma'>Mã</span><span class='ten'>Tên</span><span class='ghichu'>Nhóm</span></span>",
                itemTemplate: "<span class='item' ><span class='ma'>${MaNhanVien}</span><span class='ten'>${Name}</span><span class='ghichu'>${DeptName0}</span></span>"
            });
            comboBoxObject.appendTo('#displayValueNV');
            // Bắt sự kiện khi combobox thay đổi giá trị
            comboBoxObject.addEventListener('change', function (e) {
                // Lấy giá trị đã chọn
                var selectedData = comboBoxObject.getDataByValue(comboBoxObject.value);

                // Kiểm tra xem có dữ liệu đã chọn hay không
                if (selectedData) {
                    // Lấy giá trị của trường 'Ma'
                    var maNhanVien = selectedData.MaNhanVien;
                    $('#nhanVienXLPCTomHHidden').val(maNhanVien);
                    alert(maNhanVien);
                }
            });
        }

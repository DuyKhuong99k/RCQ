    }
    .e-input-group.e-input-focus:not(.e-success):not(.e-warning):not(.e-error),.e-input-group.e-control-wrapper.e-input-focus:not(.e-success):not(.e-warning):not(.e-error) {
        border-color: #0078d4;
        border-radius: 0.5rem;
        box-shadow: 0 0 0 1px #0078d4
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân Vùng Nuôi Đại Thành Side</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themPhieuCanVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Thêm Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (themPhieuCanVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaPhieuCanVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Sửa Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (suaPhieuCanVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaPhieuCanVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Xoá Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (xoaPhieuCanVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importPhieuCanVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Import Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (importPhieuCanVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportPhieuCanVungNuoiDaiThanhSide = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Func == "Export Xử Lý Phiếu Cân / Phiếu Cân Vùng Nuôi Đại Thành Side" && x.Status == 1).FirstOrDefault();
                            if (exportPhieuCanVungNuoiDaiThanhSide != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

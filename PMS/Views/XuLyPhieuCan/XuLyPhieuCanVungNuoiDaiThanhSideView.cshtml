<script>
    // $(document).ready(function () {
    //     loadGridData();
    // });
    let selectedIdsString = ""; // Khai báo một chuỗi để lưu trữ MaNhanVien đã chọn
    let numRowSelect = 0;
    var grid;
    function creatTable(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid!= null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {

            var contextMenuItems = [
                { text: 'Xem ghi chú', id: 'viewNote' },
                // { text: 'Chuyển xưởng', id: 'changeDepartment' },
                // { text: 'Chuyển size', id: 'changeSize' },
                // { text: 'Chuyển thành phẩm', id: 'changeThanhPham' },
            ];
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 500 },
                allowSelection: true,
                allowFiltering: true,
                allowSorting: true,
                allowResizing: true,
                //enableVirtualization: true,
                //loadingIndicator: { indicatorType: 'Shimmer' },
                filterSettings: { type: 'Excel' },
                //selectionSettings: { persistSelection: true, type: "Multiple", checkboxOnly: true },
                selectionSettings: { persistSelection: true },
                rowSelected: selectionChanged,
                rowDeselected: unSelectionChanged,
                height: 400,
                contextMenuItems: contextMenuItems,
                contextMenuClick: contextMenuClickHandler,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150 },
                    { field: 'Gio', headerText: 'Giờ', width: 150 },
                    { field: 'NgayTai', headerText: 'Ngày Tải', width: 150 },
                    { field: 'GioTai', headerText: 'Giờ Tải', width: 150 },
                    { field: 'MaLo', headerText: 'Mã Lô', width: 150 },
                    { field: 'MaUserCan', headerText: 'Người Cân', width: 150 },
                    { field: 'MaLoaiCaDaiThanhId', headerText: 'Mã Loại Cá', width: 150 },
                    { field: 'TenLoaiCa', headerText: 'Loại Cá', width: 150 },
                    { field: 'CanLai', headerText: 'Cân Lại', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'MaGhe', headerText: 'Mã Ghe', width: 150 },
                    { field: 'TenGhe', headerText: 'Ghe', width: 150 },
                    { field: 'TenAo', headerText: 'Ao', width: 150 },
                    { field: 'TenCongDoan', headerText: 'Công Đoạn', width: 150 },
                    { field: 'TenThongKeDauAo', headerText: 'Thống Kê', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                    { field: 'TrongLuongTare', headerText: 'Trọng Lượng Tare', type: 'number', width: 150 },
                    { field: 'IsTap', headerText: 'Tạp', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'MaMayCan', headerText: 'Mã Máy Cân', width: 150 },
                    { field: 'BiosId', headerText: 'BiosId', width: 150 },
                ],
                aggregates: [{
                    columns: [{
                        type: 'Sum',
                        field: 'TrongLuong',
                        format: 'N2',
                        footerTemplate: 'Tổng TL: ${Sum} Kg'
                    }]
                }]
            });
            grid.appendTo('#Grid');
        }
    }

    creatTable();
    function contextMenuClickHandler(args) {
        var rowData = args.rowInfo.rowData;
        if (rowData) {
            switch (args.item.id) {
                case 'viewNote':
                    var ghiChu = rowData.GhiChu;
                    if (ghiChu) {
                        // Thay thế dấu phẩy bằng thẻ <br> để tạo xuống hàng
                        ghiChu = ghiChu.replace(/,/g, '<br>');
                        bootbox.alert({
                            title: "Ghi chú",
                            message: ghiChu,
                            callback: function () { }
                        });
                    } else {
                        bootbox.alert("Không có ghi chú nào cho hàng này.");
                    }
                    break;
                case 'changeDepartment':
                    $.ajax({
                        url: "/XuLyPhieuCan/CheckQuyenFillet",
                        data: { typeOption: "CHUYENXUONG" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển xưởng của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenXuong').modal('show');
                                        }
                                    }
                                });
                            }


@{
    ViewData["Title"] = "TongHopDauAoCaGiongView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tổng Hợp Cá Giống</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid && data != null && data != "") {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    { field: 'TenCongDoan', headerText: 'Công Đoạn', width: 150 },
                    { field: 'TenThongKeDauAo', headerText: 'Thống Kê', width: 150 },
                    { field: 'MaMayCan', headerText: 'Máy Cân', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150 },
                    { field: 'TenAo', headerText: 'Ao', width: 150 },
                    { field: 'TenLoaiCa', headerText: 'Loại Cá', width: 150 },
                    { field: 'TenChuAo', headerText: 'Chủ Ao', width: 150 },
                    { field: 'MaGhe', headerText: 'Mã Ghe', width: 150 },
                    { field: 'TrongLuongTrenPhieu', headerText: 'Trọng Lượng/Phiếu', type: 'number', width: 150 },
                    { field: 'TrongLuongMau', headerText: 'Trọng Lượng Mẫu', type: 'number', width: 150 },
                    { field: 'LuongMat', headerText: 'Lượng Mất', type: 'number', width: 150 },
                    { field: 'TyLeMat', headerText: 'Tỷ Lệ Mất', type: 'number', width: 150 },
                    { field: 'TrongLuongCan', headerText: 'Trọng Lượng Cân', type: 'number', width: 150 },
                    { field: 'SoCon', headerText: 'Số Con', type: 'number', width: 150 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuongMau',
                            //format: '0,000',
                            footerTemplate: 'Tổng Trọng Lượng Mẫu: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'LuongMat',
                            //format: '0,000',
                            footerTemplate: 'Tổng Lượng Mất: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'TrongLuongCan',
                            //format: '0,000',
                            footerTemplate: 'Tổng Trọng Lượng Cân: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'SoCon',
                            //format: '0,000',
                            footerTemplate: 'Tổng Số Con: ${Sum} con'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    document.getElementById('RefreshButton').addEventListener("click",
        function () {
            var btn = document.getElementById('RefreshButton').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var grid = document.getElementById("Grid").ej2_instances[0]; // ej2-grid instance
            var fromDate = document.getElementById("datepicker1").ej2_instances[0];
            var toDate = document.getElementById("datepicker2").ej2_instances[0];
            $.ajax({
                url: "@Url.Action("Reload", "DauAoCaGiong")",
                type: "POST",
                data: { "fromDate": fromDate.value.toDateString(), "toDate": toDate.value.toDateString() },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>

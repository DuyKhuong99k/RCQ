
@{
    ViewData["Title"] = "TongHopDanhGiaDinhMucView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tổng Hợp Đánh Gía Định Mức</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid!= null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    // { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150 },
                    // { field: 'Gio', headerText: 'Giờ', width: 150 },
                    { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                    { field: 'TenNhanVien', headerText: 'Tên Nhân Viên', width: 150 },
                    { field: 'Nhom', headerText: 'Nhóm', width: 150 },
                    { field: 'MaLo', headerText: 'Mã Lô', width: 150 },
                    { field: 'LoaiCaName', headerText: 'Loại Cá', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'MaSanPham', headerText: 'Mã Lương', width: 150 },
                    { field: 'SizeName', headerText: 'Size', width: 150 },
                    { field: 'MauName', headerText: 'Màu', width: 150 },
                    { field: 'CaTra', headerText: 'Cá Trả', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'DinhMuc', headerText: 'Định Mức', type: 'number', format:'N2',width: 150 },
                    { field: 'DinhMucChuan', headerText: 'Định Mức Chuẩn', type: 'number',format:'N2', width: 150 },
                    { field: 'TrongLuongNhan', headerText: 'Trọng Lượng Nhận', type: 'number',format:'N2', width: 150 },
                    { field: 'TrongLuongTra', headerText: 'Trọng Lượng Trả', type: 'number',format:'N2', width: 150 },
                    { field: 'SoRo', headerText: 'Số Rổ', type: 'number',format:'N2', width: 150 },
                    { field: 'DanhGia', headerText: 'Đánh Gía', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'DonGia', headerText: 'Đơn Gía', type: 'number',format:'N2', width: 150 },
                    { field: 'ThanhTien', headerText: 'Thành Tiền', type: 'number',format:'N2', width: 150 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuong',
                            //format: '0,000',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    document.getElementById('RefreshButton').addEventListener("click",
        function () {
            ClearData("Grid");
            var btn = document.getElementById('RefreshButton').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var grid = document.getElementById("Grid").ej2_instances[0]; // ej2-grid instance
            var fromDate = document.getElementById("datepicker1").ej2_instances[0];
            var toDate = document.getElementById("datepicker2").ej2_instances[0];
            $.ajax({
                url: "@Url.Action("Reload", "TP")",
                type: "POST",
                data: { "fromDate": fromDate.value.toDateString(), "toDate": toDate.value.toDateString() },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        loadGridData(response.Data);
                    } else {
                        loadGridData();
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>



@{
    ViewData["Title"] = "ChiTietTP2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Chi Tiết Thành Phẩm 2</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var grid;
    var datalength = 0;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }
        if (grid!= null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    //{ field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150 , type: 'date', format: 'dd-MM-yyyy' },
                    { field: 'ThoiGian', headerText: 'Giờ', width: 150 , type: 'date', format: 'HH:mm:ss'},
                    //{ field: 'MaPhuongTien', headerText: 'Mã Phương Tiện', width: 150 },
                    //{ field: 'TenPhuongTien', headerText: 'TenPhuongTien', width: 150 },
                    //{ field: 'TenNCC', headerText: 'Tên Nhà Cung Cấp', width: 150 },
                    { field: 'MaLo', headerText: 'Lô', width: 150 },
                    //{ field: 'MaAo', headerText: 'Ao', width: 150 },
                    { field: 'TenThanhPham', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'TenSize', headerText: 'Size', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number',format:'N2', width: 150 },
                    { field: 'TrongLuongTare', headerText: 'Trọng Lượng Tare', type: 'number',format:'N2', width: 150 },
                    { field: 'MaMayTinhCan', headerText: 'Máy Cân', width: 150 },
                    { field: 'MaXuongSanXuat', headerText: 'Mã Xưởng', width: 150 },
                    //{ field: 'IsTap', headerText: 'Tạp', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuong',
                            //format: '0,000',
                            format: '#,###.##',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    </script>
 <script>
     document.getElementById('RefreshButton').addEventListener("click", function () {
        var btnEle = document.getElementById('RefreshButton');
        var btn = btnEle.ej2_instances[0];

        if (btnEle.classList.contains("loading")) return;
        btnEle.classList.add("loading");

        ClearData("Grid");

        var originalContent = btn.content;
        // btn.disabled = true;

        var dots = 0;
        btn.content = "Đang tải";
        var loadingInterval = setInterval(function () {
            dots = (dots + 1) % 4;
            btn.content = "Đang tải" + ".".repeat(dots);
        }, 500);

        var grid = document.getElementById("Grid").ej2_instances[0];
        var fromDate = document.getElementById("datepicker1").ej2_instances[0];
        var toDate = document.getElementById("datepicker2").ej2_instances[0];


        $.ajax({
            url: "@Url.Action("Reload", "BaoCaoNguyenLieu")",
            type: "POST",
            data: {
                fromDate: fromDate.value ? fromDate.value.toDateString() : null,
                toDate: toDate.value ? toDate.value.toDateString() : null
                // xuongId: xuongId
            },
            success: function (response) {
                if (response.Success) {
                    loadGridData(response.Data);
                } else {
                    loadGridData();
                    console.error(response.Messages);
                    if (typeof toastOptionNotyfi === "function") toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                if (typeof toastOptionNotyfi === "function") toastOptionNotyfi();
                toastr["error"](error.statusText || "Lỗi không xác định", "Thông báo");
            }
        }).always(function () {
            clearInterval(loadingInterval);
            btn.content = originalContent;
            // btn.disabled = false;
            btnEle.classList.remove("loading");
        });
    });

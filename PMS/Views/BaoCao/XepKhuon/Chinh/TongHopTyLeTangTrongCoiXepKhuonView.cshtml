
@{
    ViewData["Title"] = "TongHopTyLeTangTrongCoiXepKhuonView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tổng Tỷ Lệ Tăng Trọng</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var grid;
    var datalength = 0;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
            if(data != null && data.length !=null){
        datalength = data.length;
    }
    else{
        datalength = 0;
    }
        if (grid!= null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                    actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                allowResizing: true,
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    { field: 'NgayNguyenLieu', headerText: 'Ngày Nguyên Liệu', width: 150 , type: 'date', format: 'dd-MM-yyyy'},
                    { field: 'MaCoi', headerText: 'Mã Cối', width: 150 },
                    { field: 'ThanhPhamNameVao', headerText: 'Thành Phẩm Vào', width: 200 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm Ra', width: 200 },
                    { field: 'SizeNameVao', headerText: 'Size Vào', width: 200 },
                    { field: 'SizeName', headerText: 'Size Ra', width: 200 },
                    { field: 'TyLeTangTrong', headerText: 'Tỷ Lệ Tăng Trọng', type: 'number',format:'N2', width: 200 },
                    { field: 'trong_luong_vao_coi', headerText: 'Trọng Lượng Vào', type: 'number',format:'N2', width: 200 },
                    { field: 'tong_trong_luong_ra_coi', headerText: 'Trọng Lượng Ra', type: 'number',format:'N2', width: 200 },



                    { field: 'gio_bat_dau_vao', headerText: 'Giờ Bất Đầu Vào', width: 200 },
                    { field: 'gio_ket_thuc_Vao', headerText: 'Giờ Kết Thúc Vào', width: 200 },
                    { field: 'gio_bat_dau', headerText: 'Giờ Bất Đầu Ra', width: 200 },
                    { field: 'gio_ket_thuc', headerText: 'Giờ Kết Thúc Ra', width: 200 },
                    { field: 'so_phieu_vao', headerText: 'Số Rổ Vào', type: 'number',format:'N2', width: 200 },
                    { field: 'so_phieu', headerText: 'Số Rổ Ra', type: 'number',format:'N2', width: 200 },
                    { field: 'luotvao', headerText: 'Lượt Quay Vào', type: 'number',format:'N2', width: 200 },
                    { field: 'luot', headerText: 'Lượt Quay Ra', type: 'number',format:'N2', width: 200 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'trong_luong_vao_coi',
                            format: '#,###.##',
                            footerTemplate: 'Tổng TL Vào: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'tong_trong_luong_ra_coi',
                            format: '#,###.##',
                            footerTemplate: 'Tổng TL Ra: ${Sum} Kg'
                        },
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
</script>
<script>
    document.getElementById('RefreshButton').addEventListener("click", function () {
        var btnEle = document.getElementById('RefreshButton');
        var btn = btnEle.ej2_instances[0];

        if (btnEle.classList.contains("loading")) return;
        btnEle.classList.add("loading");

        ClearData("Grid");

        var originalContent = btn.content;
        // btn.disabled = true;

        var dots = 0;
        btn.content = "Đang tải";
        var loadingInterval = setInterval(function () {
            dots = (dots + 1) % 4;
            btn.content = "Đang tải" + ".".repeat(dots);
        }, 500);

        var grid = document.getElementById("Grid").ej2_instances[0];
        var fromDate = document.getElementById("datepicker1").ej2_instances[0];
        var toDate = document.getElementById("datepicker2").ej2_instances[0];
        var xuongId = '@XuongId';

        $.ajax({
            url: "@Url.Action("Reload", "BaoCaoSanPhamChinhXepKhuon")",
            type: "POST",
            data: {
                fromDate: fromDate.value ? fromDate.value.toDateString() : null,
                toDate: toDate.value ? toDate.value.toDateString() : null,
                xuongId: xuongId
            },
            success: function (response) {
                if (response.Success) {
                    loadGridData(response.Data);
                } else {
                    loadGridData();
                    console.error(response.Messages);
                    if (typeof toastOptionNotyfi === "function") toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                if (typeof toastOptionNotyfi === "function") toastOptionNotyfi();
                toastr["error"](error.statusText || "Lỗi không xác định", "Thông báo");
            }
        }).always(function () {
            clearInterval(loadingInterval);
            btn.content = originalContent;
            // btn.disabled = false;
            btnEle.classList.remove("loading");
        });
    });
</script>



@{
    ViewData["Title"] = "TongHopCoiChinhXepKhuonView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tổng Hợp Cối</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid && data != null && data != "") {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50 },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    // { field: 'STT', headerText: 'STT', width: 150 },
                    // { field: 'Ngay', headerText: 'Ngày', width: 150 },
                    // { field: 'Gio', headerText: 'Giờ', width: 150 },

                    // { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    // { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                    // { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                    // { field: 'MaHoSoPV', headerText: 'Mã Số Phục Vụ', width: 150 },
                    // { field: 'NhanVienPhucVuPhanCoName', headerText: 'Tên Nhân Viên Phục Vụ', width: 150 },
                    { field: 'MaLo', headerText: 'Lô', width: 150 },
                    { field: 'LoaiCaName', headerText: 'Loại Cá', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'SizeName', headerText: 'Size', width: 150 },
                    { field: 'ChieuXaName', headerText: 'Chiếu Xạ', width: 150 },
                    { field: 'ChatLuongName', headerText: 'Chất Lượng', width: 150 },
                    //{ field: 'MauName', headerText: 'Màu', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                    { field: 'SoRo', headerText: 'Số Rổ', type: 'number', width: 150 },
                    //{ field: 'CoiChinhName', headerText: 'Cối', width: 150 },
                    // { field: 'ThoiGianBatDauQuay', headerText: 'Thời Gian BĐ', width: 150 },
                    // { field: 'ThoiGianQuay', headerText: 'Thời Gian Quay', width: 150 },
                    // { field: 'EpRaCoi', headerText: 'Ép Ra Cối', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    // { field: 'TaiChe', headerText: 'Tái Chế', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'ChuyenXuong', headerText: 'Chuyển Xưởng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                    // { field: 'MaMayCan', headerText: 'Máy Cân', width: 150 },
                    // { field: 'MayQuay', headerText: 'Máy Quay', width: 150 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuong',
                            //format: '0,000',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'SoRo',
                            //format: '0,000',
                            footerTemplate: 'Tổng Số Rổ: ${Sum}'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
        }
    }
    loadGridData();

</script>
<script>
    document.getElementById('RefreshButton').addEventListener("click",
        function () {
            var btn = document.getElementById('RefreshButton').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var grid = document.getElementById("Grid").ej2_instances[0]; // ej2-grid instance
            var fromDate = document.getElementById("datepicker1").ej2_instances[0];
            var toDate = document.getElementById("datepicker2").ej2_instances[0];
            var xuongId = @XuongId;
            $.ajax({
                url: "@Url.Action("Reload", "BaoCaoSanPhamChinhXepKhuon")",
                type: "POST",
                data: { "fromDate": fromDate.value.toDateString(), "toDate": toDate.value.toDateString(), xuongId: xuongId },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>
@using Syncfusion.EJ2
@{
    ViewData["Tittle"] = "Chi Tiết Tôm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section ControlsSection{
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Phiếu Cân Chi Tiết</h2>
                </div>
                <div class="card-body">
                    
                        <ejs-grid height="400" id="Grid" dataSource="@ViewBag.datasource" allowResizing="true" actionComplete="actionComplete" allowReordering="true" allowExcelExport="true" allowPaging="true" allowSorting="true" toolbarClick="toolbarClick" toolbar="@(new List<string> { "ExcelExport", "Search" })" allowExcelExport="true" allowFiltering="true">
                            <e-grid-pagesettings pageSizes="@(new string[] {"20" ,"50", "100" , "200", "500", "All" })" pageSize="20">
                            </e-grid-pagesettings>
                            @*<e-data-manager url="@Url.Action("GetChiTiet", "TP")" adaptor="UrlAdaptor"></e-data-manager>*@
                            <e-grid-filterSettings type="Excel"></e-grid-filterSettings>

                            @*<e-grid-searchsettings fields="@(new string[] { "MaNhanVien","STT","TrongLuong"})" ignoreCase="true" operator="contains"></e-grid-searchsettings>*@
                            <e-grid-aggregates>
                                <e-grid-aggregate>
                                    <e-aggregate-columns>
                                        <e-aggregate-column field="TrongLuong" type="Sum" format="#,###.##" footerTemplate="Tổng Trọng Lượng: ${Sum}"></e-aggregate-column>
                                        <e-aggregate-column field="SoLuong" type="Sum" format="#,###.##" footerTemplate="Tổng Số Phiếu: ${Sum}"></e-aggregate-column>
                                    </e-aggregate-columns>
                                </e-grid-aggregate>
                            </e-grid-aggregates>
                            <e-grid-columns>
                                <e-grid-column field="STT" headerText="STT" type="number" textAlign="Right" width="120"></e-grid-column>
                                <e-grid-column field="Ngay" headerText="Ngày" type="datetime" format="dd/MM/yyyy" textAlign="Center" width="140"></e-grid-column>
                                <e-grid-column field="Gio" headerText="Giờ" textAlign="Right" format="hh:mm:ss" width="120"></e-grid-column>
                                <e-grid-column field="MaNhanVien" headerText="Mã Nhân Viên" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="MaHoSo" headerText="Mã Số" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="TenNhanVien" headerText="Tên Nhân Viên" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="Nhom" headerText="Tên Nhóm" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="NhomLo" headerText="Lô" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="NgayNguyenLieu" headerText="Ngày Nguyên Liệu" type="datetime" format="dd/MM/yyyy" textAlign="Center" width="140"></e-grid-column>
                                <e-grid-column field="SanPhamName" headerText="Sản Phẩm" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="SizeName" headerText="Size TL" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="SizeTPName" headerText="Size TP" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="QuyTrinhName" headerText="Quy Trình" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="KhangSinhName" headerText="Kháng Sinh" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="ThongTinPhuName" headerText="Thông Tin Phụ" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="ThongTinNguyenLieuName" headerText="TT Nguyên Liệu" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="PhuGiaName" headerText="Phụ Gia" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="NhomCongViecName" headerText="Nhóm Công Việc" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="CongViecName" headerText="Công Việc" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="KhachHangName" headerText="Khách Hàng" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="VoXo2" headerText="Vỏ Xô Dao Động" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="TrongLuong" headerText="Trọng Lượng" type="number" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="SoLuong" headerText="Số Lượng" type="number" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="IsCanTay" headerText="Nhập" displayAsCheckBox="true" textAlign="Center"></e-grid-column>
                                <e-grid-column field="T" headerText="Nhiệt Độ" type="number" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="NhomHoaChatName" headerText="Nhóm Hoá Chất" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="MayCan" headerText="Máy Cân" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="MaXuong" headerText="Xưởng" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="GhiChu2" headerText="Ghi Chú 2" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="GhiChu3" headerText="Ghi Chú 3" type="string" textAlign="Right" width="140"></e-grid-column>
                                <e-grid-column field="GhiChu" headerText="GhiChu" type="string" textAlign="Right" width="140"></e-grid-column>
                            </e-grid-columns>
                        </ejs-grid>
                    @* <div style="margin-top:20px;">
                        <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                        <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                        <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                        <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                    </div> *@
                </div>
            </div>
        </div>
    </div>
</div>

    <script id="template" type="text/x-template">
        <div class="e-pagertemplate">
            <div class="col-lg-12 control-section">
                <div class="content-wrapper">
                    <input id="currentPage" type="text" value=${currentPage}>
                </div>
            </div>

            <div id="totalPages" class="e-pagertemplatemessage" style="margin-top:5px;margin-left:30px;border: none; display: inline-block ">
                <span class="e-pagenomsg">${currentPage} of ${totalPages} pages (${totalRecordsCount} items)</span>
            </div>
        </div>
    </script>
    <script>

        function updateTemplate() {
            var numeric;
            var grid = document.getElementById("Grid").ej2_instances[0];
            numeric = new ej.inputs.NumericTextBox({
                min: 1,
                max: 3,
                step: 1,

                format: '###.##',
                change: function (args) {
                    let value = args.value;
                    grid.goToPage(value);
                }
            });
            numeric.appendTo('#currentPage');
        };
        var flag = true;
        function dataBound() {
            if (flag) {
                flag = false;
                updateTemplate();
            }
        }
        function actionComplete(args) {
            if (args.requestType === 'paging') {
                updateTemplate();
            }
        }
        function toolbarClick(args) {
            var gridObj = document.getElementById("Grid").ej2_instances[0];
            if (args.item.id === 'Grid_excelexport') {
                gridObj.excelExport();
            }
        }


    </script>
    <script>
        document.getElementById('RefreshButton').addEventListener("click",
            function () {
                var btn = document.getElementById('RefreshButton').ej2_instances[0];
                var content = btn.content;
                btn.content = "Đang Tải ...";
                var grid = document.getElementById("Grid").ej2_instances[0]; // ej2-grid instance
                var fromDate = document.getElementById("datepicker1").ej2_instances[0];
                var dateTime = document.getElementById("datepicker2").ej2_instances[0];
                $.ajax({
                    url: "@Url.Action("Reload", "T_PhieuCan")",
                    type: "POST",
                    data: { "fromDate": fromDate.value.toDateString(), "dateTime": dateTime.value.toDateString() },
                    success: function (response) {
                        if (response.Success) {
                            grid.dataSource = response.Data;
                            grid.refresh();
                        } else {
                            console.error(response.Messages);
                            toastOptionNotyfi();
                            toastr["error"](response.Messages, "Không có dữ liệu!");
                        }
                    },
                    error: function (error) {
                        toastOptionNotyfi();
                        toastr["error"](error, "Thông báo");
                    }
                }).always(function () {
                    btn.content = content;
                });
            });
    </script>

}

@{
    ViewData["Title"] = "TongHopPhuongTienNguyenLieuView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tổng Hợp Ghe Nguyên Liệu</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var grid;
    var datalength = 0;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }

        if (grid!= null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    //{ field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150 , type: 'date', format: 'dd-MM-yyyy'},
                    { field: 'TenXuong', headerText: 'Xưởng', width: 150 },
                    { field: 'TenPhuongTien', headerText: 'Phương Tiện', width: 150 },
                    { field: 'MaLo', headerText: 'Lô', width: 150 },
                    { field: 'MaAo', headerText: 'Mã Ao', width: 150 },
                    // { field: 'TenLoaiCa', headerText: 'Loại Cá', width: 150 },
                    { field: 'TenThanhPham', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'TenSize', headerText: 'Size', width: 150 },
                    // { field: 'TenMau', headerText: 'Màu', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number',format:'N2', width: 150 },
                    { field: 'BatDau', headerText: 'Bất Đầu', width: 150 , type: 'date', format: 'hh:mm:ss'},
                    { field: 'KetThuc', headerText: 'Kết Thúc', width: 150, type: 'date', format: 'hh:mm:ss' },
                    { field: 'IsTap', headerText: 'Tạp', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuong',
                            //format: '0,000',
                            format: '#,###.##',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
         try {
             var gridObj = document.getElementById(GridId).ej2_instances[0];
             if(gridObj)
                 gridObj.dataSource = [];
         } catch (e) {
             Console.log(e);
         }

     }
     document.getElementById('RefreshButton').addEventListener("click",
         function () {
             ClearData("Grid");
            var btn = document.getElementById('RefreshButton').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var grid = document.getElementById("Grid").ej2_instances[0]; // ej2-grid instance
            var fromDate = document.getElementById("datepicker1").ej2_instances[0];
            var toDate = document.getElementById("datepicker2").ej2_instances[0];
            $.ajax({
                url: "@Url.Action("Reload", "BaoCaoNguyenLieu")",
                type: "POST",
                data: { "fromDate": fromDate.value.toDateString(), "toDate": toDate.value.toDateString() },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        loadGridData(response.Data);
                    } else {
                        loadGridData();
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>


@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-center align-items-center" style="margin-top:17%">
    @if (AppViewModels.AppViewModel.Instance.Company == "PhanBach")
    {
        <img src="~/assets/img/logo/PhanBachLogo.png" alt="Logo" class="img-fluid" />
    }
    else
    {
        <img src="~/assets/img/logo/PMSLogo.png" alt="Logo" class="img-fluid" />
    }

</div>


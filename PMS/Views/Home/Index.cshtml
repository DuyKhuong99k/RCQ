@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var tptl = ViewBag.listTPTLModel;
    var NumberDate = @Context.Session.GetString("NumberDate");
    var XuongId = @Context.Session.GetString("XuongId");
}
@* <!-- CSS -->
<link href="https://cdn.jsdelivr.net/npm/gridstack@9.2.0/dist/gridstack.min.css" rel="stylesheet" />
<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/gridstack@9.2.0/dist/gridstack-all.min.js"></script> *@
<link href="~/assets/vendor/libs/gridstack/gridstack.min.css" rel="stylesheet" />
<script src="~/assets/vendor/libs/gridstack/gridstack-all.min.js"></script>
<style>
    .minHeigh {
        min-height: 345px;
    }
    .marginGridjs{
        margin: 0px 0px 0px 12px;
    }

    .grid-stack-item-content {
        background: #fff;
        padding: 10px;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        height: 100%; /* luôn chiếm hết chiều cao widget */
        overflow-y: auto; /* cuộn khi tràn */
        box-sizing: border-box;
    }

    .card.marginGridjs {
        transition: all 0.3s ease;
    }

        .card.marginGridjs:hover {
            box-shadow: 0 0 12px rgba(31, 45, 61, 0.4); /* navy */
            border: 1px solid #1f2d3d;
            z-index: 10;
        }

</style>
<div class="row align-items-end g-3 mb-2" style="margin-top: -20px;">
    <!-- TOGGLE GẠT BÊN TRÁI -->
    <div class="col-auto">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="toggle-drag" checked>
            <label class="form-check-label ms-2" for="toggle-drag">Cho phép kéo</label>
        </div>
    </div>

    <!-- PHẦN NGÀY THÁNG BÊN PHẢI -->
    <div class="col-md-auto ms-auto">
        <div class="input-group">
            <span class="input-group-text">Chọn ngày</span>
            <input type="date" class="form-control" id="fromDateDB" name="fromDate">
            @* <input type="date" class="form-control" id="toDateDB" name="toDate"> *@
        </div>
    </div>

    <!-- PHẦN SỐ PHÚT -->
    <div class="col-md-auto" style="z-index:1">
        <div class="input-group">
            <span class="input-group-text">Số phút</span>
            <input type="number" class="form-control" id="minuteInput" name="minuteInput" min="5" value="5">
            <button id="applyBtn" class="btn btn-primary" type="button">
                <i class='bx bx-refresh'></i>
            </button>
        </div>
    </div>
</div>



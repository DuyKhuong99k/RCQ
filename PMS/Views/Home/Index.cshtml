    // window.onload = checkScreenSize;
    // window.onresize = checkScreenSize;

    $(function () {
        $(".sortable-container").sortable({
            items: ".draggable-item"
        });
        $(".sortable-container").disableSelection();

        $(".draggable-item").resizable({
            handles: 'e', // Chỉ cho phép thay đổi kích thước bên phải
            stop: function (event, ui) {
                var resizedElement = ui.element;
                var siblings = resizedElement.siblings('.resizable-item');
                var totalWidth = resizedElement.width();
                var numSiblings = siblings.length + 1;
                var newWidth = totalWidth / numSiblings;

                // Cập nhật kích thước của các phần tử cùng hàng
                siblings.width(newWidth);
            }
        });
    });
</script>
<script>
    // Hàm để kiểm tra kích thước màn hình và hiển thị phần thích hợp
    function checkScreenSize() {
        var isMobile = window.innerWidth < 768; // Kiểm tra nếu kích thước màn hình nhỏ hơn 768px (xs hoặc sm)

        // Nếu đang xem trên điện thoại
        if (isMobile) {
            // Kiểm tra xem phần dành cho điện thoại đã hiển thị chưa trước khi hiển thị


            if (document.getElementById('dashBoardMobie') && document.getElementById('dashBoardMobie').style.display !== 'block') {
                document.getElementById('dashBoardMobie').style.display = 'block'; // Hiển thị phần dành cho điện thoại di động
            }
            if (document.getElementById('dashBoardComputer')) {
                document.getElementById('dashBoardComputer').style.display = 'none'; // Ẩn phần dành cho máy tính
                document.getElementById('dashBoardComputer').remove(); // Ẩn phần dành cho máy tính bằng cách loại bỏ nó khỏi DOM
            }
        }
        // Nếu không phải là điện thoại (tức là xem trên máy tính)
        else {
            // Kiểm tra xem phần dành cho máy tính đã hiển thị chưa trước khi hiển thị
            if (document.getElementById('dashBoardComputer') && document.getElementById('dashBoardComputer').style.display !== 'block') {
                document.getElementById('dashBoardComputer').style.display = 'block'; // Hiển thị phần dành cho máy tính

            }

            var dashboard = document.getElementById('dashBoardMobie');
            if (dashboard) {
                dashboard.style.display = 'none'; // Ẩn phần dành cho điện thoại di động
                dashboard.remove();
            }
            // Ẩn phần dành cho điện thoại bằng cách loại bỏ nó khỏi DOM
            // document.getElementById('dashBoardMobie').remove();
        }
    }

    // Gọi hàm khi trang web được tải và cũng khi cửa sổ thay đổi kích thước
    window.onload = checkScreenSize;
    window.onresize = checkScreenSize;
</script>

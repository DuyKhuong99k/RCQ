<script>
    function equalizeCardHeights() {
        const cards = document.querySelectorAll('.marginGridjs');
        let maxHeight = 0;

        // Reset height trước để lấy đúng chiều cao thực
        cards.forEach(card => {
            card.style.height = 'auto';
            maxHeight = Math.max(maxHeight, card.offsetHeight);
        });

        // Gán chiều cao lớn nhất cho tất cả
        cards.forEach(card => {
            card.style.height = maxHeight + 'px';
        });
    }

    // Gọi khi DOM load xong
    window.addEventListener('DOMContentLoaded', equalizeCardHeights);

    // Gọi lại khi resize
    window.addEventListener('resize', equalizeCardHeights);

    // Gọi lại nếu bạn load partial view (tùy bạn chèn sau khi load xong)
    // equalizeCardHeights();

    // Optional: nếu muốn theo dõi thay đổi chiều cao tự động từng card (nâng cao)
    const observer = new ResizeObserver(equalizeCardHeights);
    document.querySelectorAll('.marginGridjs').forEach(el => observer.observe(el));
</script>
<script>
    let grid;
    // function getColumnByWidth() {
    //     const width = window.innerWidth;
    //     if (width < 768) return 1; // điện thoại
    //     else if (width < 1024) return 4; // tablet
    //     return 12; // desktop
    // }
    document.addEventListener("DOMContentLoaded", function () {
        grid = GridStack.init({
            float: false,
            column: 12, 
            marginTop: 10,
            marginRight: 10,
            marginBottom: 10,
            marginLeft: 10,
            cellHeight: 450, // CỐ ĐỊNH chiều cao widget
            disableResize: true,
            disableDrag: window.innerWidth < 768,
            animate: true
        });

        const saved = localStorage.getItem("dashboard_layout");
        if (saved) {
            try {
                const layout = JSON.parse(saved);
                grid.load(layout);
                grid.compact();
            } catch (e) {
                console.warn("Lỗi layout:", e);
            }
        }

        grid.on("change", function () {
            const layout = grid.save(true);
            localStorage.setItem("dashboard_layout", JSON.stringify(layout));
        });
    });

    function resetLayout() {
        localStorage.removeItem("dashboard_layout");
        location.reload();
    }


    function applyToggleDrag() {
        const isMobile = window.innerWidth < 768;
        const toggle = document.getElementById("toggle-drag");

        if (isMobile) {
            toggle.checked = false;
            toggle.disabled = true;
            grid.enableMove(false);
            localStorage.setItem("enable_drag", "0");
        } else {
            const enable = localStorage.getItem("enable_drag") !== "0";
            toggle.checked = enable;
            toggle.disabled = false;
            grid.enableMove(enable);
        }
    }

    // Sự kiện thay đổi toggle (chỉ hoạt động khi không bị disable)
    document.getElementById("toggle-drag").addEventListener("change", function (e) {
        if (this.disabled) return;
        const enable = this.checked;
        grid.enableMove(enable);
        localStorage.setItem("enable_drag", enable ? "1" : "0");
    });

    // Gọi khi DOM load
    document.addEventListener("DOMContentLoaded", function () {
        applyToggleDrag();
    });

    // Gọi lại khi resize màn hình
    window.addEventListener("resize", function () {
        applyToggleDrag();
    });
</script>

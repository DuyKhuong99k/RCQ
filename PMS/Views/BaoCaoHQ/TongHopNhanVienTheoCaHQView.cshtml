
@{
    ViewData["Title"] = "TongHopNhanVienTheoCaHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Tổng Hợp Nhân Viên Theo Ca</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let fromDate = document.getElementById("fromDateBCHQ");
        let toDate = document.getElementById("toDateBCHQ");

        if (fromDate) {
            fromDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 00:00:00
            fromDate.value = `${year}-${month}-${day}T00:00:00`;
        }

        if (toDate) {
            toDate.step = "1";
            let now = new Date();
            let year = now.getFullYear();
            let month = String(now.getMonth() + 1).padStart(2, "0");
            let day = String(now.getDate()).padStart(2, "0");
            // 23:59:59
            toDate.value = `${year}-${month}-${day}T23:59:59`;
        }
    });
    var grid;
    var datalength = 0;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if(data != null && data.length !=null){
            datalength = data.length;
        }
        else{
            datalength = 0;
        }
        if (grid != null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
               pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                actionBegin: function (args) {
                    if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                        args.filterChoiceCount = datalength;
                    }
                },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    //{ field: 'STT', headerText: 'STT', width: 150 },
                    //{ field: 'Ngay', headerText: 'Ngày', width: 150 },
                    //{ field: 'NgayGio', headerText: 'Ngày Giờ', width: 150 },
                    { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                    { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                    { field: 'CaName', headerText: 'Ca', width: 150 },
                    //{ field: 'MaHoSoPV', headerText: 'Mã HSPV', width: 150 },
                    // { field: 'NhanVienPVName', headerText: 'Tên NVPV', width: 150 },
                    // { field: 'MaNhanVienBanKiem', headerText: 'Mã NVBK', width: 150 },
                    // { field: 'MaHoSoBK', headerText: 'Mã HSBK', width: 150 },
                    // { field: 'NhanVienBKName', headerText: 'Tên NVBK', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                    //{ field: 'MaLo', headerText: 'Lô', width: 150 },
                    //{ field: 'SizeName', headerText: 'Size', width: 150 },
                    { field: 'LoaiNguyenLieuName', headerText: 'Nguyên Liệu', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                    { field: 'SoRo', headerText: 'Số Rổ', type: 'number', width: 150 },
                    { field: 'GioBatDauCan', headerText: 'Giờ Bất Đầu', width: 150 },
                    { field: 'GioKetThucCan', headerText: 'Giờ Kết Thúc', width: 150 },
                    { field: 'TongGioLamViec', headerText: 'Tổng Giờ', width: 150 },
                    { field: 'TrongLuongTangCa', headerText: 'Trọng Lượng Tăng Ca', type: 'number', width: 200 },
                    { field: 'SoRoTangCa', headerText: 'Sổ Rổ Tăng Ca', type: 'number', width: 200 },
                    { field: 'GioBatDauTangCa', headerText: 'Giờ Bất Đầu Tăng Ca', width: 200 },
                    { field: 'GioKetThucTangCa', headerText: 'Giờ Kết Thúc Tăng Ca', width: 200 },
                    { field: 'TongGioTangCa', headerText: 'Tổng Giờ Tăng Ca', type: 'number', width: 200 },

                   
                    // { field: 'ChiSanLuong', headerText: 'Chỉ SL', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    // { field: 'TheId', headerText: 'Mã Thẻ', width: 150 },
                    // { field: 'MaMayCan', headerText: 'Máy Cân', width: 150 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuong',
                            //format: '0,000',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'SoRo',
                            //format: '0,000',
                            footerTemplate: 'Tổng Số Rổ: ${Sum}'
                        },
                        {
                            type: 'Sum',
                            field: 'SoRoTangCa',
                            //format: '0,000',
                            footerTemplate: 'Tổng Rổ Tăng Ca: ${Sum}'
                        },
                        {
                            type: 'Sum',
                            field: 'TrongLuongTangCa',
                            //format: '0,000',
                            footerTemplate: 'Tổng TL Tăng Ca: ${Sum}'
                        },
                        {
                            type: 'Sum',
                            field: 'TongGioTangCa',
                            //format: '0,000',
                            footerTemplate: 'Tổng Giờ Tăng Ca: ${Sum}'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    document.getElementById('RefreshButtonBCHQ').addEventListener("click",
        function () {
            var btn = document.getElementById('RefreshButtonBCHQ').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var fromDate =$('#fromDateBCHQ').val();
            var toDate = $('#toDateBCHQ').val();
            var xuongId = @XuongId;
            $.ajax({
                url: "@Url.Action("Reload", "BaoCaoHQ")",
                type: "POST",
                data: { "fromDate": fromDate, "toDate": toDate, xuongId: xuongId },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        ClearData("Grid");
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>


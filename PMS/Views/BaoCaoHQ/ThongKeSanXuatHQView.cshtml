@{
    ViewData["Title"] = "ThongKeSanXuatHQView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var XuongId = @Context.Session.GetString("XuongId");
    // var token = @Context.Session.GetString("JWTTokenEncry");
    // var url = AppViewModels.AppViewModel.Instance.ApiWssHostUrl + "/progressHub";
    // var encryptedUrl = Security.Crypt.ED.EncryptString(url);
}
<style>
    #modalXemPhieuThongKeSanXuat .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }
</style>
@* <input type="hidden" id="Token" value="@token" /> *@
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Thống Kê Sản Xuất</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    @{
                        var ketchuyenBravo = rolePermistions.Where(x => x.Fu == "Báo Cáo / Thống Kê Sản Xuất HQ" && x.Func == "Kết Chuyển Báo Cáo / Thống Kê Sản Xuất HQ" && x.Status == 1).FirstOrDefault();
                        if (ketchuyenBravo != null)
                        {
                            <div style="margin-top:20px;">
                                @* <button onclick="confirmPhieuThongKeSanXuat()" style="margin-right:5px" class="btn btn-outline-primary">Xác Nhận Dữ Liệu TKSX</button> *@
                                <button onclick="confirmPhieuThongKeSanXuat()" style="margin-right:5px" class="btn btn-outline-primary w-50 position-relative" type="submit" id="">
                                    <div class="">
                                        <span id="txtconfirmPhieuThongKeSanXuat">Xác Nhận Dữ Liệu TKSX</span>
                                        <div id="loadingIndicatorconfirmPhieuThongKeSanXuat" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                                <button onclick="showPhieuCanSua()" style="margin-right:5px" class="btn btn-outline-primary">Xem Dữ Liệu TKSX</button>
                            </div>
                        }
                    }
                    
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalXemPhieuThongKeSanXuat" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Phiếu Thống Kê Sản Xuất</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div id="GridPhieuThongKeSanXuat"></div>
                        <div id="progressStatus" hidden></div>
                        <div style="margin-top:20px;">
                            @* <button onclick="ketChuyenTKSX()" style="margin-right:5px" class="btn btn-outline-primary">Kết Chuyển</button> *@
                            <button onclick="ketChuyenTKSX()" style="margin-right:5px" class="btn btn-outline-primary w-50 position-relative" type="submit" id="">
                                <div class="">
                                    <span id="txtketChuyenTKSX">Kết Chuyển Dữ Liệu</span>
                                    <div id="loadingIndicatorketChuyenTKSX" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                        <span class="visually-hidden">Đang tải...</span>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" integrity="sha512-7rhBJh1om/W5Ztx7WiYOR9h2wlSaTmPyQMoHFtbT/FVNIA12y6S6I8HY9mrBS1uJ3dSU/R3qaSAXsGYuRjMDxg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
         let fromDate = document.getElementById("fromDateBCHQ");
         let toDate = document.getElementById("toDateBCHQ");

         if (fromDate) {
             fromDate.step = "1";
             let now = new Date();
             let year = now.getFullYear();
             let month = String(now.getMonth() + 1).padStart(2, "0");
             let day = String(now.getDate()).padStart(2, "0");
             // 00:00:00
             fromDate.value = `${year}-${month}-${day}T00:00:00`;
         }

         if (toDate) {
             toDate.step = "1";
             let now = new Date();
             let year = now.getFullYear();
             let month = String(now.getMonth() + 1).padStart(2, "0");
             let day = String(now.getDate()).padStart(2, "0");
             // 23:59:59
             toDate.value = `${year}-${month}-${day}T23:59:59`;
         }
     });
    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid != null) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    { field: 'Ngay', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                    { field: 'CaLamViec', headerText: 'Ca', width: 150 },
                    { field: 'MA_DAI_DIEN', headerText: 'Mã Tổ', width: 150 },
                    { field: 'TenNhom', headerText: 'Tên Tổ', width: 150 },
                    { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    //{ field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                    { field: 'TenNhanVien', headerText: 'Tên Nhân Viên', width: 150 },
                    //{ field: 'MaThanhPham', headerText: 'Mã Công Việc', width: 150 },
                    //{ field: 'ThanhPhamName', headerText: 'Tên Công Việc', width: 150 },
                    { field: 'MaSanPham', headerText: 'Mã Sản Phẩm Tính Lương', width: 350 },
                    { field: 'SanPhamName', headerText: 'Tên Sản Phẩm Tính Lương', width: 350 },
                    { field: 'TongTrongLuong', headerText: 'Sản Lượng', type: 'number', width: 150 },
                    { field: 'GioBatDau', headerText: 'Giờ Bất Đầu', width: 150},
                    { field: 'GioKetThuc', headerText: 'Giờ Kết Thúc', width: 150},
                    { field: 'TongGio', headerText: 'Tổng Giờ', width: 150},
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TongTrongLuong',
                            format: '####.000',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        }
                    ]
                }]
            });
            grid.appendTo('#Grid');
            grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
        }
    }
    loadGridData();

</script>
<script>
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        }

    }
    document.getElementById('RefreshButtonBCHQ').addEventListener("click",
        function () {
            var btn = document.getElementById('RefreshButtonBCHQ').ej2_instances[0];
            var content = btn.content;
            btn.content = "Đang Tải ...";
            var fromDate =$('#fromDateBCHQ').val();
            var toDate = $('#toDateBCHQ').val();
            var xuongId = @XuongId;
            $.ajax({
                url: "@Url.Action("Reload", "BaoCaoHQ")",
                type: "POST",
                data: { "fromDate": fromDate, "toDate": toDate, xuongId: xuongId },
                success: function (response) {
                    // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                    if (response.Success) {
                        ClearData("Grid");
                        loadGridData(response.Data);
                    } else {
                        loadGridData(response.Data);
                        console.error(response.Messages);
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Không có dữ liệu!");
                    }
                },
                error: function (error) {
                    toastOptionNotyfi();
                    toastr["error"](error, "Thông báo");
                }

            }).always(function () {
                btn.content = content;
            });
        });
</script>
<script>
    function confirmPhieuThongKeSanXuat() {
        var fromDate = $('#fromDateBCHQ').val();
        var toDate = $('#toDateBCHQ').val();
        var xuongId = @XuongId;
        
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn tạo dữ liệu Phiếu Thống Kê Sản Xuất!",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    document.getElementById("txtconfirmPhieuThongKeSanXuat").style.visibility = "hidden";
                    document.getElementById("loadingIndicatorconfirmPhieuThongKeSanXuat").style.display = "block";
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/BaoCaoHQ/DoInsertPhieuThongKeSanXuat',
                        data: { "fromDate": fromDate, "toDate": toDate, xuongId: xuongId},
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                //reloadDataXLPCHQ();
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");
                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        },
                        complete: function () {
                            document.getElementById("loadingIndicatorconfirmPhieuThongKeSanXuat").style.display = "none";
                            document.getElementById("txtconfirmPhieuThongKeSanXuat").style.visibility = "visible";
                        }
                    });
                }
            }
        });
    }
</script>
<script>
    var datalength = 0;
    function loadPhieuCanThongKeSnXuat(){
         var ngay = $('#toDateBCHQ').val();
        //var xuongId = @XuongId;
        $.ajax({

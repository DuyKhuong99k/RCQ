                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if(data != null && data.length !=null){
                    datalength = data.length;
                }
                else{
                    datalength = 0;
                }
                if (gridPhieuThongKeSanXuat) {
                    gridPhieuThongKeSanXuat.dataSource = dataManager;
                    gridPhieuThongKeSanXuat.refresh();
                } else {
                    gridPhieuThongKeSanXuat = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        actionBegin: function (args) {
                            if (args.requestType == 'filterchoicerequest' || args.requestType == 'filtersearchbegin') {

                                args.filterChoiceCount = datalength;
                            }
                        },
                        //frozenColumns: 3,
                        allowResizing: true,
                        //rowSelected: onRowSelected,
                        height: 400,
                        //width: 1000,
                        columns: [
                           // { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            //{ field: 'Id', headerText: 'Id', width: 50 },
                            //{ field: 'STT', headerText: 'STT', width: 150 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150 , type: 'date', format: 'dd-MM-yyyy' },
                            //{ field: 'NgayGio', headerText: 'Ngày Giờ', width: 150 },
                            { field: 'SoChungTu', headerText: 'Số Chứng Từ', width: 150 },
                            { field: 'Ca', headerText: 'Ca', width: 50 },
                            { field: 'MaTo', headerText: 'Mã Nhóm', width: 150 },
                            { field: 'TenTo', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'TenNhanVien', headerText: 'Tên Nhân Viên', width: 200 },
                            { field: 'MaCongViec', headerText: 'Mã Công Việc', width: 250 },
                            { field: 'TenCongViec', headerText: 'Tên Công Việc', width: 200 },
                            { field: 'SanLuong', headerText: 'Sản Lượng', type: 'number', width: 150 },
                            { field: 'GioBatDau', headerText: 'Giờ Bất Đầu', width: 100 ,type: 'date',  format: 'HH:mm' },
                            { field: 'GioKetThuc', headerText: 'Giờ Kết Thúc', width: 100,type: 'date',  format: 'HH:mm' },
                            { field: 'NgayGioTao', headerText: 'Ngày Giờ Tạo', width: 150,type: 'date',  format: 'dd-MM-yyyy HH:mm:ss'},
                        ],
                    });
                    // Hiển thị Grid trên trang web
                    gridPhieuThongKeSanXuat.appendTo('#GridPhieuThongKeSanXuat');
                    gridPhieuThongKeSanXuat.toolbarClick = function (args) {
                        if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                    }};

                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    var gridPhieuThongKeSanXuat;
    function showPhieuCanSua() {
         $('#modalXemPhieuThongKeSanXuat').modal('show');
         loadPhieuCanThongKeSnXuat();
    }


    function ketChuyenTKSX() {
        
        var dateTime = $('#toDateBCHQ').val();
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn Kết Chuyển dữ liệu này không?",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function(result) {
                if (result) {
                    document.getElementById("txtketChuyenTKSX").style.visibility = "hidden";
                    document.getElementById("loadingIndicatorketChuyenTKSX").style.display = "block";
                    const progressDiv = document.getElementById("progressStatus");
                    progressDiv.hidden = false;
                    progressDiv.textContent = "Đang xử lý...";
                    progressDiv.style.color = "";
                    progressDiv.style.fontWeight = "";
                    $.ajax({
                        url: '/BaoCaoHQ/KetChuyenThongKeSanXuatToBravo',
                        data: {
                            dateTime: dateTime
                        },
                        type: 'POST',
                        dataType: "json",
                        success: function(rs) {
                            if (rs.isSuccess === true) {
                                toastOptionNotyfi();
                                progressDiv.textContent = "KẾT CHUYỂN THÀNH CÔNG. " + rs.Messages;
                                progressDiv.style.color = "#28a745"; // xanh lá cây
                                progressDiv.style.fontWeight = "bold";
                                toastr["success"](rs.Messages, "Thông báo");
                            } else {
                                toastOptionNotyfi();
                                progressDiv.textContent = "KẾT CHUYỂN THẤT BẠI. " + rs.Messages;
                                progressDiv.style.color = "red";
                                progressDiv.style.fontWeight = "bold";
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function(error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        },
                        complete: function () {
                            document.getElementById("loadingIndicatorketChuyenTKSX").style.display = "none";
                            document.getElementById("txtketChuyenTKSX").style.visibility = "visible";
                        }
                    });
                }
            }
        });
    }

@using Newtonsoft.Json
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);

    var listLs = ViewBag.listLs;
    var listSsis = ViewBag.listSs;
    var listTPs = ViewBag.listTPs;
    var listLNLs = ViewBag.listLNLs;
    var DataNhanVien = ViewBag.DataNhanVien;
    var listXuongs = ViewBag.listXuongs;
    var XuongId = @Context.Session.GetString("XuongId");
}

<style>
    /* CSS */
    #modalThem .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    #modalSua .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    #modalXemPhieuCanXoa .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    #modalXemPhieuCanSua .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    .displayValueNV {
        width: 100%; /* Thiết lập chiều rộng của combobox bằng 100% để nó lớn hơn và mở rộng ra toàn bộ kích thước của phần tử cha */
    }
    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: 1px solid #d9dee3 !important;
        color: #697a8d !important;
        /*   font-weight: 400 !important;
                                                                            line-height: 1.53 !important; */
        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }

    div#inputpicker-wrapped-list.inputpicker-wrapped-list {
        width: 500px !important;
        max-height: 400px !important;
    }

    @@media (max-width: 768px) {
        div#inputpicker-wrapped-list.inputpicker-wrapped-list {
            width: 244px !important;
            max-height: 400px !important;
        }
    }

    .inputpicker-wrapped-list .inputpicker-active {
        background-color: #C0C0C0 !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Phiếu Cân HQ</h2>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>

                    <div style="margin-top:20px;">
                        @{
                            var themHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Thêm Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (themHQ_PhieuCan != null)
                            {
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary">Thêm</button>
                            }
                            var suaHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Sửa Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (suaHQ_PhieuCan != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Xoá Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (xoaHQ_PhieuCan != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var xemSuaHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Xem Sửa Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (xemSuaHQ_PhieuCan != null)
                            {
                                <button onclick="showPhieuCanSua()" style="margin-right:5px" class="btn btn-outline-primary">Xem Phiếu Cân Sửa</button>
                            }
                            var xemXoaHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Xem Xoá Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (xemXoaHQ_PhieuCan != null)
                            {
                                <button onclick="showPhieuCanXoa()" style="margin-right:5px" class="btn btn-outline-primary">Xem Phiếu Cân Xóa</button>
                            }
                            var importHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Import Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (importHQ_PhieuCan != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportHQ_PhieuCan = rolePermistions.Where(x => x.Fu == "Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Func == "Export Xử Lý Phiếu Cân HQ / Phiếu Cân HQ" && x.Status == 1).FirstOrDefault();
                            if (exportHQ_PhieuCan != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Phiếu Cân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Id</label>
                                    <input type="text" id="idXLPCHQ" class="form-control form-control-lg" disabled />
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">STT</label>
                                    <input type="text" id="sttXLPCHQ" class="form-control form-control-lg" disabled />
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Giờ</label>
                                    <input type="time" id="gioXLPCHQ" class="form-control form-control-lg" placeholder="Chọn giờ..." />
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Lô</label>
                                    <select id="maLoXLPCHQ" class="form-control form-control-lg">
                                        <option value="">Chọn lô</option>
                                        @foreach (var item in listLs)
                                        {
                                            <option value="@item.Id">@item.NgayNguyenLieu</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Size</label>
                                    <select id="maSizeXLPCHQ" class="form-control form-control-lg">
                                        <option value="">Chọn size</option>
                                        @foreach (var item in listSsis)
                                        {
                                            <option value="@item.Id">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamXLPCHQ" class="form-control form-control-lg">
                                        <option value="">Chọn thành phẩm</option>
                                        @foreach (var item in listTPs)
                                        {
                                            <option value="@item.Id">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-outline">
                                    <label class="form-label">Loại Nguyên Liệu</label>
                                    <select id="maloaiNguyenLieuXLPCHQ" class="form-control form-control-lg">
                                        <option value="">Chọn loại nguyên liệu</option>
                                        @foreach (var item in listLNLs)
                                        {
                                            <option value="@item.Id">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng</label>
                                    <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongXLPCHQ" placeholder="0.000" />
                                </div>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-md-4 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên</label>
                                    @* <input class="form-control form-control-lg" id="maNhanVienXLPCHQ" placeholder="Chọn nhân viên" /> *@
                                    <ejs-combobox id="maNhanVienXLPCHQ"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 75px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên Phục Vụ</label>
                                    <@* input class="form-control form-control-lg" id="maNhanVienPhucVuXLPCHQ" placeholder="Chọn nhân viên phục vụ" /> *@
                                    <ejs-combobox id="maNhanVienPhucVuXLPCHQ"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên phục vụ"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 75px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="form-outline">
                                    <label class="form-label">Nhân Viên Bàn Kiểm</label>
                                    @* <input class="form-control form-control-lg" id="maNhanVienBanKiemXLPCHQ" placeholder="Chọn nhân viên bàn kiểm" /> *@
                                    <ejs-combobox id="maNhanVienBanKiemXLPCHQ"
                                                  open="onComboBoxOpen"
                                                  dataBound="isCheckScroll"
                                                  dataSource="@DataNhanVien"
                                                  cssClass="e-multi-column"
                                                  filtering="onfiltering"
                                                  allowFiltering="true"
                                                  placeholder="Chọn nhân viên bàn kiểm"
                                                  popupHeight="400px"
                                                  enableVirtualization="true"
                                                  headerTemplate="@Html.Raw("<table><tr><th class='e-text-center' style='width: 75px;'>Mã</th><th>Tên</th><th>Nhóm</th></tr></table>")"
                                                  itemTemplate="@Html.Raw("<table><tbody><tr><td class='e-text-center' style='width: 75px;'>${MaNhanVien}</td><td>${Name}</td><td>${DeptName0}</td></tr> </tbody></table>")">
                                        <e-combobox-fields text="Name" value="MaNhanVien"></e-combobox-fields>
                                    </ejs-combobox>
                                </div>
                            </div>

                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var gridPhieuCanSua;
    function showPhieuCanSua() {
        var dateTime = $('#dateTimeXLPC').val();
        var xuongId = @XuongId;
        $.ajax({
            url: '/XuLyPhieuCanHQ/GetPhieuCanSua',
            data: {
                dateTime: dateTime,
                xuongId: xuongId
                            },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (gridPhieuCanSua) {
                    gridPhieuCanSua.dataSource = dataManager;
                    gridPhieuCanSua.refresh();
                } else {
                    gridPhieuCanSua = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        //rowSelected: onRowSelected,
                        //height: 400,
                        //width: 1000,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'Id', headerText: 'Id', width: 150 },
                            { field: 'STT', headerText: 'STT', width: 150 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'NgayGio', headerText: 'Ngày Giờ', width: 150 },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                            { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'MaNhanVienPhucVu', headerText: 'Mã NVPV', width: 150 },
                            { field: 'MaHoSoPV', headerText: 'Mã HSPV', width: 150 },
                            { field: 'NhanVienPVName', headerText: 'Tên NVPV', width: 150 },
                            { field: 'MaNhanVienBanKiem', headerText: 'Mã NVBK', width: 150 },
                            { field: 'MaHoSoBK', headerText: 'Mã HSBK', width: 150 },
                            { field: 'NhanVienBKName', headerText: 'Tên NVBK', width: 150 },
                            { field: 'MaLo', headerText: 'Lô', width: 150 },
                            { field: 'SizeName', headerText: 'Size', width: 150 },
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'LoaiNguyenLieuName', headerText: 'Loại Thành Phẩm', width: 150 },
                            { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                            { field: 'ChiSanLuong', headerText: 'Chỉ SL', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'TheId', headerText: 'Mã Thẻ', width: 150 },
                            { field: 'MayCan', headerText: 'Máy Cân', width: 150 },
                        ],
                    });
                    // Hiển thị Grid trên trang web
                    gridPhieuCanSua.appendTo('#GridPhieuCanSua');
                    $('#modalXemPhieuCanSua').modal('show');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }

                { text: 'Chuyển nhân viên phục vụ', id: 'changeNhanVienPhucVu' },
                { text: 'Chuyển nhân viên bàn kiểm', id: 'changeNhanVienBanKiem' },

            ];
            grid = new ej.grids.Grid({

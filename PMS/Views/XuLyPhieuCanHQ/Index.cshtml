        });
        if (grid) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {

            var contextMenuItems = [
                { text: 'Xem ghi chú', id: 'viewNote' },
                { text: 'Chuyển xưởng', id: 'changeDepartment' },
                { text: 'Chuyển size', id: 'changeSize' },

        var fromDate = document.getElementById("fromDateBCN").value;
        var toDate = document.getElementById("toDateBCN").value;
        var keyWord = document.getElementById("inputTimKiem").value;
        var typeSearch = document.getElementById("loaiTimKiem").value;
        var khauBCN = document.getElementById("khauBCN").value;
        var xuongId = document.getElementById("XuongBCN").value;

        // Khởi tạo danh sách lỗi
        var errors = [];

        if (!fromDate) {
            errors.push("Vui lòng nhập 'Từ ngày'");
        }
        if (!toDate) {
            errors.push("Vui lòng nhập 'Đến ngày'");
        }
        if (!keyWord) {
            errors.push("Vui lòng nhập 'Từ khóa'");
        }
        if (!typeSearch) {
            errors.push("Vui lòng chọn 'Loại tìm kiếm'");
        }
        if (!khauBCN) {
            errors.push("Vui lòng chọn 'Khâu'");
        }
        if (!xuongId) {
            errors.push("Vui lòng chọn 'Xưởng'");
        }

        // Nếu có lỗi, hiển thị thông báo và vô hiệu hóa nút
        if (errors.length > 0) {
            toastOptionNotyfi();
            toastr["warning"](errors.join("\n"), "Không Có Dữ Liệu Biểu Đồ");
            return;
            // document.getElementById("taiBaoCaoBtn").disabled = true;
        } else {
            // Nếu không có lỗi
            // Gọi AJAX để lấy dữ liệu jsonData và chartData
            var jsonData = getDataForGrid(fromDate, toDate, keyWord, typeSearch, khauBCN, xuongId);
            var chartData = getDataForChart(fromDate, toDate, keyWord, typeSearch, khauBCN, xuongId);

            switch (khauBCN) {
            case "PhieuCanPhuPhamv2":
                loadGridData_PhieuCanPhuPhamv2(jsonData);
                loadChart_PhieuCanPhuPhamv2(chartData);
                break;

            case "PhieuCanBTPFilletv2":
                loadGridData_PhieuCanBTPFilletv2(jsonData);
                loadChart_PhieuCanBTPFilletv2(chartData);
                break;

            case "PhieuCanLangDa":
                loadGridData_PhieuCanLangDa(jsonData);
                loadChart_PhieuCanLangDa(chartData);
                break;

            case "PhieuCanTPFillet":
                loadGridData_PhieuCanTPFillet(jsonData);
                loadChart_PhieuCanTPFillet(chartData);
                break;
            case "PhieuCanTPFilletv2":
                loadGridData_PhieuCanTPFilletv2(jsonData);
                loadChart_PhieuCanTPFilletv2(chartData);
                break;
            case "PhieuCanSoCheDinhHinh":
                loadGridData_PhieuCanSoCheDinhHinh(jsonData);
                loadChart_PhieuCanSoCheDinhHinh(chartData);
                break;
            case "PhieuCanBTPDinhHinh":
                loadGridData_PhieuCanBTPDinhHinh(jsonData);
                loadChart_PhieuCanBTPDinhHinh(chartData);
                break;
            case "PhieuCanTPDinhHinh":
                loadGridData_PhieuCanTPDinhHinh(jsonData);
                loadChart_PhieuCanTPDinhHinh(chartData);
                break;
            case "PhieuCanChinhXepKhuon":
                loadGridData_PhieuCanChinhXepKhuon(jsonData);
                loadChart_PhieuCanChinhXepKhuon(chartData);
                break;
            case "PhieuCanPhuXepKhuon":
                loadGridData_PhieuCanPhuXepKhuon(jsonData);
                loadChart_PhieuCanPhuXepKhuon(chartData);
                break;
            case "PhieuCanXepKhuonBlock":
                loadGridData_PhieuCanXepKhuonBlock(jsonData);
                loadChart_PhieuCanXepKhuonBlock(chartData);
                break;
            case "PhieuCanXepKhuonKHC":
                loadGridData_PhieuCanXepKhuonKHC(jsonData);
                loadChart_PhieuCanXepKhuonKHC(chartData);
                break;
            case "PhieuCanTaiChe":
                loadGridData_PhieuCanTaiChe(jsonData);
                loadChart_PhieuCanTaiChe(chartData);
                break;
            case "BT_PhieuCan":
                loadGridData_BT_PhieuCan(jsonData);
                loadChart_BT_PhieuCan(chartData);
                break;

            // Thêm các case khác tương tự
            default:
                console.log("Giá trị không hợp lệ");
                break;
            }
        }

    }


</script>

    <script>
    $(document).ready(function () {
        var today = new Date();

        // Định dạng ngày thành yyyy-MM-dd (định dạng của trường input date)
        var formattedDate = today.toISOString().substr(0, 10);
        // Gán giá trị vào trường input
        document.getElementById("toDateBCN").value = formattedDate;
        document.getElementById("fromDateBCN").value = formattedDate;


    });
</script>
    <script>
        var currentViewChartData;
    var grid_PhieuCanPhuPhamv2;
    function loadGridData_PhieuCanPhuPhamv2(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid_PhieuCanPhuPhamv2 && data != null && data != "") {
            grid_PhieuCanPhuPhamv2.dataSource = dataManager;
            grid_PhieuCanPhuPhamv2.refresh();
        } else {
            if (grid_PhieuCanPhuPhamv2) {
                grid_PhieuCanPhuPhamv2.destroy();
                document.getElementById('Grid-PhieuCanPhuPhamv2').innerHTML = '';
            }
            grid_PhieuCanPhuPhamv2 = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50 },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                allowResizing: true,
                height: 400,
                columns: [
                    { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                    { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                    { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                    { field: 'SoRo', headerText: 'Số Rổ', type: 'number', width: 150 },
                ],
                aggregates: [{
                    columns: [
                        {
                            type: 'Sum',
                            field: 'TrongLuong',
                            footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                        },
                        {
                            type: 'Sum',
                            field: 'SoRo',
                            footerTemplate: 'Tổng Số Rổ: ${Sum}'
                        }
                    ]
                }]
            });
            grid_PhieuCanPhuPhamv2.appendTo('#Grid-PhieuCanPhuPhamv2');
        }
    }

    var chart_PhieuCanPhuPhamv2;
    function loadChart_PhieuCanPhuPhamv2(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        var maxYValue = 100;
        if (data && Array.isArray(data) && data.length > 0) {
            // Tìm giá trị lớn nhất của y trong dữ liệu (double)
            maxYValue = Math.max(...data.map(item => item.y));
        }
        var dynamicMaximum = Math.ceil(maxYValue);

        if (chart_PhieuCanPhuPhamv2 && data && data.length > 0) {
            chart_PhieuCanPhuPhamv2.dataSource = dataManager;
            chart_PhieuCanPhuPhamv2.primaryYAxis.maximum = dynamicMaximum; // Cập nhật giá trị maximum
            chart_PhieuCanPhuPhamv2.primaryYAxis.interval = dynamicMaximum > 0 ? Math.round(dynamicMaximum / 3) : 1; // Cập nhật interval
            chart_PhieuCanPhuPhamv2.refresh();
        } else {
            if (chart_PhieuCanPhuPhamv2) {
                chart_PhieuCanPhuPhamv2.destroy();
                document.getElementById('column-container-PhieuCanPhuPhamv2').innerHTML = '';
            }
            chart_PhieuCanPhuPhamv2 = new ej.charts.Chart({
                primaryXAxis: {
                    valueType: 'Category', interval: 1, majorGridLines: { width: 0 }, majorTickLines: { width: 0 },
                    labelIntersectAction: 'None', labelRotation: 270, minorTickLines: { width: 0 },
                    labelStyle: {
                        fontWeight: 'bold',  // Đặt chữ in đậm
                        size: '14px',        // Tăng kích thước chữ
                        color: '#333333'     // Đặt màu sắc chữ dễ nhìn (màu tối hơn)
                    }
                },
                chartArea: { border: { width: 0 } },
                primaryYAxis: {
                    title: 'Trọng Lượng',
                    majorTickLines: { width: 0 }, lineStyle: { width: 0 },
                    maximum: dynamicMaximum,
                    interval: dynamicMaximum > 0 ? Math.round(dynamicMaximum / 3) : 1
                },
                series: [
                    {
                        type: 'Column', xName: 'x', width: 2, yName: 'y', name: "Trọng Lượng",// name: (dataManager != "" || dataManager != null) ? data[0].x : "Thành Phẩm",
                        columnSpacing: 0.1,
                        dataSource: data,
                        marker: {
                            dataLabel:
                            {
                                visible: true,
                                font: {
                                    fontWeight: '600',
                                    color: '#000000'
                                }

                            }
                        }
                    }
                ],
                title: 'Biểu Đồ Năng Suất',
                width: ej.base.Browser.isDevice ? '100%' : '75%',
                tooltip: { enable: true },

            });
            chart_PhieuCanPhuPhamv2.appendTo('#column-container-PhieuCanPhuPhamv2');
        }
    }


    function loadGridData_DashboardHQ(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        document.getElementById('Grid-DashboardHQ').innerHTML = '';
        var grid_DashboardHQ = new ej.grids.Grid({
            dataSource: dataManager,
            allowPaging: true,
            pageSettings: { pageSize: 50 },
            allowFiltering: true,
            allowSorting: true,
            filterSettings: { type: 'Excel' },
            selectionSettings: { persistSelection: true },
            allowResizing: true,
            columns: [
                { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                { field: 'MaLo', headerText: 'Mã Lô', width: 150 },
                { field: 'SizeName', headerText: 'Size', width: 150 },
                { field: 'LoaiNguyenLieuName', headerText: 'Loại Nguyên Liệu', width: 150 },
                { field: 'TrongLuong', headerText: 'Trọng Lượng', type: 'number', width: 150 },
                { field: 'SoRo', headerText: 'Số Rổ', type: 'number', width: 150 },
            ],
            aggregates: [{
                columns: [
                    {
                        type: 'Sum',
                        field: 'TrongLuong',
                        footerTemplate: 'Tổng Trọng Lượng: ${Sum} Kg'
                    },
                    {
                        type: 'Sum',
                        field: 'SoRo',
                        footerTemplate: 'Tổng Số Rổ: ${Sum}'
                    }
                ]
            }]
        });
        grid_DashboardHQ.appendTo('#Grid-DashboardHQ');

    }


    let chart_DashboardHQ = null;

    function loadChart_DashboardHQ(data) {
        // Khởi tạo biểu đồ chỉ khi chưa tồn tại
        if (!chart_DashboardHQ) {
            chart_DashboardHQ = new ej.charts.Chart({
                primaryXAxis: {
                    valueType: 'Category',
                    interval: 1,
                    majorGridLines: { width: 0 },
                    majorTickLines: { width: 0 },
                    labelIntersectAction: 'None',
                    labelRotation: 270,
                    minorTickLines: { width: 0 },
                    labelStyle: {
                        fontWeight: 'bold',
                        size: '18px',
                        color: '#333333'
                    }
                },
                chartArea: { border: { width: 0 } },
                primaryYAxis: {
                    title: 'Trọng Lượng',
                    majorTickLines: { width: 0 },
                    lineStyle: { width: 0 },
                    interval: 1 // Giá trị mặc định
                },
                series: [
                    {
                        type: 'Column',
                        xName: 'x',
                        yName: 'y',
                        name: "Trọng Lượng",
                        columnSpacing: 0.1,
                        marker: {
                            dataLabel: {
                                visible: true,
                                font: {
                                    fontWeight: '600',
                                    color: '#000000',
                                    size: '20px'
                                }
                            }
                        }
                    }
                ],
                title: 'Biểu Đồ Năng Suất',
                width: ej.base.Browser.isDevice ? '100%' : '75%',
                tooltip: { enable: true },
            });
            chart_DashboardHQ.appendTo('#column-container-DashboardHQ');
        }

        // Cập nhật dữ liệu nếu có
        if (data && Array.isArray(data) && data.length > 0) {
            const maxYValue = Math.max(...data.map(item => item.y));
            const dynamicMaximum = Math.ceil(maxYValue);
            const dynamicInterval = dynamicMaximum > 0 ? Math.round(dynamicMaximum / 3) : 1;

            // Cập nhật trực tiếp dataSource và thuộc tính trục Y
            chart_DashboardHQ.series[0].dataSource = data;
            chart_DashboardHQ.primaryYAxis.maximum = dynamicMaximum;
            chart_DashboardHQ.primaryYAxis.interval = dynamicInterval;

            // Gọi animate để cập nhật mượt mà mà không làm mới toàn bộ
            chart_DashboardHQ.animate();
        }
    }




    function getDataForGrid(xuongId) {
        var jsonData = null;

        $.ajax({
            url: '/DashboardHQ/Reload',
            type: 'GET',
            data: {
                xuongId: xuongId
            },
            async: false, // Để đảm bảo dữ liệu được trả về trước khi tiếp tục xử lý
            success: function (response) {
                if (response.Success) {
                    jsonData = response.Data


                } else {
                    //toastOptionNotyfi();
                    //toastr["warning"](response.Messages, "Không Có Dữ Liệu");
                }
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });

        return jsonData;
    }

    function getDataForChart(xuongId) {
        let chartData = null;

        $.ajax({
            url: '/DashboardHQ/Reload',
            type: 'GET',
            data: { xuongId: xuongId },
            async: false, // Giữ lại nếu cần đồng bộ, nhưng nên cân nhắc async: true
            success: function (response) {
                if (response.Success) {
                    chartData = response.DataChart;
                    const weightDisplays = document.querySelectorAll('.weight-display');

                    // Clear và cập nhật trọng lượng
                    weightDisplays.forEach(display => {
                        display.textContent = `${response.TotalTrongLuong} kg`;
                    });
                } else {
                    // Xử lý lỗi nếu cần
                    console.warn(response.Messages || 'Không có dữ liệu biểu đồ');
                }
            },
            error: function (error) {
                console.error('Error:', error);
            }
        });

        return chartData;
    }

    function taiBaoCao() {
        var xuongId = @XuongId;
        AddUserWaitView(xuongId);
        var jsonData = getDataForGrid(xuongId);
        var chartData = getDataForChart(xuongId);
        loadGridData_DashboardHQ(jsonData);
        loadChart_DashboardHQ(chartData)
    }
    var timeInterval = @AppViewModels.AppViewModel.Instance.TimeSetIntervalDashBoardView;
    setInterval(taiBaoCao, timeInterval);
</script>
<script>
    $(document).ready(function () {
        loadGridRoleData();
        loadGridDataDecentralization();
    });
    var gridRole;
    function loadGridRoleData() {
        $.ajax({
            url: '/Authentication/GetAllRoles',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (gridRole) {
                    gridRole.dataSource = dataManager;
                    gridRole.refresh();
                } else {
                    gridRole = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        allowSorting: true,
                        filterSettings: { type: 'Excel' },
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelectedRole,
                        height: 300,
                        columns: [
                            { field: 'Id', headerText: 'Id', width: 15 },
                            { field: 'Name', headerText: 'Vai Trò', width: 50 }
                            //{ field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    gridRole.appendTo('#GridRole');
                    gridRole.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                gridRole.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridRoleData();
    function reloadDataRole() {
        loadGridRoleData();
    }
    function ClearData(GridId) {
        try {
            var gridObj = document.getElementById(GridId).ej2_instances[0];
            if(gridObj)
                gridObj.dataSource = [];
        } catch (e) {
            Console.log(e);
        } 
       
    }
    function onRowSelectedRole(args) {
        ClearData("GridDecentralization");
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var IdRole = selectedRecord.Id;
        $('#maRoleRowSelected').val(IdRole);
        reloadGridDataDecentralization(IdRole);

    }
    function reloadGridDataDecentralization(IdRole) {
        $.ajax({
            url: "/Authentication/GetsByRoleIdDecentralization",
            data: { IdRole: IdRole },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs != null) {
                    loadGridDataDecentralization(rs);
                    document.getElementById("creatPermistion").style.display = "block";
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }

    var gridDecentralization;

    function initializeGrid(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });

        gridDecentralization = new ej.grids.Grid({
            dataSource: dataManager,
            allowPaging: true,
            pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
            allowFiltering: true,
            filterSettings: { type: 'Excel' },
            allowSorting: true,
            allowResizing: true,
            allowExcelExport: true,
            toolbar: ['ExcelExport'],
            rowSelected: onRowSelectedDecentralization,
            height: 300,
            columns: [
                { field: 'Fu', headerText: 'Chức Năng', width: 300 },
                { field: 'Func', headerText: 'Hành Động', width: 250 },
                { field: 'CreatedDateTime', headerText: 'Ngày Tạo', type: 'date', format: 'dd/MM/yyyy', width: 100 },
                { field: 'Status', headerText: 'Trạng Thái', width: 100, template: '#StatusTemplate' },
            ]
        });

        // Hiển thị Grid trên trang web
        gridDecentralization.appendTo('#GridDecentralization');
        gridDecentralization.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                gridDecentralization.excelExport();
             }};
    }

    function onRowSelectedDecentralization(args) {
        var selectedRecord = args.data;
        var IdDecentralization = selectedRecord.Id;
        $('#maDecentralizationRowSelected').val(IdDecentralization);
    }

    function loadGridDataDecentralization(data) {
        if (gridDecentralization) {
            var dataManager = new ej.data.DataManager({
                json: data,
                adaptor: new ej.data.JsonAdaptor()
            });
            gridDecentralization.dataSource = dataManager;
            gridDecentralization.refresh();
        } else {
            initializeGrid(data);
        }
    }

    // // Sử dụng hàm này để tải dữ liệu vào lưới
    // loadGridDataDecentralization(/* provide your data here */);
</script>
<script>

    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/Authentication/RoleCreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maRole').val(rs.Id);
                    $('#tenRole').val(rs.Ten);
                    //$('#suDungRole').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maRole').val();
        var ten = $('#tenRole').val();
        var suDung = $('#suDungRole').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/Authentication/DoInsertRole',
            data: {
                ma: ma,
                ten: ten
                //suDung: suDung
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadDataRole();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>

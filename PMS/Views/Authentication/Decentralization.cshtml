        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn xoá quyền này!",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/Authentication/DoDeleteDecentralization',

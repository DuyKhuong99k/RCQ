@{
    ViewData["Title"] = "GrantAccess";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<div class="container-xxl flex-grow-1 container-p-y" style="margin-top:-51px">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Phân Quyền /</span> Phân Quyền</h4>
    <div class="row">
        <div class="col-md-12">
            <ul class="nav nav-pills flex-column flex-md-row mb-3">
                <li class="nav-item">
                    <a class="nav-link " href="/Authentication/Decentralization"><i class='bx bx-shield'></i> Tạo Quyền</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/Authentication/GrantAccess"><i class='bx bx-shield-quarter'></i> Phân Quyền</a>
                </li>
                @{
                    var hubs = rolePermistions.Where(x => x.Fu.Contains("Hubs")).FirstOrDefault();
                    if (hubs != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Authentication/UserArea"><i class='bx bx-shield'></i> Người Dùng Theo Khu Vực Máy Cân</a>
                        </li>
                    }
                }
            </ul>
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Phần Quyền Cho Người Dùng</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-9">
                            <h6>Danh sách người dùng</h6>
                            <div id="Grid"></div>
                            <div style="margin-top:20px;">
                                <button onclick="showCreatUserRole()" style="margin-right:5px;margin-bottom:5px" type="button" class="btn btn-outline-primary"><i class='bx bx-shield-quarter'></i>Thêm Vai Trò</button>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <h6>Vai trò của người dùng</h6>
                            <div id="GridUserRole"></div>
                            <div style="margin-top:20px">
                                <button onclick="cancelUserRole()" style="margin-right:5px;margin-bottom:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Huỷ Vai Trò</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThemUserRole" tabindex="-1" aria-hidden="true" data-bs-focus="false" no-enforce-focus>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Vai Trò Cho Người Dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mb-12 ">
                        <label class="form-label">Vai Trò</label>
                        <input class="form-control" type="text" id="multiselectRole" />
                    </div>
                </div>
                <div class="row mt-4 pt-2">
                    <div class="col-12">
                        <button onclick="CreatUserRole()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                            <div class=" align-items-center">
                                <span id="txtUserRole">Xác Nhận</span>
                                <div id="loadingIndicatorUserRole" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input id="idUserRowSelected" type="hidden" />
<input id="maUserRoleRowSelected" type="hidden" />
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
<script id="statusTemplate" type="text/x-template">
    <div>
        ${if(Status===1)}
           <span class="badge bg-info">Thử việc</span>
        ${else if(Status===2)}
            <span class="badge bg-primary">Đang làm</span>
        ${else if(Status===3)}
            <span class="badge bg-secondary">Tạm nghĩ</span>
        ${else if(Status===4)}
            <span class="badge bg-dark">Đã nghĩ</span>
        ${else}
            <span class=’ico-female’></span>
        ${/if}
    </div>
</script>

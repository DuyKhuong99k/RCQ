<script>
    $(document).ready(function () {
        loadGridData();
        loadGridDataUserRole();
    });
    var grid;

    function loadGridData() {
        $.ajax({
            url: '/Authentication/GetAllUser',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });

                // Kiểm tra xem Grid đã được tạo chưa
                if (grid) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 10 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 300,
                        columns: [
                            //{ field: 'STT', headerText: 'STT', width: 80, textAlign: 'Center' },
                            { field: 'Id', headerText: 'Id', width: 80, textAlign: 'Center' },
                            { field: 'UserName', headerText: 'Tài khoản', width: 100 },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'HoTen', headerText: 'Họ tên', width: 150 },
                            { field: 'IsActive', headerText: 'Kích Hoạt', width: 150, template: '#isActiveTemplate' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }

    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var id = selectedRecord.Id;
        $('#idUserRowSelected').val(id);
        reloadGridDataUserRole(id);
    }

    function reloadGridDataUserRole(userId) {
        $.ajax({
            url: "/Authentication/GetsByUserIdUserRole",
            data: { userId: userId },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs != null) {
                    loadGridDataUserRole(rs);
                    // document.getElementById("creatPermistion").style.display = "block";
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    var gridUserRole;
    function initializeGrid(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });

        gridUserRole = new ej.grids.Grid({
            dataSource: dataManager,
            allowPaging: true,
            pageSettings: { pageSize: 50 },
            allowFiltering: true,
            filterSettings: { type: 'Excel' },
            allowSorting: true,
            allowResizing: true,
            rowSelected: onRowSelectedUserRole,
            height: 300,
            columns: [

                { field: 'RoleName', headerText: 'Vai Trò', width: 150 }
            ]
        });

        // Hiển thị Grid trên trang web
        gridUserRole.appendTo('#GridUserRole');
    }

    function onRowSelectedUserRole(args) {
        var selectedRecord = args.data;
        var IdUserRole = selectedRecord.Id;
        $('#maUserRoleRowSelected').val(IdUserRole);
    }

    function loadGridDataUserRole(data) {
        if (gridUserRole) {
            var dataManager = new ej.data.DataManager({
                json: data,
                adaptor: new ej.data.JsonAdaptor()
            });
            gridUserRole.dataSource = dataManager;
            gridUserRole.refresh();
        } else {
            initializeGrid(data);
        }
    }

</script>
<script>
    var multiselectObjRole;
    function multiselectRole(userId) {

        function loadJSON(callback) {
            $.ajax({
                url: '/Authentication/GetRolesFilterIsExst',
                data: {
                    userId: userId
                },
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    callback(data);
                },
                error: function (xhr, status, error) {
                    toastOptionNotyfi();
                    toastr["error"]('Lỗi khi gọi API: ' + error.toString(), "Thông báo");
                }
            });
        }

        if (multiselectObjRole) {
            // Lấy dữ liệu mới và cập nhật cho MultiSelect hiện tại
            loadJSON(function (data) {
                multiselectObjRole.dataSource = data;
                multiselectObjRole.refresh();
            });
        } else {
            // Nếu chưa được khởi tạo, tạo mới MultiSelect
            initializeMultiSelect();
        }


        function initializeMultiSelect() {
            loadJSON(function (data) {
                multiselectObjRole = new ej.dropdowns.MultiSelect({
                    dataSource: data,
                    fields: { text: 'Name', value: 'Id' },
                    placeholder: 'Chọn Vai Trò',
                    mode: 'CheckBox',
                    showSelectAll: true,
                    showDropDownIcon: true,
                    filterBarPlaceholder: 'Tìm Vai Trò',
                    zIndex: 9999
                });
                multiselectObjRole.appendTo('#multiselectRole');
            });
        }
    }

    function showCreatUserRole() {
        var userId = $('#idUserRowSelected').val();
        $('#modalThemUserRole').modal('show');
        multiselectRole(userId);

    }


    function CreatUserRole() {
        document.getElementById("txtUserRole").style.visibility = "hidden";
        document.getElementById("loadingIndicatorUserRole").style.display = "block";
        var userId = $('#idUserRowSelected').val();

        var selectedRoleIdValues = multiselectObjRole.value;

        var listroleId = selectedRoleIdValues.join(', ');

        $.ajax({
            url: '/Authentication/DoInsertUserRole',
            data: {
                userId: userId,
                listroleId: listroleId
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalThemUserRole').modal('hide');
                    reloadGridDataUserRole(userId);
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorUserRole").style.display = "none";
                document.getElementById("txtUserRole").style.visibility = "visible";
            }
        });

    }

    function cancelUserRole() {
        var userRoleId = $('#maUserRoleRowSelected').val();
        var userId = $('#idUserRowSelected').val();
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn huỷ vai trò này! ",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/Authentication/DoDeleteUserRole',
                        data: { userRoleId: userRoleId },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                reloadGridDataUserRole(userId);
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");
                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                        }
                    });
                }
            }
        });



    }
</script>


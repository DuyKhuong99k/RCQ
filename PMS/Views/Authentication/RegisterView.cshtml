<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;

    function loadGridData() {
        $.ajax({
            url: '/Authentication/GetAllUser',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });

                // Kiểm tra xem Grid đã được tạo chưa
                if (grid) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        //height: 400,
                        columns: [
                            { field: 'STT', headerText: 'STT', width: 80, textAlign: 'Center' },
                            { field: 'Id', headerText: 'Id', width: 80, textAlign: 'Center' },
                            { field: 'UserName', headerText: 'Tài khoản', width: 100 },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'HoTen', headerText: 'Họ tên', width: 150 },
                            { field: 'Email', headerText: 'Email', width: 200 },
                            { field: 'PhoneNumber', headerText: 'Số Điện Thoại', width: 100 },
                            { field: 'Address', headerText: 'Địa Chỉ', width: 200 },
                            //{ field: 'Status', headerText: 'Trạng Thái', width: 150, template: '#statusTemplate' },
                            { field: 'IsActive', headerText: 'Kích Hoạt', width: 150, template: '#isActiveTemplate' },
                            //{ field: '', headerText: '', width: 100, template: '#optionTemplate' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }

    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var id = selectedRecord.Id;
        $('#idUserRowSelected').val(id);
    }
    function register(input) {
        var username = $("#userName").val();
        var password = $("#passWord").val();
        var hoten = $("#hoTen").val();
        var phoneNumber = $("#phoneNumber").val();
        var maNhanVien = $("#maNhanVien").val();
        if (!username || !password || !hoten || !phoneNumber || !maNhanVien) {
            toastOptionNotyfi();
            toastr["error"]("Vui lòng nhập đầy đủ thông tin!", "Thông báo");
            return false;
        }
        // Ẩn chữ "Đăng Ký"
        document.getElementById("txtDangKy").style.visibility = "hidden";
        // Hiển thị chỉ báo tải
        //$("#loadingIndicator").show();
        document.getElementById("loadingIndicator").style.display = "block";

        $.ajax({
            type: "POST",
            url: "/Authentication/DoRegister",
            data: { username: username, password: password, hoten: hoten, phoneNumber: phoneNumber, maNhanVien: maNhanVien }, // Không cần JSON.stringify ở đây
            success: function (response) {
               
                if (response.isSuccess === true) {
                    // $.notify(rs.Messages, "success");
                    toastOptionNotyfi();
                    toastr["success"](response.Messages, "Thông báo");

                    // Xóa dữ liệu trong modal
                    $('#userName').val('');
                    $('#passWord').val('');
                    $('#hoTen').val('');
                    $('#phoneNumber').val('');
                    $('#maNhanVien').val('');

                    // Ẩn modal
                    $('#modalDangKy').modal('hide');
                    reloadData();
                }
                else {
                    if (response.Messages == null || response.Messages == "") {

                    }
                    else {
                        toastOptionNotyfi();
                        toastr["error"](response.Messages, "Thông báo");
                    }

                }
            },
            error: function (xhr, status, error) {
                if (response.Messages == null || response.Messages == "") {

                }
                else {
                    toastOptionNotyfi();
                    toastr["error"]('Đã xảy ra lỗi khi gửi yêu cầu đăng ký: ' + error, "Thông báo");
                }
                //$.notify(rs.Messages, "error");
            },
            complete: function () {
                // // Ẩn chỉ báo tải sau khi nhận kết quả hoặc gặp lỗi
                // Sau khi tải xong, ẩn chỉ báo tải và hiển thị lại chữ "Đăng Ký"
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtDangKy").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function btnShowInfo() {
       
        var id = $('#idUserRowSelected').val();
        $.ajax({
            url: '/Authentication/GetInfoUserById',
            data: { id: id},
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    
                    $('#usernameInfo').val(rs.UserName);
                    $('#avatarImgInfo').val(rs.AvatarImg);
                    $('#hoTenInfo').val(rs.HoTen);
                    $('#emailInfo').val(rs.Email);
                    $('#maNhanVienInfo').val(rs.MaNhanVien);
                    $('#phoneNumberInfo').val(rs.PhoneNumber);
                    $('#addressInfo').val(rs.Address);
                    $('#cardIDInfo').val(rs.CardID);
                    $('#isActiveInfo').prop('checked', rs.IsActive);
                    //$('#statusInfo').val(rs.Status);
                    $('#userNameInfo').val(rs.UserName);
                    $('#passwordInfo').val(rs.Password);
                    $('#modalInfo').modal('show');
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }

    function updateInfoUser() {
        var id = $('#idUserRowSelected').val();
        var avatarImg = $('#avatarImgInfo').val();
        var hoten = $('#hoTenInfo').val();
        var email = $('#emailInfo').val();
        var maNhanVien = $('#maNhanVienInfo').val();
        var phoneNumber = $('#phoneNumberInfo').val();
        var address = $('#addressInfo').val();
        var cardID = $('#cardIDInfo').val();
        var isActive = $('#isActiveInfo').prop('checked');
        //var status = $('#statusInfo').val();
        var userName = $('#userNameInfo').val();
        var password = $('#passwordInfo').val();
        $.ajax({
            url: '/Authentication/DoUpdate',
            data: { id: id, avatarImg: avatarImg, hoten: hoten, email: email, maNhanVien: maNhanVien, phoneNumber: phoneNumber, address: address, cardID: cardID, isActive: isActive, userName: userName, password: password },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalInfo').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function btnDeleteUser(){
        var id = $('#idUserRowSelected').val();
        $.ajax({
            url: '/Authentication/GetInfoUserById',
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#hoTenUserDelete').val(rs.HoTen);
                    var hoten = $('#hoTenUserDelete').val();
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá người dùng: " + hoten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/Authentication/DeleteUser',
                                    data: { id: id },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
        
    }
</script>


@model Models.Repos.Models.MayCan
@{
    ViewData["Title"] = "MayCanManager";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listXuongs = ViewBag.listXuongs;
    var appKVValues = Enum.GetNames(typeof(Vars.AppKV));
    var jsonAppKVValues = Newtonsoft.Json.JsonConvert.SerializeObject(appKVValues);

    var appTypeValues = Enum.GetNames(typeof(Vars.AppType));
    var jsonAppTypeValues = Newtonsoft.Json.JsonConvert.SerializeObject(appTypeValues);
}

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Máy Cân</h2>
                    @{
                        var themMayCanManager = rolePermistions.Where(x => x.Fu == "Cài Đặt" && x.Func == "Thêm Quản Lý Máy Cân" && x.Status == 1).FirstOrDefault();
                        if (themMayCanManager != null)
                        {
                                        <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suaMayCanManager = rolePermistions.Where(x => x.Fu == "Cài Đặt" && x.Func == "Sửa Quản Lý Máy Cân" && x.Status == 1).FirstOrDefault();
                            if (suaMayCanManager != null)
                            {
                                            <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaMayCanManager = rolePermistions.Where(x => x.Fu == "Cài Đặt" && x.Func == "Xoá Quản Lý Máy Cân" && x.Status == 1).FirstOrDefault();
                            if (xoaMayCanManager != null)
                            {
                                            <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importMayCanManager = rolePermistions.Where(x => x.Fu == "Cài Đặt" && x.Func == "Import Quản Lý Máy Cân" && x.Status == 1).FirstOrDefault();
                            if (importMayCanManager != null)
                            {
                                            <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportMayCanManager = rolePermistions.Where(x => x.Fu == "Cài Đặt" && x.Func == "Export Quản Lý Máy Cân" && x.Status == 1).FirstOrDefault();
                            if (exportMayCanManager != null)
                            {
                                            <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


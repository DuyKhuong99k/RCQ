<script>
    var appKVValues = @Html.Raw(jsonAppKVValues);
    var appTypeValues = @Html.Raw(jsonAppTypeValues);
</script>
<script type="text/x-template" id="WKvTemplate">
    <div>
        <span>${covert(data)}</span>
    </div>
</script> 
<script type="text/x-template" id="ATypeTemplate">
    <div>
        <span>${covert2(data)}</span>
    </div>
</script>
<script>
    function covert(data) {
        var appKVValue = "";
        try {
            var wkValue = data.WKv;
            appKVValue = appKVValues[wkValue];
        } catch (error) {
            console.error(error);
        }
        if (appKVValue == "" || appKVValue == undefined) {
            appKVValue = "Chưa xác định";
        }
        return appKVValue;
    }
    function covert2(data) {
        var appTypeValue = "";
        try {
            var appTypeValue = data.AType;
            appTypeValue = appTypeValues[appTypeValue];
        } catch (error) {
            console.error(error);
        }
        if (appTypeValue == "" || appTypeValue == undefined) {
            appTypeValue = "Chưa xác định";
        }
        return appTypeValue;
    }
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {

        $.ajax({
            url: '/SettingWebApp/GetAllMayCanManagers', 
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Id', headerText: 'Id', width: 150 },
                            { field: 'DisplayName', headerText: 'Tên Máy', width: 150 },
                            { field: 'MType', headerText: 'Loại Máy', width: 150},
                            { field: 'WKv', headerText: 'Khu Vực', width: 150, template: '#WKvTemplate' },
                            { field: 'AType', headerText: 'Loại Cân', width: 150, template: '#ATypeTemplate' },
                            { field: 'SCode', headerText: 'SCode', width: 150 },
                            { field: 'Par1', headerText: 'Par1', width: 150 },
                            { field: 'Par2', headerText: 'Par2', width: 150 },
                            { field: 'Par3', headerText: 'Par3', width: 150 },
                            { field: 'Par4', headerText: 'Par4', width: 150 },
                            { field: 'Idx', headerText: 'Index', width: 150 },
                            { field: 'MaXuong', headerText: 'Xưởng', width: 150 },
                            { field: 'IsSuDungMauThanhPham', headerText: 'Màu TP', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();

    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Id = selectedRecord.Id;

        $('#idMCSTRowSelected').val(Id);
    }
    function templateKV(data) {
        var wkValue = data.WKv;
        var appKVValue = "";
        for (var i = 0; i < appKVValues.length; i++) {
            if (appKVValues[i] == wkValue) {
                appKVValue = appKVValues[i];
                break;
            }
        }
        if (!appKVValue) {
            appKVValue = "Chưa xác định";
        }
        return "<div><span>" + appKVValue + "</span></div>";
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/SettingWebApp/CreatDefautNewMayCanManagers",
            success: function (rs) {
                if (rs.isSuccess === true) {
                   // $('#idMCST').val(rs.Id);
                    $('#sCodeMCST').val(rs.SCode);
                    $('#par1MCST').val(rs.Par1);
                    $('#par2MCST').val(rs.Par2);
                    $('#par3MCST').val(rs.Par3);
                    $('#par4MCST').val(rs.Par4);
                    $('#idxMCST').val(rs.Idx);
                    $('#isSuDungMauThanhPhamMCST').prop('checked', rs.IsSuDungMauThanhPham);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });

    }
    function insert() {
        var id = $('#idMCST').val();
        if (id == null || id == "" || id == undefined) {
            toastOptionNotyfi();
            toastr["error"]('Bạn Chưa Nhập Id', "Thông báo");
            return;
        }
        var displayName = $('#displayNameMCST').val();
        var wKv = $('#wKvMCST').val();
        var aType = $('#aTypeMCST').val();
        var mType = $('#mTypeMCST').val();
        var xuongId = $('#maXuongMCST').val();
        var isSuDungMauThanhPham = $('#isSuDungMauThanhPhamMCST').prop('checked');
        var sCode = $('#sCodeMCST').val();
        var par1 = $('#par1MCST').val();
        var par2= $('#par2MCST').val();
        var par3 = $('#par3MCST').val();
        var par4 = $('#par4MCST').val();
        var idx = $('#idxMCST').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/SettingWebApp/DoInsertMayCanManager',
            data: {
                id: id,
                displayName: displayName,
                wKv: wKv,
                aType: aType,
                mType: mType,
                xuongId: xuongId,
                isSuDungMauThanhPham: isSuDungMauThanhPham,
                sCode: sCode,
                par1: par1,
                par2: par2,
                par3: par3,
                par4: par4,
                idx: idx,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var id = $('#idMCSTRowSelected').val();
        $.ajax({
            url: "/SettingWebApp/GetsByMaMayCanManager",
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#idMCSTSua').val(rs.Id);
                    $('#displayNameMCSTSua').val(rs.DisplayName);
                    $('#wKvMCSTSua').val(rs.WKv);
                    $('#aTypeMCSTSua').val(rs.AType);
                    $('#mTypeMCSTSua').val(rs.MType);
                    $('#maXuongMCSTSua').val(rs.MaXuong);
                    $('#isSuDungMauThanhPhamMCSTSua').prop('checked', rs.IsSuDungMauThanhPham);
                    $('#sCodeMCSTSua').val(rs.SCode);
                    $('#par1MCSTSua').val(rs.Par1);
                    $('#par2MCSTSua').val(rs.Par2);
                    $('#par3MCSTSua').val(rs.Par3);
                    $('#par4MCSTSua').val(rs.Par4);
                    $('#idxMCSTSua').val(rs.Idx);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var id = $('#idMCSTSua').val();
        var displayName = $('#displayNameMCSTSua').val();
        var wKv = $('#wKvMCSTSua').val();
        var aType = $('#aTypeMCSTSua').val();
        var mType = $('#mTypeMCSTSua').val();
        var xuongId = $('#maXuongMCSTSua').val();
        var isSuDungMauThanhPham = $('#isSuDungMauThanhPhamMCSTSua').prop('checked');
        var sCode = $('#sCodeMCSTSua').val();
        var par1 = $('#par1MCSTSua').val();
        var par2 = $('#par2MCSTSua').val();
        var par3 = $('#par3MCSTSua').val();
        var par4 = $('#par4MCSTSua').val();
        var idx = $('#idxMCSTSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/SettingWebApp/DoUpDateManager',
            data: {
                id: id,
                displayName: displayName,
                wKv: wKv,
                aType: aType,
                mType: mType,
                xuongId: xuongId,
                isSuDungMauThanhPham: isSuDungMauThanhPham,
                sCode: sCode,
                par1: par1,
                par2: par2,
                par3: par3,
                par4: par4,
                idx: idx,
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var id = $('#idMCSTRowSelected').val();
        $.ajax({
            url: "/SettingWebApp/GetsByMaMayCanManager",
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.DisplayName,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/SettingWebApp/DoDeleteManager',
                                    data: { id: id },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>



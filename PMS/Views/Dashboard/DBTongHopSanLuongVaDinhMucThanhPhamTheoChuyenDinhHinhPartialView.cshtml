@{
    var XuongId = @Context.Session.GetString("XuongId");
}
<div class="card mb-4 marginGridjs position-relative">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 position-relative">
        <div class="text-start">
            <small class="fw-semibold text-muted d-block"> Sản lượng trung bình:</small>
            <p class="weight-displayTBSanLuongCongNhan fw-bold fs-6 mb-0">0,000.00 Kg</p>
        </div>
        <h6 class="mb-0 mx-auto text-center flex-grow-1">
            Tổng Hợp Sản Lượng & Định Mức Thành Phẩm Theo Chuyền Sửa Cá
        </h6>
        <button class="btn btn-outline-primary btn-sm position-absolute top-0 end-0 mt-2 me-3 shadow-sm"
                onclick="location.href='@Url.Action("DBTongHopSanLuongVaDinhMucThanhPhamTheoChuyenDinhHinhAdvanceView", "Dashboard")'">
            <i class='bx bxs-bar-chart-alt-2 fs-5'></i>
        </button>
    </div>

    <div class="card-body px-3 py-2">
        <div id="column-container-SanLuongDinhMucTPTheoChuyenDinhHinh" style="width: 100%;height:275px"></div>
    </div>
</div>
<script>
    var chart_SanLuongDinhMucTPTheoChuyenDinhHinhh;

    $(document).ready(function () {
        taiDasboardTongHopSanLuongDinhMucTPTheoChuyenDinhHinhh();

        var timeInterval = localStorage.getItem("timeInterval_dashboard_user");

        if (isNaN(timeInterval) || timeInterval <= 0) {
            timeInterval = 1800000; // 30 phút mặc định
        }

        setInterval(taiDasboardTongHopSanLuongDinhMucTPTheoChuyenDinhHinhh, timeInterval);
    });

    function taiDasboardTongHopSanLuongDinhMucTPTheoChuyenDinhHinhh() {
        const xuongId = '@XuongId';
        const chartDataSLDMTP = getDataForChartSLDMTP(xuongId);
        if (chartDataSLDMTP && chartDataSLDMTP.length > 0) {
            createComboChart(chartDataSLDMTP);
        }
    }

    function getDataForChartSLDMTP(xuongId) {
        let chartDataSLDMTP = null;
        const fromDate = localStorage.getItem("fromDate_dashboard_user");
        const toDate = localStorage.getItem("toDate_dashboard_user");
        $.ajax({
            url: '/Dashboard/DataChartTongHopSanLuongVaDinhMucThanhPhamTheoChuyenDinhHinh',
            type: 'GET',
            data: { fromDate: fromDate, toDate: toDate, xuongId: xuongId },
            async: false,
            success: function (response) {
                if (response.Success) {
                    chartDataSLDMTP = response.DataChart;
                    if (Array.isArray(chartDataSLDMTP)) {

                        const weightDisplays = document.querySelectorAll('.weight-displayTBSanLuongCongNhan');
                        weightDisplays.forEach(display => {
                            display.textContent = `${response.TotalTrongLuong} kg`;
                        });
                    }
                } else {
                    console.warn("Không có dữ liệu");
                }
            },
            error: function (e) {
                console.error("Lỗi khi lấy dữ liệu:", e);
            }
        });
        return chartDataSLDMTP;
    }


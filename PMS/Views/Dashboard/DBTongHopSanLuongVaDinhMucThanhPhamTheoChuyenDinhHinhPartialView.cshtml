    function createComboChart(data) {
        const isMobile = window.innerWidth <= 768;
        const xKey = "Nhom";
        const yKey = "TongTLTra";

        const lineKeysSet = new Set();
        data.forEach(row => {
            Object.keys(row).forEach(k => {
                if (k.startsWith("DinhMuc_")) {
                    lineKeysSet.add(k);
                }
            });
        });
        let lineKeys = Array.from(lineKeysSet);

        // data.forEach(row => {
        //     lineKeys.forEach(k => {
        //         if (!(k in row)) {
        //             row[k] = 0;
        //         }
        //     });
        // });

        const series = [];

        // Cột: Tổng trọng lượng
        series.push({
            type: 'Column',
            xName: xKey,
            yName: yKey,
            name: 'Sản Lượng',
            marker: {
                dataLabel: {
                    visible: true,
                    font: { fontWeight: '600', color: '#000' }
                }
            }
        });

        // Các đường định mức
        lineKeys.forEach((key) => {
            series.push({
                type: 'Line',
                xName: xKey,
                yName: key,
                name: key.replace("DinhMuc_", ""),
                width: 2,
                marker: { visible: true },
                yAxisName: 'yDinhMuc'
            });
        });

        if (chart_SanLuongDinhMucTPTheoChuyenDinhHinhh) {
            chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.series = series;
            chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.dataSource = data;
            chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.refresh();
            return;
        }

        chart_SanLuongDinhMucTPTheoChuyenDinhHinhh = new ej.charts.Chart({
            primaryXAxis: {
                valueType: 'Category',
                labelIntersectAction: 'Rotate45',
                labelRotation: isMobile ? 270 : 0,
                labelStyle: {
                    fontWeight: 'bold',
                    size: '9px',
                    color: '#333'
                },
                majorGridLines: { width: 0 },
                majorTickLines: { width: 0 },
                minorTickLines: { width: 0 }
            },
            primaryYAxis: {
                title: 'Sản Lượng',
                majorTickLines: { width: 0 },
                lineStyle: { width: 0 },
                labelFormat: '{value}'
            },
            axes: [
                {
                    name: 'yDinhMuc',
                    title: 'Định Mức (%)',
                    opposedPosition: true,
                    lineStyle: { width: 0 },
                    majorTickLines: { width: 0 },
                    labelStyle: { color: '#565656', fontWeight: 'bold' },
                    labelFormat: '{value}'
                }
            ],
            chartArea: { border: { width: 0 } },
            tooltip: {
                enable: true,
                shared: true,showNearestPoint: false,
            },
            legendSettings: { visible: true },
            width: '100%',
            height: '400px',
            series: series,
            dataSource: data,

            textRender: function (args) {
                const num = parseFloat(args.text);
                if (!isNaN(num)) {
                    args.text = num.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            },

            tooltipRender: function (args) {
                const value = args.point?.y;
                const name = args.series?.name;

                if (typeof value === 'number' && !isNaN(value)) {
                    const formatted = value.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });

                    if (name === 'Sản Lượng') {
                        args.text = `${name}: ${formatted} kg`;
                    } else {
                        args.text = `${name}: ${formatted} %`;
                    }
                }
            }
        });

        chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.appendTo('#column-container-SanLuongDinhMucTPTheoChuyenDinhHinh');
    }
</script>



@{
    ViewData["Title"] = "DBTongHopDinhMucSanLuongTheoChuyenDinhHinhAdvanceView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}
<div class="row g-3 align-items-end mb-2" style="margin-top: -20px;">
    <!-- Nút Quay lại bên trái -->
    <div class="col-md-auto">
        <button class="btn btn-outline-secondary" type="button" onclick="window.history.back();">
            <i class='bx bx-arrow-back'></i> Quay lại
        </button>
    </div>

    <!-- Các thành phần bên phải, đẩy về cuối hàng -->
    <div class="col-md-auto ms-auto">
        <div class="input-group">
            <span class="input-group-text">Chọn ngày</span>
            <input type="date" class="form-control" id="fromDateDB" name="fromDate">
            <input type="date" class="form-control" id="toDateDB" name="toDate">
        </div>
    </div>
    <div class="col-md-auto" style="z-index:1">
        <div class="input-group">
            <span class="input-group-text">Số phút</span>
            <input type="number" class="form-control" id="minuteInput" name="minuteInput" min="5" value="5">
            <button id="applyBtn" class="btn btn-primary" type="button">
                <i class='bx bx-refresh'></i>
            </button>
        </div>
    </div>
</div>
<div class="card mb-4 marginGridjs position-relative">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 position-relative">
        <div class="text-start">
            <small class="fw-semibold text-muted d-block">Năng suất trung bình:</small>
            <p class="weight-display fw-bold fs-6 mb-0">0,000.00 Kg</p>
        </div>

        <h6 class="mb-0 mx-auto text-center flex-grow-1">
            Tổng Hợp Năng Suất Theo Chuyền Sửa Cá
        </h6>

        <div class="position-absolute top-0 end-0 mt-2 me-3 z-1 text-end">
            <label for="kyVongInput" class="form-label mb-1 fw-semibold small text-muted d-block">Kỳ vọng</label>
            <div class="input-group">
                <input type="number" class="form-control form-control-sm shadow-sm" id="kyVongInput" placeholder="Nhập số" />
                <button id="setKyVong" class="btn btn-primary" type="button">
                    Set
                </button>
            </div>
        </div>
    </div>

    <div class="card-body px-3 py-2">
        <div id="column-container-DinhMucSanLuongDinhHinh" style="width: 100%; height: 350px;"></div>
        <div id="Grid"></div>
    </div>
</div>
<script>
    $(document).ready(function () {
        taiDasboardTongHopDinhMucSanLuongDinhHinh();
    });

    var chart_DinhMucSanLuongDinhHinh;

    function createChartFL() {
        const isMobile = window.innerWidth <= 768;

        chart_DinhMucSanLuongDinhHinh = new ej.charts.Chart({
            primaryXAxis: {
                valueType: 'Category',
                title: 'Ngày',
                interval: 1,
                labelRotation: isMobile ? 270 : 0,
                labelIntersectAction: 'Rotate90',
                labelStyle: {
                    fontWeight: 'bold',
                    size: '10px',
                    color: '#333333'
                }
            },
            chartArea: { border: { width: 0 } },
            primaryYAxis: {
                title: 'Trọng Lượng (kg)',
                majorTickLines: { width: 0 },
                lineStyle: { width: 0 }
            },
            series: [],
            width: '100%',
            tooltip: {
                enable: true,
                shared: true,showNearestPoint: false,
            },
            tooltipRender: function (args) {
                const d = args.point?.data || {};
                const dm = d.dm;
                const y = d.y;

                args.text = `
                    Nhóm: ${d.group || args.series.name}
                    <br/>Năng suất: ${y != null ? y.toLocaleString('vi-VN', { minimumFractionDigits: 2 }) + ' kg' : '–'}
                `;
                if (dm !== undefined && dm !== null) {
                    args.text += `<br/>Định mức: ${dm.toLocaleString('vi-VN', { minimumFractionDigits: 2 })} kg`;
                }
            },
            textRender: function (args) {
                const num = parseFloat(args.text);
                if (!isNaN(num)) {
                    args.text = num.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            },
            legendSettings: {
                visible: true
            }
        });

        chart_DinhMucSanLuongDinhHinh.appendTo('#column-container-DinhMucSanLuongDinhHinh');
    }

    function loadChart_TongHopDinhMucSanLuongDinhHinh(data) {
        if (!Array.isArray(data)) return;

        const palette = [
            '#00bdae', '#c1442b', '#2a81b9', '#4c8c2b', '#b58900',
            '#7e57c2', '#2aa198', '#c2185b', '#6a1b9a', '#388e3c', '#ef6c00'
        ];

        // 1. Tập hợp tất cả ngày và nhóm
        const allNgay = new Set();
        const allGroups = new Set();

        data.forEach(item => {
            if (item.ngay && item.x) {
                allNgay.add(item.ngay);
                allGroups.add(item.x);
            }
        });

        // 2. Tạo map nhóm => map ngày => dữ liệu
        const groupDataMap = {};
        allGroups.forEach(group => {
            groupDataMap[group] = {};
        });

        data.forEach(item => {
            groupDataMap[item.x][item.ngay] = {
                x: item.ngay,
                y: item.y,
                dm: item.dm,
                group: item.x
            };
        });

        // 3. Đảm bảo mỗi nhóm có đủ điểm tại tất cả các ngày
        const seriesList = [];
        const sortedNgay = Array.from(allNgay).sort();

        let colorIndex = 0;
        allGroups.forEach(group => {
            const items = [];

            sortedNgay.forEach(ngay => {
                if (groupDataMap[group][ngay]) {
                    items.push(groupDataMap[group][ngay]);
                } else {
                    items.push({
                        x: ngay,
                        y: null,
                        dm: null,
                        group: group
                    });
                }
            });

            seriesList.push({
                type: 'Line',
                name: group,
                xName: 'x',
                yName: 'y',
                dataSource: items,
                marker: {
                    visible: true,
                    width: 8,
                    height: 8,
                    shape: 'Circle',
                    fill: '#ffffff',
                    border: {
                        width: 2,
                        color: palette[colorIndex % palette.length]
                    },
                    dataLabel: {
                        visible: false
                    }
                },
                fill: palette[colorIndex % palette.length]
            });

            colorIndex++;
        });

        chart_DinhMucSanLuongDinhHinh.series = seriesList;

        // Cập nhật trục Y
        const allY = data.map(d => d.y).filter(y => y != null && !isNaN(y));
        const maxY = Math.max(...allY);
        const newMax = Math.ceil(maxY);
        const interval = newMax > 0 ? Math.round(newMax / 3) + 50 : 1;

        chart_DinhMucSanLuongDinhHinh.setProperties({
            primaryYAxis: {
                maximum: newMax,
                interval: interval
            }
        });

        chart_DinhMucSanLuongDinhHinh.refresh();
    }


    function getDataForChartFL(xuongId) {
        let chartData = null;
        const fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        const toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var kyVong =  @AppViewModels.AppViewModel.Instance.ChiSoKyVongDH;
        if (kyVong == null) {
            kyVong = 0;
        }
        $.ajax({
            url: '/Dashboard/DataChartTongHopDinhMucSanLuongTheoChuyenDinhHinh',
            type: 'GET',
            data: {fromDate:fromDate,toDate:toDate, xuongId: xuongId , kyVong:kyVong},
            async: false,
            success: function (response) {
                if (response.Success) {
                    chartData = response.DataChart;
                    if (Array.isArray(chartData) && chartData.length > 0) {
                        const weightDisplays = document.querySelectorAll('.weight-display');
                        weightDisplays.forEach(display => {
                            display.textContent = `${response.TotalTrongLuong} kg`;
                        });
                    }
                } else {
                    console.warn(response.Messages || 'Không có dữ liệu biểu đồ');
                }
            },
            error: function (error) {
                console.error('Lỗi khi tải dữ liệu:', error);
            }
        });

        return chartData;
    }

    function taiDasboardTongHopDinhMucSanLuongDinhHinh() {
        var xuongId = @XuongId;
        //AddUserWaitView(xuongId);

        const chartData = getDataForChartFL(xuongId);
        if (!chart_DinhMucSanLuongDinhHinh) {
            createChartFL();
        }
        if (chartData) {
            loadChart_TongHopDinhMucSanLuongDinhHinh(chartData);
        }
    }

    // var timeInterval = localStorage.getItem("timeInterval_dashboard_user");
    // setInterval(taiDasboardTongHopDinhMucSanLuongDinhHinh, timeInterval);

    var timeInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");

    // Nếu null thì ép thành 30p
    if (isNaN(timeInterval) || timeInterval <= 0) {
        timeInterval = 1800000;
    }

    setInterval(taiDasboardTongHopDinhMucSanLuongDinhHinh, timeInterval);
</script>
<script>
    document.getElementById("setKyVong").addEventListener("click", function () {
        var kyVong = document.getElementById("kyVongInput").value;

        $.ajax({
            url: '/Dashboard/SetChiSoKyVongDH',
            type: 'GET',
            data: { kyVong: kyVong },
            async: false,
            success: function (response) {
                if (response.Success) {
                    toastOptionNotyfi();
                    toastr["success"]("Tải lại biểu đồ sau 5s", response.Messages);

                    setTimeout(function () {
                        location.reload();
                    }, 5000); // sửa thành setTimeout để chạy sau 5s (1 lần), tránh lặp liên tục như setInterval
                } else {
                    console.warn(response.Messages || 'Không có dữ liệu biểu đồ');
                }
            },
            error: function (error) {
                console.error('Lỗi khi tải dữ liệu:', error);
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        var toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var xuongId = @XuongId;
        $.ajax({
            url: '/Dashboard/TongHopDinhMucSanLuongTheoChuyenDinhHinh',
            type: 'GET',
            dataType: 'json',
            data: {
                fromDate: fromDate,toDate:toDate,xuongId:xuongId
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        //rowSelected: onRowSelected,
                        //height: auto,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 , type: 'date', format: 'dd-MM-yyyy'},
                            { field: 'Nhom', headerText: 'Nhóm', width: 150 },
                            { field: 'TongTrongLuong', headerText: 'Trọng Lượng', type: 'number',format:'N2', width: 200 },
                            { field: 'TongSoNhanVien', headerText: 'Số Nhân Viên', type: 'number',format:'N2', width: 200 },
                            { field: 'NangSuat', headerText: 'Năng Suất', type: 'number',format:'N2', width: 200 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                         if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                         }};
                    }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
</script>
<script>

    window.addEventListener("DOMContentLoaded", function () {
        const today = new Date().toLocaleDateString('en-CA');
        //const today = new Date('2023/10/05');
        const fromInput = document.getElementById("fromDateDB");
        const toInput = document.getElementById("toDateDB");
        const minuteInput = document.getElementById("minuteInput");

        const savedFrom = localStorage.getItem("fromDate_dashboard_user_Advance");
        const savedTo = localStorage.getItem("toDate_dashboard_user_Advance");
        const savedInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");
        const isApplied = localStorage.getItem("dashboard_is_applied_Advance");
        const kyVong = @AppViewModels.AppViewModel.Instance.ChiSoKyVongDH;
        if (kyVong !== null) {
            document.getElementById("kyVongInput").value = parseFloat(kyVong);
        }
        // nếu apply thì áp dung localstoge sau khi hoanf thành thì xóa cờ
        if (isApplied === "true" && savedFrom && savedTo) {
            fromInput.value = savedFrom;
            toInput.value = savedTo;
            localStorage.removeItem("dashboard_is_applied_Advance"); // Xoá cờ khi đã dùng
        } else {
            fromInput.value = today;
            toInput.value = today;
            localStorage.setItem("fromDate_dashboard_user_Advance", today);
            localStorage.setItem("toDate_dashboard_user_Advance", today);
        }

        if (savedInterval) {
            const minutes = parseInt(savedInterval, 10) / 60000;
            minuteInput.value = Math.max(minutes, 5);
        } else {
            minuteInput.value = 30;
            localStorage.setItem("timeInterval_dashboard_user_Advance", 1800000); // 30 phút mặc định
        }
    });



@{
    ViewData["Title"] = "DBTyLeThuHoiThanhPham2AdvanceView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="row g-3 align-items-end mb-2" style="margin-top: -20px;">
    <!-- Nút Quay lại bên trái -->
    <div class="col-md-auto">
        <button class="btn btn-outline-secondary" type="button" onclick="window.history.back();">
            <i class='bx bx-arrow-back'></i> Quay lại
        </button>
    </div>

    <!-- Các thành phần bên phải, đẩy về cuối hàng -->
    <div class="col-md-auto ms-auto">
        <div class="input-group">
            <span class="input-group-text">Chọn ngày</span>
            <input type="date" class="form-control" id="fromDateDB" name="fromDate">
            <input type="date" class="form-control" id="toDateDB" name="toDate">
        </div>
    </div>
    <div class="col-md-auto" style="z-index:1">
        <div class="input-group">
            <span class="input-group-text">Số phút</span>
            <input type="number" class="form-control" id="minuteInput" name="minuteInput" min="5" value="5">
            <button id="applyBtn" class="btn btn-primary" type="button">
                <i class='bx bx-refresh'></i>
            </button>
        </div>
    </div>
</div>
<div class="card mb-4 marginGridjs position-relative">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 position-relative">
        <div class="text-start">
            <small class="fw-semibold text-muted d-block">Sản lượng trung bình:</small>
            <p class="weight-displayTyLeThuHoiThanhPham2 fw-bold fs-6 mb-0">0,000.00 Kg</p>
        </div>
        <h6 class="mb-0 mx-auto text-center flex-grow-1">
            Tỷ Lệ Thu Hồi Thành Phẩm 2
        </h6>
    </div>

    <div class="card-body px-3 py-2">
        <div id="column-container-TyLeThuHoiThanhPham2" style="width: 100%;height:350px"></div>
        <div id="Grid"></div>
    </div>
</div>
<script>
    var chart_TyLeThuHoiThanhPham2;

    $(document).ready(function () {
        taiDasboardTongHopTyLeThuHoiThanhPham2();

        var timeInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");

        if (isNaN(timeInterval) || timeInterval <= 0) {
            timeInterval = 1800000; // 30 phút mặc định
        }

        setInterval(taiDasboardTongHopTyLeThuHoiThanhPham2, timeInterval);
    });

    function taiDasboardTongHopTyLeThuHoiThanhPham2() {
        const xuongId = '@XuongId';
        const chartDataTLTHTP2 = getDataForChartTLTHTP2(xuongId);
        if (chartDataTLTHTP2 && chartDataTLTHTP2.length > 0) {
            createComboChartTLTHTP2(chartDataTLTHTP2);
        }
    }

    function getDataForChartTLTHTP2(xuongId) {
        let chartDataTLTHTP2 = null;
        const fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        const toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        $.ajax({
            url: '/Dashboard/DataChartTyLeThuHoiThanhPham2',
            type: 'GET',
            data: { fromDate: fromDate, toDate: toDate, xuongId: xuongId },
            async: false,
            success: function (response) {
                if (response.Success) {
                    chartDataTLTHTP2 = response.DataChart;
                    if (Array.isArray(chartDataTLTHTP2)) {

                        const weightDisplays = document.querySelectorAll('.weight-displayTyLeThuHoiThanhPham2');
                        weightDisplays.forEach(display => {
                            display.textContent = `${response.TotalTrongLuong} kg`;
                        });
                    }
                } else {
                    console.warn("Không có dữ liệu");
                }
            },
            error: function (e) {
                console.error("Lỗi khi lấy dữ liệu:", e);
            }
        });
        return chartDataTLTHTP2;
    }

    function createComboChartTLTHTP2(data) {
        const isMobile = window.innerWidth <= 768;

        let maxTyLeToanBo = 0;

        data.forEach(row => {
            if (!row.ThanhPhamName || row.ThanhPhamName.trim() === "") {
                row.ThanhPhamName = row.MaThanhPham || "Không tên";
            } else {
                row.ThanhPhamName = `${row.ThanhPhamName}`;
            }

            const tyLeKeys = Object.keys(row).filter(k => k.startsWith("TyLeThuHoi_"));
            let maxTyLe = 0;
            tyLeKeys.forEach(k => {
                const val = parseFloat(row[k]);
                if (!isNaN(val)) {
                    if (val > maxTyLe) maxTyLe = val;
                    if (val > maxTyLeToanBo) maxTyLeToanBo = val;
                }
            });

            row.TyLeThuHoi = maxTyLe > 0 ? maxTyLe : null;
        });

        const yAxisMax = Math.ceil((maxTyLeToanBo + 2) / 2) * 2;

        const series = [
            {
                type: 'Line',
                xName: 'ThanhPhamName',
                yName: 'TyLeThuHoi',
                name: 'Tỷ Lệ Thu Hồi',
                width: 2,
                marker: { visible: true }
            }
        ];

        const chartHeight = data.length > 10 ? '600px' : '400px';

        if (chart_TyLeThuHoiThanhPham2) {
            chart_TyLeThuHoiThanhPham2.series = series;
            chart_TyLeThuHoiThanhPham2.dataSource = data;
            chart_TyLeThuHoiThanhPham2.height = chartHeight;
            chart_TyLeThuHoiThanhPham2.primaryYAxis.maximum = yAxisMax;
            chart_TyLeThuHoiThanhPham2.refresh();
            return;
        }

        chart_TyLeThuHoiThanhPham2 = new ej.charts.Chart({
            primaryXAxis: {
                valueType: 'Category',
                labelIntersectAction: 'Rotate45',
                labelRotation: isMobile ? 270 : 0,
                labelStyle: {
                    fontWeight: 'bold',
                    size: '9px',
                    color: '#333'
                },
                majorGridLines: { width: 0 },
                majorTickLines: { width: 0 },
                minorTickLines: { width: 0 }
            },
            primaryYAxis: {
                title: 'Tỷ Lệ Thu Hồi (%)',
                labelFormat: '{value} %',
                minimum: 0,
                maximum: yAxisMax,
                interval: 1,
                labelStyle: { color: '#565656', fontWeight: 'bold' },
                lineStyle: { width: 0 },
                majorTickLines: { width: 0 }
            },
            chartArea: { border: { width: 0 } },
            tooltip: {
                enable: true,
                shared: true,
                showNearestPoint: false
            },
            legendSettings: { visible: true },
            width: '100%',
            height: chartHeight,
            series: series,
            dataSource: data,

            textRender: function (args) {
                const num = parseFloat(args.text);
                if (!isNaN(num)) {
                    args.text = num.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            },

            tooltipRender: function (args) {
                if (args.series && args.point && !isNaN(args.point.y)) {
                    const formatted = args.point.y.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                    args.text = `${args.series.name}: ${formatted} %`;
                }
            }
        });

        chart_TyLeThuHoiThanhPham2.appendTo('#column-container-TyLeThuHoiThanhPham2');
    }

        
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        var toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var xuongId = @XuongId;
        $.ajax({
            url: '/Dashboard/TyLeThuHoiThanhPham2',
            type: 'GET',
            dataType: 'json',
            data: {
                fromDate: fromDate,toDate:toDate,xuongId:xuongId
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        //rowSelected: onRowSelected,
                        //height: auto,
                        columns: [
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'SanLuong', headerText: 'Sản Lượng', type: 'number',format:'N2', width: 150 },
                            { field: 'SanLuongNL', headerText: 'Nguyên Liệu', type: 'number',format:'N2', width: 150 },
                            { field: 'TyLeThuHoi', headerText: 'Tỷ Lệ Thu Hồi', type: 'number', width: 150,
                                template: function(data) {
                                    const value = data.TyLeThuHoi;
                                      if (typeof value === 'number' && !isNaN(value)) {
                                        return (value * 100).toFixed(2) + ' %';
                                      }
                                      return '0.00 %';
                                }
                            },
                            { field: 'CTTYLE', headerText: 'CTTYLE', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                         if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                         }};
                    }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
</script>
<script>

    window.addEventListener("DOMContentLoaded", function () {
        const today = new Date().toLocaleDateString('en-CA');
        //const today = new Date('2023/10/05');
        const fromInput = document.getElementById("fromDateDB");
        const toInput = document.getElementById("toDateDB");
        const minuteInput = document.getElementById("minuteInput");

        const savedFrom = localStorage.getItem("fromDate_dashboard_user_Advance");
        const savedTo = localStorage.getItem("toDate_dashboard_user_Advance");
        const savedInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");
        const isApplied = localStorage.getItem("dashboard_is_applied_Advance");

        // nếu apply thì áp dung localstoge sau khi hoanf thành thì xóa cờ
        if (isApplied === "true" && savedFrom && savedTo) {
            fromInput.value = savedFrom;
            toInput.value = savedTo;
            localStorage.removeItem("dashboard_is_applied_Advance"); // Xoá cờ khi đã dùng
        } else {
            fromInput.value = today;
            toInput.value = today;
            localStorage.setItem("fromDate_dashboard_user_Advance", today);
            localStorage.setItem("toDate_dashboard_user_Advance", today);
        }

        if (savedInterval) {
            const minutes = parseInt(savedInterval, 10) / 60000;
            minuteInput.value = Math.max(minutes, 5);
        } else {
            minuteInput.value = 30;
            localStorage.setItem("timeInterval_dashboard_user_Advance", 1800000); // 30 phút mặc định
        }
    });


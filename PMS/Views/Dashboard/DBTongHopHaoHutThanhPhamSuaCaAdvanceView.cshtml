
@{
    ViewData["Title"] = "DBTongHopHaoHutThanhPhamSuaCaAdvanceView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

<div class="row g-3 align-items-end mb-2" style="margin-top: -20px;">
    <!-- Nút Quay lại bên trái -->
    <div class="col-md-auto">
        <button class="btn btn-outline-secondary" type="button" onclick="window.history.back();">
            <i class='bx bx-arrow-back'></i> Quay lại
        </button>
    </div>

    <!-- Các thành phần bên phải, đẩy về cuối hàng -->
    <div class="col-md-auto ms-auto">
        <div class="input-group">
            <span class="input-group-text">Chọn ngày</span>
            <input type="date" class="form-control" id="fromDateDB" name="fromDate">
            <input type="date" class="form-control" id="toDateDB" name="toDate">
        </div>
    </div>
    <div class="col-md-auto" style="z-index:1">
        <div class="input-group">
            <span class="input-group-text">Số phút</span>
            <input type="number" class="form-control" id="minuteInput" name="minuteInput" min="5" value="5">
            <button id="applyBtn" class="btn btn-primary" type="button">
                <i class='bx bx-refresh'></i>
            </button>
        </div>
    </div>
</div>

<div class="card mb-4 marginGridjs position-relative">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 position-relative">
        @* <div class="text-start">
            <small class="fw-semibold text-muted d-block"> Sản lượng trung bình:</small>
            <p class="weight-displayTBSanLuongCongNhan fw-bold fs-6 mb-0">0,000.00 Kg</p>
        </div> *@
        <h6 class="mb-0 mx-auto text-center flex-grow-1">
            Tổng Hợp Hao Hụt Thành Phẩm Sửa Cá
        </h6>
        @* <button class="btn btn-outline-primary btn-sm position-absolute top-0 end-0 mt-2 me-3 shadow-sm"
                onclick="location.href='@Url.Action("DBTongHopHaoHutThanhPhamSuaCaAdvanceView", "Dashboard")'">
            <i class='bx bxs-bar-chart-alt-2 fs-5'></i>
        </button> *@
    </div>

    <div class="card-body px-3 py-2">
        <div id="column-container-TongHopHaoHutDinhHinh" style="width: 100%;height:275px"></div>
        <div id="Grid"></div>
    </div>
</div>
<script>
    $(document).ready(function () {
        taiDashboardTongHopHaoHutDinhHinh();
    });

    var chart_TongHopHaoHutDinhHinh;

            function createChart_TongHopHaoHutDinhHinh(allSeries) {
        const allValues = allSeries.flatMap(s => s.dataSource.map(d => d.HaoHut).filter(v => v !== null && !isNaN(v)));

        const minY = Math.min(...allValues);
        const maxY = Math.max(...allValues);
        const buffer = (maxY - minY) * 0.1 || 100;

        // Đảm bảo mốc 0 luôn nằm giữa trục
        let adjustedMin = Math.floor((minY - buffer) / 100) * 100;
        let adjustedMax = Math.ceil((maxY + buffer) / 100) * 100;

        // Nếu cả min và max đều dương thì vẫn đưa min xuống 0
        if (adjustedMin > 0) adjustedMin = 0;
        // Nếu cả min và max đều âm thì vẫn đưa max lên 0
        if (adjustedMax < 0) adjustedMax = 0;

        const range = adjustedMax - adjustedMin;
        const interval = Math.ceil(range / 4 / 100) * 100;

        chart_TongHopHaoHutDinhHinh = new ej.charts.Chart({
            primaryXAxis: {
                valueType: 'Category',
                labelIntersectAction: 'Rotate45',
                labelStyle: {
                    fontWeight: 'bold',
                    size: '9px',
                    color: '#333333'
                },
                majorGridLines: { width: 0 },
                majorTickLines: { width: 0 },
                minorTickLines: { width: 0 }
            },
            primaryYAxis: {
                title: 'Hao hụt (Kg)',
                minimum: adjustedMin,
                maximum: adjustedMax,
                interval: interval,
                majorTickLines: { width: 0 },
                lineStyle: { width: 0 },
                labelStyle: {
                    fontWeight: 'bold',
                    size: '10px',
                    color: '#000'
                },
                stripLines: [{
                    value: 0,
                    color: '#ff0000',
                    width: 1.5,
                    dashArray: '3,3',
                    zIndex: 'Behind'
                }]
            },
            chartArea: { border: { width: 0 } },
            series: allSeries,
            tooltip: {
                enable: true,
                shared: true,
                showNearestPoint: false
            },
            legendSettings: { visible: true },
            width: '100%',
            height: '500px',
            axisLabelRender: function (args) {
                // Ép hiển thị mốc 0 nếu bị bỏ qua
                if (args.axis.name === 'primaryYAxis') {
                    const labelVal = Number(args.text);
                    if (labelVal === 0) {
                        args.text = '0';
                    }
                }
            }
        });

        chart_TongHopHaoHutDinhHinh.appendTo('#column-container-TongHopHaoHutDinhHinh');
    }

    function loadChart_TongHopHaoHutDinhHinh() {
        var fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        var toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var xuongId = '@XuongId';

        $.ajax({
            url: '/Dashboard/DataChartTongHopHaoHutThanhPhamSuaCa',
            type: 'GET',
            data: {
                fromDate: fromDate,
                toDate: toDate,
                xuongId: xuongId
            },
            success: function (response) {
                if (response.Success && Array.isArray(response.DataChart)) {
                    const dataMau = response.DataChart;

                    const uniqueDates = [...new Set(dataMau.map(d => d.Ngay))];
                    const productNames = [...new Set(dataMau.map(d => d.Ten))];

                    const allSeries = productNames.map(product => {
                        const dataForProduct = uniqueDates.map(date => {
                            const entry = dataMau.find(d => d.Ten === product && d.Ngay === date);
                            return {
                                Ngay: date,
                                HaoHut: entry?.HaoHut ?? null
                            };
                        });

                        return {
                            type: 'Line', //Column
                            name: product,
                            dataSource: dataForProduct,
                            xName: 'Ngay',
                            yName: 'HaoHut',
                            marker: { visible: true }
                        };
                    });

                    createChart_TongHopHaoHutDinhHinh(allSeries);
                } else {
                    console.warn(response.Messages || 'Không có dữ liệu biểu đồ.');
                }
            },
            error: function (xhr, status, error) {
                console.error('Lỗi khi gọi dữ liệu biểu đồ:', error);
            }
        });
    }

    function taiDashboardTongHopHaoHutDinhHinh() {
        loadChart_TongHopHaoHutDinhHinh();
    }

    var timeInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");

    // Nếu null thì ép thành 30p
    if (isNaN(timeInterval) || timeInterval <= 0) {
        timeInterval = 1800000;
    }

    setInterval(taiDasboardTongHopDinhMucSanLuongDinhHinh, timeInterval);
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        var toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var xuongId = @XuongId;
        $.ajax({
            url: '/Dashboard/TongHopHaoHutThanhPhamSuaCa',
            type: 'GET',
            dataType: 'json',
            data: {
                fromDate: fromDate,toDate:toDate,xuongId:xuongId
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        //rowSelected: onRowSelected,
                        //height: auto,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'Ten', headerText: 'Sản Phẩm', width: 150 },
                            { field: 'TrongLuong', headerText: 'Sản Lượng', type: 'number',format:'N2', width: 150 },
                            { field: 'HaoHut', headerText: 'Hao Hụt', type: 'number',format:'N2', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                         if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                         }};
                    }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
</script>
<script>

    window.addEventListener("DOMContentLoaded", function () {
        const today = new Date().toLocaleDateString('en-CA');
        //const today = new Date('2023/10/05');
        const fromInput = document.getElementById("fromDateDB");
        const toInput = document.getElementById("toDateDB");
        const minuteInput = document.getElementById("minuteInput");

        const savedFrom = localStorage.getItem("fromDate_dashboard_user_Advance");
        const savedTo = localStorage.getItem("toDate_dashboard_user_Advance");
        const savedInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");
        const isApplied = localStorage.getItem("dashboard_is_applied_Advance");

        // nếu apply thì áp dung localstoge sau khi hoanf thành thì xóa cờ
        if (isApplied === "true" && savedFrom && savedTo) {
            fromInput.value = savedFrom;
            toInput.value = savedTo;
            localStorage.removeItem("dashboard_is_applied_Advance"); // Xoá cờ khi đã dùng
        } else {
            fromInput.value = today;
            toInput.value = today;
            localStorage.setItem("fromDate_dashboard_user_Advance", today);
            localStorage.setItem("toDate_dashboard_user_Advance", today);
        }

        if (savedInterval) {
            const minutes = parseInt(savedInterval, 10) / 60000;
            minuteInput.value = Math.max(minutes, 5);
        } else {
            minuteInput.value = 30;
            localStorage.setItem("timeInterval_dashboard_user_Advance", 1800000); // 30 phút mặc định
        }
    });

    


    document.getElementById("applyBtn").addEventListener("click", function () {
        const minuteValue = parseInt(document.getElementById("minuteInput").value);
        const fromDate = document.getElementById("fromDateDB").value;
        const toDate = document.getElementById("toDateDB").value;
        if (isNaN(minuteValue) || minuteValue < 5) {
            alert("Nhỏ nhất là 5 phút");
            document.getElementById("minuteInput").value = 5;
            return;
        }

        const intervalMilliseconds = minuteValue * 60000;

        localStorage.setItem("timeInterval_dashboard_user_Advance", intervalMilliseconds);
        localStorage.setItem("fromDate_dashboard_user_Advance", fromDate);
        localStorage.setItem("toDate_dashboard_user_Advance", toDate);
        localStorage.setItem("dashboard_is_applied_Advance", "true");
        location.reload();
    });

</script>


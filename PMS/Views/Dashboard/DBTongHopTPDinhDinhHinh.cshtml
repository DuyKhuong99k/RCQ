<script src="~/js/adduserwaitview.js"></script>
<script>
    if(typeof detailLink === 'undefined'){
        var detailLink = document.getElementById('detailLink2');
    }
    if(typeof tongHopTPDHChart2 === 'undefined'){
        var tongHopTPDHChart2;
    }
    detailLink.addEventListener('click', function () {
        if (this.classList.contains('active-link2')) {
            this.classList.remove('active-link2');
        } else {
            this.classList.add('active-link2'); 
        }
    });

    $(document).ready(function () {
        document.getElementById("loadingIndicator2").style.display = "block";
        loadData2();
        //var XuongId = @Context.Session.GetString("XuongId");
        // var xuongId = @XuongId;
        // AddUserWaitView(xuongId);
    });
    function loadData2() {
        var xuongId = @XuongId;
        AddUserWaitView(xuongId);
        const parentElement = document.querySelector('.v');
        var fromDate = "@DateTime.Now.Date.AddDays(int.Parse((NumberDate ?? "0").ToString()) * -1).ToString("yyyy-MM-dd")";
        var toDate = "@DateTime.Now.Date.ToString("yyyy-MM-dd")";
        $.ajax({
            url: '/Dashboard/TongHopTyLeThanhPhamWithDate',
            data: { fromDate: fromDate, toDate: toDate },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (tongHopTPDHChart2) {
                    tongHopTPDHChart2.dataSource = data.datas;
                } else {
                    rendertChartTHTPDH2(data);
                }
                parentElement.innerHTML = '';
                updateUI2(data);

            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi khi lấy dữ liệu từ server: ', error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator2").style.display = "none";
            }
        });
    }

    function rendertChartTHTPDH2(data) {
        var _data = data.datas;
       
        tongHopTPDHChart2 = new ej.treemap.TreeMap({
            dataSource: _data,
            weightValuePath: 'TrongLuongTP',
            layoutType: 'Squarified',
            leafItemSettings: {
                labelPath: 'labels',
                labelFormat: '${labels}:${DinhMucTP} - ${TrongLuongTP}Kg'
                
            },

            palette: ['#71B081', '#5A9A77', '#498770', '#39776C', '#266665', '#124F5E'],
            renderDirection: 'BottomLeftTopRight',
            tooltipSettings: {
                visible: true,
                format: '${labels} : ${DinhMucTP} - ${TrongLuongTP}Kg'
            },
            width: '100%', // Thay đổi giá trị tùy theo kích thước mong muốn
            height: '100%',
            canvasRendering: true,
        }, '#element2');
    }
   
    function updateUI2(data) {

        const parentElement = document.querySelector('.v');
        // document.getElementById("tongTLTPDinHinh").textContent = data.TongTL + " Kg";
        for (let i = 0; i < data.datas.length; i++) {
            const newItem = document.createElement('tr');
            // newItem.classList.add('table-border-bottom-0');
            var item = data.datas[i];
            newItem.innerHTML = `
                                                                        <td>
                                                                            <div>

                                                                                        <h6 class="mb-0">${item.labels}</h6>
                                                                            </div>
                                                                        </td>
                                                                        <td>
                                                                                <small class="fw-semibold">${item.DinhMucTP}</small>
                                                                        </td>
                                                                            <td style="text-align: right;">
                                                                                <small class="fw-semibold">${item.TrongLuongTP} Kg</small>
                                                                        </td>


                                                                        `;

            parentElement.appendChild(newItem);
        }
    }
    function RefreshDBTHTPDH2() {
        loadData();
    }
    var timeInterval = @AppViewModels.AppViewModel.Instance.TimeSetIntervalDashBoardView;
    setInterval(loadData2, timeInterval);
</script>

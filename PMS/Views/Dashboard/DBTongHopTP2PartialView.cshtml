@{
    var NumberDate = @Context.Session.GetString("NumberDate");
    var XuongId = @Context.Session.GetString("XuongId");
}
<link href="~/css/dbtonghoptpstyle.css" rel="stylesheet" />
<style>
    @@media (max-width: 768px) {
        div#elementThanhPham2.e-lib.e-accumulationchart.e-control.e-touch.e-accumulationchart-focused {
            height: 0 !important;
            margin-top: -8.5rem !important;
        }

        svg#elementThanhPham2_svg {
            height: 350px
        }
    }
</style>
<div class="card mb-4 minHeigh">
    <div class="card-header" style="text-align:center">
        <h6>Tổng Hợp Sản Phẩm TP2</h6>
    </div>
    <div style="margin-top:-1.5rem !important" class="card-body ">
        <div class="fixed-chartPie d-flex flex-column justify-content-between align-items-center mb-3" style="width:100%; height:200px;">
            <div id="elementThanhPham2"></div>

        </div>
        <div style="text-align:center">
            <div id="tongTLTPThanhPham2"></div>
        </div>
        <div id="loadingIndicatorThanhPham2" class=" spinner-border text-primary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
            <span class="visually-hidden">Đang tải...</span>
        </div>

        <a id="detailLinkThanhPham2" class="me-1"
           data-bs-toggle="collapse"
           data-bs-target="#collapseExampleThanhPham2"
           aria-expanded="false"
           aria-controls="collapseExample" style="position:relative; z-index:1;">
            Xem chi tiết
        </a>
        <div class="collapse" id="collapseExampleThanhPham2">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead class="d-none">
                        <tr>
                            <th scope="col">1</th>
                            <th scope="col">2</th>
                        </tr>
                    <tbody class="table-border-bottom-0 ThanhPham2">
                    </tbody>
                </table>
            </div>

        </div>

    </div>
</div>
<script src="~/js/adduserwaitview.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var detailLink = document.getElementById('detailLinkThanhPham2');
        var collapseElement = document.getElementById('collapseExampleThanhPham2');

        function setColor(defaultColor, hoverColor) {
            detailLink.style.color = defaultColor;

            detailLink.onmouseenter = function () {
                detailLink.style.color = hoverColor;
            };
            detailLink.onmouseleave = function () {
                detailLink.style.color = defaultColor;
            };
        }

        detailLink.textContent = 'Xem chi tiết';
        setColor('#75aaff', '#0056b3');

        collapseElement.addEventListener('show.bs.collapse', function () {
            detailLink.textContent = 'Thu gọn';
            setColor('#6c757d', '#dc3545');
        });

        collapseElement.addEventListener('hide.bs.collapse', function () {
            detailLink.textContent = 'Xem chi tiết';
            setColor('#75aaff', '#0056b3');
        });
    });
</script>
<script>
    if(typeof detailLinkThanhPham2 === 'undefined') {
        var detailLinkThanhPham2 = document.getElementById('detailLinkThanhPham2');
    }
    if(typeof tongHopTPThanhPham2Chart === 'undefined') {
        var tongHopTPThanhPham2Chart;
    }
    detailLinkThanhPham2.addEventListener('click', function () {
        if (this.classList.contains('active-link')) {
            this.classList.remove('active-link');
        } else {
            this.classList.add('active-link');
        }
    });


    $(document).ready(function () {
        document.getElementById("loadingIndicatorThanhPham2").style.display = "block";
        loadDataThanhPham2();
        //var XuongId = @Context.Session.GetString("XuongId");
        // var xuongId = @XuongId;
        // AddUserWaitView(xuongId);
    });
    function loadDataThanhPham2() {
        var xuongId = @XuongId;
        //AddUserWaitView(xuongId);
        const parentElement = document.querySelector('.ThanhPham2');
        const fromDate = localStorage.getItem("fromDate_dashboard_user");
        const toDate = localStorage.getItem("toDate_dashboard_user");
        $.ajax({
            url: '/Dashboard/TongHopTyLeSanPhamTP2WithDate',
            data: { fromDate: fromDate, toDate: toDate },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (tongHopTPThanhPham2Chart) {
                    tongHopTPThanhPham2Chart.series[0].dataSource = data.datas;
                } else {
                    rendertChartTHTPThanhPham2(data);
                }

                updateUIThanhPham2(data);

            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi khi lấy dữ liệu từ server: ', error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorThanhPham2").style.display = "none";
            }
        });
    }

    function rendertChartTHTPThanhPham2(data) {
        var _data = data.datas;
        chartData = {
            series: [
                {
                    dataSource: _data,
                    innerRadius: '80%',
                    xName: 'labels',
                    yName: 'TrongLuongTP',
                    text: 'TrongLuongTP',
                    dataLabel: {
                        visible: true,
                        name: 'TrongLuongAndPersente',
                        position: 'Outside',
                        template: '<div style="position:relative; z-index:1;">${point.text}</div>'
                    }

                }
            ],
            centerLabel: {
                text: ' ',
                hoverTextFormat: '${point.x}<br>${point.percentage}%'
            }, legendSettings: {
                visible: false
            },
            //title: 'Tổng Hợp Loại Thành Phẩm Định Hình',
            width: '100%',
            height: '100%'
        };
        tongHopTPThanhPham2Chart = new ej.charts.AccumulationChart(chartData, '#elementThanhPham2');

    }

    function updateUIThanhPham2(data) {
         const rawTongTL = data.TongTL;

        // Nếu không có giá trị hoặc là "underfile" thì không làm gì
        if (
            rawTongTL === undefined ||
            rawTongTL === null ||
            rawTongTL === 'underfile'
        ) {
            return;
        }

        // Chuẩn hóa giá trị: loại bỏ dấu phẩy và ép sang số
        const tongTLNumber = Number(String(rawTongTL).replace(/,/g, ''));

        // Nếu sau khi chuẩn hóa mà vẫn không hợp lệ hoặc = 0, thì cũng không cập nhật
        if (isNaN(tongTLNumber) || tongTLNumber === 0) {
            return;
        }
        const parentElement = document.querySelector('.ThanhPham2');
        parentElement.innerHTML = '';
        //tongHopTPDHChart.centerLabel.text = 'Tổng<br>' + data.TongTL + 'Kg';
        document.getElementById("tongTLTPThanhPham2").textContent = 'Tổng: ' + rawTongTL + " Kg";
        var series = tongHopTPThanhPham2Chart.series[0];
        for (let i = 0; i < series.points.length; i++) {
            var item = series.points[i];
            const newItem = document.createElement('tr');
            const trongLuongTP = item.y;
            const trongLuongTPFormat = trongLuongTP.toLocaleString('vi-VN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            newItem.innerHTML = `
                        <td>
                            <div>
                                <h6 style="color: ${item.color}" class="mb-0">${item.x}</h6>
                            </div>
                        </td>
                        <td style="text-align: right;">
                            <small class="fw-semibold">${trongLuongTPFormat} Kg</small>
                        </td>
                     `;

            parentElement.appendChild(newItem);
        }
    }
    // var timeInterval = localStorage.getItem("timeInterval_dashboard_user");
    // setInterval(loadDataThanhPham2, timeInterval);

    var timeInterval = localStorage.getItem("timeInterval_dashboard_user");

    // Nếu null thì ép thành 30p
    if (isNaN(timeInterval) || timeInterval <= 0) {
        timeInterval = 1800000;
    }

    setInterval(loadDataThanhPham2, timeInterval);
</script>

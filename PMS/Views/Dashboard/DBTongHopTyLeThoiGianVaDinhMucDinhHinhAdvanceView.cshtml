
@{
    ViewData["Title"] = "DBTongHopTyLeThoiGianVaDinhMucDinhHinhAdvanceView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}
<div class="row g-3 align-items-end mb-2" style="margin-top: -20px;">
    <!-- Nút Quay lại bên trái -->
    <div class="col-md-auto">
        <button class="btn btn-outline-secondary" type="button" onclick="window.history.back();">
            <i class='bx bx-arrow-back'></i> Quay lại
        </button>
    </div>

    <!-- Các thành phần bên phải, đẩy về cuối hàng -->
    <div class="col-md-auto ms-auto">
        <div class="input-group">
            <span class="input-group-text">Chọn ngày</span>
            <input type="date" class="form-control" id="fromDateDB" name="fromDate">
            <input type="date" class="form-control" id="toDateDB" name="toDate">
        </div>
    </div>
    <div class="col-md-auto" style="z-index:1">
        <div class="input-group">
            <span class="input-group-text">Số phút</span>
            <input type="number" class="form-control" id="minuteInput" name="minuteInput" min="5" value="5">
            <button id="applyBtn" class="btn btn-primary" type="button">
                <i class='bx bx-refresh'></i>
            </button>
        </div>
    </div>
</div>
<div class="card mb-4 marginGridjs position-relative">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 position-relative">
        <div class="text-start">
            <small class="fw-semibold text-muted d-block">Tổng số rổ:</small>
            <p class="weight-displayTyLeThoiGianVaDinhMucDinhHinh fw-bold fs-6 mb-0">0,000.00 Rổ</p>
        </div>

        <h6 class="mb-0 mx-auto text-center flex-grow-1">
            Tổng Hợp Tỷ Lệ Định Mức Và Thời Gian Sửa Cá
        </h6>
    </div>

    <div class="card-body px-3 py-2">
        <div id="column-container-TyLeThoiGianVaDinhMucDinhHinh" style="width: 100%; height: 350px;"></div>
        <div id="Grid"></div>
    </div>
</div>



<script>
    $(document).ready(function () {
        taiDasboardTongHopTyLeThoiGianVaDinhMucDinhHinh();
    });

    function formatCategoryName(category) {
        switch (category) {
            case 'DinhMuc': return 'Định Mức';
            case 'ThoiGian': return 'Thời Gian';
            default: return category;
        }
    }

    var chart_TyLeThoiGianVaDinhMucDinhHinh;
    var chartDataGlobal = []; // dữ liệu toàn cục dùng cho tooltip

    function createChartTyLeThoiGianVaDinhMuc() {
        chart_TyLeThoiGianVaDinhMucDinhHinh = new ej.charts.Chart({
            primaryXAxis: {
                valueType: 'Category',
                labelIntersectAction: 'Rotate45',
                majorGridLines: { width: 0 },
                majorTickLines: { width: 0 },
                lineStyle: { width: 0 }
            },
            primaryYAxis: {
                minimum: 0,
                maximum: 100,
                interval: 20,
                labelFormat: '{value}%',
                lineStyle: { width: 0 },
                majorTickLines: { width: 0 },
                majorGridLines: { width: 1 },
                minorGridLines: { width: 1 }
            },
            chartArea: { border: { width: 0 } },
            series: [
                {
                    type: 'StackingColumn100',
                    dataSource: [],
                    xName: 'category',
                    yName: 'Dat',
                    name: 'Đạt',
                    columnWidth: 0.6,
                    border: { width: 1, color: 'white' },
                    marker: {
                        dataLabel: {
                            visible: true,
                            position: 'Center',
                            font: { color: 'white', fontWeight: 'bold' }
                        }
                    }
                },
                {
                    type: 'StackingColumn100',
                    dataSource: [],
                    xName: 'category',
                    yName: 'KhongDat',
                    name: 'Không đạt',
                    columnWidth: 0.6,
                    border: { width: 1, color: 'white' },
                    marker: {
                        dataLabel: {
                            visible: true,
                            position: 'Center',
                            font: { color: 'white', fontWeight: 'bold' }
                        }
                    }
                }
            ],
            tooltip: {
                enable: true,
                header: '<b>${point.x}</b>',
                shared: false
            },
            tooltipRender: function (args) {
                let category = args.point.x;
                let isDat = args.series.name === 'Đạt';
                let row = chartDataGlobal.find(d => d.category === category);
                if (!row) return;

                let soRo = isDat ? row.soRoDat : row.soRoKhongDat;
                let soRoFm = soRo.toLocaleString('vi-VN', {minimumFractionDigits: 2,maximumFractionDigits: 2});
                let formattedCategory = formatCategoryName(category);
                args.header = `<b>${formatCategoryName(category)}</b>`;
                args.text = `${args.series.name}: <b>${args.point.y.toFixed(1)}%</b><br>Số rổ: <b>${soRoFm}</b>`;
            },
            textRender: function (args) {
                let category = args.point.x;
                let isDat = args.series.name === 'Đạt';
                let row = chartDataGlobal.find(d => d.category === category);
                if (!row) return;

                let soRo = isDat ? row.soRoDat : row.soRoKhongDat;
                let soRoFm = soRo.toLocaleString('vi-VN', {minimumFractionDigits: 2,maximumFractionDigits: 2});
                args.text = `${args.point.y.toFixed(1)}% (${soRoFm})`;
            },
            axisLabelRender: function (args) {
                if (args.axis.name === 'primaryXAxis') {
                    args.text = formatCategoryName(args.text);
                }
            },

            legendSettings: {
                visible: true,
                shape: 'Rectangle',
                enableHighlight: true
            },
            load: function (args) {
                // loadChartTheme(args); // nếu có dùng chủ đề
            }
        });

        chart_TyLeThoiGianVaDinhMucDinhHinh.appendTo('#column-container-TyLeThoiGianVaDinhMucDinhHinh');
    }
    function loadChart_TongHopTyLeThoiGianVaDinhMucDinhHinh(data) {
        if (!chart_TyLeThoiGianVaDinhMucDinhHinh || !Array.isArray(data)) return;

        chartDataGlobal = data;

        // Gán text thủ công cho từng điểm
        const series0Data = data.map(row => ({
            ...row,
            text: `${row.Dat.toFixed(1)}% (${row.soRoDat.toLocaleString('vi-VN', {minimumFractionDigits: 2,maximumFractionDigits: 2})})`
        }));
        const series1Data = data.map(row => ({
            ...row,
            text: `${row.KhongDat.toFixed(1)}% (${row.soRoKhongDat.toLocaleString('vi-VN', {minimumFractionDigits: 2,maximumFractionDigits: 2})})`
        }));

        chart_TyLeThoiGianVaDinhMucDinhHinh.series[0].dataSource = series0Data;
        chart_TyLeThoiGianVaDinhMucDinhHinh.series[1].dataSource = series1Data;

        chart_TyLeThoiGianVaDinhMucDinhHinh.series[0].marker.dataLabel.name = 'text';
        chart_TyLeThoiGianVaDinhMucDinhHinh.series[1].marker.dataLabel.name = 'text';

        chart_TyLeThoiGianVaDinhMucDinhHinh.series[0].dataBind();
        chart_TyLeThoiGianVaDinhMucDinhHinh.series[1].dataBind();
    }

    function getDataForChartTyLeThoiGianVaDinhMucDinhHinh(xuongId) {
        let chartData = null;
        const fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        const toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        $.ajax({
            url: '/Dashboard/DataChartTongHopTongHopTyLeThoiGianVaDinhMucDinhHinh',
            type: 'GET',
            data: {fromDate:fromDate,toDate:toDate, xuongId: xuongId },
            async: false,
            success: function (response) {
                if (response.Success) {
                    chartData = response.DataChart;
                     if (Array.isArray(chartData) && chartData.length > 0) {
                    const weightDisplays = document.querySelectorAll('.weight-displayTyLeThoiGianVaDinhMucDinhHinh');
                    weightDisplays.forEach(display => {
                        display.textContent = `${response.TotalRo} rổ`;
                    });
                }
                } else {
                    console.warn(response.Messages || 'Không có dữ liệu biểu đồ');
                }
            },
            error: function (error) {
                console.error('Lỗi khi tải dữ liệu:', error);
            }
        });

        return chartData;
    }

    function taiDasboardTongHopTyLeThoiGianVaDinhMucDinhHinh() {
        var xuongId = @XuongId;
        //AddUserWaitView(xuongId);

        const chartData = getDataForChartTyLeThoiGianVaDinhMucDinhHinh(xuongId);
        if (!chartData || !Array.isArray(chartData) || chartData.length === 0) return;

        if (!chart_TyLeThoiGianVaDinhMucDinhHinh) {
            createChartTyLeThoiGianVaDinhMuc();
        }

        loadChart_TongHopTyLeThoiGianVaDinhMucDinhHinh(chartData);
    }

    var timeInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");

      // Nếu null thì ép thành 30p
      if (isNaN(timeInterval) || timeInterval <= 0) {
          timeInterval = 1800000;
      }

        setInterval(taiDasboardTongHopTyLeThoiGianVaDinhMucDinhHinh, timeInterval);
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        var toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var xuongId = @XuongId;
        $.ajax({
            url: '/Dashboard/TongHopTongHopTyLeThoiGianVaDinhMucForGridDinhHinh',
            type: 'GET',
            dataType: 'json',
            data: {
                fromDate: fromDate,toDate:toDate,xuongId:xuongId
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        //rowSelected: onRowSelected,
                        //height: auto,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 , type: 'date', format: 'dd-MM-yyyy'},
                            
                            { field: 'SoRoDauDinhMuc', headerText: 'Số Rổ Đậu ĐM', type: 'number',format:'N2', width: 150 },
                            { field: 'TyLeDauDinhMuc', headerText: 'Tỷ Lệ Đậu ĐM', width: 150 },
                            { field: 'SoRoRotDinhMuc', headerText: 'Số Rổ Rớt ĐM', type: 'number',format:'N2', width: 150 },
                            { field: 'TyLeRotDinhMuc', headerText: 'Tỷ Lệ Rớt ĐM', width: 150 },
                            { field: 'SoRoDatThoiGian', headerText: 'Số Rổ Đạt TG', type: 'number',format:'N2', width: 150 },
                            { field: 'TyLeDatThoiGian', headerText: 'Tỷ Lệ Đạt TG', width: 150 },
                            { field: 'SoRoRotThoiGian', headerText: 'Số Rổ Rớt TG', type: 'number',format:'N2', width: 150 },
                            { field: 'TyLeRotThoiGian', headerText: 'Tỷ Lệ Rớt TG', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                         if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                         }};
                    }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
</script>
<script>

    window.addEventListener("DOMContentLoaded", function () {
        const today = new Date().toLocaleDateString('en-CA');
        //const today = new Date('2023/10/05');
        const fromInput = document.getElementById("fromDateDB");
        const toInput = document.getElementById("toDateDB");
        const minuteInput = document.getElementById("minuteInput");

        const savedFrom = localStorage.getItem("fromDate_dashboard_user_Advance");
        const savedTo = localStorage.getItem("toDate_dashboard_user_Advance");
        const savedInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");
        const isApplied = localStorage.getItem("dashboard_is_applied_Advance");
        
        // nếu apply thì áp dung localstoge sau khi hoanf thành thì xóa cờ
        if (isApplied === "true" && savedFrom && savedTo) {
            fromInput.value = savedFrom;
            toInput.value = savedTo;
            localStorage.removeItem("dashboard_is_applied_Advance"); // Xoá cờ khi đã dùng
        } else {
            fromInput.value = today;
            toInput.value = today;
            localStorage.setItem("fromDate_dashboard_user_Advance", today);
            localStorage.setItem("toDate_dashboard_user_Advance", today);
        }

        if (savedInterval) {
            const minutes = parseInt(savedInterval, 10) / 60000;
            minuteInput.value = Math.max(minutes, 5);
        } else {
            minuteInput.value = 30;
            localStorage.setItem("timeInterval_dashboard_user_Advance", 1800000); // 30 phút mặc định
        }
    });


@{
    var tptl = ViewBag.listTPTLModel;
    var NumberDate = @Context.Session.GetString("NumberDate");
}

<style>

    .active-link {
        color: #696cff; /* Màu chữ khi đã click */
        font-weight: bold; /* Độ đậm chữ khi đã click */
        text-decoration: underline; /* Gạch chân khi đã click (tùy chọn) */
        transition: all 0.3s ease; /* Hiệu ứng chuyển đổi trong 0.3 giây */
    }


    .apexcharts-tooltip {
        display: none !important;
    }

    td.fitwidth {
        width: 1px;
        white-space: nowrap;
    }

</style>

<div class="card mb-4">
    <div class="card-body d-flex flex-column justify-content-between align-items-center mb-3">

        <div id="element" class="position-relative"></div>

        <div id="loadingIndicator" class=" spinner-border text-primary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
            <span class="visually-hidden">Đang tải...</span>
        </div>

        <a id="detailLink" class="me-1"
           data-bs-toggle="collapse"
           data-bs-target="#collapseExample"
           aria-expanded="false"
           aria-controls="collapseExample">
            Xem chi tiết
        </a>
        <div class="collapse" id="collapseExample">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead class="d-none">
                        <tr>
                            <th scope="col">1</th>
                            <th scope="col">2</th>
                            <th scope="col">3</th>
                        </tr>
                    <tbody class="table-border-bottom-0">
                    </tbody>
                </table>
            </div>

        </div>

    </div>
</div>




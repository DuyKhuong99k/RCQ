<script>
    var detailLink = document.getElementById('detailLink');
    detailLink.addEventListener('click', function () {
        if (this.classList.contains('active-link')) {
            this.classList.remove('active-link');
        } else {
            this.classList.add('active-link');
        }
    });


    let tongHopTPDHChart;

    $(document).ready(function () {
        document.getElementById("loadingIndicator").style.display = "block";
        loadData();
    });
    function loadData() {
        const parentElement = document.querySelector('.table-border-bottom-0');
        var fromDate = "@DateTime.Now.Date.AddDays(int.Parse((NumberDate ?? "0").ToString()) * -1).ToString("yyyy-MM-dd")";
        var toDate = "@DateTime.Now.Date.ToString("yyyy-MM-dd")";
        $.ajax({
            url: '/Dashboard/TongHopTyLeThanhPhamWithDate',
            data: { fromDate: fromDate, toDate: toDate },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (tongHopTPDHChart) {
                    tongHopTPDHChart.series[0].dataSource = data.datas;
                } else {
                    rendertChartTHTPDH(data);
                }
                parentElement.innerHTML = '';
                updateUI(data);

            },
            error: function (error) {
                console.error('Đã xảy ra lỗi khi lấy dữ liệu từ server:', error);
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
            }
        });
    }


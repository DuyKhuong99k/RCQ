<script>

   function generateCards(chartDataSLDMTPFL) {
        const cardContainer = document.getElementById('cardContainer');
        cardContainer.innerHTML = '';

        cardContainer.style.display = 'flex';
        cardContainer.style.flexWrap = 'wrap';
        cardContainer.style.gap = '10px';
        cardContainer.style.padding = '10px';
        cardContainer.style.maxHeight = '550px';  // Giới hạn chiều cao
        //cardContainer.style.overflowY = 'auto';   // Thêm thanh cuộn dọc

        chartDataSLDMTPFL.forEach(item => {
            const cardDiv = document.createElement('div');
            cardDiv.style.flex = '0 0 auto';
            cardDiv.style.width = '200px';
            cardDiv.className = 'card h-100';
            cardDiv.style.fontSize = '10px';
            cardDiv.style.backgroundColor = 'rgba(0, 0, 0, 0.5)';
            cardDiv.style.color = 'white';
            cardDiv.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.5)';
            cardDiv.style.borderRadius = '6px';

            const cardBody = document.createElement('div');
            cardBody.className = 'card-body';
            cardBody.style.padding = '8px';

            const cardTitle = document.createElement('h5');
            cardTitle.className = 'card-title';
            cardTitle.style.fontSize = '11px';
            cardTitle.textContent = item.Nhom;
            cardTitle.style.color = 'white';
            cardBody.appendChild(cardTitle);

            const hr = document.createElement('hr');
            hr.style.border = '0';
            hr.style.borderTop = '1px solid #ccc';
            hr.style.margin = '5px 0';
            cardBody.appendChild(hr);

            const weightPara = document.createElement('p');
            weightPara.className = 'card-text';
            weightPara.innerHTML = `<strong>Sản Lượng:</strong> ${Number(item.TongTLTra).toLocaleString('vi-VN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} kg`;
            cardBody.appendChild(weightPara);

            for (const [key, value] of Object.entries(item)) {
                if (key.includes('DinhMuc')) {
                    const dinhMucPara = document.createElement('p');
                    dinhMucPara.className = 'card-text';
                    dinhMucPara.innerHTML = `<strong>${key.replace('DinhMuc_', '')}:</strong> ${Number(value).toLocaleString('vi-VN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                    cardBody.appendChild(dinhMucPara);
                }
            }

            cardDiv.appendChild(cardBody);
            cardContainer.appendChild(cardDiv);
        });
    }


    var chart_SanLuongDinhMucTPTheoChuyenDinhHinhh;

    $(document).ready(function () {
        taiDasboardTongHopSanLuongDinhMucTPTheoChuyenDinhHinhh();

        var timeInterval = localStorage.getItem("timeInterval_dashboard_user");

        if (isNaN(timeInterval) || timeInterval <= 0) {
            timeInterval = 1800000; // 30 phút mặc định
        }

        setInterval(taiDasboardTongHopSanLuongDinhMucTPTheoChuyenDinhHinhh, timeInterval);
    });

    function taiDasboardTongHopSanLuongDinhMucTPTheoChuyenDinhHinhh() {
        const xuongId = '@XuongId';
        const chartDataSLDMTP = getDataForChartSLDMTP(xuongId);
        if (chartDataSLDMTP && chartDataSLDMTP.length > 0) {
            createComboChart(chartDataSLDMTP);
        }
    }

    function getDataForChartSLDMTP(xuongId) {
        let chartDataSLDMTP = null;
        const fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        const toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        $.ajax({
            url: '/Dashboard/DataChartTongHopSanLuongVaDinhMucThanhPhamTheoChuyenDinhHinh',
            type: 'GET',
            data: { fromDate: fromDate, toDate: toDate, xuongId: xuongId },
            async: false,
            success: function (response) {
                if (response.Success) {
                    chartDataSLDMTP = response.DataChart;
                    if (Array.isArray(chartDataSLDMTP)) {
                         generateCards(chartDataSLDMTP);
                        const weightDisplays = document.querySelectorAll('.weight-displayTBSanLuongCongNhan');
                        weightDisplays.forEach(display => {
                            display.textContent = `${response.TotalTrongLuong} kg`;
                        });
                    }
                } else {
                    console.warn("Không có dữ liệu");
                }
            },
            error: function (e) {
                console.error("Lỗi khi lấy dữ liệu:", e);
            }
        });
        return chartDataSLDMTP;
    }

    function createComboChart(data) {
        const isMobile = window.innerWidth <= 768;
        const xKey = "Nhom";
        const yKey = "TongTLTra";

        const lineKeysSet = new Set();
        data.forEach(row => {
            Object.keys(row).forEach(k => {
                if (k.startsWith("DinhMuc_")) {
                    lineKeysSet.add(k);
                }
            });
        });
        let lineKeys = Array.from(lineKeysSet);

        // data.forEach(row => {
        //     lineKeys.forEach(k => {
        //         if (!(k in row)) {
        //             row[k] = 0;
        //         }
        //     });
        // });

        const series = [];

        // Cột: Tổng trọng lượng
        series.push({
            type: 'Column',
            xName: xKey,
            yName: yKey,
            name: 'Sản Lượng',
            marker: {
                dataLabel: {
                    visible: true,
                    font: { fontWeight: '600', color: '#000' }
                }
            }
        });

        // Các đường định mức
        lineKeys.forEach((key) => {
            series.push({
                type: 'Line',
                xName: xKey,
                yName: key,
                name: key.replace("DinhMuc_", ""),
                width: 2,
                marker: { visible: true },
                yAxisName: 'yDinhMuc'
            });
        });

        if (chart_SanLuongDinhMucTPTheoChuyenDinhHinhh) {
            chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.series = series;
            chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.dataSource = data;
            chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.refresh();
            return;
        }

        chart_SanLuongDinhMucTPTheoChuyenDinhHinhh = new ej.charts.Chart({
            primaryXAxis: {
                valueType: 'Category',
                labelIntersectAction: 'Rotate45',
                labelRotation: isMobile ? 270 : 0,
                labelStyle: {
                    fontWeight: 'bold',
                    size: '9px',
                    color: '#333'
                },
                majorGridLines: { width: 0 },
                majorTickLines: { width: 0 },
                minorTickLines: { width: 0 }
            },
            primaryYAxis: {
                title: 'Sản Lượng',
                majorTickLines: { width: 0 },
                lineStyle: { width: 0 },
                labelFormat: '{value}'
            },
            axes: [
                {
                    name: 'yDinhMuc',
                    title: 'Định Mức (%)',
                    opposedPosition: true,
                    lineStyle: { width: 0 },
                    majorTickLines: { width: 0 },
                    labelStyle: { color: '#565656', fontWeight: 'bold' },
                    labelFormat: '{value}'
                }
            ],
            chartArea: { border: { width: 0 } },
            tooltip: {
                enable: true,
                shared: true,showNearestPoint: false,
            },
            legendSettings: { visible: true },
            width: '100%',
            height: '400px',
            series: series,
            dataSource: data,

            textRender: function (args) {
                const num = parseFloat(args.text);
                if (!isNaN(num)) {
                    args.text = num.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            },

            tooltipRender: function (args) {
                const value = args.point?.y;
                const name = args.series?.name;

                if (typeof value === 'number' && !isNaN(value)) {
                    const formatted = value.toLocaleString('vi-VN', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });

                    if (name === 'Sản Lượng') {
                        args.text = `${name}: ${formatted} kg`;
                    } else {
                        args.text = `${name}: ${formatted} %`;
                    }
                }
            }
        });

        chart_SanLuongDinhMucTPTheoChuyenDinhHinhh.appendTo('#column-container-SanLuongDinhMucTPTheoChuyenDinhHinh');
    }
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var fromDate = localStorage.getItem("fromDate_dashboard_user_Advance");
        var toDate = localStorage.getItem("toDate_dashboard_user_Advance");
        var xuongId = @XuongId;
        $.ajax({
            url: '/Dashboard/TongHopSanLuongVaDinhMucThanhPhamTheoChuyenDinhHinh',
            type: 'GET',
            dataType: 'json',
            data: {
                fromDate: fromDate,toDate:toDate,xuongId:xuongId
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        //rowSelected: onRowSelected,
                        //height: auto,
                        columns: [
                            { field: 'Nhom', headerText: 'Nhóm', width: 150 },
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'DinhMuc', headerText: 'Định Mức', type: 'number',format:'N2', width: 200 },
                            { field: 'TLNhan', headerText: 'Trọng Lượng Nhận', type: 'number',format:'N2', width: 200 },
                            { field: 'TLTra', headerText: 'Trọng Lượng Trả', type: 'number',format:'N2', width: 200 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                         if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                         }};
                    }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
</script>
<script>

    window.addEventListener("DOMContentLoaded", function () {
        const today = new Date().toLocaleDateString('en-CA');
        //const today = new Date('2023/10/05');
        const fromInput = document.getElementById("fromDateDB");
        const toInput = document.getElementById("toDateDB");
        const minuteInput = document.getElementById("minuteInput");

        const savedFrom = localStorage.getItem("fromDate_dashboard_user_Advance");
        const savedTo = localStorage.getItem("toDate_dashboard_user_Advance");
        const savedInterval = localStorage.getItem("timeInterval_dashboard_user_Advance");
        const isApplied = localStorage.getItem("dashboard_is_applied_Advance");

        // nếu apply thì áp dung localstoge sau khi hoanf thành thì xóa cờ
        if (isApplied === "true" && savedFrom && savedTo) {
            fromInput.value = savedFrom;
            toInput.value = savedTo;
            localStorage.removeItem("dashboard_is_applied_Advance"); // Xoá cờ khi đã dùng
        } else {
            fromInput.value = today;
            toInput.value = today;
            localStorage.setItem("fromDate_dashboard_user_Advance", today);
            localStorage.setItem("toDate_dashboard_user_Advance", today);
        }

        if (savedInterval) {
            const minutes = parseInt(savedInterval, 10) / 60000;
            minuteInput.value = Math.max(minutes, 5);
        } else {
            minuteInput.value = 30;
            localStorage.setItem("timeInterval_dashboard_user_Advance", 1800000); // 30 phút mặc định
        }
    });


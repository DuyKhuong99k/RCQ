
@{
    ViewData["Title"] = "DBTongHopSanLuongVaDinhMucThanhPhamTheoChuyenDinhHinhAdvanceView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}
<style>
    .collapse-horizontal {
        position: absolute;
        top: 80px;
        left: 0;
        height: 400px;
        background-color: rgba(255, 255, 255, 0.8);
        z-index: 2;
        width: 0;
        max-width: 0;
        transition: all 0.3s ease-in-out;
        /* Xóa overflow: hidden */
        overflow-y: auto; /* CHO PHÉP SCROLL DỌC */
        overflow-x: hidden;
    }

        .collapse-horizontal.collapse.show {
            width: 100%;
            max-width: 100%;
        }

    .collapse-inner {
        padding: 15px;
        white-space: nowrap;
        max-height: 100%;
        overflow-y: auto;
    }

    .card {
        position: relative;
        overflow: visible;
    }
</style>

<div class="row g-3 align-items-end mb-2" style="margin-top: -20px;">
    <!-- Nút Quay lại bên trái -->
    <div class="col-md-auto">
        <button class="btn btn-outline-secondary" type="button" onclick="window.history.back();">
            <i class='bx bx-arrow-back'></i> Quay lại
        </button>
    </div>

    <!-- Các thành phần bên phải, đẩy về cuối hàng -->
    <div class="col-md-auto ms-auto">
        <div class="input-group">
            <span class="input-group-text">Chọn ngày</span>
            <input type="date" class="form-control" id="fromDateDB" name="fromDate">
            <input type="date" class="form-control" id="toDateDB" name="toDate">
        </div>
    </div>
    <div class="col-md-auto" style="z-index:1">
        <div class="input-group">
            <span class="input-group-text">Số phút</span>
            <input type="number" class="form-control" id="minuteInput" name="minuteInput" min="5" value="5">
            <button id="applyBtn" class="btn btn-primary" type="button">
                <i class='bx bx-refresh'></i>
            </button>
        </div>
    </div>
</div>
<div class="card mb-4 marginGridjs position-relative">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 position-relative">
        <div class="text-start">
            <small class="fw-semibold text-muted d-block">Sản lượng trung bình:</small>
            <p class="weight-displayTBSanLuongCongNhan fw-bold fs-6 mb-0">0,000.00 Kg</p>
        </div>
        <h6 class="mb-0 mx-auto text-center flex-grow-1">
            Tổng Hợp Sản Lượng & Định Mức Thành Phẩm Theo Chuyền Sửa Cá
        </h6>
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
            Chi Tiết Định Mức Từng Chuyền
        </button>
    </div>
    <div class="card-body px-3 py-2">
        <div class="collapse collapse-horizontal" id="collapseExample">
            <div class="collapse-inner">
                <div id="cardContainer" style="width: 100%; white-space: nowrap;"></div>
            </div>
        </div>
    </div>
    <div id="column-container-SanLuongDinhMucTPTheoChuyenDinhHinh">
    </div>
    <div id="Grid"></div>
</div>

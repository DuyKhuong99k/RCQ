<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
<script src="~/assets/vendor/libs/inputpicker/jquery.inputpicker.js?v3"></script>
<script>

    let selectedIdsString = "";
    let numRowSelect = 0;
    var grid;
    function creatTable(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid) {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {

            var contextMenuItems = [
                { text: 'Xem ghi chú', id: 'viewNote' },
                { text: 'Chuyển xưởng', id: 'changeDepartment' },
                { text: 'Chuyển size', id: 'changeSize' },
                { text: 'Chuyển thành phẩm', id: 'changeThanhPham' },
                { text: 'Chuyển loại nguyên liệu', id: 'changeLoaiNguyenLieu' },
            ];
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500, 1000] },
                allowSelection: true,
                allowFiltering: true,
                allowSorting: true,
                allowResizing: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                rowSelected: selectionChanged,
                rowDeselected: unSelectionChanged,
                height: 400,
                contextMenuItems: contextMenuItems,
                contextMenuClick: contextMenuClickHandler,
                columns: [
                    { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                    { field: 'LoNguyenLieu', headerText: 'Lô', width: 150 },
                    { field: 'NgayNguyenLieu', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss'  },
                    { field: 'SoPhieu', headerText: 'Số Phiếu', width: 150},
                    { field: 'SoLanSuaDoi', headerText: 'Số Lần Sửa', width: 150},
                    { field: 'DiaDiem', headerText: 'Địa Điểm', width: 150 },
                    { field: 'NguoiGiao', headerText: 'Người Giao', width: 150 },
                    { field: 'TaiXe', headerText: 'Tài Xế', width: 150 },
                    { field: 'SoXe', headerText: 'Số Xe', width: 150 },
                    { field: 'CCCD', headerText: 'CCCD', width: 150 },
                    { field: 'ThoiGian', headerText: 'Thời Gian', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                    { field: 'SDT', headerText: 'SĐT', width: 150 },
                    { field: 'NoiDungGiaoNhan', headerText: 'Nội Dung', width: 150 },
                    { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'QuyCachSanPham', headerText: 'Quy Cách', width: 150 },
                    { field: 'DonViTinh', headerText: 'Đơn Vị', width: 150 },
                    { field: 'CanHang', headerText: 'Cân Hàng', width: 150 },
                    { field: 'TruBi', headerText: 'Trừ Bì', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'PhanLoaiNguyenLieu', headerText: 'Phân Loại', width: 150 },
                    { field: 'TrongLuongHang', headerText: 'Trọng Lượng Gốc', type: 'number', width: 150 },
                    { field: 'TrongLuongPhanBo', headerText: 'Trọng Lượng Phân Bổ', type: 'number', width: 150 },
                    { field: 'TrongLuongXe', headerText: 'Trọng Lượng Xe', type: 'number', width: 150 },
                ],
                aggregates: [{
                    columns: [{
                        type: 'Sum',
                        field: 'TrongLuongHang',
                        format: 'N2',
                        footerTemplate: 'Tổng TL: ${Sum} Kg'
                    }]
                }]
            });
            grid.appendTo('#Grid');
        }
    }

    creatTable();
    function contextMenuClickHandler(args) {
        var rowData = args.rowInfo.rowData;
        if (rowData) {
            switch (args.item.id) {
                case 'viewNote':
                    var ghiChu = rowData.GhiChu;
                    if (ghiChu) {
                        ghiChu = ghiChu.replace(/,/g, '<br>');
                        bootbox.alert({
                            title: "Ghi chú",
                            message: ghiChu,
                            callback: function () { }
                        });
                    } else {
                        bootbox.alert("Không có ghi chú nào cho hàng này.");
                    }
                    break;
                case 'changeDepartment':
                    $.ajax({
                        url: "/XuLyPhieuCanHQ/CheckQuyenHQ",
                        data: { typeOption: "CHUYENXUONG" },
                        type: 'GET',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                bootbox.confirm({
                                    title: "Thông báo!",
                                    message: "Bạn có chắc muốn chuyển xưởng của " + numRowSelect + " phiếu cân đang chọn!",
                                    buttons: {
                                        confirm: {
                                            label: 'OK',
                                            className: 'btn btn-primary'
                                        }
                                    },
                                    callback: function (result) {
                                        if (result) {
                                            $('#modalChuyenXuong').modal('show');
                                        }
                                    }
                                });
                            }
                            else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {


@{
    ViewData["Title"] = "XuLyPhieuCanNhapHQ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);

    var listSanPhams = ViewBag.listSanPhams;
    var listQuyCachs = ViewBag.listQuyCachs;
    var listKhos = ViewBag.listKhos; 
    var listPhuongTiens = ViewBag.listPhuongTiens;
    var listDonViTinhss = ViewBag.listDonViTinhss;

    var XuongId = @Context.Session.GetString("XuongId");
}

<style>
    #modalThem .modal-dialog {
        max-width: 1200px;
    }

    #modalSua .modal-dialog {
        max-width: 1000px;
    }

    #modalXemPhieuCanXoa .modal-dialog {
        max-width: 1000px; 
    }

    #modalXemPhieuCanSua .modal-dialog {
        max-width: 1000px; 
    }

    .displayValueNV {
        width: 100%
    }
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; 
        padding: 5px 10px; 
        font-weight: bold;
        border-bottom: 1px solid #ccc;
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center;
        }
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px;
        border-bottom: 1px solid #eee;
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; 
        }

    span.e-input-group.e-control-wrapper.e-multi-column.e-ddl {
        height: 50px !important;
        border: 1px solid #d9dee3 !important;
        color: #697a8d !important;

        background-clip: padding-box !important;
        min-height: calc(1.53em + 1.5rem + 2px) !important;
        padding: 0.75rem 1.25rem !important;
        font-size: 1rem !important;
        border-radius: 0.5rem !important;
    }

    div#inputpicker-wrapped-list.inputpicker-wrapped-list {

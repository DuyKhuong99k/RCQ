    var chart_PhieuCanTPDinhHinh;
    function loadChart_PhieuCanTPDinhHinh(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        currentViewChartData = undefined;
        var maxYValue = 100;
        if (data && Array.isArray(data) && data.length > 0) {
            // Tìm giá trị lớn nhất của y trong dữ liệu (double)
            maxYValue = Math.max(...data.map(item => item.y));
        }
        var dynamicMaximum = Math.ceil(maxYValue);
        if (chart_PhieuCanTPDinhHinh && data && data.length > 0) {
            chart_PhieuCanTPDinhHinh.series[0].dataSource = dataManager;
            chart_PhieuCanTPDinhHinh.series[1].dataSource = dataManager;
            chart_PhieuCanTPDinhHinh.primaryYAxis.maximum = dynamicMaximum; // Cập nhật giá trị maximum
            chart_PhieuCanTPDinhHinh.primaryYAxis.interval = dynamicMaximum > 0 ? Math.round(dynamicMaximum / 3) : 1; // Cập nhật interval
            chart_PhieuCanTPDinhHinh.refresh();// Refresh biểu đồ
        } else {
            if (chart_PhieuCanTPDinhHinh) {
                chart_PhieuCanTPDinhHinh.destroy();
                document.getElementById('column-container-PhieuCanTPDinhHinh').innerHTML = '';
            }
            var colors = ['#00bdae', '#404041', '#357cd2', '#e56590', '#f8b883',
                '#70ad47', '#dd8abd', '#7f84e8', '#7bb4eb', '#ea7a57'];
            chart_PhieuCanTPDinhHinh = new ej.charts.Chart({
                primaryXAxis: {
                    valueType: 'Category', interval: 1, majorGridLines: { width: 0 }, majorTickLines: { width: 0 },
                    labelIntersectAction: 'None', labelRotation: 270, minorTickLines: { width: 0 },
                    labelStyle: {
                        fontWeight: 'bold',  // Đặt chữ in đậm
                        size: '14px',        // Tăng kích thước chữ
                        color: '#333333'     // Đặt màu sắc chữ dễ nhìn (màu tối hơn)
                    }
                },
                chartArea: { border: { width: 0 } },
                primaryYAxis: {
                    title: 'Trọng Lượng ( kg )',
                    majorTickLines: { width: 0 }, lineStyle: { width: 0 },
                    maximum: dynamicMaximum,
                    interval: dynamicMaximum > 0 ? Math.round(dynamicMaximum / 3) : 1
                },
                // Initializing multiple axis
                axes: [
                    {
                        majorGridLines: { width: 0 },
                        opposedPosition: true,
                        name: 'yAxis',
                        lineStyle: { width: 0 },
                        maximum: 3,
                        interval: Math.round(3 / 3),
                        title: 'Định Mức',
                    }
                ],
                series: [
                    {
                        type: 'Column', xName: 'x', width: 2, yName: 'y', name: "Trọng Lượng",// name: (dataManager != "" || dataManager != null) ? data[0].x : "Thành Phẩm",
                        columnSpacing: 0.1,
                        dataSource: data,
                        marker: {
                            dataLabel:
                            {
                                visible: true,
                                font: {
                                    fontWeight: '600',
                                    color: '#000000'
                                }

                            }
                        }

                    },
                    {
                        type: 'Column',
                        xName: 'x',
                        yName: 'dm', // Tên đúng của dữ liệu
                        yAxisName: 'yAxis', // Đảm bảo trùng khớp
                        name: 'Định Mức',
                        dataSource: data,
                        marker: {
                            dataLabel: {
                                visible: true,
                                font: { fontWeight: '600', color: '#000000' }
                            }
                        }
                    }
                ],
                title: 'Biểu Đồ Năng Suất',
                width: ej.base.Browser.isDevice ? '100%' : '75%',
                tooltip: { enable: true },
                // point render event for chart
                textRender: (args) => {
                    if (args.point.series.yName === 'dm') {
                        var xName = args.point.x;
                        if (!currentViewChartData) {
                            currentViewChartData = args.series.currentViewData;
                        }
                        var d = currentViewChartData
                            .find(x => x.x === xName);
                        if (d) {
                            if (d.dm > d.dmc) {
                                args.color = 'red';
                                args.font.color = 'white';
                            }
                        }
                       
                    }
                }
            });

            chart_PhieuCanTPDinhHinh.appendTo('#column-container-PhieuCanTPDinhHinh');
        }
    }

    function getDataForGrid(fromDate, toDate, keyWord, typeSearch, khauBCN, xuongId, loaiBaoCao) {
        var jsonData = null;

        $.ajax({
            url: '/BaoCaoNhanh/Reload',
            type: 'GET',
            data: {
                fromDate: fromDate,
                toDate: toDate,
                keyWord: keyWord,
                typeSearch: typeSearch,
                khauValues: khauBCN,
                xuongId: xuongId,
                loaiBaoCao: loaiBaoCao
            },
            async: false, // Để đảm bảo dữ liệu được trả về trước khi tiếp tục xử lý
            success: function (response) {
                if (response.Success) {
                    jsonData = response.Data


                } else {
                    toastOptionNotyfi();
                    toastr["warning"](response.Messages, "Không Có Dữ Liệu");
                }
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });

        return jsonData;
    }

    function getDataForChart(fromDate, toDate, keyWord, typeSearch, khauBCN, xuongId, loaiBaoCao) {
        var chartData = null;

        $.ajax({
            url: '/BaoCaoNhanh/Reload',
            type: 'GET',
            data: {
                fromDate: fromDate,
                toDate: toDate,
                keyWord: keyWord,
                typeSearch: typeSearch,
                khauValues: khauBCN,
                xuongId: xuongId,
                loaiBaoCao: loaiBaoCao
            },
            async: false, // Để đảm bảo dữ liệu được trả về trước khi tiếp tục xử lý
            success: function (response) {
                if (response.Success) {
                    chartData = response.DataChart;
                    // Chọn tất cả các phần tử có class 'weight-display'
                    var weightDisplays = document.querySelectorAll('.weight-display');

                    // Clear nội dung trước cho tất cả các phần tử
                    weightDisplays.forEach(function (weightDisplay) {
                        weightDisplay.textContent = '0 kg';
                    });

                    // Sau đó cập nhật dữ liệu mới
                    var totalWeight = response.TotalTrongLuong;
                    weightDisplays.forEach(function (weightDisplay) {
                        weightDisplay.textContent = `${totalWeight} kg`;
                    });
                } else {
                    // toastOptionNotyfi();
                    // toastr["warning"](response.Messages, "Không Có Dữ Liệu Biểu Đồ");
                }
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });

        return chartData;
    }

    function taiBaoCao() {
        var fromDate = document.getElementById("fromDateBCN").value;
        var toDate = document.getElementById("toDateBCN").value;
        var keyWord = document.getElementById("inputTimKiem").value;
        var typeSearch = document.getElementById("loaiTimKiem").value;
        var khauBCN = document.getElementById("khauBCN").value;
        var loaiBaoCao = document.getElementById("loaiBaoCao").value;
        var xuongId = @XuongId;

        // Khởi tạo danh sách lỗi
        var errors = [];

        if (!fromDate) {
            errors.push("Vui lòng nhập 'Từ ngày'");
        }
        if (!toDate) {
            errors.push("Vui lòng nhập 'Đến ngày'");
        }
        if (!keyWord) {
            errors.push("Vui lòng nhập 'Từ khóa'");
        }
        if (!typeSearch) {
            errors.push("Vui lòng nhập 'Loại tìm kiếm'");
        }
        if (!khauBCN || khauBCN == "Chọn...") {
            errors.push("Vui lòng chọn 'Khâu BCN'");
        }
        if (!loaiBaoCao || loaiBaoCao == "Chọn loại báo cáo") {
            errors.push("Vui lòng chọn 'Loại Báo Cáo'");
        }

        // Nếu có lỗi, hiển thị thông báo và vô hiệu hóa nút
        if (errors.length > 0) {
            toastOptionNotyfi();
            toastr["warning"](errors.join("\n"), "Không Có Dữ Liệu Biểu Đồ");
            return;
            // document.getElementById("taiBaoCaoBtn").disabled = true;
        } else {
            // Nếu không có lỗi
            // Gọi AJAX để lấy dữ liệu jsonData và chartData
            var jsonData = getDataForGrid(fromDate, toDate, keyWord, typeSearch, khauBCN, xuongId, loaiBaoCao);
            var chartData = getDataForChart(fromDate, toDate, keyWord, typeSearch, khauBCN, xuongId, loaiBaoCao);
            switch (loaiBaoCao) {
                case "1": // chi tiết
                    switch (khauBCN) {
                        case "PhieuCanPhuPhamv2":
                            loadGridData_PhieuCanPhuPhamv2ChiTiet(jsonData);
                            loadChart_PhieuCanPhuPhamv2(chartData);
                            break;
                        case "PhieuCanBTPFilletv2":
                            loadGridData_PhieuCanBTPFilletv2ChiTiet(jsonData);
                            loadChart_PhieuCanBTPFilletv2(chartData);
                            break;
                        case "PhieuCanLangDa":
                            loadGridData_PhieuCanLangDaChiTiet(jsonData);

<style>
    /* CSS để làm cho option bị vô hiệu hóa mờ đi */
    option:disabled {
        background-color: #eceef1; /* Màu mờ */
    }

    .weight-container {
        display: flex; /* Sử dụng Flexbox để bố trí */
        align-items: center; /* Căn giữa theo chiều dọc */
        justify-content: center; /* Căn giữa theo chiều ngang */
    }

    .weight-display {
        font-size: 24px; /* Kích thước chữ lớn hơn */
        font-weight: bold; /* Đậm */
        color: #4CAF50; /* Màu sắc đẹp */
        background-color: #f0f0f0; /* Nền nhẹ */
        padding: 10px; /* Khoảng cách xung quanh chữ */
        border-radius: 5px; /* Bo tròn các góc */
        margin-left: 10px; /* Khoảng cách giữa h3 và p */

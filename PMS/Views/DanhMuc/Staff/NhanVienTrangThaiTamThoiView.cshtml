@{
    ViewData["Title"] = "NhanVienTrangThaiTamThoiView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
}

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Nhân Viên - Trạng Thái Tạm Thời</h2>
                    <div class="d-flex align-items-center">
                        <label class="form-label text-center mb-0 me-2">Chọn Ngày:</label>
                        <input type="date" id="dateTimeNhanVienTrangThaiTamThoi" class="form-control" style="width: auto;" />
                        <button onclick="reloadData()" style="margin-left:5px" class="btn btn-primary"><i class='bx bx-cloud'></i>Tải dữ liệu</button>
                    </div>
                </div>

                <div class="card-body">
                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
<script>
    var grid;
    function loadGridData(data) {
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        if (grid && data != null && data != "") {
            grid.dataSource = dataManager;
            grid.refresh();
        } else {
            grid = new ej.grids.Grid({
                dataSource: dataManager,
                allowPaging: true,
                pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                allowFiltering: true,
                allowSorting: true,
                filterSettings: { type: 'Excel' },
                selectionSettings: { persistSelection: true },
                //frozenColumns: 3,
                allowResizing: true,
                //rowSelected: onRowSelected,
                // rowSelected: selectionChanged,
                // rowDeselected: unSelectionChanged,
                //allowGrouping: true,
                //groupSettings: { showDropArea: false, columns: ['MaThanhPham'] },
                //toolbar: ['ExcelExport'],
                allowExcelExport: true,
                toolbar: ['ExcelExport'],
                height: 400,
                columns: [
                    { field: 'STT', headerText: 'STT', width: 150 },
                    { field: 'Ngay', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy HH:mm:ss' },
                    { field: 'Gio', headerText: 'Giờ', width: 150 },
                    { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                    { field: 'MaHoSo', headerText: 'Mã Hồ Sơ', width: 150 },
                    { field: 'NhanVienName', headerText: 'Tên Nhân Viên', width: 150 },
                    { field: 'IsPhucVu', headerText: 'Phục Vụ', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                    { field: 'KhuVuc', headerText: 'Khu Vực', width: 150 },
                    { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                    { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },

                ]
            });
            grid.appendTo('#Grid');
        }
    }
    loadGridData();

</script>
<script>
    // Lấy ngày hiện tại
    var today = new Date();

    // Định dạng ngày thành yyyy-MM-dd (định dạng của trường input date)
    var formattedDate = today.toISOString().substr(0, 10);

    // Gán giá trị vào trường input
    document.getElementById("dateTimeNhanVienTrangThaiTamThoi").value = formattedDate;
</script>
<script>

    function reloadData() {
        var dateTime = $('#dateTimeNhanVienTrangThaiTamThoi').val();
        $.ajax({
            url: "@Url.Action("GetDanhSachNhanVienTrangThaiTamThois", "Staff")",
            type: "POST",
            data: { dateTime: dateTime },
            success: function (response) {
                // Kiểm tra trạng thái "Success" trong dữ liệu JSON từ máy chủ
                if (response.Success) {
                    loadGridData(response.Data);
                } else {
                    console.error(response.Messages);
                    toastOptionNotyfi();
                    toastr["error"](response.Messages, "Không có dữ liệu!");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"](error, "Thông báo");
            }

        });
    }
</script>


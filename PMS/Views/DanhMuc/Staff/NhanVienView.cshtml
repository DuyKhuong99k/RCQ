@{
    ViewData["Title"] = "NhanVienView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var XuongId = @Context.Session.GetString("XuongId");
    var listXuongs = ViewBag.listXuongs;
    var listNhoms = ViewBag.listNhoms;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<style>

    div[style*="color: #222222;"] {
        display: none;
    }
</style>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Nhân Viên</h2>
                    @{
                        
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themnhanvien = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên" && x.Func == "Thêm Nhân Viên" && x.Status == 1).FirstOrDefault();
                            if (themnhanvien != null)
                            {
                                <button onclick="showInsertNhanVien()" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalThemNhanVien">Thêm</button>
                            }
                            var suanhanvien = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên" && x.Func == "Sửa Nhân Viên" && x.Status == 1).FirstOrDefault();
                            if (suanhanvien != null)
                            {
                                <button onclick="showUpdateNhanVien()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoanhanvien = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên" && x.Func == "Xoá Nhân Viên" && x.Status == 1).FirstOrDefault();
                            if (xoanhanvien != null)
                            {
                                <button onclick="showDeleteNhanVien()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            // var importnhanvien = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên" && x.Func == "Import Nhân Viên" && x.Status == 1).FirstOrDefault();
                            // if (importnhanvien != null)
                            // {
                            //     <button onclick="importNhanVien()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            // }
                            // var exportnhanvien = rolePermistions.Where(x => x.Fu == "Danh Mục / Nhân Viên" && x.Func == "Export Nhân Viên" && x.Status == 1).FirstOrDefault();
                            // if (exportnhanvien != null)
                            // {
                            //     <button onclick="exportNhanVien()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            // }
                        }
                    </div>

                </div>
            </div>
        </div>

<input type="hidden" id="maNhanVienRowSelected" />
<script>
    var listNhoms = @Html.Raw(Json.Serialize(listNhoms));
    // initialize ComboBox component
    var comboBox = new ej.dropdowns.ComboBox({
        dataSource: listNhoms,
        placeholder: 'Nhập/Chọn Nhóm',
    });
    var comboBox2 = new ej.dropdowns.ComboBox({
        dataSource: listNhoms,
        placeholder: 'Nhập/Chọn Nhóm',
    });
    // Render initialized ComboBox.
    comboBox.appendTo('#displayValueNhom');
    comboBox2.appendTo('#displayValueNhomSua');
</script>
<script>
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/Staff/GetAllNhanViens',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                // Kiểm tra xem Grid đã được tạo chưa
                if (grid) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 10, pageCount:10, pageSizes: [10,50, 100, 200, 500] },
                        allowFiltering: true,
                        allowSorting: true,
                        filterSettings: { type: 'Excel' },
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            //{ field: 'STT', headerText: 'STT', width: 80, textAlign: 'Center' },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'MaChamCong', headerText: 'Mã Chấm Công', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'IsContracting', headerText: 'Trạng Thái', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsPhucVu', headerText: 'Phục Vụ', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsBanKiem', headerText: 'Bàn Kiểm', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsChucNang', headerText: 'Chức Năng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'LoaiSanLuong', headerText: 'Loại SL', width: 100, textAlign: 'Center' },
                            { field: 'IsHuman', headerText: 'Nhân Viên BT', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNhom', headerText: 'Nhóm', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsGiaCong', headerText: 'Gia Công', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            //{ field: '', headerText: '', width: 100, template: '#optionTemplate' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();


    ////optmize load dữ liệu
    

    //// end optimize loadGridData dữ liệu




    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var maNhanVien = selectedRecord.MaNhanVien;
        $('#maNhanVienRowSelected').val(maNhanVien);
    }
</script>
<script>
    function showInsertNhanVien() {
        $.ajax({
            type: "GET",
            url: "/Staff/CreatDefaulNew", // Đường dẫn đến action trong controller
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maNhanVien').val(rs.MaNhanVien);
                    $('#maHoSo').val(rs.MaHoSo);
                    $('#hoTen').val(rs.Name);
                    $('#loaiSanLuong').val(rs.LoaiSanLuong);
                    $('#displayValueNhom').val(rs.DeptName0);
                    //$('#xuongSelect').val(rs.Xuong);
                    $('#isContracting').prop('checked', rs.IsContracting);
                    $('#isPhucVu').prop('checked', rs.IsPhucVu);
                    $('#isBanKiem').prop('checked', rs.IsBanKiem);
                    $('#isNhom').prop('checked', rs.IsNhom);
                    $('#isHuman').prop('checked', rs.IsHuman);
                    $('#isGiaCong').prop('checked', rs.IsGiaCong);
                    $('#isChucNang').prop('checked', rs.IsChucNang);
                    $('#isShowDinhMuc').prop('checked', rs.IsShowDinhMuc);

                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }

    function insertNhanVien() {
        var maNhanVien = $('#maNhanVien').val();
        var maHoSo = $('#maHoSo').val();
        var tenNhanVien = $('#hoTen').val();
        var loaiSL = $('#loaiSanLuong').val();
        var nhomName = $('#displayValueNhom').val();
        var xuongId = @XuongId;
        var isContracting = $('#isContracting').prop('checked');
        var isPhucVu = $('#isPhucVu').prop('checked');
        var isBanKiem = $('#isBanKiem').prop('checked');
        var isNhom = $('#isNhom').prop('checked');
        var isHuman = $('#isHuman').prop('checked');
        var isGiaCong = $('#isGiaCong').prop('checked');
        var isChucNang = $('#isChucNang').prop('checked');
        var isShowDinhMuc = $('#isShowDinhMuc').prop('checked');
        var maChamCong = $('#maChamCong').val();
        document.getElementById("txtThemNhanVien").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/Staff/DoInsert',
            data: {
                maNhanVien: maNhanVien,
                maHoSo: maHoSo,
                tenNhanVien: tenNhanVien,
                loaiSL: loaiSL,
                nhomName: nhomName,
                xuongId: xuongId,
                isContracting: isContracting,
                isHuman: isHuman,
                isPhucVu: isPhucVu,
                isGiaCong: isGiaCong,
                isBanKiem: isBanKiem,
                isChucNang: isChucNang,
                isNhom: isNhom,
                isShowDinhMuc: isShowDinhMuc,
                maChamCong:maChamCong
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThemNhanVien').modal('hide');
                    $('#nhomSelect').val('');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThemNhanVien").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdateNhanVien() {
        var maNhanVien = $('#maNhanVienRowSelected').val();
        $.ajax({
            url: "/Staff/GetInfoNhanVienByMaNhanVien",
            data: { maNhanVien: maNhanVien },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maNhanVienSua').val(rs.MaNhanVien);
                    $('#maHoSoSua').val(rs.MaHoSo);
                    $('#hoTenSua').val(rs.Name);
                    $('#loaiSanLuongSua').val(rs.LoaiSanLuong);
                    $('#displayValueNhomSua').val(rs.DeptName0);
                    //$('#xuongSelectSua').val(rs.Xuong);
                    $('#isContractingSua').prop('checked', rs.IsContracting);
                    $('#isPhucVuSua').prop('checked', rs.IsPhucVu);
                    $('#isBanKiemSua').prop('checked', rs.IsBanKiem);
                    $('#isNhomSua').prop('checked', rs.IsNhom);
                    $('#isHumanSua').prop('checked', rs.IsHuman);
                    $('#isGiaCongSua').prop('checked', rs.IsGiaCong);
                    $('#isChucNangSua').prop('checked', rs.IsChucNang);
                    $('#isShowDinhMucSua').prop('checked', rs.IsShowDinhMuc);
                    $('#maChamCongSua').val(rs.MaChamCong);
                    $('#modalSuaNhanVien').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function updateNhanVien() {
        var maNhanVien = $('#maNhanVienRowSelected').val();
        var maHoSo = $('#maHoSoSua').val();
        var tenNhanVien = $('#hoTenSua').val();
        var loaiSL = $('#loaiSanLuongSua').val();
        var nhomName = $('#displayValueNhomSua').val();
        var xuongId = @XuongId;
        var isContracting = $('#isContractingSua').prop('checked');
        var isPhucVu = $('#isPhucVuSua').prop('checked');
        var isBanKiem = $('#isBanKiemSua').prop('checked');
        var isNhom = $('#isNhomSua').prop('checked');
        var isHuman = $('#isHumanSua').prop('checked');
        var isGiaCong = $('#isGiaCongSua').prop('checked');
        var isChucNang = $('#isChucNangSua').prop('checked');
        var isShowDinhMuc = $('#isShowDinhMucSua').prop('checked');
        var maChamCong = $('#maChamCongSua').val();
        document.getElementById("txtSuaNhanVien").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/Staff/DoUpdate',
            data: {
                maNhanVien: maNhanVien,
                maHoSo: maHoSo,
                tenNhanVien: tenNhanVien,
                loaiSL: loaiSL,
                nhomName: nhomName,
                xuongId: xuongId,
                isContracting: isContracting,
                isHuman: isHuman,
                isPhucVu: isPhucVu,
                isGiaCong: isGiaCong,
                isBanKiem: isBanKiem,
                isChucNang: isChucNang,
                isNhom: isNhom,
                isShowDinhMuc: isShowDinhMuc,
                maChamCong : maChamCong
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSuaNhanVien').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSuaNhanVien").style.visibility = "visible";
            }
        });
    }
    function showDeleteNhanVien() {
        var maNhanVien = $('#maNhanVienRowSelected').val();
        $.ajax({
            url: '/Staff/GetInfoNhanVienByMaNhanVien',
            data: { maNhanVien: maNhanVien },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá nhân viên: " + rs.Name,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/Staff/DeleteNhanVien',
                                    data: { maNhanVien: maNhanVien },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });

    }





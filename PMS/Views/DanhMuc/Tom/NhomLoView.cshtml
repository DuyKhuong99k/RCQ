@{
    ViewData["Title"] = ViewBag.TitlePage;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Nhóm Lô</h2>
                    <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm Nhóm Lô</button>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                        <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                        <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                        <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Nhóm Lô</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã</label>
                                    <input type="text" id="maLo" class="form-control form-control-lg" placeholder="Nhập mã..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Tên</label>
                                    <input type="text" id="tenLo" class="form-control form-control-lg" placeholder="Nhập tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ngày Nguyên Liệu</label>
                                    <input id='ngayNguyenLieuLo' class="form-control form-control-lg" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ghi Chú</label>
                                    <textarea id="ghiChuLo" class="form-control form-control-lg" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4 list-group">
                                <label class="form-outline">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="daKetThucLo" />
                                    Đã Kết Thúc
                                </label>
                            </div>
                            <div class="col-md-6 mb-4 list-group">
                                <label class="form-outline">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="suDungLo" />
                                    Sử Dụng
                                </label>

                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Nhóm Lô</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã</label>
                                    <input type="text" id="maLoSua" class="form-control form-control-lg" placeholder="Nhập mã..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Tên</label>
                                    <input type="text" id="tenLoSua" class="form-control form-control-lg" placeholder="Nhập tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ngày Nguyên Liệu</label>
                                    <input id='ngayNguyenLieuLoSua' class="form-control form-control-lg" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ghi Chú</label>
                                    <textarea id="ghiChuLoSua" class="form-control form-control-lg" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4 list-group">
                                <label class="">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="daKetThucLoSua" />
                                    Đã Kết Thúc
                                </label>
                            </div>
                            <div class="col-md-6 mb-4 list-group">
                                <label class="">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="suDungLoSua" />
                                    Sử Dụng
                                </label>

                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="maLoRowSelected" />
<script>
    var now = new Date();

    var day = ("0" + now.getDate()).slice(-2);
    var month = ("0" + (now.getMonth() + 1)).slice(-2);

    var today = now.getFullYear() + "-" + (month) + "-" + (day);
    $('#ngayNguyenLieuLo').val(today);
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/T_NhomLo/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã Lô', width: 150 },
                            { field: 'Ten', headerText: 'Tên Lô', width: 150 },
                            { field: 'NgayTao', headerText: 'Ngày Tạo', type: 'date', format: 'dd/MM/yyyy', width: 200 },
                            { field: 'NgayNguyenLieu', headerText: 'Ngày Nguyên Liệu', type: 'date', format: 'dd/MM/yyyy', width: 200 },
                            { field: 'DaKetThuc', headerText: 'Đã Kết Thúc', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'GhiChu', headerText: 'Ghi Chú', width: 200 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaLo = selectedRecord.Ma;
        $('#maLoRowSelected').val(MaLo);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/T_NhomLo/CreatDefautNew", // Đường dẫn đến action trong controller
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maLo').val(rs.Ma);
                    $('#tenLo').val(rs.Ten);
                    $('#daKetThucLo').prop('checked', rs.DaKetThuc);
                    $('#suDungLo').prop('checked', rs.SuDung);
                    $('#ghiChuLo').val(rs.GhiChu);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maLo').val();
        var ten = $('#tenLo').val();
        var ngayNguyenLieu = $('#ngayNguyenLieuLo').val();
        var daKetThuc = $('#daKetThucLo').prop('checked');
        var suDung = $('#suDungLo').prop('checked');
        var ghiChu = $('#ghiChuLo').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/T_NhomLo/DoInsert',
            data: {
                ma: ma,
                ten: ten,
                suDung: suDung,
                ngayNguyenLieu: ngayNguyenLieu,
                daKetThuc: daKetThuc,
                ghiChu: ghiChu
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ma = $('#maLoRowSelected').val();
        $.ajax({
            url: "/T_NhomLo/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maLoSua').val(rs.Ma);
                    $('#tenLoSua').val(rs.Ten);
                    $('#daKetThucLoSua').prop('checked', rs.DaKetThuc);
                    $('#suDungLoSua').prop('checked', rs.SuDung);
                    $('#ghiChuLoSua').val(rs.GhiChu);
                    var now = new Date(rs.NgayNguyenLieu);

                    var day = ("0" + now.getDate()).slice(-2);
                    var month = ("0" + (now.getMonth() + 1)).slice(-2);

                    var today = now.getFullYear() + "-" + (month) + "-" + (day);
                    $('#ngayNguyenLieuLoSua').val(today);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ma = $('#maLoSua').val();
        var ten = $('#tenLoSua').val();
        var ngayNguyenLieu = $('#ngayNguyenLieuLoSua').val();
        var daKetThuc = $('#daKetThucLoSua').prop('checked');
        var suDung = $('#suDungLoSua').prop('checked');
        var ghiChu = $('#ghiChuLoSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/T_NhomLo/DoUpdate',
            data: {
                ma: ma,
                ten: ten,
                suDung: suDung,
                ngayNguyenLieu: ngayNguyenLieu,
                daKetThuc: daKetThuc,
                ghiChu: ghiChu
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var ma = $('#maLoRowSelected').val();
        $.ajax({
            url: "/T_NhomLo/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/T_NhomLo/DoDelete',
                                    data: { ma: ma },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>


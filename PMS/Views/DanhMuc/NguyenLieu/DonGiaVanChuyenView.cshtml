@{
    ViewData["Title"] = "DonGiaVanChuyenView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listNhaCCs = ViewBag.listNhaCCs;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<style>
    span.e-input-group.e-control-wrapper.e-date-wrapper.e-valid-input {
        width: 100%;
        border-radius: 0.5em;
        border: 1px solid #d9dee3 !important;
        color: #566a7f !important;
    }

    .form-control.form-control-lg.e-control.e-datepicker.e-lib.e-input.e-keyboard {
        width: 100%;
        border-radius: 0.5em;
        border: 1px solid #d9dee3 !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Đơn Giá Vận Chuyển</h2>
                    @{
                        var themdongiavanchuyennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Func == "Thêm Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Status == 1).FirstOrDefault();
                        if (themdongiavanchuyennguyenlieu != null)
                        {
                            <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suadongiavanchuyennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Func == "Sửa Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Status == 1).FirstOrDefault();
                            if (suadongiavanchuyennguyenlieu != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoadongiavanchuyennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Func == "Xoá Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Status == 1).FirstOrDefault();
                            if (xoadongiavanchuyennguyenlieu != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importdongiavanchuyennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Func == "Import Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Status == 1).FirstOrDefault();
                            if (importdongiavanchuyennguyenlieu != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportdongiavanchuyennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Func == "Export Nguyên Liệu / Đơn Giá Vận Chuyển" && x.Status == 1).FirstOrDefault();
                            if (exportdongiavanchuyennguyenlieu != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Đơn Giá Vận Chuyển</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Nhà Cung Cấp</label>
                                    <select id="maNhaCC" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Nhà Cung Cấp...</option>
                                        @foreach (var item in listNhaCCs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Áp Dụng</label>
                                    <input id='ngayApDung' class="form-control form-control-lg" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Đơn Giá</label>
                                    <input type="text" id="donGia" class="form-control form-control-lg" placeholder="Nhập Đơn Giá..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ghi Chú</label>
                                    <textarea id="ghiChu" class="form-control form-control-lg" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Đơn Giá Vận Chuyển</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Nhà Cung Cấp</label>
                                    <select id="maNhaCCSua" class="form-control form-control-lg" disabled>
                                        <option disabled selected>Chọn Nhà Cung Cấp...</option>
                                        @foreach (var item in listNhaCCs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Áp Dụng</label>
                                    <input id="ngayApDungSua" class="form-control form-control-lg" type="date" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Đơn Giá</label>
                                    <input type="text" id="donGiaSua" class="form-control form-control-lg" placeholder="Nhập Đơn Giá..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ghi Chú</label>
                                    <textarea id="ghiChuSua" class="form-control form-control-lg" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="maNhaCCRowSelect" />
<input type="hidden" id="ngayApDungRowSelect" />

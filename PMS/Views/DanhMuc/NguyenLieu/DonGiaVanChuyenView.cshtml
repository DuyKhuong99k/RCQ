<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/DonGiaVanChuyen/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                // Kiểm tra xem Grid đã được tạo chưa
                if (grid) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'MaNhaCC', headerText: 'Mã NCC', width: 150 },
                            { field: 'Ten', headerText: 'Tên NCC', width: 150 },
                            { field: 'DonGia', headerText: 'Đơn Giá', type: 'number', width: 150 },
                            { field: 'NgayApDung', headerText: 'Ngày Áp Dụng', type: 'date', format: 'dd/MM/yyyy', width: 200 },
                            { field: 'GhiChu', headerText: 'Ghi Chú', width: 200 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaNhaCC = selectedRecord.MaNhaCC;
        var NgayApDung = selectedRecord.NgayApDung;
        $('#maNhaCCRowSelect').val(MaNhaCC);
        $('#ngayApDungRowSelect').val(NgayApDung);

    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/DonGiaVanChuyen/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#donGia').val(rs.DonGia);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var maNhaCC = $('#maNhaCC').val();
        var ngayApDung = $('#ngayApDung').val();
        var donGia = $('#donGia').val();
        var ghiChu = $('#ghiChu').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/DonGiaVanChuyen/DoInsert',
            data: {
                maNhaCC: maNhaCC,
                ngayApDung: ngayApDung,
                donGia: donGia,
                ghiChu: ghiChu
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                    //clear
                    $('#ghiChu').val('');
                    $('#maNhaCC').val('');
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var maNhaCC = $('#maNhaCCRowSelect').val();
        var ngayApDung = $('#ngayApDungRowSelect').val();
        $.ajax({
            url: "/DonGiaVanChuyen/GetByMaNhaCCAndNgayApDung",
            data: { maNhaCC: maNhaCC, ngayApDung: ngayApDung },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maNhaCCSua').val(rs.MaNhaCC);
                    $('#donGiaSua').val(rs.DonGia);
                    $('#ghiChuSua').val(rs.GhiChu);
                    $('#ngayApDungSua').val(rs.NgayApDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var maNhaCC = $('#maNhaCCSua').val();
        var ngayApDung = $('#ngayApDungSua').val();
        var donGia = $('#donGiaSua').val();
        var ghiChu = $('#ghiChuSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/DonGiaVanChuyen/DoUpdate',
            data: {
                maNhaCC: maNhaCC,
                ngayApDung: ngayApDung,
                donGia: donGia,
                ghiChu: ghiChu
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var maNhaCC = $('#maNhaCCRowSelect').val();
        var ngayApDung = $('#ngayApDungRowSelect').val();
        $.ajax({
            url: '/DonGiaVanChuyen/GetByMaNhaCCAndNgayApDung',
            data: { maNhaCC: maNhaCC, ngayApDung: ngayApDung },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá bàn cắt tiết: " + rs.MaNhaCC,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/DonGiaVanChuyen/DoDelete',
                                    data: { maNhaCC: maNhaCC, ngayApDung: ngayApDung },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });

    }
</script>




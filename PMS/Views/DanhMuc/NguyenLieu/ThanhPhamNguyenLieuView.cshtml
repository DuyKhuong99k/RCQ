<input type="hidden" id="maTPNLRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/ThanhPhamNguyenLieu/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsSNL', headerText: 'Sống', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNgopGhe', headerText: 'Ngộp Ghe', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNgopGheMuoi', headerText: 'Ngộp Ghe Muối', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsMuoiGhePhuPham', headerText: 'Muối Ghe Phụ Phẩm', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNgopAoMuoi', headerText: 'Ngộp Ao Nuôi', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNgopAoPhuPham', headerText: 'Ngộp Ao Phụ Phẩm', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsDatNho', headerText: 'Dạt Nhỏ', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsPhuPhamCaTap', headerText: 'Phụ Phẩm Cá Tạp', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsCaCanTin', headerText: 'Căn Tin', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsCaNgopXeMuoi', headerText: 'Ngộp Xe Muối', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNgopGhePhuPham', headerText: 'Ngộp Ghe Phụ Phẩm', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNgopXePhuPham', headerText: 'Ngộp Xe Phụ Phẩm', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsCaNgopGheTuoiBanNgoai', headerText: 'Ngộp Ghe Tươi Bán Ngoài', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsCaNgopGheAoBanNgoai', headerText: 'Ngộp Ao Ghe Bán Ngoài', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsManh', headerText: 'Mạnh', width: 150, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'TyLeNuoc', headerText: 'Tỷ Lệ Nước', type: 'number', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;

        $('#maTPNLRowSelected').val(Ma);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/ThanhPhamNguyenLieu/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPNL').val(rs.Ma);
                    $('#tenTPNL').val(rs.Ten);
                    $('#tyLeNuocTPNL').val(rs.TyLeNuoc);
                    $('#suDungTPNL').prop('checked', rs.SuDung);
                    $('#isSNL').prop('checked', rs.IsSNL);
                    $('#isNgopGheMuoi').prop('checked', rs.IsNgopGheMuoi);
                    $('#isNgopAoMuoi').prop('checked', rs.IsNgopAoMuoi);
                    $('#isDatNho').prop('checked', rs.IsDatNho);
                    $('#isCaCanTin').prop('checked', rs.IsCaCanTin);
                    $('#isNgopGhePhuPham').prop('checked', rs.IsNgopGhePhuPham);
                    $('#isNgopGheTuoiBanNgoai').prop('checked', rs.IsCaNgopGheTuoiBanNgoai);
                    $('#isManh').prop('checked', rs.IsManh);
                    $('#isNgopGhe').prop('checked', rs.IsNgopGhe);
                    $('#isMuoiGhePhuPham').prop('checked', rs.IsMuoiGhePhuPham);
                    $('#isNgopAoPhuPham').prop('checked', rs.IsNgopAoPhuPham);
                    $('#isPhuPhamCaTap').prop('checked', rs.IsPhuPhamCaTap);
                    $('#isCaNgopXeMuoi').prop('checked', rs.IsCaNgopXeMuoi);
                    $('#isNgopXePhuPham').prop('checked', rs.IsNgopXePhuPham);
                    $('#isCaNgopGheAoBanNgoai').prop('checked', rs.IsCaNgopGheAoBanNgoai);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maTPNL').val();
        var ten = $('#tenTPNL').val();
        var tyLeNuoc = $('#tyLeNuocTPNL').val();
        var suDung = $('#suDungTPNL').prop('checked');
        var isSNL = $('#isSNL').prop('checked');
        var isNgopGheMuoi = $('#isNgopGheMuoi').prop('checked');
        var isNgopAoMuoi = $('#isNgopAoMuoi').prop('checked');
        var isDatNho = $('#isDatNho').prop('checked');
        var isCaCanTin = $('#isCaCanTin').prop('checked');
        var isNgopGhePhuPham = $('#isNgopGhePhuPham').prop('checked');
        var isNgopGheTuoiBanNgoai = $('#isNgopGheTuoiBanNgoai').prop('checked');
        var isManh = $('#isManh').prop('checked');
        var isNgopGhe = $('#isNgopGhe').prop('checked');
        var isMuoiGhePhuPham = $('#isMuoiGhePhuPham').prop('checked');
        var isNgopAoPhuPham = $('#isNgopAoPhuPham').prop('checked');
        var isPhuPhamCaTap = $('#isPhuPhamCaTap').prop('checked');
        var isCaNgopXeMuoi = $('#isCaNgopXeMuoi').prop('checked');
        var isNgopXePhuPham = $('#isNgopXePhuPham').prop('checked');
        var isCaNgopGheAoBanNgoai = $('#isCaNgopGheAoBanNgoai').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/ThanhPhamNguyenLieu/DoInsert',
            data: {
                ma: ma,
                ten: ten,
                tyLeNuoc: tyLeNuoc,
                suDung: suDung,
                isSNL: isSNL,
                isNgopGhe: isNgopGhe,
                isNgopGheMuoi: isNgopGheMuoi,
                isMuoiGhePhuPham: isMuoiGhePhuPham,
                isNgopAoMuoi: isNgopAoMuoi,
                isNgopAoPhuPham: isNgopAoPhuPham,
                isDatNho: isDatNho,
                isPhuPhamCaTap: isPhuPhamCaTap,
                isCaCanTin: isCaCanTin,
                isCaNgopXeMuoi: isCaNgopXeMuoi,
                isNgopGhePhuPham: isNgopGhePhuPham,
                isNgopXePhuPham: isNgopXePhuPham,
                isNgopGheTuoiBanNgoai: isNgopGheTuoiBanNgoai,
                isCaNgopGheAoBanNgoai: isCaNgopGheAoBanNgoai,
                isManh: isManh
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>

<input type="hidden" id="maGheMCGVNRowSelected" />
<input type="hidden" id="ngayMCGVNRowSelected" />
<script>

    function onfiltering(e) {
        var query = new ej.data.Query().select(['Ma', 'Ten', 'SuDung']); // Chỉ lấy 100 phần tử đầu tiên
        var predicateQuery = query.where(new ej.data.Predicate('Ma', 'contains', e.text, true));//.or('Ten', 'contains', e.text, true));
        query = (e.text !== '') ? predicateQuery : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(@ViewBag.listGheVungNuois)), query);
        isCheckScroll.call(this);
    }

    function onComboBoxOpen(args) {
        var comboBox = args.popup; // Lấy popup của combobox
        if (comboBox) {
            // Kiểm tra nếu dataSource tồn tại
            if (comboBox.dataSource) {
                // Chỉ hiển thị 10 phần tử đầu tiên
                comboBox.dataSource = comboBox.dataSource.slice(0, 10);
            }
        }
    }

    function isCheckScroll() {
        if (this.popupObj && this.popupObj.element && this.liCollections.length > 0) {
            var offsetHeight = this.popupObj.element.querySelector('.e-content').offsetHeight;
            var contentHeight = offsetHeight < this.liCollections[0].offsetHeight * this.liCollections.length;
            if (contentHeight || offsetHeight === 0) {
                this.popupObj.element.classList.add('e-scroller');
            } else {
                this.popupObj.element.classList.remove('e-scroller');
            }
        }
    }

</script>
<script>
    function chuyenDoiNgay(inputDate) {
        // Chuyển đổi kiểu dữ liệu của inputDate thành đối tượng Date
        var dateObject = new Date(inputDate);

        // Lấy ngày, tháng, năm từ đối tượng Date
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1; // Tháng bắt đầu từ 0
        var year = dateObject.getFullYear();

        // Định dạng lại ngày, tháng, năm theo định dạng yyyy-MM-dd
        var formattedDate = year + "-" + (month < 10 ? '0' : '') + month + "-" + (day < 10 ? '0' : '') + day;

        // Trả về ngày đã định dạng
        return formattedDate;
    }
    // Lấy ngày hiện tại
    var today = new Date();

    // Định dạng ngày thành yyyy-MM-dd (định dạng của trường input date)
    var formattedDate = today.toISOString().substr(0, 10);

    // Gán giá trị vào trường input
    //document.getElementById("ngaynxnhapdauao").value = formattedDate;
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/MauCaGiongVungNuoi/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'MaGhe', headerText: 'Mã Ghe', width: 150 },
                            { field: 'GheName', headerText: 'Tên Ghe', width: 150 },
                            { field: 'SoLuong', headerText: 'Số Lượng', width: 150 },
                            { field: 'TrongLuongDonVi', headerText: 'Trọng Lương Đơn Vị', width: 150 },
                            { field: 'TrongLuong', headerText: 'Trọng Lượng Trên Giấy', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ngay = selectedRecord.Ngay;
        var MaGhe = selectedRecord.MaGhe;

        $('#ngayMCGVNRowSelected').val(Ngay);
        $('#maGheMCGVNRowSelected').val(MaGhe);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/MauCaGiongVungNuoi/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#ngayMCGVN').val(rs.Ngay);
                    // $('#maGheMCGVN').val(rs.MaGhe);
                    // $('#soLuongMCGVN').val(rs.SoLuong);
                    // $('#trongLuongDonViMCGVN').val(rs.TrongLuongDonVi);
                    // $('#trongLuongMCGVN').val(rs.TrongLuong);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ngay = $('#ngayMCGVN').val();
        var comboboxMaGhe = document.getElementById('maGheMCGVN').ej2_instances[0];
        var maGhe = comboboxMaGhe.value;
        var soLuong = $('#soLuongMCGVN').val();
        var trongLuongDonVi = $('#trongLuongDonViMCGVN').val();
        var trongLuong = $('#trongLuongMCGVN').val();

        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/MauCaGiongVungNuoi/DoInsert',
            data: {
                ngay: ngay,
                maGhe: maGhe,
                soLuong: soLuong,
                trongLuongDonVi: trongLuongDonVi,
                trongLuong: trongLuong,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ngay = $('#ngayMCGVNRowSelected').val();
        var maGhe = $('#maGheMCGVNRowSelected').val();
        $.ajax({
            url: "/MauCaGiongVungNuoi/GetsByMa",
            data: { ngay: ngay, maGhe: maGhe },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#ngayMCGVNSua').val(chuyenDoiNgay(rs.Ngay));
                    $('#maGheMCGVNSua').val(rs.MaGhe);
                    // var comboBoxObjpv = document.getElementById('maGheMCGVNSua').ej2_instances[0];
                    // // Sử dụng phương thức value để gán MaNhanVien
                    // comboBoxObjpv.value = rs.MaGhe;
                    // // Nếu cần, có thể dùng phương thức `dataBound` để gán giá trị sau khi dữ liệu đã được liên kết
                    // comboBoxObjpv.dataBound = function () {
                    //     comboBoxObjpv.value = rs.MaGhe;
                    // };
                    $('#soLuongMCGVNSua').val(rs.SoLuong);
                    $('#trongLuongDonViMCGVNSua').val(rs.TrongLuongDonVi);
                    $('#trongLuongMCGVNSua').val(rs.TrongLuong);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ngay = $('#ngayMCGVNSua').val();
       
        var maGhe = $('#maGheMCGVNSua').val();
        var soLuong = $('#soLuongMCGVNSua').val();
        var trongLuongDonVi = $('#trongLuongDonViMCGVNSua').val();
        var trongLuong = $('#trongLuongMCGVNSua').val();

        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/MauCaGiongVungNuoi/DoUpdate',
            data: {
                ngay: ngay,
                maGhe: maGhe,
                soLuong: soLuong,
                trongLuongDonVi: trongLuongDonVi,
                trongLuong: trongLuong
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var ngay = $('#ngayMCGVNRowSelected').val();
        var maGhe = $('#maGheMCGVNRowSelected').val();
        $.ajax({
            url: "/MauCaGiongVungNuoi/GetsByMa",
            data: { ngay: ngay, maGhe: maGhe },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.MaGhe,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/MauCaGiongVungNuoi/DoDelete',
                                    data: { ngay: ngay, maGhe: maGhe },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            loadGridData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>



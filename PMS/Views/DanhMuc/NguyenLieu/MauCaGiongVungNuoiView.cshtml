@using Newtonsoft.Json
@{
    ViewData["Title"] = "MauCaGiongVungNuoiView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listGheVungNuois = ViewBag.listGheVungNuois;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Mẫu Cá Giống Vùng Nuôi</h2>
                    @{
                        var themMauCaGiongVungNuoi = rolePermistions.Where(x => x.Fu == "Danh Mục / Vùng Nuôi / Mẫu Cá Giống" && x.Func == "Thêm Vùng Nuôi / Mẫu Cá Giống" && x.Status == 1).FirstOrDefault();
                        if (themMauCaGiongVungNuoi != null)
                        {
                            <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suaMauCaGiongVungNuoi = rolePermistions.Where(x => x.Fu == "Danh Mục / Vùng Nuôi / Mẫu Cá Giống" && x.Func == "Sửa Vùng Nuôi / Mẫu Cá Giống" && x.Status == 1).FirstOrDefault();
                            if (suaMauCaGiongVungNuoi != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaMauCaGiongVungNuoi = rolePermistions.Where(x => x.Fu == "Danh Mục / Vùng Nuôi / Mẫu Cá Giống" && x.Func == "Xoá Vùng Nuôi / Mẫu Cá Giống" && x.Status == 1).FirstOrDefault();
                            if (themMauCaGiongVungNuoi != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importMauCaGiongVungNuoi = rolePermistions.Where(x => x.Fu == "Danh Mục / Vùng Nuôi / Mẫu Cá Giống" && x.Func == "Import Vùng Nuôi / Mẫu Cá Giống" && x.Status == 1).FirstOrDefault();
                            if (themMauCaGiongVungNuoi != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportMauCaGiongVungNuoi = rolePermistions.Where(x => x.Fu == "Danh Mục / Vùng Nuôi / Mẫu Cá Giống" && x.Func == "Export Vùng Nuôi / Mẫu Cá Giống" && x.Status == 1).FirstOrDefault();
                            if (themMauCaGiongVungNuoi != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/vendor/libs/inputpicker/jquery.inputpicker.js?v3"></script>
<script>
    function getCurrentTime() {
        let now = new Date();

        // Lấy các thành phần giờ, phút, giây và mili giây
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');
        let milliseconds = String(now.getMilliseconds()).padStart(7, '0');

        // Định dạng thời gian theo yêu cầu
        let currentTime = `${hours}:${minutes}:${seconds}.${milliseconds}`;

        return currentTime;
    }
    function setFormattedTime(timeString) {
        // Chuyển đổi chuỗi thời gian sang đối tượng Date
        var time = new Date("1970-01-01T" + timeString);

        // Lấy giờ và phút
        var hours = time.getHours().toString().padStart(2, '0');
        var minutes = time.getMinutes().toString().padStart(2, '0');
        var seconds = time.getSeconds().toString().padStart(2, '0');

        // Định dạng lại chuỗi thời gian
        var formattedTime = hours + ":" + minutes;

        return formattedTime;
    }




    // Lấy ngày hiện tại
    var today = new Date();

    // Định dạng ngày thành yyyy-MM-dd (định dạng của trường input date)
    var formattedDate = today.toISOString().substr(0, 10);

    // Gán giá trị vào trường input
    document.getElementById("ngaynxnhapdauao").value = formattedDate;
    document.getElementById("ngayxpnhapdauao").value = formattedDate;
    document.getElementById("ngaybcnhapdauao").value = formattedDate;
    document.getElementById("gioxpnhapdauao").value = setFormattedTime(getCurrentTime());



    function chuyenDoiNgay(inputDate) {
        // Chuyển đổi kiểu dữ liệu của inputDate thành đối tượng Date
        var dateObject = new Date(inputDate);

        // Lấy ngày, tháng, năm từ đối tượng Date
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1; // Tháng bắt đầu từ 0
        var year = dateObject.getFullYear();

        // Định dạng lại ngày, tháng, năm theo định dạng yyyy-MM-dd
        var formattedDate = year + "-" + (month < 10 ? '0' : '') + month + "-" + (day < 10 ? '0' : '') + day;

        // Trả về ngày đã định dạng
        return formattedDate;
    }
    function layGioTuDate(dateString) {
        // Khởi tạo một đối tượng Date từ chuỗi ngày
        var date = new Date(dateString);

        // Lấy giờ, phút và giây từ đối tượng Date
        var gio = date.getHours();
        var phut = date.getMinutes();
        var giay = date.getSeconds();

        // Định dạng lại chuỗi kết quả
        var gioPhutGiayString = pad(gio, 2) + ":" + pad(phut, 2) + ":" + pad(giay, 2);

        // Trả về chuỗi kết quả
        return gioPhutGiayString;
    }

    // Hàm pad để thêm số 0 vào trước nếu cần
    function pad(number, length) {
        var str = '' + number;
        while (str.length < length) {
            str = '0' + str;
        }
        return str;
    }

    function setTimeInput(time) {
        /// Kiểm tra định dạng thời gian hợp lệ
        const timeParts = time.split(':');

        // Nếu định dạng không đúng hoặc không đủ 3 phần, trả về thông báo lỗi
        if (timeParts.length !== 3) {
            console.error("Invalid time format. Please use hh:mm:ss.");
            return;
        }

        // Lấy giờ, phút và giây từ chuỗi
        let hours = timeParts[0].padStart(2, '0');
        let minutes = timeParts[1].padStart(2, '0');
        let seconds = timeParts[2].padStart(2, '0');

        // Tạo chuỗi thời gian theo định dạng hh:mm:ss
        let formattedTime = `${hours}:${minutes}:${seconds}`;

        return formattedTime;
    }
</script>

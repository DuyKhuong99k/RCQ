@{
    ViewData["Title"] = "PhuongTienTaiTrongView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listPhuongTiens = ViewBag.listPhuongTiens;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Phương Tiện - Tải Trọng</h2>
                    @{
                        
                    }
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themphuongtientaitrongnguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Tải Trọng" && x.Func == "Thêm Nguyên Liệu / Phương Tiện Tải Trọng" && x.Status == 1).FirstOrDefault();
                            if (themphuongtientaitrongnguyenlieu != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaphuongtientaitrongnguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Tải Trọng" && x.Func == "Sửa Nguyên Liệu / Phương Tiện Tải Trọng" && x.Status == 1).FirstOrDefault();
                            if (suaphuongtientaitrongnguyenlieu != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaphuongtientaitrongnguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Tải Trọng" && x.Func == "Xoá Nguyên Liệu / Phương Tiện Tải Trọng" && x.Status == 1).FirstOrDefault();
                            if (xoaphuongtientaitrongnguyenlieu != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importphuongtientaitrongnguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Tải Trọng" && x.Func == "Import Nguyên Liệu / Phương Tiện Tải Trọng" && x.Status == 1).FirstOrDefault();
                            if (importphuongtientaitrongnguyenlieu != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportphuongtientaitrongnguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Tải Trọng" && x.Func == "Export Nguyên Liệu / Phương Tiện Tải Trọng" && x.Status == 1).FirstOrDefault();
                            if (exportphuongtientaitrongnguyenlieu != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Phương Tiện - Tải Trọng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Phương Tiện</label>
                                    <select id="maPhuongTien" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Phương Tiện...</option>
                                        @foreach (var item in listPhuongTiens)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Áp Dụng</label>
                                    <input id='ngayApDung' class="form-control form-control-lg" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tải Trọng</label>
                                    <input type="text" id="taiTrong" class="form-control form-control-lg" placeholder="Nhập tải trọng..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ghi Chú</label>
                                    <textarea id="ghiChu" class="form-control form-control-lg" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Phương Tiện Tải Trọng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Phương Tiện</label>
                                    <select id="maPhuongTienSua" class="form-control form-control-lg" disabled>
                                        <option disabled selected>Chọn Phương Tiện...</option>
                                        @foreach (var item in listPhuongTiens)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Áp Dụng</label>
                                    <input id='ngayApDungSua' class="form-control form-control-lg" type="date" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tải Trọng</label>
                                    <input type="text" id="taiTrongSua" class="form-control form-control-lg" placeholder="Nhập tải trọng..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ghi Chú</label>
                                    <textarea id="ghiChuSua" class="form-control form-control-lg" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="maPhuongTienTaiTrongRowSelected" />
    <input type="hidden" id="ngayApDungRowSelect" />
</div>
<script>
    var now = new Date();

    var day = ("0" + now.getDate()).slice(-2);
    var month = ("0" + (now.getMonth() + 1)).slice(-2);

    var today = now.getFullYear() + "-" + (month) + "-" + (day);

    $('#ngayApDungSua').val(today);
    $('#ngayApDung').val(today);
</script>
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/PhuongTienTaiTrong/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'MaPhuongTien', headerText: 'Mã Phương Tiện', width: 150 },
                            { field: 'Ten', headerText: 'Tên Phương Tiện', width: 150 },
                            { field: 'TaiTrong', headerText: 'Tải Trọng', type: 'number', width: 150 },
                            { field: 'NgayApDung', headerText: 'Ngày Áp Dụng', type: 'date', format: 'dd/MM/yyyy', width: 200 },
                            { field: 'GhiChu', headerText: 'Ghi Chú', width: 200 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaPhuongTien = selectedRecord.MaPhuongTien;
        var NgayApDung = selectedRecord.NgayApDung;
        $('#maPhuongTienTaiTrongRowSelected').val(MaPhuongTien);
        $('#ngayApDungRowSelect').val(NgayApDung);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/PhuongTienTaiTrong/CreatDefautNew", // Đường dẫn đến action trong controller
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#taiTrong').val(rs.TaiTrong);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var maPhuongTien = $('#maPhuongTien').val();
        var ngayApDung = $('#ngayApDung').val();
        var taiTrong = $('#taiTrong').val();
        var ghiChu = $('#ghiChu').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/PhuongTienTaiTrong/DoInsert',
            data: {
                maPhuongTien: maPhuongTien,
                ngayApDung: ngayApDung,
                taiTrong: taiTrong,
                ghiChu: ghiChu
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var maPhuongTien = $('#maPhuongTienTaiTrongRowSelected').val();
        var ngayApDung = $('#ngayApDungRowSelect').val();
        $.ajax({
            url: "/PhuongTienTaiTrong/GetByMaPhuongTienAndNgayApDung",
            data: { maPhuongTien: maPhuongTien, ngayApDung: ngayApDung },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maPhuongTienSua').val(rs.MaPhuongTien);
                    $('#taiTrongSua').val(rs.TaiTrong);
                    $('#ghiChuSua').val(rs.GhiChu);
                    $('#ngayApDungSua').val(rs.NgayApDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var maPhuongTien = $('#maPhuongTienSua').val();
        var ngayApDung = $('#ngayApDungSua').val();
        var taiTrong = $('#taiTrongSua').val();
        var ghiChu = $('#ghiChuSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/PhuongTienTaiTrong/DoUpdate',
            data: {
                maPhuongTien: maPhuongTien,
                ngayApDung: ngayApDung,
                taiTrong: taiTrong,
                ghiChu: ghiChu
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var maPhuongTien = $('#maPhuongTienTaiTrongRowSelected').val();
        var ngayApDung = $('#ngayApDungRowSelect').val();
        $.ajax({
            url: "/PhuongTienTaiTrong/GetByMaPhuongTienAndNgayApDung",
            data: { maPhuongTien: maPhuongTien, ngayApDung: ngayApDung },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.MaPhuongTien,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/PhuongTienTaiTrong/DoDelete',
                                    data: { maPhuongTien: maPhuongTien, ngayApDung: ngayApDung },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>





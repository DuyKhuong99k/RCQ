                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="maPhuongTienRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/PhuongTienNguyenLieu/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'SoGhe', headerText: 'Số Ghe', width: 150 },
                            { field: 'IsHD', headerText: 'Hợp Đồng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsGhe', headerText: 'Ghe', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'VungNuoiId', headerText: 'Mã Vùng Nuôi', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;
        $('#maPhuongTienRowSelected').val(Ma);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/PhuongTienNguyenLieu/CreatDefautNew", // Đường dẫn đến action trong controller
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maPhuongTien').val(rs.Ma);
                    $('#tenPhuongTien').val(rs.Ten);
                    $('#soGhePhuongTien').val(rs.SoGhe);
                    $('#vungNuoiIdPhuongTien').val(rs.VungNuoiId);
                    $('#isGhePhuongTien').prop('checked', rs.IsGhe);
                    $('#isHopDongPhuongTien').prop('checked', rs.IsHD);
                    $('#suDungPhuongTien').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maPhuongTien').val();
        var ten = $('#tenPhuongTien').val();
        var soGhe = $('#soGhePhuongTien').val();
        var vungNuoiId = $('#vungNuoiIdPhuongTien').val();
        var isGhe = $('#isGhePhuongTien').prop('checked');
        var isHD = $('#isHopDongPhuongTien').prop('checked');
        var suDung =$('#suDungPhuongTien').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/PhuongTienNguyenLieu/DoInsert',
            data: {
                ma: ma,
                ten: ten,
                suDung: suDung,
                isHD: isHD,
                isGhe:isGhe,
                vungNuoiId: vungNuoiId,
                soGhe: soGhe
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ma = $('#maPhuongTienRowSelected').val();
        $.ajax({
            url: "/PhuongTienNguyenLieu/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maPhuongTienSua').val(rs.Ma);
                    $('#tenPhuongTienSua').val(rs.Ten);
                    $('#soGhePhuongTienSua').val(rs.SoGhe);
                    $('#vungNuoiIdPhuongTienSua').val(rs.VungNuoiId);
                    $('#isGhePhuongTienSua').prop('checked', rs.IsGhe);
                    $('#isHopDongPhuongTienSua').prop('checked', rs.IsHD);
                    $('#suDungPhuongTienSua').prop('checked', rs.SuDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ma = $('#maPhuongTienSua').val();
        var ten = $('#tenPhuongTienSua').val();
        var soGhe = $('#soGhePhuongTienSua').val();
        var vungNuoiId = $('#vungNuoiIdPhuongTienSua').val();
        var isGhe = $('#isGhePhuongTienSua').prop('checked');
        var isHD = $('#isHopDongPhuongTienSua').prop('checked');
        var suDung = $('#suDungPhuongTienSua').prop('checked');
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/PhuongTienNguyenLieu/DoUpdate',
            data: {
                ma: ma,
                ten: ten,
                suDung: suDung,
                isHD: isHD,
                isGhe: isGhe,
                vungNuoiId: vungNuoiId,
                soGhe: soGhe
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var ma = $('#maPhuongTienRowSelected').val();
        $.ajax({
            url: '/PhuongTienNguyenLieu/GetsByMa',
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/PhuongTienNguyenLieu/DoDelete',
                                    data: { ma: ma },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });

    }
</script>



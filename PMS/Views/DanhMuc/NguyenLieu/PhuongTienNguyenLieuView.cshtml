@{
    ViewData["Title"] = "NhaCungCapView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Phương Tiện Nguyên Liệu</h2>
                    @{
                        
                    }
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themphuongtiennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Func == "Thêm Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (themphuongtiennguyenlieu != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaphuongtiennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Func == "Sửa Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (suaphuongtiennguyenlieu != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaphuongtiennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Func == "Xoá Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (xoaphuongtiennguyenlieu != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importphuongtiennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Func == "Import Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (importphuongtiennguyenlieu != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportphuongtiennguyenlieu = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Func == "Export Nguyên Liệu / Phương Tiện Nguyên Liệu" && x.Status == 1).FirstOrDefault();
                            if (exportphuongtiennguyenlieu != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Phương Tiện Nguyên Liệu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã</label>
                                    <input type="text" id="maPhuongTien" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã..." style="text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tên</label>
                                    <input type="text" id="tenPhuongTien" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Số Ghe</label>
                                    <input type="text" id="soGhePhuongTien" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Số Ghe..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã Vùng Nuôi</label>
                                    <input type="text" id="vungNuoiIdPhuongTien" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Vùng Nuôi..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isGhePhuongTien" />
                                        Ghe
                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isHopDongPhuongTien" />
                                        Hợp Đồng
                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="suDungPhuongTien" />
                                        Sử Dụng
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

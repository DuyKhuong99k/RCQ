@{
    ViewData["Title"] = ViewBag.TitlePage;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = ViewModels.Repos.HQ.RolePermistionViewModel.Instance.GetRolePermistions(roleIds);//
    var i = 1;
}
<style>

    div[style*="color: #222222;"] {
        display: none;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Bàn Cắt Tiết</h2>
                    @{
                        var thembancattiet = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Bàn Cắt Tiết" && x.Func == "Thêm Nguyên Liệu / Bàn Cắt Tiết" && x.Status == 1).FirstOrDefault();
                        if (thembancattiet != null)
                        {
                            <button onclick="showInsertBanCatTiet()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suabancattiet = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Bàn Cắt Tiết" && x.Func == "Sửa Nguyên Liệu / Bàn Cắt Tiết" && x.Status == 1).FirstOrDefault();
                            if (suabancattiet != null)
                            {
                                <button onclick="showUpdateBanCatTiet()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoabancattiet = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Bàn Cắt Tiết" && x.Func == "Xoá Nguyên Liệu / Bàn Cắt Tiết" && x.Status == 1).FirstOrDefault();
                            if (xoabancattiet != null)
                            {
                                <button onclick="showDeleteBanCatTiet()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importbancattiet = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Bàn Cắt Tiết" && x.Func == "Import Nguyên Liệu / Bàn Cắt Tiết" && x.Status == 1).FirstOrDefault();
                            if (importbancattiet != null)
                            {
                                <button onclick="importNhanVien()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportbancattiet = rolePermistions.Where(x => x.Fu == "Danh Mục / Nguyên Liệu / Bàn Cắt Tiết" && x.Func == "Export Nguyên Liệu / Bàn Cắt Tiết" && x.Status == 1).FirstOrDefault();
                            if (suabancattiet != null)
                            {
                                <button onclick="exportNhanVien()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

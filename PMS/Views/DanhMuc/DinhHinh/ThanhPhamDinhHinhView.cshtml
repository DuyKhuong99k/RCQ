        var isBaoCaoDauRot = $('#isBaoCaoDauRotTPDHSua').prop('checked');
        var isCaDa = $('#isCaDaTPDHSua').prop('checked');
        var suDung = $('#suDungTPDHSua').prop('checked');
        var thoiGianHT = $('#thoiGianHTTPDHSua').val();

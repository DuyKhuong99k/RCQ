<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/ThanhPhamDinhHinh/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'DinhMuc', headerText: 'Định Mức', type: 'number', width: 150 },
                            { field: 'SanPhamTinhLuongName', headerText: 'Sản Phẩm Tính Lương', width: 250 },
                            { field: 'TLMin', headerText: 'TL Min', type: 'number', width: 150 },
                            { field: 'TLMax', headerText: 'TL Max', type: 'number', width: 150 },
                            { field: 'TLMinOut', headerText: 'TL Min Out', type: 'number', width: 150 },
                            { field: 'TLMaxOut', headerText: 'TL Max Out', type: 'number', width: 150 },
                            { field: 'TyLeDinhMucDau', headerText: 'Tỷ Lệ Định Mức Đậu', type: 'number', width: 150 },
                            { field: 'TyLeDinhMucRot', headerText: 'Tỷ Lệ Định Mức Rớt', type: 'number', width: 150 },
                            { field: 'TrongLuongTare', headerText: 'Trọng Lượng Tare', type: 'number', width: 150 },
                            { field: 'IsDauVaoBatBuoc', headerText: 'Đầu Vào Bất Buộc', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },

    function insert() {
        var ma = $('#maTPDH').val();
        var ten = $('#tenTPDH').val();
        var dinhMuc = $('#dinhMucTPDH').val();
        var min = $('#TLMinTPDH').val();
        var max = $('#TLMaxTPDH').val();
        var minOut = $('#TLMinOutTPDH').val();
        var maxOut = $('#TLMaxOutTPDH').val();
        var tyLeDinhMucDau = $('#TyLeDinhMucDauTPDH').val();
        var tyLeDinhMucRot = $('#TyLeDinhMucRotTPDH').val();
        var trongLuongTare = $('#TLTareTPDH').val();
        var bravoId = $('#sanPhamTLTPDHHidden').val();
        var dinhMucKhongCanDauVao = $('#dinhMucKhongCanDauVaoTPDH').val();
        var dinhMucCaTra = $('#dinhMucCaTraTPDH').val();
        var codeId = $('#codeIdTPDH').val();
        var isSuDungThoiGianGiuaLoaiThanhPham = $('#isSuDungThoiGianGiuaLoaiThanhPhamTPDH').prop('checked');
        var isDauVaoBatBuoc = $('#isDauVaoBatBuocTPDH').prop('checked');
        var isBaoCaoDauRot = $('#isBaoCaoDauRotTPDH').prop('checked');
        var isCaDa = $('#isCaDaTPDH').prop('checked');
        var suDung = $('#suDungTPDH').prop('checked');
        var thoiGianHT = $('#thoiGianHTTPDH').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/ThanhPhamDinhHinh/DoInsert',
            data: {
                ma: ma,
                ten: ten,
                dinhMuc: dinhMuc,
                min: min,
                max: max,
                minOut: minOut,
                maxOut: maxOut,
                tyLeDinhMucDau: tyLeDinhMucDau,
                tyLeDinhMucRot: tyLeDinhMucRot,
                trongLuongTare: trongLuongTare,
                bravoId: bravoId,
                dinhMucKhongCanDauVao: dinhMucKhongCanDauVao,
                dinhMucCaTra: dinhMucCaTra,
                codeId: codeId,
                isSuDungThoiGianGiuaLoaiThanhPham: isSuDungThoiGianGiuaLoaiThanhPham,
                isDauVaoBatBuoc: isDauVaoBatBuoc,
                isBaoCaoDauRot: isBaoCaoDauRot,
                suDung: suDung,
                isCaDa: isCaDa,
                thoiGianHT: thoiGianHT
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ma = $('#maTPDHRowSelected').val();
        var maCa = $('#maCaTPDHRowSelected').val();
        $.ajax({
            url: "/ThanhPhamDinhHinh/GetsByMa",
            data: { ma: ma, maCa: maCa },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPDHSua').val(rs.Ma);
                    $('#tenTPDHSua').val(rs.Ten);
                    $('#dinhMucTPDHSua').val(rs.DinhMuc);
                    $('#TLMinTPDHSua').val(rs.Min);
                    $('#TLMaxTPDHSua').val(rs.Max);
                    $('#TLMinOutTPDHSua').val(rs.MinOut);
                    $('#TLMaxOutTPDHSua').val(rs.MaxOut);
                    $('#TyLeDinhMucDauTPDHSua').val(rs.TyLeDinhMucDau);
                    $('#TyLeDinhMucRotTPDHSua').val(rs.TyLeDinhMucRot);
                    $('#TLTareTPDHSua').val(rs.TrongLuongTare);
                    $('#sanPhamTLTPDHHidden').val(rs.BravoId);
                    // Kiểm tra xem comboBoxObjectLDGSua đã được khởi tạo và dữ liệu đã được nạp vào
                    if (comboBoxObjectSanPhamSua && comboBoxObjectSanPhamSua.dataSource && comboBoxObjectSanPhamSua.dataSource.length > 0) {
                        // Lặp qua danh sách dữ liệu của combobox để tìm giá trị mặc định
                        for (var i = 0; i < comboBoxObjectSanPhamSua.dataSource.length; i++) {
                            if (comboBoxObjectSanPhamSua.dataSource[i].Ma === rs.BravoId) {
                                // Nếu tìm thấy giá trị mặc định, chọn nó và thoát khỏi vòng lặp
                                comboBoxObjectSanPhamSua.value = rs.BravoId;
                                break;
                            }
                        }
                    }
                    $('#dinhMucKhongCanDauVaoTPDHSua').val(rs.DinhMucKhongDauVao);
                    $('#dinhMucCaTraTPDHSua').val(rs.DinhMucCaTra);
                    $('#codeIdTPDHSua').val(rs.CodeId);
                    $('#isSuDungThoiGianGiuaLoaiThanhPhamTPDHSua').prop('checked', rs.IsSuDungThoiGianGiuaLoaiThanhPham);
                    $('#isDauVaoBatBuocTPDHSua').prop('checked', rs.IsDauVaoBatBuoc);
                    $('#isBaoCaoDauRotTPDHSua').prop('checked', rs.BaoCaoDauRot);
                    $('#isCaDaTPDHSua').prop('checked', rs.IsCaDa);
                    $('#suDungTPDHSua').prop('checked', rs.SuDung);
                    $('#thoiGianHTTPDHSua').val(rs.ThoiGianHT);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }

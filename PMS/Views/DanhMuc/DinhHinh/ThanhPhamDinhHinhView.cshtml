@{
    ViewData["Title"] = "ThanhPhamDinhHinhView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listXuongs = ViewBag.listXuongs;
    var listSPTLs = ViewBag.listSPTLs;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);

}
<style>
    #modalThem .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }

    #modalSua .modal-dialog {
        max-width: 1000px; /* Thiết lập kích thước tùy chỉnh cho modal */
    }
    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }
</style>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Thành Phẩm Định Hình</h2>
                    @{
                        
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themThanhPhamDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Thành Phẩm" && x.Func == "Thêm Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (themThanhPhamDinhHinh != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaThanhPhamDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Thành Phẩm" && x.Func == "Sửa Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (suaThanhPhamDinhHinh != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaThanhPhamDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Thành Phẩm" && x.Func == "Xoá Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (xoaThanhPhamDinhHinh != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


<input type="hidden" id="sttDMDHRowSelected" />
<input type="hidden" id="ngayDMDHRowSelected" />
<input type="hidden" id="gioDMDHRowSelected" />
<input type="hidden" id="maloDMDHRowSelected" />
<input type="hidden" id="maloaicaDMDHRowSelected" />
<input type="hidden" id="mamauDMDHRowSelected" />
<input type="hidden" id="masizeDMDHRowSelected" />
<input type="hidden" id="mathanhphamDMDHRowSelected" />
<input type="hidden" id="maxuongDMDHRowSelected" />
<input type="checkbox" id="caTraDMDHRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/DinhMucDinhHinh/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'STT', headerText: 'STT', width: 50 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'Gio', headerText: 'Giờ', width: 150 },
                            { field: 'MaLo', headerText: 'Lô', width: 150 },
                            { field: 'LoaiCaName', headerText: 'Loại Cá', width: 150 },
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'MauName', headerText: 'Màu', width: 150 },
                            { field: 'SizeName', headerText: 'Size', width: 150 },
                            { field: 'CaTra', headerText: 'Cá Trả', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'DinhMuc', headerText: 'Định Mức', type: 'number', width: 150 },
                            { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var stt = selectedRecord.STT;
        var ngay = selectedRecord.Ngay;
        var gio = selectedRecord.Gio;
        var malo = selectedRecord.MaLo;
        var maloaica = selectedRecord.MaLoaiCa;
        var mamau = selectedRecord.MaMau;
        var masize = selectedRecord.MaSize;
        var mathanhpham = selectedRecord.MaThanhPham;
        var maxuong = selectedRecord.MaXuong;
        var catra = selectedRecord.CaTra;
        $('#sttDMDHRowSelected').val(stt);
        $('#ngayDMDHRowSelected').val(ngay);
        $('#gioDMDHRowSelected').val(gio);
        $('#maloDMDHRowSelected').val(malo);
        $('#maloaicaDMDHRowSelected').val(maloaica);
        $('#mamauDMDHRowSelected').val(mamau);
        $('#masizeDMDHRowSelected').val(masize);
        $('#mathanhphamDMDHRowSelected').val(mathanhpham);
        $('#maxuongDMDHRowSelected').val(maxuong);
        $('#caTraDMDHRowSelected').prop('checked', catra);
    }
</script>
<script>
    function layGioTuDate(dateString) {
        // Khởi tạo một đối tượng Date từ chuỗi ngày
        var date = new Date(dateString);

        // Lấy giờ, phút và giây từ đối tượng Date
        var gio = date.getHours();
        var phut = date.getMinutes();
        var giay = date.getSeconds();

        // Định dạng lại chuỗi kết quả
        var gioPhutGiayString = pad(gio, 2) + ":" + pad(phut, 2) + ":" + pad(giay, 2);

        // Trả về chuỗi kết quả
        return gioPhutGiayString;
    }
    // Hàm pad để thêm số 0 vào trước nếu cần
    function pad(number, length) {
        var str = '' + number;
        while (str.length < length) {
            str = '0' + str;
        }
        return str;
    }
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/DinhMucDinhHinh/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#sttDMDH').val(rs.STT);
                    $('#gioDMDH').val(layGioTuDate(rs.Gio));
                    $('#dinhMucDMDH').val(rs.DinhMuc);
                    $('#caTraDMDH').prop('checked', rs.CaTra);
                    $('#suDungDMDH').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var stt = $('#sttDMDH').val();
        var gio = $('#gioDMDH').val();
        var maLo = $('#maLoDMDH').val();
        var maLoaiCa = $('#maLoaiCaDMDH').val();
        var maMau = $('#maMauDMDH').val();
        var masize = $('#maSizeDMDH').val();
        var maThanhPham = $('#maThanhPhamDMDH').val();
        var caTra = $('#caTraDMDH').prop('checked');
        var dinhMuc = $('#dinhMucDMDH').val();
        var maXuong = $('#maXuongDMDH').val();
        var suDung = $('#suDungDMDH').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/DinhMucDinhHinh/DoInsert',
            data: {
                stt: stt,
                gio: gio,
                maLo: maLo,
                maLoaiCa: maLoaiCa,
                maMau: maMau,
                masize: masize,
                maThanhPham: maThanhPham,
                maXuong: maXuong,
                caTra: caTra,
                dinhMuc: dinhMuc,
                suDung: suDung,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var stt = $('#sttDMDHRowSelected').val();
        var ngay = $('#ngayDMDHRowSelected').val();
        var gio = $('#gioDMDHRowSelected').val();
        var malo = $('#maloDMDHRowSelected').val();
        var maloaica = $('#maloaicaDMDHRowSelected').val();
        var mamau = $('#mamauDMDHRowSelected').val();
        var masize = $('#masizeDMDHRowSelected').val();
        var mathanhpham = $('#mathanhphamDMDHRowSelected').val();
        var maxuong = $('#maxuongDMDHRowSelected').val();
        var catra = $('#caTraDMDHRowSelected').prop('checked');

        $.ajax({
            url: "/DinhMucDinhHinh/GetsByMa",
            data: {
                stt: stt,
                ngay: ngay,
                gio: gio,
                malo: malo,
                maloaica: maloaica,
                mamau: mamau,
                masize: masize,
                mathanhpham: mathanhpham,
                maxuong: maxuong,
                catra: catra
            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#sttDMDHSua').val(rs.STT);
                    $('#gioDMDHSua').val(rs.Gio);
                    $('#maLoDMDHSua').val(rs.MaLo);
                    $('#maLoaiCaDMDHSua').val(rs.MaLoaiCa);
                    $('#maMauDMDHSua').val(rs.MaMau);
                    $('#maSizeDMDHSua').val(rs.MaSize);
                    $('#maThanhPhamDMDHSua').val(rs.MaThanhPham);
                    $('#caTraDMDHSua').prop('checked', rs.CaTra);
                    $('#dinhMucDMDHSua').val(rs.DinhMuc);
                    $('#maXuongDMDHSua').val(rs.MaXuong);
                    $('#suDungDMDHSua').prop('checked', rs.SuDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var stt = $('#sttDMDHSua').val();
        var ngay = $('#ngayDMDHRowSelected').val();
        var gio = $('#gioDMDHSua').val();
        var maLo = $('#maLoDMDHSua').val();
        var maLoaiCa = $('#maLoaiCaDMDHSua').val();
        var maMau = $('#maMauDMDHSua').val();
        var masize = $('#maSizeDMDHSua').val();
        var maThanhPham = $('#maThanhPhamDMDHSua').val();
        var caTra = $('#caTraDMDHSua').prop('checked');
        var dinhMuc = $('#dinhMucDMDHSua').val();
        var maXuong = $('#maXuongDMDHSua').val();
        var suDung = $('#suDungDMDHSua').prop('checked');
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/DinhMucDinhHinh/DoUpdate',
            data: {
                stt: stt,
                ngay: ngay,
                gio: gio,
                maLo: maLo,
                maLoaiCa: maLoaiCa,
                maMau: maMau,
                masize: masize,
                maThanhPham: maThanhPham,
                maXuong: maXuong,
                caTra: caTra,
                dinhMuc: dinhMuc,
                suDung: suDung,
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>

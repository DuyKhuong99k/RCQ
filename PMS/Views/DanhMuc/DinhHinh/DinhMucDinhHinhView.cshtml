
@{
    ViewData["Title"] = "DinhMucDinhHinhView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listMaLos = ViewBag.listMaLos;
    var listMaLoaiCas = ViewBag.listMaLoaiCas;
    var listMaMaus = ViewBag.listMaMaus;
    var listTPFLs = ViewBag.listTPFLs;
    var listSFLs = ViewBag.listSFLs;
    var listXuongs = ViewBag.listXuongs;
}

<style>
    #caTraDMDHRowSelected {
        display: none;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Định Mức Định Hình</h2>
                    @{
                        var themDinhMucDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Định Mức" && x.Func == "Thêm Định Hình / Định Mức" && x.Status == 1).FirstOrDefault();
                        if (themDinhMucDinhHinh != null)
                        {
                            <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suaDinhMucDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Định Mức" && x.Func == "Sửa Định Hình / Định Mức" && x.Status == 1).FirstOrDefault();
                            if (suaDinhMucDinhHinh != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaDinhMucDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Định Mức" && x.Func == "Xoá Định Hình / Định Mức" && x.Status == 1).FirstOrDefault();
                            if (xoaDinhMucDinhHinh != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importDinhMucDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Định Mức" && x.Func == "Import Định Hình / Định Mức" && x.Status == 1).FirstOrDefault();
                            if (importDinhMucDinhHinh != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportDinhMucDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Định Hình / Định Mức" && x.Func == "Export Định Hình / Định Mức" && x.Status == 1).FirstOrDefault();
                            if (exportDinhMucDinhHinh != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Định Mức Định Hình</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">STT</label>
                                    <input type="text" id="sttDMDH" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập STT..." style="text-transform: uppercase;" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Giờ</label>
                                    <input type="time" id="gioDMDH" class="form-control form-control-lg" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã Lô</label>
                                    <select id="maLoDMDH" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Lô</option>
                                        @foreach (var item in listMaLos)
                                        {
                                            <option value="@item.Item2">@item.Item2</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Loại Cá</label>
                                    <select id="maLoaiCaDMDH" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Loại Cá</option>
                                        @foreach (var item in listMaLoaiCas)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Màu</label>
                                    <select id="maMauDMDH" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Màu</option>
                                        @foreach (var item in listMaMaus)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Size</label>
                                    <select id="maSizeDMDH" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Size</option>
                                        @foreach (var item in listSFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamDMDH" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Thành Phẩm</option>
                                        @foreach (var item in listTPFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="caTraDMDH" />
                                        Cá Trả
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Định Mức</label>
                                    <input type="number" min="0" step="0.0001" id="dinhMucDMDH" class="form-control form-control-lg" autocomplete="off" placeholder="0.0000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Xưởng</label>
                                    <select id="maXuongDMDH" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Xưởng</option>
                                        @foreach (var item in listXuongs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="suDungDMDH" />
                                        Sử Dụng
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "DonGiaView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listSPTLs = ViewBag.listSPTLs;
    var listSDHs = ViewBag.listSDHs;
    var listTPFLs = ViewBag.listTPFLs;
    var listSFLs = ViewBag.listSFLs;
    var listLDGs = ViewBag.listLDGs;
    var listXHs = ViewBag.listXHs;
    var userName = @Context.Session.GetString("Username");
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}

<style>

    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Đơn Giá</h2>
                    @{
                        var themdongiaSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Đơn Giá" && x.Func == "Thêm Sản Phẩm Tính Lương / Đơn Giá" && x.Status == 1).FirstOrDefault();
                        if (themdongiaSPTL != null)
                        {
                            <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suadongiaSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Đơn Giá" && x.Func == "Sửa Sản Phẩm Tính Lương / Đơn Giá" && x.Status == 1).FirstOrDefault();
                            if (suadongiaSPTL != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoadongiaSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Đơn Giá" && x.Func == "Xoá Sản Phẩm Tính Lương / Đơn Giá" && x.Status == 1).FirstOrDefault();
                            if (xoadongiaSPTL != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importdongiaSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Đơn Giá" && x.Func == "Import Sản Phẩm Tính Lương / Đơn Giá" && x.Status == 1).FirstOrDefault();
                            if (importdongiaSPTL != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportdongiaSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Đơn Giá" && x.Func == "Export Sản Phẩm Tính Lương / Đơn Giá" && x.Status == 1).FirstOrDefault();
                            if (exportdongiaSPTL != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

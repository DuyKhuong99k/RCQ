<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    let d = new Date();
    // let year = d.getFullYear();
    let year = d.getFullYear();
    $('#year').val(year);

    function loadGridData() {
        $.ajax({
            url: '/dongiaSPTL/GetAllsFullFieldByYear',
            type: 'GET',
            //dataType: 'json',
            // data: {
            //     year: yearValue
            // },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'Gio', headerText: 'Giờ', width: 150 },
                            { field: 'MaSanPham', headerText: 'Mã Sản Phẩm', width: 150 },
                            { field: 'SanPhamTinhLuongName', headerText: 'Tên Sản Phẩm', width: 150 },
                            { field: 'SizeDinhHinhName', headerText: 'Size Định Hình', width: 150 },
                            { field: 'LoaiDonGiaName', headerText: 'Loại Đơn Giá', width: 150 },
                            { field: 'DanhGia', headerText: 'Đánh Giá', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'XepHangName', headerText: 'Hạng', width: 100 },
                            { field: 'DinhMucDown', headerText: 'Định Mức Dưới', type: 'number', width: 150 },
                            { field: 'DinhMucUp', headerText: 'Định Mức Trên', type: 'number', width: 150 },
                            { field: 'HeSo', headerText: 'Hệ Số', type: 'number', width: 150 },
                            { field: 'HeSoRot', headerText: 'Hệ Số Rớt', type: 'number', width: 150 },
                            { field: 'IsUsedHeSoRot', headerText: 'Sử Dụng Hệ Số Rớt', width: 200, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'DonGia', headerText: 'Đơn Giá', type: 'number', width: 150 },
                            { field: 'DonGiaGiaCong', headerText: 'Đơn Giá Gia Công', type: 'number', width: 150 },
                            { field: 'ThanhPhamFilletName', headerText: 'Thành Phẩm Fillet', width: 150 },
                            { field: 'SizeFilletName', headerText: 'Size Fillet', width: 150 },
                            { field: 'CreateBy', headerText: 'Người Tạo', width: 150 },
                            { field: 'ModifiedBy', headerText: 'Người Sửa', width: 150 },

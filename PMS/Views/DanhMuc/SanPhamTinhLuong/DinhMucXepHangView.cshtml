@{
    ViewData["Title"] = "DinhMucXepHangView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listMaLos = ViewBag.listMaLos;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<style>

    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }
</style>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Định Mức Xếp Hạng</h2>
                    @{
                        
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        <div style="display: inline-block;margin-right: -10%;">
                            <h3 style="display: inline-block; margin-right: 5px;">Năm: </h3>
                            <input id="year" type="number" style="display: inline-block; font-size:20px; width:30%" class="form-control form-control-lg" />
                            <button onclick="reloadData()" style="margin-right:5px" class="btn btn-outline-primary"><i class='bx bx-cloud-download'></i>Tải</button>
                        </div>
                        
                        @{
                            var themdinhmucxephangSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Định Mức Xếp Hạng" && x.Func == "Thêm Sản Phẩm Tính Lương / Định Mức Xếp Hạng" && x.Status == 1).FirstOrDefault();
                            if (themdinhmucxephangSPTL != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suadinhmucxephangSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Định Mức Xếp Hạng" && x.Func == "Sửa Sản Phẩm Tính Lương / Định Mức Xếp Hạng" && x.Status == 1).FirstOrDefault();
                            if (suadinhmucxephangSPTL != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoadinhmucxephangSPTL = rolePermistions.Where(x => x.Fu == "Danh Mục / Sản Phẩm Tính Lương / Định Mức Xếp Hạng" && x.Func == "Xoá Sản Phẩm Tính Lương / Định Mức Xếp Hạng" && x.Status == 1).FirstOrDefault();
                            if (xoadinhmucxephangSPTL != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


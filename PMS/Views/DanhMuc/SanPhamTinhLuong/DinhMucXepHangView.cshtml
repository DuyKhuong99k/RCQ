<input type="hidden" id="maLoDMXHSPTLRowSelected" />
<input type="hidden" id="maSanPhamDMXHSPTLRowSelected" />
<input type="hidden" id="maXepHangDMXHSPTLRowSelected" />
<input type="hidden" id="sanPhamDMXHSPTLHidden" />
<input type="hidden" id="hangDMXHSPTLHidden" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    let d = new Date();
    // let year = d.getFullYear();
    let year = d.getFullYear();
    $('#year').val(year);
    
    function loadGridData(yearValue) {
        $.ajax({
            url: '/DinhMucXepHangSPTL/GetAllsFullFieldByYear',
            type: 'GET',
            //dataType: 'json',
            data: {
                year: yearValue
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'MaLo', headerText: 'Mã Lô', width: 150 },
                            { field: 'SanPhamName', headerText: 'Sản Phẩm', width: 150 },
                            { field: 'XepHangName', headerText: 'Hạng', width: 150 },
                            { field: 'DinhMucDown', headerText: 'Định Mức Dưới', type: 'number', width: 150 },
                            { field: 'DinhMucUp', headerText: 'Định Mức Trên', type: 'number', width: 150 },
                            { field: 'DinhMuc', headerText: 'Định Mức Đại Diện', type: 'number', width: 250 }]

                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    
    function reloadData() {
        var yearValue = $('#year').val();
        loadGridData(yearValue);
    }
    $(document).ready(function () {
        reloadData();
    });
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var MaLo = selectedRecord.MaLo;
        var MaSanPham = selectedRecord.MaSanPham;
        var MaXepHang = selectedRecord.MaXepHang;
        $('#maLoDMXHSPTLRowSelected').val(MaLo);
        $('#maSanPhamDMXHSPTLRowSelected').val(MaSanPham);
        $('#maXepHangDMXHSPTLRowSelected').val(MaXepHang);
        var hhh = $('#maLoDMXHSPTLRowSelected').val();
        var hhh1 = $('#maSanPhamDMXHSPTLRowSelected').val();
        var hhh2 = $('#maXepHangDMXHSPTLRowSelected').val();
        //alert(MaLo);
    }
</script>
<script>
    function loadDataSanPham() {
        $.ajax({
            type: "GET",
            url: "/SanPhamSPTL/GetAlls",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // Khởi tạo ComboBox khi dữ liệu được tải
                initializeComboBoxSanPham(response);
                //initializeComboBoxSanPhamSua(response);
            },
            error: function (xhr, status, error) {
                console.error(status, error);
            }
        });
    }

    function initializeComboBoxSanPham(data) {
        var comboBoxObject = new ej.dropdowns.ComboBox({
            dataSource: data,
            fields: { value: 'Ma', text: 'Ten', tooltip: 'GhiChu' },
            placeholder: "Chọn Sản Phẩm",
            sortOrder: 'Ascending',
            headerTemplate: "<span class='head'><span class='ma'>Mã</span><span class='ten'>Tên</span><span class='ghichu'>Ghi Chú</span></span>",
            itemTemplate: "<span class='item' ><span class='ma'>${Ma}</span><span class='ten'>${Ten}</span><span class='ghichu'>${GhiChu}</span></span>"
        });
        comboBoxObject.appendTo('#sanPhamDMXHSPTL');
        // Bắt sự kiện khi combobox thay đổi giá trị
        comboBoxObject.addEventListener('change', function (e) {
            // Lấy giá trị đã chọn
            var selectedData = comboBoxObject.getDataByValue(comboBoxObject.value);

            // Kiểm tra xem có dữ liệu đã chọn hay không
            if (selectedData) {
                // Lấy giá trị của trường 'Ma'
                var maSanPham = selectedData.Ma;
                $('#sanPhamDMXHSPTLHidden').val(maSanPham);
            }
        });
    }
    function initializeComboBoxSanPhamSua(data) {
        var comboBoxObject = new ej.dropdowns.ComboBox({
            dataSource: data,
            fields: { value: 'Ma', text: 'Ten', tooltip: 'GhiChu' },
            placeholder: "Chọn Sản Phẩm",
            sortOrder: 'Ascending',
            headerTemplate: "<span class='head'><span class='ma'>Mã</span><span class='ten'>Tên</span><span class='ghichu'>Ghi Chú</span></span>",
            itemTemplate: "<span class='item' ><span class='ma'>${Ma}</span><span class='ten'>${Ten}</span><span class='ghichu'>${GhiChu}</span></span>"
        });
        comboBoxObject.appendTo('#sanPhamDMXHSPTLSua');
        // Bắt sự kiện khi combobox thay đổi giá trị
        comboBoxObject.addEventListener('change', function (e) {
            // Lấy giá trị đã chọn
            var selectedData = comboBoxObject.getDataByValue(comboBoxObject.value);

            // Kiểm tra xem có dữ liệu đã chọn hay không
            if (selectedData) {
                // Lấy giá trị của trường 'Ma'
                var maSanPham = selectedData.Ma;
                $('#sanPhamDMXHSPTLHidden').val(maSanPham);
            }
        });
    }
    function loadDataHang() {
        $.ajax({
            type: "GET",
            url: "/MaXepHangSPTL/GetAlls",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // Khởi tạo ComboBox khi dữ liệu được tải
                initializeComboBoxHang(response);
                //initializeComboBoxHangSua(response);
            },
            error: function (xhr, status, error) {
                console.error(status, error);
            }
        });
    }

    function initializeComboBoxHang(data) {
        var comboBoxObject = new ej.dropdowns.ComboBox({
            dataSource: data,
            fields: { value: 'Ma', text: 'Ten', tooltip: 'SuDung'},
            placeholder: "Chọn Hạng",
            sortOrder: 'Ascending',
            headerTemplate: "<span class='head'><span class='ma'>Mã</span><span class='ten'>Tên</span><span class='ghichu'>Sử Dụng</span></span>",
            itemTemplate: "<span class='item'><span class='ma'>${Ma}</span><span class='ten'>${Ten}</span><span class='ghichu'><input type='checkbox' checked disabled/></span></span>"
        });
        comboBoxObject.appendTo('#hangDMXHSPTL');
        // Bắt sự kiện khi combobox thay đổi giá trị
        comboBoxObject.addEventListener('change', function (e) {
            // Lấy giá trị đã chọn
            var selectedData = comboBoxObject.getDataByValue(comboBoxObject.value);

            // Kiểm tra xem có dữ liệu đã chọn hay không
            if (selectedData) {
                // Lấy giá trị của trường 'Ma'
                var maSanPham = selectedData.Ma;
                $('#hangDMXHSPTLHidden').val(maSanPham);
            }
        });
    }
    function initializeComboBoxHangSua(data) {
        var comboBoxObject = new ej.dropdowns.ComboBox({
            dataSource: data,
            fields: { value: 'Ma', text: 'Ten', tooltip: 'SuDung' },
            placeholder: "Chọn Hạng",
            sortOrder: 'Ascending',
            headerTemplate: "<span class='head'><span class='ma'>Mã</span><span class='ten'>Tên</span><span class='ghichu'>Sử Dụng</span></span>",
            itemTemplate: "<span class='item'><span class='ma'>${Ma}</span><span class='ten'>${Ten}</span><span class='ghichu'><input type='checkbox' checked disabled/></span></span>"
        });
        comboBoxObject.appendTo('#hangDMXHSPTLSua');
        // Bắt sự kiện khi combobox thay đổi giá trị
        comboBoxObject.addEventListener('change', function (e) {
            // Lấy giá trị đã chọn
            var selectedData = comboBoxObject.getDataByValue(comboBoxObject.value);

            // Kiểm tra xem có dữ liệu đã chọn hay không
            if (selectedData) {
                // Lấy giá trị của trường 'Ma'
                var maSanPham = selectedData.Ma;
                $('#hangDMXHSPTLHidden').val(maSanPham);
            }
        });
    }
    // Gọi hàm loadData khi trang được tải
    $(document).ready(function () {
        loadDataSanPham();
        loadDataHang();
    });
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/DinhMucXepHangSPTL/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#dinhMucDownDMXHSPTL').val(rs.DinhMucDown);
                    $('#dinhMucUpDMXHSPTL').val(rs.DinhMucUp);
                    $('#dinhMucDMXHSPTL').val(rs.DinhMuc);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var maLo = $('#maLoDMXHSPTL').val();
        var maSanPham = $('#sanPhamDMXHSPTLHidden').val();
        var maXepHang = $('#hangDMXHSPTLHidden').val();
        var dinhMucDown = $('#dinhMucDownDMXHSPTL').val();
        var dinhMucUp = $('#dinhMucUpDMXHSPTL').val();
        var dinhMuc = $('#dinhMucDMXHSPTL').val();
        var year = $('#year').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/DinhMucXepHangSPTL/DoInsert',
            data: {
                maLo: maLo,
                maSanPham: maSanPham,
                maXepHang: maXepHang,
                year: year,
                dinhMucDown: dinhMucDown,
                dinhMucUp: dinhMucUp,
                dinhMuc: dinhMuc
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var maLo = $('#maLoDMXHSPTLRowSelected').val();
        var maSanPham = $('#maSanPhamDMXHSPTLRowSelected').val();
        var maXepHang = $('#maXepHangDMXHSPTLRowSelected').val();
        var year = $('#year').val();
        $.ajax({
            url: "/DinhMucXepHangSPTL/GetsByMa",
            data: { 
                maLo: maLo,
                maSanPham: maSanPham,
                maXepHang: maXepHang,
                year: year
            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maLoDMXHSPTLSua').val(rs.MaLo);
                    $('#sanPhamDMXHSPTLSua').val(rs.MaSanPham);
                    $('#hangDMXHSPTLSua').val(rs.MaXepHang);
                    $('#sanPhamDMXHSPTLHidden').val(rs.MaSanPham);
                    $('#hangDMXHSPTLHidden').val(rs.MaXepHang);
                    $('#dinhMucDownDMXHSPTLSua').val(rs.DinhMucDown);
                    $('#dinhMucUpDMXHSPTLSua').val(rs.DinhMucUp);
                    $('#dinhMucDMXHSPTLSua').val(rs.DinhMuc);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var maLo = $('#maLoDMXHSPTLSua').val();
        var maSanPham = $('#sanPhamDMXHSPTLSua').val();
        var maXepHang = $('#hangDMXHSPTLSua').val();
        var dinhMucDown = $('#dinhMucDownDMXHSPTLSua').val();
        var dinhMucUp = $('#dinhMucUpDMXHSPTLSua').val();
        var dinhMuc = $('#dinhMucDMXHSPTLSua').val();
        var year = $('#year').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/DinhMucXepHangSPTL/DoUpdate',
            data: {
                maLo: maLo,
                maSanPham: maSanPham,
                maXepHang: maXepHang,
                year: year,
                dinhMucDown: dinhMucDown,
                dinhMucUp: dinhMucUp,
                dinhMuc: dinhMuc
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>

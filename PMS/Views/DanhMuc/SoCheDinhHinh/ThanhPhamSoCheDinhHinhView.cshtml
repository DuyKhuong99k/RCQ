<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/ThanhPhamSoCheDinhHinh/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'X', headerText: 'Dòng (X-1)', type: 'number', width: 150 },
                            { field: 'Y', headerText: 'Dòng (Y-1)', type: 'number', width: 150 },
                            { field: 'TinhKiem', headerText: 'Kiểm', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'TinhPhucVu', headerText: 'Phục Vụ', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'CaMuoi', headerText: 'Muối', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'NguyenLieu', headerText: 'Nguyên Liệu', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'Ban09', headerText: 'Bàn 09', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'LoaiGui', headerText: 'Loại Gửi', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'TruocLangDa', headerText: 'Trước Lạng Da', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'SauLangDa', headerText: 'Sau Lạng Da', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'Nhan', headerText: 'Nhận', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'TinhGio', headerText: 'Tính Giở', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'BatCO', headerText: 'CO', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNhapTay', headerText: 'Nhập Tay', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'Createdby', headerText: 'Người Tạo', width: 150 },
                            { field: 'CreatedDateTime', headerText: 'Ngày Tạo', width: 150 },
                            { field: 'Modifiedby', headerText: 'Người Sửa', width: 150 },
                            { field: 'ModifiedDateTime', headerText: 'Ngày Sửa', width: 150 },
                            { field: 'BravoId', headerText: 'Mã Lương', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;

        $('#maTPSCDHRowSelected').val(Ma);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/ThanhPhamSoCheDinhHinh/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPSCDH').val(rs.Ma);
                    $('#tenTPSCDH').val(rs.Ten);
                    $('#xTPSCDH').val(rs.X);
                    $('#yTPSCDH').val(rs.Y);
                    $('#bravoIdTPSCDH').val(rs.BravoId);
                    $('#suDungTPSCDH').prop('checked', rs.SuDung);
                    $('#tinhKiemTPSCDH').prop('checked', rs.TinhKiem);
                    $('#phucVuTPSCDH').prop('checked', rs.TinhPhucVu);
                    $('#muoiTPSCDH').prop('checked', rs.CaMuoi);
                    $('#nguyenLieuTPSCDH').prop('checked', rs.NguyenLieu);
                    $('#ban09TPSCDH').prop('checked', rs.Ban09);
                    $('#loaiGuiTPSCDH').prop('checked', rs.LoaiGui);
                    $('#truocLDTPSCDH').prop('checked', rs.TruocLangDa);
                    $('#sauLDTPSCDH').prop('checked', rs.SauLangDa);
                    $('#nhanTPSCDH').prop('checked', rs.Nhan);
                    $('#tinhGioTPSCDH').prop('checked', rs.TinhGio);
                    $('#batCOTPSCDH').prop('checked', rs.BatCO);
                    $('#isNhapTayTPSCDH').prop('checked', rs.IsNhapTay);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maTPSCDH').val();
        var ten = $('#tenTPSCDH').val();
        var suDung = $('#suDungTPSCDH').prop('checked');
        var x = $('#xTPSCDH').val();
        var y = $('#yTPSCDH').val();
        var bravoId = $('#bravoIdTPSCDH').val();
        var tinhKiem = $('#tinhKiemTPSCDH').prop('checked');
        var tinhPhucVu = $('#phucVuTPSCDH').prop('checked');
        var caMuoi = $('#muoiTPSCDH').prop('checked');
        var nguyenLieu = $('#nguyenLieuTPSCDH').prop('checked');
        var ban09 = $('#ban09TPSCDH').prop('checked');
        var loaiGui = $('#loaiGuiTPSCDH').prop('checked');
        var truocLangDa = $('#truocLDTPSCDH').prop('checked');
        var sauLangDa = $('#sauLDTPSCDH').prop('checked');
        var nhan = $('#nhanTPSCDH').prop('checked');
        var tinhGio = $('#tinhGioTPSCDH').prop('checked');
        var batCO = $('#batCOTPSCDH').prop('checked');
        var isNhapTay = $('#isNhapTayTPSCDH').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/ThanhPhamSoCheDinhHinh/DoInsert',
            data: {
                ma: ma,
                ten: ten,
                suDung: suDung,
                x: x,
                y: y,
                bravoId: bravoId,
                tinhKiem: tinhKiem,
                tinhPhucVu: tinhPhucVu,
                caMuoi: caMuoi,
                nguyenLieu: nguyenLieu,
                ban09: ban09,
                loaiGui: loaiGui,
                truocLangDa: truocLangDa,
                sauLangDa: sauLangDa,
                nhan: nhan,
                tinhGio: tinhGio,
                batCO: batCO,
                isNhapTay: isNhapTay
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function formatDateTime(dateTime) {
        var ngayGio = new Date(dateTime);
        var ngay = ngayGio.getFullYear() + '-' +
            ('0' + (ngayGio.getMonth() + 1)).slice(-2) + '-' +
            ('0' + ngayGio.getDate()).slice(-2);
        var gioPhut = ('0' + ngayGio.getHours()).slice(-2) + ':' +
            ('0' + ngayGio.getMinutes()).slice(-2);

        return ngay + 'T' + gioPhut;
    }

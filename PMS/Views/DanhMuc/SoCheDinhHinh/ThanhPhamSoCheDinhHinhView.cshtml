@{
    ViewData["Title"] = "ThanhPhamSoCheDinhHinhView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Sơ Chế Định Hình Sơ Chế Định Hình</h2>
                    @{
                        var themThanhPhamSoCheDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Sơ Chế Định Hình / Thành Phẩm" && x.Func == "Thêm Sơ Chế Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                        if (themThanhPhamSoCheDinhHinh != null)
                        {
                            <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suaThanhPhamSoCheDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Sơ Chế Định Hình / Thành Phẩm" && x.Func == "Sửa Sơ Chế Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (suaThanhPhamSoCheDinhHinh != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaThanhPhamSoCheDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Sơ Chế Định Hình / Thành Phẩm" && x.Func == "Xóa Sơ Chế Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (xoaThanhPhamSoCheDinhHinh != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importThanhPhamSoCheDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Sơ Chế Định Hình / Thành Phẩm" && x.Func == "Import Sơ Chế Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (importThanhPhamSoCheDinhHinh != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportThanhPhamSoCheDinhHinh = rolePermistions.Where(x => x.Fu == "Danh Mục / Sơ Chế Định Hình / Thành Phẩm" && x.Func == "Export Sơ Chế Định Hình / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (exportThanhPhamSoCheDinhHinh != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

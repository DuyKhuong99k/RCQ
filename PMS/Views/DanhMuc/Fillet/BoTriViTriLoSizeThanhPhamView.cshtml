
@{
    ViewData["Title"] = "BoTriViTriLoSizeThanhPhamView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listViTris = ViewBag.listViTris;
    var ListLos = ViewBag.ListLos;
    var listSFLs = ViewBag.listSFLs;
    var listTPFLs = ViewBag.listTPFLs;
    var XuongId = @Context.Session.GetString("XuongId");
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .sidebar {
        background-color: #f1f1f1;
        padding: 10px;
        height: calc(90vh - 200px); /* Chiều cao sidebar */
        border-right: 1px solid #ddd;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .sidebar-section {
        display: flex;
        flex-direction: column;
        flex: 1; /* Chia đều */
        min-height: 0; /* Cho phép overflow */
    }

    .sidebar-header {
        flex-shrink: 0;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .sidebar-list {
        flex: 1;
        overflow: auto;
    }

    .sidebar .btn {
        width: 100%;
        margin-bottom: 5px;
    }


    .footer-bar {
        background: #fff;
        padding: 10px;
        border-top: 1px solid #ddd;
    }

    .form-check-label {
        display: inline-block;
        white-space: nowrap;
    }

    #modalNhanVien .modal-dialog {
        max-width: 1000px;
    }

    /* --- Responsive cho mobile --- */
    @@media (max-width: 768px) {
        .sidebar {
            flex-direction: row; /* Nằm ngang */
            height: auto;
            border-right: none;
            border-bottom: 1px solid #ddd;
        }

        .sidebar-section {
            flex: 1; /* Mỗi phần 50% */
            min-height: auto;
        }

        .sidebar-header {
            font-size: 14px;
            margin-bottom: 3px;
            text-align: center;
        }

        .sidebar-list {
            max-height: 150px;
            overflow-y: auto;
        }

        .sidebar .btn {
            font-size: 12px;
            padding: 3px 5px;
            margin-bottom: 3px;
        }
        /* Để bảng xuống dưới sidebar */
        .col-2.sidebar {
            max-width: 100%;
            flex: 0 0 100%;
        }

        .col-10 {
            max-width: 100%;
            flex: 0 0 100%;
        }
    }

    @@media (max-width: 768px) {
        .footer-bar {
            flex-direction: column;
            align-items: stretch; /* Cho các phần tử full chiều ngang */
            gap: 10px;
        }

            .footer-bar .d-flex {
                flex-wrap: wrap; /* Cho phép xuống dòng */
                gap: 5px;
            }

            .footer-bar label {
                font-size: 14px;
            }

            .footer-bar input[type="date"],
            .footer-bar input[type="time"] {
                flex: 1 1 auto; /* Để input co giãn vừa khung */
                min-width: 120px;
            }

            .footer-bar .btn {
                width: 100%; /* Nút full width */
            }
    }

    @@media (max-width: 768px) {
        .table-container {
            display: flex;
            flex-direction: column-reverse; /* Đảo thứ tự khi mobile */
        }

            .table-container > #GridLineStaff {
                margin-top: 10px;
            }
    }

    @@media (max-width: 992px) {
        /* Sidebar thành 5 cột ngang */
        .col-1.sidebar {
            flex: 0 0 20%; /* 5 ô mỗi ô 20% */
            max-width: 20%;
            border-bottom: none;
            border-right: 1px solid #ddd;
        }
        /* Grid xuống dưới full width */
        .col-7 {
            flex: 0 0 100%;
            max-width: 100%;
            margin-top: 10px;
        }
        /* Sidebar nội dung tối ưu */
        .sidebar {
            height: auto;
            padding: 6px;
        }

        .sidebar-header {
            font-size: 13px;
            text-align: center;
            margin-bottom: 4px;
        }

        .sidebar-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .sidebar .btn {
            width: 100%;
            font-size: 12px;
            margin-bottom: 4px;
            padding: 4px 6px;
        }
        /* Nút chức năng & input dưới Grid */
        .d-flex.flex-wrap.align-items-center.gap-2 {
            flex-direction: column;
            align-items: stretch;
            gap: 10px !important;
        }

        .d-flex.gap-1 {
            width: 100%;
            justify-content: space-between;
        }

        .form-control {
            width: 100%;
        }

        .btn {
            width: 100%;
        }
    }

</style>

<div class="row">
    <div class="col-12">
        <div class="row">
            <div class="col-1 sidebar mb-2">
                <div class="sidebar-section">
                    <div class="sidebar-header">Lô</div>
                    <div class="sidebar-list" id="sidebar-list-lo">
                        @foreach (var lo in ListLos)
                        {
                            <button class="btn btn-secondary btn-sm" data-id="@lo">@lo</button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-1 sidebar mb-2">
                <div class="sidebar-section">
                    <div class="sidebar-header">Vị Trí</div>
                    <div class="sidebar-list">
                        @foreach (var item in listViTris)
                        {
                            <button class="btn btn-secondary btn-sm" data-id="@item.Ma">@item.Ten</button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-1 sidebar mb-2">
                <div class="sidebar-section">
                    <div class="sidebar-header">Size</div>
                    <div class="sidebar-list">
                        @foreach (var item in listSFLs)
                        {
                            <button class="btn btn-secondary btn-sm" data-id="@item.Ma">@item.Ten</button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-1 sidebar mb-2">
                <div class="sidebar-section">
                    <div class="sidebar-header">Size Phụ</div>
                    <div class="sidebar-list">
                        @foreach (var item in listSFLs)
                        {
                            <button class="btn btn-secondary btn-sm" data-id="@item.Ma">@item.Ten</button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-1 sidebar mb-2">
                <div class="sidebar-section">
                    <div class="sidebar-header">Thành Phẩm</div>
                    <div class="sidebar-list">
                        @foreach (var item in listTPFLs)
                        {
                            <button class="btn btn-secondary btn-sm" data-id="@item.Ma">@item.Ten</button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-7">
                <h5>Danh Sách Cài Đặt</h5>
                <div id="GridBoTriLoSizeThanhPham"></div>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <div class="d-flex gap-1">
                        <button class="btn btn-outline-primary" onclick="insert()" title="Thêm">
                            <i class='bx bx-layer-plus'></i>
                        </button>
                        <button class="btn btn-outline-danger" onclick="deleteBoTriLoSizeThanhPham()" title="Xóa">
                            <i class='bx bx-layer-minus'></i>
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label for="date" class="mb-0">Ngày:</label>
                        <input type="date" class="form-control" id="date">
                        <label for="time" class="mb-0">Giờ:</label>
                        <input type="time" class="form-control" id="time">
                    </div>
                    <div class="form-check form-check-inline d-flex align-items-center ms-2">
                        <input class="form-check-input" type="checkbox" id="checkNow">
                        <label class="form-check-label mb-0 ms-1" for="checkNow" style="white-space: nowrap;">Mới Nhất</label>
                    </div>
                    <button class="btn btn-primary" onclick="reloadBoTriLoSizeThanhPham()">Tải Lại</button>
                </div>


            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById('date').value = today;

        function updateTime() {
            var now = new Date();
            var hh = String(now.getHours()).padStart(2, '0');
            var mm = String(now.getMinutes()).padStart(2, '0');
            var ss = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('time').value = hh + ':' + mm + ':' + ss;
        }
        updateTime();
        setInterval(updateTime, 1000);
    });

    $("#date").on("change", function () {
        var selectedDate = $(this).val();

        $.ajax({
            url: "/BoTriViTriLoSizeThanhPhamFillet/GetLosWithDate",
            type: "GET",
            data: { ngay: selectedDate },
            success: function (data) {
                var container = $("#sidebar-list-lo");
                container.empty();

                if (data && data.length > 0) {
                    data.forEach(function (lo) {
                        container.append(
                            `<button class="btn btn-secondary btn-sm" data-id="${lo}">${lo}</button>`
                        );
                    });
                } else {
                    container.append("<p class='text-muted'>Không có dữ liệu</p>");
                }
            },
            error: function () {
                alert("Có lỗi khi tải dữ liệu Lô!");
            }
        });
    });


    var gridBoTriViTriLoSizeThanhPham;
    var selectedLo = null;
    var selectedViTri = null;
    var selectedSize = null;
    var selectedSizePhu = null;
    var selectedThanhPham = null;

    $(document).on('click', '.sidebar button[data-id]', function () {
        var $section = $(this).closest('.sidebar-section');
        var parentTitle = $section.find('.sidebar-header').text().trim();

        if (parentTitle === "Lô") {
            selectedLo = $(this).data('id');
        }
        else if (parentTitle === "Vị Trí") {
            selectedViTri = $(this).data('id');
        }
        else if (parentTitle === "Size") {
            selectedSize = $(this).data('id');
        }
        else if (parentTitle === "Size Phụ") {
            selectedSizePhu = $(this).data('id');
        }
        else if (parentTitle === "Thành Phẩm") {
            selectedThanhPham = $(this).data('id');
        }
        $section.find('button[data-id]')
            .removeClass('btn-primary')
            .addClass('btn-secondary');
        $(this)
            .removeClass('btn-secondary')
            .addClass('btn-primary');

        checkAndLoad();
    });

      function checkAndLoad() {
            var ngay = document.getElementById('date').value;
            if (ngay && selectedLo) {
                reloadGridBoTriLoSizeThanhPham(ngay, selectedLo);
            }
      }

      function reloadGridBoTriLoSizeThanhPham(ngay,maLo){
          var isCheckNow = $('#checkNow').prop('checked');
          $.ajax({
            url: '/BoTriViTriLoSizeThanhPhamFillet/GetAllsFullField',
            type: 'GET',
            data: {
                    ngay: ngay,
                    maLo: maLo,
                    isCheckNow:isCheckNow
            },
            dataType: 'json',
            success: function (rs) {
                if (rs != null) {
                    loadGridDataBoTriLoSizeThanhPham(rs);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
      }

      function loadGridDataBoTriLoSizeThanhPham(data) {
        if (gridBoTriViTriLoSizeThanhPham) {
            gridBoTriViTriLoSizeThanhPham.dataSource = [];
            gridBoTriViTriLoSizeThanhPham.dataBind();
            if (data && data.length > 0) {
                gridBoTriViTriLoSizeThanhPham.dataSource = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                gridBoTriViTriLoSizeThanhPham.dataBind();
            }
        } else {
            initializeGrid(data);
        }
    }
     loadGridDataBoTriLoSizeThanhPham();
      function initializeGrid(data){
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        gridBoTriViTriLoSizeThanhPham = new ej.grids.Grid({
                            dataSource: dataManager,
                            allowPaging: true,
                            pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                            allowFiltering: true,
                            filterSettings: { type: 'Excel' },
                            allowSorting: true,
                            allowResizing: true,
                            allowExcelExport: true,
                            selectionSettings: { persistSelection: true },
                            toolbar: ['ExcelExport'],
                            rowSelected: selectionChangedBoTriLoSizeThanhPham,
                            rowDeselected: unSelectionChangedBoTriLoSizeThanhPham,
                            height: 400,
                            columns: [
                                { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                                { field: 'MaLo', headerText: 'Mã Lô', width: 150 },
                                { field: 'ViTriName', headerText: 'Vị Trí', width: 150 },
                                { field: 'SizeName', headerText: 'Size', width: 150 },
                                { field: 'SizePhuName', headerText: 'Size Phụ', width: 150 },
                                { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                                { field: 'Gio', headerText: 'Giờ Bắt Đầu', width: 150 }
                            ]
                        });
        gridBoTriViTriLoSizeThanhPham.appendTo('#GridBoTriLoSizeThanhPham');
        gridBoTriViTriLoSizeThanhPham.toolbarClick = function (args) {
        if (args.item.id === 'Grid_excelexport') {
            gridBoTriViTriLoSizeThanhPham.excelExport();
        }};

      }

    let selectedIdsStringBoTriLoSizeThanhPham = "";
    let selectedCount = 0;
    function unSelectionChangedBoTriLoSizeThanhPham(args) {
        let deselectedRecords = args.data ? args.data : [];
        if (deselectedRecords.length == 0) {
            selectedIdsStringBoTriLoSizeThanhPham = "";
            selectedCount = 0;
            //alert(selectedIdsStringBoTriLoSizeThanhPham);
            return;
        }
        let deselectedId = deselectedRecords.Id;
        if (selectedIdsStringBoTriLoSizeThanhPham.includes(deselectedId)) {
            selectedIdsStringBoTriLoSizeThanhPham = selectedIdsStringBoTriLoSizeThanhPham.replace(deselectedId + ",", "");
            selectedCount--;
        }
        //alert(selectedIdsStringBoTriLoSizeThanhPham);
    }

    function selectionChangedBoTriLoSizeThanhPham(args) {
        let selectedRecords = args.data ? args.data : [];
        if (selectedRecords.length == 0) {
            let filteredRecords = gridBoTriViTriLoSizeThanhPham.getCurrentViewRecords();
            selectedIdsStringBoTriLoSizeThanhPham = "";
            selectedCount = filteredRecords.length;
            filteredRecords.forEach(record => {
                selectedIdsStringBoTriLoSizeThanhPham += record.Id + ",";
            });
            //alert(selectedIdsStringBoTriLoSizeThanhPham);
            return;
        }
        let selectedId = selectedRecords.Id;
        if (!selectedIdsStringBoTriLoSizeThanhPham.includes(selectedId)) {
            selectedIdsStringBoTriLoSizeThanhPham += selectedId + ",";
            selectedCount++;
        }
        //alert(selectedIdsStringBoTriLoSizeThanhPham);

    }

    function deleteBoTriLoSizeThanhPham() {
        var ngay = $('#date').val();
        var gio = $('#time').val();
        var maLo = selectedLo;
        var xuongId = @XuongId;
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn xoá " + selectedCount + " items!  ",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    $.ajax({
                        url: '/BoTriViTriLoSizeThanhPhamFillet/DoDelete',
                        data: {
                            selectedIdsStringBoTriLoSizeThanhPham: selectedIdsStringBoTriLoSizeThanhPham,
                        },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                reloadGridBoTriLoSizeThanhPham(ngay,maLo);
                                selectedIdsStringBoTriViTriLoSizeThanhPham = "";
                                selectedCount = 0;
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");

                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        }
                    });
                }
            }
        });
    }

    

    function reloadBoTriLoSizeThanhPham(){
        var ngay = $('#date').val();;
        var maLo = selectedLo;
        reloadGridBoTriLoSizeThanhPham(ngay,maLo);
    }

    // var selectedLo = null;
    // var selectedViTri = null;
    // var selectedSize = null;
    // var selectedSizePhu = null;
    // var selectedThanhPham = null;
    // var selectedLine = null;
    // var selectedViTri = null;
    function insert() {
        var ngay = $('#date').val();
        var gio = $('#time').val();
        var xuongId = @XuongId;
        $.ajax({
            type: 'POST',
            url: '/BoTriViTriLoSizeThanhPhamFillet/DoInsert',
            data: {
                maLo: selectedLo,
                maViTri:selectedViTri,
                maSize : selectedSize,
                maSizePhu:selectedSizePhu,
                maThanhPham :selectedThanhPham,
                ngay: ngay,
                gio: gio,
                xuongId: xuongId
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    reloadGridBoTriLoSizeThanhPham(ngay, selectedLo);
                } else {
                    toastOptionNotyfi(); 
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }

</script>


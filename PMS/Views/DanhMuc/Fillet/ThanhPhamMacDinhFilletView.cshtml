@{
    ViewData["Title"] = "ThanhPhamMacDinhFilletView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listMaLos = ViewBag.listMaLos;
    var listTPFLs = ViewBag.listTPFLs;
    var listXuongs = ViewBag.listXuongs;
    var XuongIdTPMDFL = @Context.Session.GetString("XuongId");
}

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Thành Phẩm Mặc Định Fillet</h2>
                    @{
                        
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themThanhPhamMacDinhFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm Mặc Định" && x.Func == "Thêm Fillet / Thành Phẩm Mặc Định" && x.Status == 1).FirstOrDefault();
                            if (themThanhPhamMacDinhFillet != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaThanhPhamMacDinhFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm Mặc Định" && x.Func == "Sửa Fillet / Thành Phẩm Mặc Định" && x.Status == 1).FirstOrDefault();
                            if (suaThanhPhamMacDinhFillet != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaThanhPhamMacDinhFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm Mặc Định" && x.Func == "Xoá Fillet / Thành Phẩm Mặc Định" && x.Status == 1).FirstOrDefault();
                            if (xoaThanhPhamMacDinhFillet != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Thành Phẩm Mặc Định Fillet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">STT</label>
                                    <input type="text" id="sttTPMDFL" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập STT..." style="text-transform: uppercase;" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ngày</label>
                                    <input type="date" id="ngayTPMDFL" class="form-control form-control-lg" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã Lô</label>
                                    <select id="maLoTPMDFL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Lô</option>
                                        @foreach (var item in listMaLos)
                                        {
                                            <option value="@item.Item2">@item.Item2</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamTPMDFL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Thành Phẩm</option>
                                        @foreach (var item in listTPFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                       
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Thành Phẩm Mặc Định Fillet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">STT</label>
                                    <input type="text" id="sttTPMDFLSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập STT..." style="text-transform: uppercase;" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Ngày</label>
                                    <input type="date" id="ngayTPMDFLSua" class="form-control form-control-lg" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã Lô</label>
                                    <select id="maLoTPMDFLSua" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Lô</option>
                                        @foreach (var item in listMaLos)
                                        {
                                            <option value="@item.Item2">@item.Item2</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamTPMDFLSua" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Thành Phẩm</option>
                                        @foreach (var item in listTPFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="sttTPMDFLRowSelected" />
<input type="hidden" id="ngayTPMDFLRowSelected" />
<input type="hidden" id="maxuongTPMDFLRowSelected" />
<input type="hidden" id="xuongIdTPMDFL" value="@XuongIdTPMDFL" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    var now = new Date();

    var day = ("0" + now.getDate()).slice(-2);
    var month = ("0" + (now.getMonth() + 1)).slice(-2);

    var ngay = now.getFullYear() + "-" + (month) + "-" + (day);
    var maXuong = $('#xuongIdTPMDFL').val();
    function loadGridData() {
        $.ajax({
            url: '/ThanhPhamMacDinhFillet/GetAllsFullField',
            type: 'GET',
            //dataType: 'json',
            data: {
                ngay: ngay,
                maXuong: maXuong
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'STT', headerText: 'STT', width: 50 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy' },
                            { field: 'MaLo', headerText: 'Lô', width: 150 },
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var stt = selectedRecord.STT;
        var ngay = selectedRecord.Ngay;
        var maxuong = selectedRecord.MaXuong;
        $('#sttTPMDFLRowSelected').val(stt);
        $('#ngayTPMDFLRowSelected').val(ngay); 
        $('#maxuongTPMDFLRowSelected').val(maxuong);
      
    }
</script>
<script>
    function chuyenDoiNgay(inputDate) {
        // Chuyển đổi kiểu dữ liệu của inputDate thành đối tượng Date
        var dateObject = new Date(inputDate);

        // Lấy ngày, tháng, năm từ đối tượng Date
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1; // Tháng bắt đầu từ 0
        var year = dateObject.getFullYear();

        // Định dạng lại ngày, tháng, năm theo định dạng yyyy-MM-dd
        var formattedDate = year + "-" + (month < 10 ? '0' : '') + month + "-" + (day < 10 ? '0' : '') + day;

        // Trả về ngày đã định dạng
        return formattedDate;
    }
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/ThanhPhamMacDinhFillet/CreatDefautNew",
            data: {
                ngay: ngay,
                maXuong: maXuong
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#sttTPMDFL').val(rs.STT);
                    $('#ngayTPMDFL').val(chuyenDoiNgay(rs.Ngay));
                    $('#maloTPMDFL').val(rs.MaLo);
                    $('#ThanhPhamMacDinhTPMDFL').val(rs.ThanhPhamMacDinh);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var stt = $('#sttTPMDFL').val();
        var ngay = $('#ngayTPMDFL').val();
        var maLo = $('#maLoTPMDFL').val();
        var maThanhPham = $('#maThanhPhamTPMDFL').val();
      
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/ThanhPhamMacDinhFillet/DoInsert',
            data: {
                stt: stt,
                ngay: ngay,
                maLo: maLo,
                maThanhPham: maThanhPham,
                maXuong: maXuong
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }

    function showUpdate() {
        var stt = $('#sttTPMDFLRowSelected').val();
        var ngay = $('#ngayTPMDFLRowSelected').val();
        var maXuong = $('#maxuongTPMDFLRowSelected').val();

        $.ajax({
            url: "/ThanhPhamMacDinhFillet/GetsByMa",
            data: {
                stt: stt,
                ngay: ngay,
                maXuong: maXuong,
            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#sttTPMDFLSua').val(rs.STT);
                    $('#ngayTPMDFLSua').val(chuyenDoiNgay(rs.Ngay));
                    $('#maLoTPMDFLSua').val(rs.MaLo);
                    $('#maThanhPhamTPMDFLSua').val(rs.MaThanhPham);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var stt = $('#sttTPMDFLSua').val();
        var ngay = $('#ngayTPMDFLRowSelected').val();
        var maLo = $('#maLoTPMDFLSua').val();
        var maThanhPham = $('#maThanhPhamTPMDFLSua').val();

        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/ThanhPhamMacDinhFillet/DoUpdate',
            data: {
                stt: stt,
                ngay: ngay,
                maLo: maLo,
                maThanhPham: maThanhPham,
                maXuong: maXuong
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }

    function showDelete() {
        var stt = $('#sttTPMDFLRowSelected').val();
        var ngay = $('#ngayTPMDFLRowSelected').val();
        var maXuong = $('#maxuongTPMDFLRowSelected').val();
      
        $.ajax({
            url: "/ThanhPhamMacDinhFillet/GetsByMa",
            data: {
                stt: stt,
                ngay: ngay,
                maXuong: maXuong
               
            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá ! ",
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/ThanhPhamMacDinhFillet/DoDelete',
                                    data: {
                                        stt: stt,
                                        ngay: ngay,
                                        maXuong: maXuong
                                    },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>



@{
    ViewData["Title"] = "ThanhPhamFilletView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Thành Phẩm Fillet</h2>
                    @{
                        var themthanhphamFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm" && x.Func == "Thêm Fillet / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                        if (themthanhphamFillet != null)
                        {
                            <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                        }
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var suathanhphamFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm" && x.Func == "Sửa Fillet / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (suathanhphamFillet != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoathanhphamFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm" && x.Func == "Xoá Fillet / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (themthanhphamFillet != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importthanhphamFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm" && x.Func == "Import Fillet / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (themthanhphamFillet != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportthanhphamFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Thành Phẩm" && x.Func == "Export Fillet / Thành Phẩm" && x.Status == 1).FirstOrDefault();
                            if (themthanhphamFillet != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Thành Phẩm Fillet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã</label>
                                    <input type="text" id="maTPFL" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã..." style="text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Mã Cá</label>
                                    <input type="text" id="maCaTPFL" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Cá..." style="text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Tên</label>
                                    <input type="text" id="tenTPFL" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Thời Gian Trên 1Kg (s)</label>
                                    <input type="number" min="0" step="0.001" id="thoiGianTren1kgSecondsTPFL" class="form-control form-control-lg" autocomplete="off" placeholder="0,000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Định Mức Hao Hụt</label>
                                    <input type="number" min="0" step="0.001" id="dinhMucHaoHutTPFL" class="form-control form-control-lg" autocomplete="off" placeholder="0,000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Xí Nghiệp</label>
                                    <input type="text" id="codeIdTPFL" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã Xưởng..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isCaMuoiTPFL" />
                                        Cá Muối
                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isSoCheTPFL" />
                                        Sơ Chế
                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isNotSetByTimeTPFL" />
                                        Không Áp Dụng Đặt Theo Thời Gian
                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="khongPhanBietSizeTPFL" />
                                        Không Phân Biệt Size
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

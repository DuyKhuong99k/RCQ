                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isNotSetByTimeTPFLSua" />
                                        Không Áp Dụng Đặt Theo Thời Gian
                                    </label>
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="khongPhanBietSizeTPFLSua" />
                                        Không Phân Biệt Size
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="maTPFLRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/ThanhPhamFillet/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'MaCa', headerText: 'Mã Cá', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            //{ field: 'BravoId', headerText: 'Mã Tính Lương', width: 150 },
                            { field: 'Min', headerText: 'TL Min', type: 'number', width: 150 },
                            { field: 'Max', headerText: 'TL Max', type: 'number', width: 150 },
                            { field: 'DinhMucHaoHut', headerText: 'Định Mức Hao Hụt', type: 'number', width: 150 },
                            { field: 'ThoiGianTren1kgSeconds', headerText: 'Thời Gian Trên 1Kg (s)', type: 'number', width: 170},
                            { field: 'IsSoChe', headerText: 'Sơ Chế', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsCaMuoi', headerText: 'Cá Muối', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'IsNotSetByTime', headerText: 'Không Áp Dụng Thời Gian', width: 200, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'KhongPhanBietSize', headerText: 'Không Phân Biệt Size', width: 170, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;

        $('#maTPFLRowSelected').val(Ma);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/ThanhPhamFillet/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPFL').val(rs.Ma);
                    $('#maCaTPFL').val(rs.MaCa);
                    $('#thoiGianTren1kgSecondsTPFL').val(rs.ThoiGianTren1kgSeconds);
                    $('#dinhMucHaoHutTPFL').val(rs.DinhMucHaoHut);
                    $('#codeIdTPFL').val(rs.CodeId);
                    $('#isNotSetByTimeTPFL').val(rs.IsNotSetByTime);
                    $('#khongPhanBietSizeTPFL').val(rs.KhongPhanBietSize);
                    $('#tenTPFL').val(rs.Ten);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maTPFL').val();
        var maCa = $('#maCaTPFL').val();
        var ten = $('#tenTPFL').val();
        var thoiGianTren1kgSeconds = $('#thoiGianTren1kgSecondsTPFL').val();
        var dinhMucHaoHut = $('#dinhMucHaoHutTPFL').val();
        var codeId = $('#codeIdTPFL').val();
        var isCaMuoi = $('#isCaMuoiTPFL').prop('checked');
        var isSoChe = $('#isSoCheTPFL').prop('checked');
        var isNotSetByTime = $('#isNotSetByTimeTPFL').prop('checked');
        var khongPhanBietSize = $('#khongPhanBietSizeTPFL').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/thanhPhamFillet/DoInsert',
            data: {
                ma: ma,
                maCa: maCa,
                ten: ten,
                thoiGianTren1kgSeconds: thoiGianTren1kgSeconds,
                dinhMucHaoHut: dinhMucHaoHut,
                codeId: codeId,
                isCaMuoi: isCaMuoi,
                isSoChe: isSoChe,
                isNotSetByTime: isNotSetByTime,
                khongPhanBietSize: khongPhanBietSize
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ma = $('#maTPFLRowSelected').val();
        $.ajax({
            url: "/ThanhPhamFillet/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPFLSua').val(rs.Ma);
                    $('#maCaTPFLSua').val(rs.MaCa);
                    $('#tenTPFLSua').val(rs.Ten);
                    $('#thoiGianTren1kgSecondsTPFLSua').val(rs.ThoiGianTren1kgSeconds);
                    $('#dinhMucHaoHutTPFLSua').val(rs.DinhMucHaoHut);
                    $('#codeIdTPFLSua').val(rs.CodeId);
                    $('#isCaMuoiTPFLSua').prop('checked', rs.IsCaMuoi);
                    $('#isSoCheTPFLSua').prop('checked', rs.IsSoChe);
                    $('#isNotSetByTimeTPFLSua').prop('checked', rs.IsNotSetByTime);
                    $('#khongPhanBietSizeTPFLSua').prop('checked', rs.KhongPhanBietSize);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ma = $('#maTPFLSua').val();
        var maCa = $('#maCaTPFLSua').val();
        var ten = $('#tenTPFLSua').val();
        var thoiGianTren1kgSeconds = $('#thoiGianTren1kgSecondsTPFLSua').val();
        var dinhMucHaoHut = $('#dinhMucHaoHutTPFLSua').val();
        var codeId = $('#codeIdTPFLSua').val();
        var isCaMuoi = $('#isCaMuoiTPFLSua').prop('checked');
        var isSoChe = $('#isSoCheTPFLSua').prop('checked');
        var isNotSetByTime = $('#isNotSetByTimeTPFLSua').prop('checked');
        var khongPhanBietSize = $('#khongPhanBietSizeTPFLSua').prop('checked');
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/ThanhPhamFillet/DoUpdate',
            data: {
                ma: ma,
                maCa: maCa,
                ten: ten,
                thoiGianTren1kgSeconds: thoiGianTren1kgSeconds,
                dinhMucHaoHut: dinhMucHaoHut,
                codeId: codeId,
                isCaMuoi: isCaMuoi,
                isSoChe: isSoChe,
                isNotSetByTime: isNotSetByTime,
                khongPhanBietSize: khongPhanBietSize
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var ma = $('#maTPFLRowSelected').val();
        $.ajax({
            url: "/ThanhPhamFillet/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/ThanhPhamFillet/DoDelete',
                                    data: { ma: ma },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>




@{
    ViewData["Title"] = "NhanVienTheoBanView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listBanFLs = ViewBag.listBanFLs;
    var listXuongs = ViewBag.listXuongs;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<style>
    .vertical-buttons {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

        .vertical-buttons button {
            margin-bottom: 5px; /* Khoảng cách giữa các nút */
        }

    @@media (max-width: 767px) {
        .vertical-buttons {
            margin-top: 5px;
            flex-direction: row;
        }
    }

    .btn-equal-size {
        width: 100%;
    }

    div.col-sm-9 > span.e-input-group.e-control-wrapper.e-ddl {
        width: 30% !important;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Nhân Viên Theo Bàn</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-5">
                            <h6>Danh sách nhân viên</h6>
                            <div id="Grid"></div>
                        </div>
                        <div class="col-sm-1">
                            <div class="vertical-buttons">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">>></span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                                <button onclick="deleteNhanVienBan()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtXoa">-</span>
                                        <div id="loadingIndicatorXoa" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto;  display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="row">
                                <div class="col-sm-3">
                                    <h6>Nhân viên bàn</h6>
                                </div>
                                <div class="col-sm-9">
                                    <select id="listBan" class="form-control-sm">
                                        <option disabled>Chọn bàn</option>
                                        @foreach (var item in listBanFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                    <select id="listXuong" class="form-control-sm">
                                        <option disabled>Chọn xưởng</option>
                                        @foreach (var item in listXuongs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div id="GridDeskStaff"></div>
                            <div style="margin-top:5px">
                                <label class="">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="suDungBFL" />
                                    Xem nhân viên bàn hiện tại
                                </label>
                                <button onclick="" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-loader'></i>Tải Lại</button>
                                <button onclick="" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="maNhanVienRowSelected" />
<input type="hidden" id="maBanId" />
<input type="hidden" id="maXuongId" />

<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/Staff/GetAllNhanViens',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                // Kiểm tra xem Grid đã được tạo chưa
                if (grid) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 500 },
                        allowSelection: true,
                        allowFiltering: true,
                        allowSorting: true,
                        allowResizing: true,
                        enableVirtualization: true,
                        loadingIndicator: { indicatorType: 'Shimmer' },
                        filterSettings: { type: 'Excel' },
                        //selectionSettings: { persistSelection: true, type: "Multiple", checkboxOnly: true },
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionChanged,
                        rowDeselected: unSelectionChanged,
                        height: 400,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'IsContracting', headerText: 'Trạng Thái', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' }
                        ]
                    });

                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }

    let selectedIdsString = ""; // Khai báo một chuỗi để lưu trữ MaNhanVien đã chọn

    function unSelectionChanged(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        if (deselectedRecords.length == 0) {
            selectedIdsString = "";
            //alert(selectedIdsString);
            return;
        }

        let deselectedId = deselectedRecords.MaNhanVien;

        // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
        if (selectedIdsString.includes(deselectedId)) {
            selectedIdsString = selectedIdsString.replace(deselectedId + ",", ""); // Loại bỏ MaNhanVien khỏi chuỗi
        }

       
    }
    function selectionChanged(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {
           
            // Lấy toàn bộ Mã Nhân viên từ grid vào selectedIdsString
            let filteredRecords = grid.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdsString = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            filteredRecords.forEach(record => {
                selectedIdsString += record.MaNhanVien + ","; // Thêm Mã Nhân viên vào chuỗi, phân tách bằng dấu phẩy
            });
          
            return;
        }
        let selectedId = selectedRecords.MaNhanVien;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdsString.includes(selectedId)) {
            selectedIdsString += selectedId + ","; // Thêm MaNhanVien mới vào chuỗi, phân tách bằng dấu phẩy
        }
       
    }

</script>
<script>
    $(document).ready(function () {
        creatListBan();
        creatListXuong();
    });
    function creatListBan() {
        // initialize ComboBox component
        var comboBoxObj = new ej.dropdowns.ComboBox({
            // set the height of the popup element
            popupHeight: '230px',
            index: 0,
            // set the placeholder to ComboBox input element
            placeholder: 'Chọn bàn',
            // bind the change event
            change: function () { valueChangeBan(); }
        });
        comboBoxObj.appendTo('#listBan');
        // call the change event's function after initialized the component.
        valueChangeBan();

        function valueChangeBan() {
            var maBan = comboBoxObj.value === null ? 'null' : comboBoxObj.value.toString();
            var tenBan = comboBoxObj.text === null ? 'null' : comboBoxObj.text.toString();
            $('#maBanId').val(maBan);
            loadData();
        }
    };
    function creatListXuong() {
        // initialize ComboBox component
        var comboBoxObj = new ej.dropdowns.ComboBox({
            // set the height of the popup element
            popupHeight: '230px',
            index: 0,
            // set the placeholder to ComboBox input element
            placeholder: 'Chọn xưởng',
            // bind the change event
            change: function () { valueChangeXuong(); }
        });
        comboBoxObj.appendTo('#listXuong');
        // call the change event's function after initialized the component.
        valueChangeXuong();

        function valueChangeXuong() {
            var maXuong = comboBoxObj.value === null ? 'null' : comboBoxObj.value.toString();
            var tenXuong = comboBoxObj.text === null ? 'null' : comboBoxObj.text.toString();
            $('#maXuongId').val(maXuong);
            loadData();
        }
    };

    function loadData() {
        var maBan = $('#maBanId').val();
        var maXuong = $('#maXuongId').val();
        loadGridDataDeskStaff(maBan, maXuong);
    }
    var gridDeskStaff;

    function loadGridDataDeskStaff(maBan, maXuong) {
        $.ajax({
            url: '/NhanVienTheoBanFillet/GetAllsFullField',
            type: 'GET',
            data: {
                maBan: maBan,
                maXuong: maXuong
            },
            success: function (data) {
                // Khởi tạo DataManager và gán dữ liệu từ API vào dataSource
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                // Kiểm tra xem Grid đã được tạo chưa
                if (gridDeskStaff) {
                    // Nếu Grid đã được tạo, chỉ cập nhật dữ liệu mới
                    gridDeskStaff.dataSource = dataManager;
                    gridDeskStaff.refresh();
                } else {
                    // Nếu Grid chưa được tạo, tạo mới Grid
                    gridDeskStaff = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 500 },
                        allowSelection: true,
                        allowFiltering: true,
                        allowSorting: true,
                        allowResizing: true,
                        enableVirtualization: true,
                        loadingIndicator: { indicatorType: 'Shimmer' },
                        filterSettings: { type: 'Excel' },
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionNhanVienTheoBan,
                        rowDeselected: unSelectionNhanVienTheoBan,
                        height: 400,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'Id', headerText: 'Id', width: 150 },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'BanName', headerText: 'Bàn', width: 150 },
                            { field: 'MaKhuVuc', headerText: 'Khu Vực', width: 150 },
                            { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                            { field: 'NgayGio', headerText: 'Ngày Thêm', width: 150 },
                            { field: 'Creator', headerText: 'Người Thêm', width: 150 },
                            { field: 'PCName', headerText: 'Máy Thêm', width: 150 },
                        ]
                    });

                    gridDeskStaff.appendTo('#GridDeskStaff');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridDataDeskStaff();
    function reloadDataDeskStaff() {
        loadData();
    }

    let selectedIdNhanVienBans = ""; // Khai báo một chuỗi để lưu trữ Id đã chọn
    let selectedCount = 0; // Biến để đếm số phần tử được chọn

    function unSelectionNhanVienTheoBan(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        if (deselectedRecords.length == 0) {
            selectedIdNhanVienBans = "";
            selectedCount = 0; // Reset số lượng phần tử được chọn
            return;
        }

        let deselectedId = deselectedRecords.Id;

        // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
        if (selectedIdNhanVienBans.includes(deselectedId)) {
            selectedIdNhanVienBans = selectedIdNhanVienBans.replace(deselectedId + ",", ""); // Loại bỏ Id khỏi chuỗi
            selectedCount--; // Giảm số lượng phần tử được chọn
        }
    }

    function selectionNhanVienTheoBan(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {

            // Lấy toàn bộ id từ grid vào selectedIdsString
            let filteredRecords = gridDeskStaff.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdNhanVienBans = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            selectedCount = filteredRecords.length; // Cập nhật số lượng phần tử được chọn
            filteredRecords.forEach(record => {
                selectedIdNhanVienBans += record.Id + ","; // Thêm Mã Nhân viên vào chuỗi, phân tách bằng dấu phẩy
            });
            return;
        }
        let selectedId = selectedRecords.Id;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdNhanVienBans.includes(selectedId)) {
            selectedIdNhanVienBans += selectedId + ","; // Thêm MaNhanVien mới vào chuỗi, phân tách bằng dấu phẩy
            selectedCount++; // Tăng số lượng phần tử được chọn
        }
    }


    function insert() {
        var maBan = $('#maBanId').val();
        var maXuong = $('#maXuongId').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/NhanVienTheoBanFillet/DoInsert',
            data: {
                selectedIdsString: selectedIdsString,
                maBan: maBan,
                maXuong: maXuong
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    loadData();
                    reloadData();
                    selectedIdsString = "";
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
    
        
    function deleteNhanVienBan(){
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn xoá "+selectedCount+" items!  ",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/NhanVienTheoBanFillet/DoDelete',
                        data: {
                            selectedIdNhanVienBans: selectedIdNhanVienBans
                        },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                loadData();
                                selectedIdNhanVienBans = "";
                                selectedCount = 0;
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");
                                
                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        }
                    });
                }
            }
        });
    }
</script>


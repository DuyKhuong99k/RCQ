    function loadData() {
        var ngay = $('#datepicker').val();
        var maLo = $('#maLoId').val();
        var maXuong = $('#maXuongId').val();
        reloadGridSizeStaff(ngay, maLo, maXuong);
    }
    var gridSizeStaff;

    function reloadGridSizeStaff(ngay, maLo, maXuong){
          //var isCheckNow = $('#checkNow').prop('checked');
          $.ajax({
            url: '/BoTriNVTheoSize/GetAllsFullField',
            type: 'GET',
            data: {
                dateTime: ngay,
                maLo: maLo,
                maXuong: maXuong
            },
            dataType: 'json',
            success: function (rs) {
                if (rs != null) {
                    loadGridDataSizeStaff(rs);
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
      }
      function loadGridDataSizeStaff(data) {
        if (gridSizeStaff) {
            gridSizeStaff.dataSource = [];
            gridSizeStaff.dataBind();
            if (data && data.length > 0) {
                gridSizeStaff.dataSource = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                gridSizeStaff.dataBind();
            }
        } else {
            initializeGrid(data);
        }
    }
    loadGridDataSizeStaff();
    function initializeGrid(data){
        var dataManager = new ej.data.DataManager({
            json: data,
            adaptor: new ej.data.JsonAdaptor()
        });
        gridSizeStaff = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 500, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        allowSorting: true,
                        filterSettings: { type: 'Excel' },
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        //rowSelected: onRowSelected,
                        selectionSettings: { persistSelection: true },
                        rowSelected: selectionNhanVienTheoSize,
                        rowDeselected: unSelectionNhanVienTheoSize,
                        height: 400,
                        columns: [
                            { type: "checkbox", field: "", allowFiltering: false, allowSorting: false, width: '50' },
                            { field: 'MaNhanVien', headerText: 'Mã Nhân Viên', width: 150 },
                            { field: 'MaHoSo', headerText: 'Mã Số', width: 150 },
                            { field: 'Name', headerText: 'Tên Nhân Viên', width: 150 },
                            { field: 'DeptName0', headerText: 'Tên Nhóm', width: 150 },
                            { field: 'SizeName', headerText: 'Size', width: 150 },
                            { field: 'ThoiGianBatDau', headerText: 'Giờ Bất Đầu', width: 150 },

                        ]
                    });

                    gridSizeStaff.appendTo('#GridSizeStaff');
        gridSizeStaff.toolbarClick = function (args) {
        if (args.item.id === 'Grid_excelexport') {
            gridSizeStaff.excelExport();
        }};

      }


    

    let selectedIdNhanVienSizes = ""; // Khai báo một chuỗi để lưu trữ Id đã chọn
    let selectedCount = 0; // Biến để đếm số phần tử được chọn

    function unSelectionNhanVienTheoSize(args) {
        let deselectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        if (deselectedRecords.length == 0) {
            selectedIdNhanVienSizes = "";
            selectedCount = 0; // Reset số lượng phần tử được chọn
            //alert(selectedIdNhanVienSizes);
            return;
        }

        let deselectedId = deselectedRecords.MaNhanVien;

        // Kiểm tra xem MaNhanVien đã có trong chuỗi chưa trước khi loại bỏ
        if (selectedIdNhanVienSizes.includes(deselectedId)) {
            selectedIdNhanVienSizes = selectedIdNhanVienSizes.replace(deselectedId + ",", ""); // Loại bỏ Id khỏi chuỗi
            selectedCount--; // Giảm số lượng phần tử được chọn
        }
        //alert(selectedIdNhanVienSizes);
    }

    function selectionNhanVienTheoSize(args) {
        let selectedRecords = args.data ? args.data : []; // Lấy các bản ghi được chọn
        // Giả định có một thuộc tính isHeader để xác định xem dữ liệu có phải từ header hay không
        if (selectedRecords.length == 0) {

            // Lấy toàn bộ id từ grid vào selectedIdsString
            let filteredRecords = gridSizeStaff.getCurrentViewRecords(); // Lấy các bản ghi đã được lọc
            selectedIdNhanVienSizes = ""; // Reset selectedIdsString trước khi thêm dữ liệu mới
            selectedCount = filteredRecords.length; // Cập nhật số lượng phần tử được chọn
            filteredRecords.forEach(record => {
                selectedIdNhanVienSizes += record.MaNhanVien + ","; // Thêm Mã Nhân viên vào chuỗi, phân tách bằng dấu phẩy
            });
            //alert(selectedIdNhanVienSizes);
            return;
        }
        let selectedId = selectedRecords.MaNhanVien;
        // Kiểm tra xem MaNhanVien đã được thêm vào chuỗi chưa trước khi thêm vào
        if (!selectedIdNhanVienSizes.includes(selectedId)) {
            selectedIdNhanVienSizes += selectedId + ","; // Thêm MaNhanVien mới vào chuỗi, phân tách bằng dấu phẩy
            selectedCount++; // Tăng số lượng phần tử được chọn
        }
        //alert(selectedIdNhanVienSizes);
    }

    function showInsert() {
        var maLo = $('#maLoId').val();
        if (selectedIdsString == null || selectedIdsString == undefined || selectedIdsString == "" || maLo == null || maLo == undefined || maLo == "") {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn nhân viên hoặc Lô", "Thông báo");
        } else {
            $('#modalThem').modal('show');
        }
    }
    function insert() {
        var ngay = $('#datepicker').val();
        var maLo = $('#maLoId').val();
        var maXuong = $('#maXuongId').val();
        var maSize = $('#maSizeId').val();
        var thoiGianBatDau = $('#timepickerNVS').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/BoTriNVTheoSize/DoInsert',
            data: {
                selectedIdsString: selectedIdsString,
                ngay: ngay,
                maLo: maLo,
                maXuong: maXuong,
                maSize: maSize,
                thoiGianBatDau: thoiGianBatDau
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    loadData();
                    reloadData();
                    selectedIdsString = "";
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }


    function deleteNhanVienSize() {
        var ngay = $('#datepicker').val();
        var maLo = $('#maLoId').val();
        var maXuong = $('#maXuongId').val();
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn xoá " + selectedCount + " items!  ",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/BoTriNVTheoSize/DoDelete',
                        data: {
                            selectedIdNhanVienSizes: selectedIdNhanVienSizes,
                            dateTime: ngay,
                            maLo: maLo,
                            maXuong: maXuong
                        },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                loadData();
                                selectedIdNhanVienSizes = "";
                                selectedCount = 0;
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");

                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        }
                    });
                }
            }
        });
    }

    function showUpdate() {
        var maLo = $('#maLoId').val();
        if (selectedIdNhanVienSizes == null || selectedIdNhanVienSizes == undefined || selectedIdNhanVienSizes == "" || maLo == null || maLo == undefined || maLo == "") {
            toastOptionNotyfi();
            toastr["warning"]("Bạn chưa chọn nhân viên hoặc Lô", "Thông báo");
        } else {
            $('#modalSua').modal('show');
        }
    }
    function update() {
        var ngay = $('#datepicker').val();
        var maLo = $('#maLoId').val();
        var maXuong = $('#maXuongId').val();
        var maSize = $('#maSizeIdSua').val();
        var thoiGianBatDau = $('#timepickerNVSSua').val();
        bootbox.confirm({
            title: "Thông báo!",
            message: "Bạn có chắc muốn sửa " + selectedCount + " items!  ",
            buttons: {
                confirm: {
                    label: 'OK',
                    className: 'btn btn-primary'
                }
            },
            callback: function (result) {
                if (result) {
                    //Người dùng đã bấm OK, Gọi API xóa ở đây
                    $.ajax({
                        url: '/BoTriNVTheoSize/DoUpDate',
                        data: {
                            selectedIdNhanVienSizes: selectedIdNhanVienSizes,
                            dateTime: ngay,
                            maLo: maLo,
                            maXuong: maXuong,
                            maSize: maSize,
                            thoiGianBatDau: thoiGianBatDau
                        },
                        type: 'POST',
                        dataType: 'json',
                        success: function (rs) {
                            if (rs.isSuccess === true) {
                                loadData();
                                selectedIdNhanVienSizes = "";
                                selectedCount = 0;
                                $('#modalSua').modal('hide');
                                toastOptionNotyfi();
                                toastr["success"](rs.Messages, "Thông báo");

                            } else {
                                toastOptionNotyfi();
                                toastr["warning"](rs.Messages, "Thông báo");
                            }
                        },
                        error: function (error) {
                            toastOptionNotyfi();
                            toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                        }
                    });
                }
            }
        });
    }
</script>


@{
    ViewData["Title"] = "DinhMucFilletView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listMaLos = ViewBag.listMaLos;
    var listMaLoaiCas = ViewBag.listMaLoaiCas;
    var listMaMaus = ViewBag.listMaMaus;
    var listTPFLs = ViewBag.listTPFLs;
    var listSFLs = ViewBag.listSFLs;
    var listXuongs = ViewBag.listXuongs;
}
<style>
    #caTraDMFLRowSelected {
        display: none;
    }
</style>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Định Mức Fillet</h2>


                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                        var themdinhmucFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Định Mức" && x.Func == "Thêm Fillet / Định Mức" && x.Status == 1).FirstOrDefault();
                        if (themdinhmucFillet != null)
                        {
                            <button onclick="showInsert()" type="button" style="margin-right:5px" class="btn btn-primary">Thêm</button>
                        }
                            var suadinhmucFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Định Mức" && x.Func == "Sửa Fillet / Định Mức" && x.Status == 1).FirstOrDefault();
                            if (suadinhmucFillet != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoadinhmucFillet = rolePermistions.Where(x => x.Fu == "Danh Mục / Fillet / Định Mức" && x.Func == "Xoá Fillet / Định Mức" && x.Status == 1).FirstOrDefault();
                            if (xoadinhmucFillet != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


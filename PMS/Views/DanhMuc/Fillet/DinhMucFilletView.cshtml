<input type="hidden" id="sttDMFLRowSelected" />
<input type="hidden" id="ngayDMFLRowSelected" />
<input type="hidden" id="gioDMFLRowSelected" />
<input type="hidden" id="maloDMFLRowSelected" />
<input type="hidden" id="maloaicaDMFLRowSelected" />
<input type="hidden" id="mamauDMFLRowSelected" />
<input type="hidden" id="masizeDMFLRowSelected" />
<input type="hidden" id="mathanhphamDMFLRowSelected" />
<input type="hidden" id="maxuongDMFLRowSelected" />
<input type="checkbox" id="caTraDMFLRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/dinhmucFillet/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'STT', headerText: 'STT', width: 50 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150, type: 'date', format: 'dd-MM-yyyy'  },
                            { field: 'Gio', headerText: 'Giờ', width: 150},
                            { field: 'MaLo', headerText: 'Lô', width: 150 },
                            { field: 'LoaiCaName', headerText: 'Loại Cá', width: 150 },
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'MauName', headerText: 'Màu', width: 150 },
                            { field: 'SizeName', headerText: 'Size', width: 150 },
                            { field: 'CaTra', headerText: 'Cá Trả', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'DinhMuc', headerText: 'Định Mức', type: 'number', width: 150 },
                            { field: 'XuongName', headerText: 'Xưởng', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var stt = selectedRecord.STT;
        var ngay = selectedRecord.Ngay;
        var gio = selectedRecord.Gio;
        var malo = selectedRecord.MaLo;
        var maloaica = selectedRecord.MaLoaiCa;
        var mamau = selectedRecord.MaMau;
        var masize = selectedRecord.MaSize;
        var mathanhpham = selectedRecord.MaThanhPham;
        var maxuong = selectedRecord.MaXuong;
        var catra = selectedRecord.CaTra;
        $('#sttDMFLRowSelected').val(stt);
        $('#ngayDMFLRowSelected').val(ngay);
        $('#gioDMFLRowSelected').val(gio);
        $('#maloDMFLRowSelected').val(malo);
        $('#maloaicaDMFLRowSelected').val(maloaica);
        $('#mamauDMFLRowSelected').val(mamau);
        $('#masizeDMFLRowSelected').val(masize);
        $('#mathanhphamDMFLRowSelected').val(mathanhpham);
        $('#maxuongDMFLRowSelected').val(maxuong);
        $('#caTraDMFLRowSelected').prop('checked', catra);
    }
</script>
<script>
    function layGioTuDate(dateString) {
        // Khởi tạo một đối tượng Date từ chuỗi ngày
        var date = new Date(dateString);

        // Lấy giờ, phút và giây từ đối tượng Date
        var gio = date.getHours();
        var phut = date.getMinutes();
        var giay = date.getSeconds();

        // Định dạng lại chuỗi kết quả
        var gioPhutGiayString = pad(gio, 2) + ":" + pad(phut, 2) + ":" + pad(giay, 2);

        // Trả về chuỗi kết quả
        return gioPhutGiayString;
    }
    // Hàm pad để thêm số 0 vào trước nếu cần
    function pad(number, length) {
        var str = '' + number;
        while (str.length < length) {
            str = '0' + str;
        }
        return str;
    }
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/dinhmucFillet/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#sttDMFL').val(rs.STT);
                    $('#gioDMFL').val(layGioTuDate(rs.Gio));
                    $('#dinhMucDMFL').val(rs.DinhMuc);
                    $('#caTraDMFL').prop('checked', rs.CaTra);
                    $('#suDungDMFL').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var stt = $('#sttDMFL').val();
        var gio = $('#gioDMFL').val();
        var maLo = $('#maLoDMFL').val();
        var maLoaiCa = $('#maLoaiCaDMFL').val();
        var maMau = $('#maMauDMFL').val();
        var masize = $('#maSizeDMFL').val();
        var maThanhPham = $('#maThanhPhamDMFL').val();
        var caTra = $('#caTraDMFL').prop('checked');
        var dinhMuc = $('#dinhMucDMFL').val();
        var maXuong = $('#maXuongDMFL').val();
        var suDung = $('#suDungDMFL').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/DinhMucFillet/DoInsert',
            data: {
                stt: stt,
                gio: gio,
                maLo: maLo,
                maLoaiCa: maLoaiCa,
                maMau: maMau,
                masize: masize,
                maThanhPham: maThanhPham,
                maXuong: maXuong,
                caTra: caTra,
                dinhMuc: dinhMuc,
                suDung: suDung,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var stt = $('#sttDMFLRowSelected').val();
        var ngay = $('#ngayDMFLRowSelected').val();
        var gio = $('#gioDMFLRowSelected').val();
        var malo = $('#maloDMFLRowSelected').val();
        var maloaica = $('#maloaicaDMFLRowSelected').val();
        var mamau = $('#mamauDMFLRowSelected').val();
        var masize = $('#masizeDMFLRowSelected').val();
        var mathanhpham = $('#mathanhphamDMFLRowSelected').val();
        var maxuong = $('#maxuongDMFLRowSelected').val();
        var catra = $('#caTraDMFLRowSelected').prop('checked');
        
        $.ajax({
            url: "/DinhMucFillet/GetsByMa",
            data: { 
                stt: stt,
                ngay: ngay,
                gio: gio,
                malo: malo,
                maloaica: maloaica,
                mamau: mamau,
                masize: masize,
                mathanhpham: mathanhpham,
                maxuong: maxuong,
                catra: catra
            },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#sttDMFLSua').val(rs.STT);
                    $('#gioDMFLSua').val(rs.Gio);
                    $('#maLoDMFLSua').val(rs.MaLo);
                    $('#maLoaiCaDMFLSua').val(rs.MaLoaiCa);
                    $('#maMauDMFLSua').val(rs.MaMau);
                    $('#maSizeDMFLSua').val(rs.MaSize);
                    $('#maThanhPhamDMFLSua').val(rs.MaThanhPham);
                    $('#caTraDMFLSua').prop('checked', rs.CaTra);
                    $('#dinhMucDMFLSua').val(rs.DinhMuc);
                    $('#maXuongDMFLSua').val(rs.MaXuong);
                    $('#suDungDMFLSua').prop('checked', rs.SuDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var stt = $('#sttDMFLSua').val();
        var ngay = $('#ngayDMFLRowSelected').val();
        var gio = $('#gioDMFLSua').val();
        var maLo = $('#maLoDMFLSua').val();
        var maLoaiCa = $('#maLoaiCaDMFLSua').val();
        var maMau = $('#maMauDMFLSua').val();
        var masize = $('#maSizeDMFLSua').val();
        var maThanhPham = $('#maThanhPhamDMFLSua').val();
        var caTra = $('#caTraDMFLSua').prop('checked');
        var dinhMuc = $('#dinhMucDMFLSua').val();
        var maXuong = $('#maXuongDMFLSua').val();
        var suDung = $('#suDungDMFLSua').prop('checked');
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/DinhMucFillet/DoUpdate',
            data: {
                stt: stt,
                ngay:ngay,
                gio: gio,
                maLo: maLo,
                maLoaiCa: maLoaiCa,
                maMau: maMau,
                masize: masize,
                maThanhPham: maThanhPham,
                maXuong: maXuong,
                caTra: caTra,
                dinhMuc: dinhMuc,
                suDung: suDung,
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>

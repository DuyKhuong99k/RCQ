                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maThanhPhamDMFL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Thành Phẩm</option>
                                        @foreach (var item in listTPFLs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="caTraDMFL" />
                                        Cá Trả
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Định Mức</label>
                                    <input type="number" min="0" step="0.0001" id="dinhMucDMFL" class="form-control form-control-lg" autocomplete="off" placeholder="0.0000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Xưởng</label>
                                    <select id="maXuongDMFL" class="form-control form-control-lg">
                                        <option disabled selected>Chọn Xưởng</option>
                                        @foreach (var item in listXuongs)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="suDungDMFL" />
                                        Sử Dụng
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

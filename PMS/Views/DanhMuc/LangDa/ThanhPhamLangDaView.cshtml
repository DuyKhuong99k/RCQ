    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Thành Phẩm Lạng Da</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Mã</label>
                                    <input type="text" id="maTPLDSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Mã..." style="text-transform: uppercase;"  disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Tên</label>
                                    <input type="text" id="tenTPLDSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Tên..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng Min</label>
                                    <input type="number" min="0" step="0.001" id="minTPLDSua" class="form-control form-control-lg" autocomplete="off" placeholder="0,000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label">Trọng Lượng Max</label>
                                    <input type="number" min="0" step="0.001" id="maxTPLDSua" class="form-control form-control-lg" autocomplete="off" placeholder="0,000" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">BravoId</label>
                                    <input type="text" id="bravoIdTPLDSua" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập BravoId..." />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-12">
                            <div class="list-group form-outline">
                                <label class="">
                                    <input class="form-check-input me-1" type="checkbox" value="" id="suDungTPLDSua" />

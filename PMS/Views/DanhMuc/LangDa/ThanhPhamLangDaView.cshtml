                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4 pt-2">
                        <div class="col-12">
                            <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                <div class=" align-items-center">
                                    <span id="txtSua">Sửa</span>
                                    <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                        <span class="visually-hidden">Đang tải...</span>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="maTPLDRowSelected" />
<script>
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/ThanhPhamLangDa/GetAlls',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'Min', headerText: 'TL Min', type: 'number', width: 150 },
                            { field: 'Max', headerText: 'TL Max', type: 'number', width: 150 },
                            { field: 'BravoId', headerText: 'BravoId', width: 150 },
                            { field: '_type', headerText: 'Type', type: 'number', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;

        $('#maTPLDRowSelected').val(Ma);
    }
</script>
<script>
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/ThanhPhamLangDa/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPLD').val(rs.Ma);
                    $('#tenTPLD').val(rs.Ten);
                    $('#minTPLD').val(rs.Min);
                    $('#maxTPLD').val(rs.Max);
                    $('#bravoIdTPLD').val(rs.BravoId);
                    $('#suDungTPLD').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maTPLD').val();
        var ten = $('#tenTPLD').val();
        var min = $('#minTPLD').val();
        var max = $('#maxTPLD').val();
        var bravoId = $('#bravoIdTPLD').val();
        var suDung = $('#suDungTPLD').prop('checked');
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/ThanhPhamLangDa/DoInsert',
            data: {
                ma: ma,
                ten: ten,
                min: min,
                max: max,
                bravoId: bravoId,
                suDung: suDung
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var ma = $('#maTPLDRowSelected').val();
        $.ajax({
            url: "/ThanhPhamLangDa/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maTPLDSua').val(rs.Ma);
                    $('#tenTPLDSua').val(rs.Ten);
                    $('#minTPLDSua').val(rs.Min);
                    $('#maxTPLDSua').val(rs.Max);
                    $('#bravoIdTPLDSua').val(rs.BravoId);
                    $('#suDungTPLDSua').prop('checked', rs.SuDung);
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var ma = $('#maTPLDSua').val();
        var ten = $('#tenTPLDSua').val();
        var min = $('#minTPLDSua').val();
        var max = $('#maxTPLDSua').val();
        var bravoId = $('#bravoIdTPLDSua').val();
        var suDung = $('#suDungTPLD').prop('checked');
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/ThanhPhamLangDa/DoUpdate',
            data: {
                ma: ma,
                ten: ten,
                min: min,
                max: max,
                bravoId: bravoId,
                suDung: suDung
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var ma = $('#maTPLDRowSelected').val();
        $.ajax({
            url: "/ThanhPhamLangDa/GetsByMa",
            data: { ma: ma },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/ThanhPhamLangDa/DoDelete',
                                    data: { ma: ma },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>

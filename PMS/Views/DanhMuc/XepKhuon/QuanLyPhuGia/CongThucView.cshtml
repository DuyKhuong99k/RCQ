@{
    ViewData["Title"] = "CongThucView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var listSanPhams = ViewBag.listSanPhams;
    var listDonViTinhs = ViewBag.listDonViTinhs;
    var userId = @Context.Session.GetString("Id");
}
<style>
    div.col-sm-9.dateCTQLPG, span.e-input-group.e-control-wrapper.e-date-wrapper.e-valid-input {
        width: 36%;
    }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Công Thức</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <h6>Công Thức</h6>
                            <div id="Grid"></div>
                            <div style="margin-top:5px">
                                <button onclick="showInsert()" style="margin-right:5px" class="btn btn-outline-primary"><i class='bx bx-plus'></i>Thêm</button>
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xóa</button>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="row">
                                <div class="col-sm-4">
                                    <h6>Công Thức Chi Tiết</h6>
                                </div>
                                <div class="col-sm-8">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <label for="dateCTCTQLPG" class="form-label">Chọn ngày:</label>
                                        </div>
                                        <div class="col-sm-8">
                                            <input type="date" id="dateCTCTQLPG" class="form-control form-control-sm" style="width: 100%;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="GridCongThucChiTiet"></div>
                            <div style="margin-top:5px">
                                <button onclick="showInsertCTCT()" style="margin-right:5px" class="btn btn-outline-primary"><i class='bx bx-plus'></i>Thêm</button>
                                <button onclick="showUpdateCTCT()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                                <button onclick="showDeleteCTCT()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xóa</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">

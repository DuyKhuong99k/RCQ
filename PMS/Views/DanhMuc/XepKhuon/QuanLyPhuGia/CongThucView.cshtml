<script>
    // Lấy ngày hiện tại
    var today = new Date();

    // Định dạng ngày thành yyyy-MM-dd (định dạng của trường input date)
    var formattedDate = today.toISOString().substr(0, 10);

    // Gán giá trị vào trường input
    document.getElementById("dateCTCTQLPG").value = formattedDate;
</script>
<script>
    $(document).ready(function () {
        loadGridData();
        loadGridDataCongThucChiTiet();
    });
    var grid;
    function loadGridData() {
        $.ajax({
            url: '/CongThuc/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Ma', headerText: 'Mã', width: 150 },
                            { field: 'Ten', headerText: 'Tên', width: 150 },
                            { field: 'TrongLuongNguyenLieu', headerText: 'Trọng Lượng Nguyên Liệu', type: 'number', width: 150 },
                            { field: 'DonViTinhName', headerText: 'Đơn Vị Tính', width: 150 },
                            { field: 'GhiChu', headerText: 'Ghi Chú', width: 150 },
                            { field: 'SuDung', headerText: 'Sử Dụng', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Ma = selectedRecord.Ma;

        $('#maCTQLPGRowSelected').val(Ma);

        loadGridDataCongThucChiTiet();
    }


    var gridCongThucChiTiet;
    function loadGridDataCongThucChiTiet() {
        var maCongThuc = $('#maCTQLPGRowSelected').val();
        var ngay = $('#dateCTCTQLPG').val();
        $.ajax({
            url: '/CongThuc/GetAllsFullFieldCongThucChiTiet',
            type: 'GET',
            data: {
                maCongThuc: maCongThuc,
                ngay: ngay,
            },
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (gridCongThucChiTiet) {
                    gridCongThucChiTiet.dataSource = dataManager;
                    gridCongThucChiTiet.refresh();
                } else {
                    gridCongThucChiTiet = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50 },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelectedCongThucChiTiet,
                        height: 400,
                        columns: [
                            { field: 'STT', headerText: 'STT', width: 150 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150 },
                            { field: 'SanPhamName', headerText: 'Sản Phẩm', width: 150 },
                            { field: 'SanLuong', headerText: 'Sản Lượng', type: 'number', width: 150 },
                            { field: 'TyLe', headerText: 'Tỷ Lệ', type: 'number', width: 150 },
                            { field: 'BienDo', headerText: 'Biên Độ', type: 'number', width: 150 },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    gridCongThucChiTiet.appendTo('#GridCongThucChiTiet');
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    function reloadDataCongThucChiTiet() {
        loadGridDataCongThucChiTiet();
    }
    function onRowSelectedCongThucChiTiet(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var STT = selectedRecord.STT;
        var Ngay = selectedRecord.Ngay;
        var MaCongThuc = selectedRecord.MaCongThuc;
        $('#sttCTCTQLPGRowSelected').val(STT);
        $('#maCongThucCTCTQLPGRowSelected').val(MaCongThuc);
        // Chuyển đổi thành chuỗi "yyyy-mm-dd"
        var ngayFormatted = Ngay.substring(0, 10);
        $('#ngayCTCTQLPGRowSelected').val(ngayFormatted);
       
    }

    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/CongThuc/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maCTQLPG').val(rs.Ma);
                    $('#trongLuongNLCTQLPG').val(rs.TrongLuongNguyenLieu);
                    $('#suDungCTQLPG').prop('checked', rs.SuDung);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var ma = $('#maCTQLPG').val();
        var ten = $('#tenCTQLPG').val();

    function initializeComboBoxCoi(data) {
        var comboBoxObject = new ej.dropdowns.ComboBox({
            dataSource: data,
            fields: { value: 'Ma', text: 'Ten', tooltip: 'TrongLuongMax' },
            placeholder: "Chọn Cối",
            sortOrder: 'Ascending',
            headerTemplate: "<span class='head'><span class='ma'>Mã</span><span class='ten'>Tên</span><span class='ghichu'>Trọng Lượng Max</span><span class='ghichu'>Tam</span></span>",
            itemTemplate: "<span class='item' ><span class='ma'>${Ma}</span><span class='ten'>${Ten}</span><span class='ghichu'>${TrongLuongMax}</span><span class='ghichu'>${Tam}</span></span>"
        });

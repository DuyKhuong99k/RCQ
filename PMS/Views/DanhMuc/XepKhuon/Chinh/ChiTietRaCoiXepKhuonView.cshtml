    var grid;
    function loadGridData() {
        $.ajax({
            url: '/ChiTietRaCoiXepKhuon/GetAllsFullField',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        rowSelected: onRowSelected,
                        height: 400,
                        columns: [
                            { field: 'Id', headerText: 'Id', width: 150 },
                            { field: 'Ngay', headerText: 'Ngày', width: 150 , type: 'date', format: 'dd-MM-yyyy' },
                            { field: 'Gio', headerText: 'Giờ', width: 150 },
                            { field: 'CoiName', headerText: 'Cối', width: 150 },
                            { field: 'Luot', headerText: 'Lượt', type: 'number', width: 150 },
                            { field: 'IsDone', headerText: 'Hoàn Thành', width: 100, displayAsCheckBox: 'true', textAlign: 'Center' },
                            { field: 'NgayNguyenLieu', headerText: 'Ngày Nguyên Liệu', width: 150 , type: 'date', format: 'dd-MM-yyyy'  },
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
             if (args.item.id === 'Grid_excelexport') {
                grid.excelExport();
             }};
                }
            },
            error: function (error) {
                console.error(error);
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Id = selectedRecord.Id;

        $('#idCTRCXKRowSelected').val(Id);
    }
</script>
<script>
    var now = new Date();
    // Format lại thời gian thành YYYY-MM-DD (đúng định dạng cho input date)
    var ngayHienTai = now.getFullYear() + '-' +
        ('0' + (now.getMonth() + 1)).slice(-2) + '-' +
        ('0' + now.getDate()).slice(-2);
    var gioPhutHienTai = ('0' + now.getHours()).slice(-2) + ':' +
        ('0' + now.getMinutes()).slice(-2);
    function showInsert() {
        $.ajax({
            type: "GET",
            url: "/ChiTietRaCoiXepKhuon/CreatDefautNew",
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#idCTRCXK').val(rs.Id);
                    $('#ngayCTRCXK').val(ngayHienTai);
                    $('#gioCTRCXK').val(gioPhutHienTai);
                    $('#isDoneCTRCXK').prop('checked', rs.IsDone);
                    $('#modalThem').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function () {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function insert() {
        var id = $('#idCTRCXK').val();
        var ngay = $('#ngayCTRCXK').val();
        var gio = $('#gioCTRCXK').val();
        var maCoi = $('#maCoiHidden').val();
        var luot = $('#luotCTRCXK').val();
        var isDone = $('#isDoneCTRCXK').prop('checked');
        var ngayNguyenLieu = $('#ngayNguyenLieuCTRCXK').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/ChiTietRaCoiXepKhuon/DoInsert',
            data: {
                id: id,
                ngay: ngay,
                gio: gio,
                maCoi: maCoi,
                luot: luot,
                isDone: isDone,
                ngayNguyenLieu: ngayNguyenLieu,
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>

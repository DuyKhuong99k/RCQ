        $.ajax({
            type: "GET",
            url: "/CoiChinhXepKhuon/GetAlls",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // Khởi tạo ComboBox khi dữ liệu được tải
                initializeComboBoxCoi(response);
                //createOrUpdateComboBox(response);
                createComboBox(response);
                localData = response;

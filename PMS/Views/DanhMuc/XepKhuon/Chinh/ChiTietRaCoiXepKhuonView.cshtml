                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Id</label>
                                    <input type="number" id="idCTRCXK" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Id..." style="text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày</label>
                                    <input type="date" id="ngayCTRCXK" class="form-control form-control-lg" autocomplete="off" placeholder="Chọn ngày..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Giờ</label>
                                    <input type="time" id="gioCTRCXK" class="form-control form-control-lg" autocomplete="off" placeholder="Chọn giờ..." />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Cối</label>
                                    @* <ejs-combobox id="maCoiCTRCXK" open="isCheckScroll" dataBound="isCheckScroll" dataSource="@listCois" cssClass="e-multi-column" filtering="onfiltering" allowFiltering="true" placeholder="Chọn Cối" popupHeight="400px"
                                    headerTemplate="@Html.Raw("<table style='width:100%'><tr><th class='e-text-center' style='width: 25%;'>Mã</th><th style='width: 25%;'>Tên</th><th style='width: 35%;'>Trọng Lượng Max</th><th class='e-text-center' style='width: 15%;'>Tạm</th></tr></table>")"
                                    itemTemplate="@Html.Raw("<table style='width:100%'><tbody><tr><td class='e-text-center' style='width: 25%;'>${Ma}</td><td style='width: 25%;'>${Ten}</td><td style='width: 35%;'>${TrongLuongMax}</td><td class='e-text-center' style='width: 15%;'>${Tam}</td></tr></tbody></table>")">
                                    <e-combobox-fields text="Ten" value="Ma"></e-combobox-fields>
                                    </ejs-combobox> *@
                                    <input type="text" id="maCoiCTRCXK" class="form-control form-control-lg">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Lượt</label>
                                    <input type="number" id="luotCTRCXK" class="form-control form-control-lg" autocomplete="off" placeholder="Nhập Lượt..." style="text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-12">
                                <div class="list-group form-outline">
                                    <label class="">
                                        <input class="form-check-input me-1" type="checkbox" value="" id="isDoneCTRCXK" />
                                        Hoàn Thành
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Nguyên Liệu</label>
                                    <input type="date" id="ngayNguyenLieuCTRCXK" class="form-control form-control-lg" autocomplete="off" placeholder="Chọn ngày..." />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

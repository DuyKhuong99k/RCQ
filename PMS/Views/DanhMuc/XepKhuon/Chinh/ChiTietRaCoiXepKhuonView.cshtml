@using Newtonsoft.Json

@{
    ViewData["Title"] = "ChiTietRaCoiXepKhuonView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listCois = ViewBag.listCois;
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
}
<style>

    /* CSS cho headerTemplate */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #f0f0f0; /* Màu nền header */
        padding: 5px 10px; /* Khoảng cách bên trong header */
        font-weight: bold;
        border-bottom: 1px solid #ccc; /* Viền dưới header */
    }

        .head .ma, .head .ten, .head .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }

    /* CSS cho itemTemplate */
    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 10px; /* Khoảng cách bên trong mỗi item */
        border-bottom: 1px solid #eee; /* Viền dưới mỗi item */
    }

        .item .ma, .item .ten, .item .ghichu {
            flex: 1;
            text-align: center; /* Căn giữa nội dung của các cột */
        }
</style>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Danh Sách Chi Tiết Ra Cối  Xếp Khuôn</h2>
                    @{
                        
                    }

                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themChiTietRaCoiXepKhuon = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Chi Tiết Ra Cối" && x.Func == "Thêm Xếp Khuôn / Chi Tiết Ra Cối" && x.Status == 1).FirstOrDefault();
                            if (themChiTietRaCoiXepKhuon != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaChiTietRaCoiXepKhuon = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Chi Tiết Ra Cối" && x.Func == "Sửa Xếp Khuôn / Chi Tiết Ra Cối" && x.Status == 1).FirstOrDefault();
                            if (suaChiTietRaCoiXepKhuon != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaChiTietRaCoiXepKhuon = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Chi Tiết Ra Cối" && x.Func == "Xóa Xếp Khuôn / Chi Tiết Ra Cối" && x.Status == 1).FirstOrDefault();
                            if (xoaChiTietRaCoiXepKhuon != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                            var importChiTietRaCoiXepKhuon = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Chi Tiết Ra Cối" && x.Func == "Import Xếp Khuôn / Chi Tiết Ra Cối" && x.Status == 1).FirstOrDefault();
                            if (importChiTietRaCoiXepKhuon != null)
                            {
                                <button onclick="import()" style="margin-right:5px" class="btn btn-outline-info"><i class='bx bx-import'></i>Import</button>
                            }
                            var exportChiTietRaCoiXepKhuon = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Chi Tiết Ra Cối" && x.Func == "Export Xếp Khuôn / Chi Tiết Ra Cối" && x.Status == 1).FirstOrDefault();
                            if (exportChiTietRaCoiXepKhuon != null)
                            {
                                <button onclick="export()" style="margin-right:5px" class="btn btn-outline-secondary"><i class='bx bx-export'></i>Export Excel</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">

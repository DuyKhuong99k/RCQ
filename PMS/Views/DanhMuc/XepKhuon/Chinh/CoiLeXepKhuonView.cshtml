
@{
    ViewData["Title"] = "CoiLeXepKhuonView";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //lấy danh sách roleid từ cookie
    var roleIds = PMS.Middlewares.AuthenticationHelpers.GetRoleIdsFromCookie(Context);
    // lấy danh sách fu func từ list roleId
    var rolePermistions = await PMS.Middlewares.AuthenticationHelpers.GetRolePermistionsAsync(Context, roleIds);
    var Cois = ViewBag.Cois;
    var ThanhPhams = ViewBag.ThanhPhams;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Cối Lẻ Xếp Khuôn</h2>
                    <div class="d-flex align-items-center gap-2">
                        <input id="ngayChon" type="date" class="form-control form-control" style="width: auto; max-width: 200px;" />
                        <button onclick="reloadData()" class="btn btn-primary">Tải</button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="Grid"></div>
                    <div style="margin-top:20px;">
                        @{
                            var themTrongLuongCoiTheoSanPham = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Cối Lẻ" && x.Func == "Thêm Xếp Khuôn / Cối Lẻ" && x.Status == 1).FirstOrDefault();
                            if (themTrongLuongCoiTheoSanPham != null)
                            {
                                <button onclick="showInsert()" type="button" class="btn btn-primary">Thêm</button>
                            }
                            var suaTrongLuongCoiTheoSanPham = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Cối Lẻ" && x.Func == "Sửa Xếp Khuôn / Cối Lẻ" && x.Status == 1).FirstOrDefault();
                            if (suaTrongLuongCoiTheoSanPham != null)
                            {
                                <button onclick="showUpdate()" style="margin-right:5px" class="btn btn-outline-warning"><i class='bx bx-edit-alt'></i>Sửa</button>
                            }
                            var xoaTrongLuongCoiTheoSanPham = rolePermistions.Where(x => x.Fu == "Danh Mục / Xếp Khuôn / Cối Lẻ" && x.Func == "Xóa Xếp Khuôn / Cối Lẻ" && x.Status == 1).FirstOrDefault();
                            if (xoaTrongLuongCoiTheoSanPham != null)
                            {
                                <button onclick="showDelete()" style="margin-right:5px" class="btn btn-outline-danger"><i class='bx bx-trash'></i>Xoá</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalThem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Cối Lẻ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12">
                                <div class="form-outline">
                                    <label class="form-label">Cối</label>
                                    <select id="maCoiCLXK" class="form-control form-control-lg">
                                        <option value="">Chọn Cối</option>
                                        @foreach (var item in Cois)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maSanPhamCLXK" class="form-control form-control-lg">
                                        <option value="">Chọn Thành Phẩm</option>
                                        @foreach (var item in ThanhPhams)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12 mb-12">
                            <div class="form-outline">
                                <label class="form-label">Trọng Lượng</label>
                                <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongCLXK" placeholder="0.000" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Giờ</label>
                                    <input id='ngayGioCLXK' class="form-control form-control-lg" type="datetime-local" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Nguyên Liệu</label>
                                    <input id='ngayNguyenLieuCLXK' class="form-control form-control-lg" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="insert()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtThem">Thêm</span>
                                        <div id="loadingIndicator" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalSua" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa Size</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-12">
                                <div class="form-outline">
                                    <label class="form-label">Cối</label>
                                    <select id="maCoiCLXKSua" class="form-control form-control-lg">
                                        <option value="">Chọn Cối</option>
                                        @foreach (var item in Cois)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12">
                                <div class="form-outline">
                                    <label class="form-label">Thành Phẩm</label>
                                    <select id="maSanPhamCLXKSua" class="form-control form-control-lg">
                                        <option value="">Chọn Thành Phẩm</option>
                                        @foreach (var item in ThanhPhams)
                                        {
                                            <option value="@item.Ma">@item.Ten</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 mb-12">
                            <div class="form-outline">
                                <label class="form-label">Trọng Lượng</label>
                                <input type="number" min="0" step=".001" class="form-control form-control-lg" id="trongLuongCLXKSua" placeholder="0.000" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Giờ</label>
                                    <input id='ngayGioCLXKSua' class="form-control form-control-lg" type="datetime-local" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-12 ">
                                <div class="form-outline">
                                    <label class="form-label" for="x1">Ngày Nguyên Liệu</label>
                                    <input id='ngayNguyenLieuCLXKSua' class="form-control form-control-lg" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-2">
                            <div class="col-12">
                                <button onclick="update()" class="btn btn-primary w-100 position-relative" type="submit" id="">
                                    <div class=" align-items-center">
                                        <span id="txtSua">Sửa</span>
                                        <div id="loadingIndicatorSua" class=" spinner-border text-secondary position-absolute" role="status" style="left: 0;right: 0;top: 0;bottom: 0;margin: auto; display:none">
                                            <span class="visually-hidden">Đang tải...</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="idCLXKRowSelected" />
<script>
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('ngayChon').value = today;

    var now = new Date();

    var day = ("0" + now.getDate()).slice(-2);
    var month = ("0" + (now.getMonth() + 1)).slice(-2);
    var year = now.getFullYear();
    var hours = ("0" + now.getHours()).slice(-2);
    var minutes = ("0" + now.getMinutes()).slice(-2);
    var seconds = ("0" + now.getSeconds()).slice(-2);

    var todayWithTime = year + "-" + month + "-" + day + "T" + hours + ":" + minutes+ ":" + seconds;
    var todayNotTime = year + "-" + month + "-" + day;
    $('#ngayGioCLXK').val(todayWithTime);
    $('#ngayGioCLXKSua').val(todayWithTime);
    $('#ngayNguyenLieuCLXK').val(todayNotTime);
    $('#ngayNguyenLieuCLXKSua').val(todayNotTime);

    function chuyenDoiNgay(inputDate) {
        // Chuyển đổi kiểu dữ liệu của inputDate thành đối tượng Date
        var dateObject = new Date(inputDate);

        // Lấy ngày, tháng, năm từ đối tượng Date
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1; // Tháng bắt đầu từ 0
        var year = dateObject.getFullYear();

        // Định dạng lại ngày, tháng, năm theo định dạng yyyy-MM-dd
        var formattedDate = year + "-" + (month < 10 ? '0' : '') + month + "-" + (day < 10 ? '0' : '') + day;

        // Trả về ngày đã định dạng
        return formattedDate;
    }
    $(document).ready(function () {
        loadGridData();
    });
    var grid;
    function loadGridData() {
        var dateTime = $('#ngayChon').val();
        $.ajax({
            url: '/CoiLeXepKhuon/GetAllsFullField',
            data: {
                dateTime: dateTime
            },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var dataManager = new ej.data.DataManager({
                    json: data,
                    adaptor: new ej.data.JsonAdaptor()
                });
                if (grid) {
                    grid.dataSource = dataManager;
                    grid.refresh();
                } else {
                    grid = new ej.grids.Grid({
                        dataSource: dataManager,
                        allowPaging: true,
                        pageSettings: { pageSize: 50, pageSizes: [50, 100, 200, 500] },
                        allowFiltering: true,
                        filterSettings: { type: 'Excel' },
                        allowSorting: true,
                        //frozenColumns: 3,
                        allowResizing: true,
                        rowSelected: onRowSelected,
                        allowExcelExport: true,
                        toolbar: ['ExcelExport'],
                        height: 400,
                        columns: [
                            { field: 'CoiName', headerText: 'Cối', width: 150 },
                            { field: 'ThanhPhamName', headerText: 'Thành Phẩm', width: 150 },
                            { field: 'TrongLuong', headerText: 'Trọng Lượng',width: 150 },
                            { field: 'NgayGio', headerText: 'Ngày Giờ', width: 150 , type: 'date', format: 'dd-MM-yyyy hh:mm:ss'},
                            { field: 'NgayNguyenLieu', headerText: 'Ngày Nguyên Liệu', width: 150 , type: 'date', format: 'dd-MM-yyyy'},
                        ]
                    });
                    // Hiển thị Grid trên trang web
                    grid.appendTo('#Grid');
                    grid.toolbarClick = function (args) {
                        if (args.item.id === 'Grid_excelexport') {
                            grid.excelExport();
                        }
                    };
                }
            }
        });
    }
    loadGridData();
    function reloadData() {
        loadGridData();
        loadGridData();
    }
    function onRowSelected(args) {
        // Lấy dữ liệu của hàng được chọn
        var selectedRecord = args.data;
        // Lấy giá trị Id từ dữ liệu của hàng được chọn
        var Id = selectedRecord.Id;

        $('#idCLXKRowSelected').val(Id);
    }

    

</script>
<script>
    function showInsert() {
        $('#modalThem').modal('show');
    }
    function insert() {
        var maCoi = $('#maCoiCLXK').val();
        var maSanPham = $('#maSanPhamCLXK').val();
        var trongLuong = $('#trongLuongCLXK').val();
        var ngayGio = $('#ngayGioCLXK').val();
        var ngayNguyenLieu = $('#ngayNguyenLieuCLXK').val();
        document.getElementById("txtThem").style.visibility = "hidden";
        document.getElementById("loadingIndicator").style.display = "block";
        $.ajax({
            type: 'POST',
            url: '/CoiLeXepKhuon/DoInsert',
            data: {
                maCoi: maCoi,
                maSanPham: maSanPham,
                trongLuong: trongLuong,
                ngayGio:ngayGio, ngayNguyenLieu : ngayNguyenLieu
            },
            success: function (rs) {
                if (rs.isSuccess === true) {
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                    $('#modalThem').modal('hide');
                    reloadData();
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicator").style.display = "none";
                document.getElementById("txtThem").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showUpdate() {
        var id = $('#idCLXKRowSelected').val();
        $.ajax({
            url: "/CoiLeXepKhuon/GetsByMa",
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#maCoiCLXKSua').val(rs.MaCoi);
                    $('#maSanPhamCLXKSua').val(rs.MaSanPham);
                    $('#trongLuongCLXKSua').val(rs.TrongLuong);
                    $('#ngayGioCLXKSua').val(rs.NgayGio);
                    $('#ngayNguyenLieuCLXKSua').val(chuyenDoiNgay(rs.NgayNguyenLieu));
                    $('#modalSua').modal('show');
                }
                else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Mesages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error, "Thông báo");
            }
        });
    }
    function update() {
        var id = $('#idCLXKRowSelected').val();
        var maCoi = $('#maCoiCLXKSua').val();
        var maSanPham = $('#maSanPhamCLXKSua').val();
        var trongLuong = $('#trongLuongCLXKSua').val();
        var ngayGio = $('#ngayGioCLXKSua').val();
        var ngayNguyenLieu = $('#ngayNguyenLieuCLXKSua').val();
        document.getElementById("txtSua").style.visibility = "hidden";
        document.getElementById("loadingIndicatorSua").style.display = "block";
        $.ajax({
            url: '/CoiLeXepKhuon/DoUpdate',
            data: {
                id: id,
                maCoi: maCoi,
                maSanPham:maSanPham,
                trongLuong: trongLuong,
                ngayGio:ngayGio, ngayNguyenLieu: ngayNguyenLieu
            },
            type: 'POST',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    $('#modalSua').modal('hide');
                    reloadData();
                    toastOptionNotyfi();
                    toastr["success"](rs.Messages, "Thông báo");
                } else {
                    toastOptionNotyfi();
                    toastr["warning"](rs.Messages, "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            },
            complete: function () {
                document.getElementById("loadingIndicatorSua").style.display = "none";
                document.getElementById("txtSua").style.visibility = "visible";
            }
        });
    }
</script>
<script>
    function showDelete() {
        var id = $('#idCLXKRowSelected').val();
        $.ajax({
            url: "/CoiLeXepKhuon/GetsByMa",
            data: { id: id },
            type: 'GET',
            dataType: 'json',
            success: function (rs) {
                if (rs.isSuccess === true) {
                    bootbox.confirm({
                        title: "Thông báo!",
                        message: "Bạn có chắc muốn xoá : " + rs.Ten,
                        buttons: {
                            confirm: {
                                label: 'OK',
                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            if (result) {
                                //Người dùng đã bấm OK, Gọi API xóa ở đây
                                $.ajax({
                                    url: '/CoiLeXepKhuon/DoDelete',
                                    data: { id: id },
                                    type: 'POST',
                                    dataType: 'json',
                                    success: function (rs) {
                                        if (rs.isSuccess === true) {
                                            reloadData();
                                            toastOptionNotyfi();
                                            toastr["success"](rs.Messages, "Thông báo");
                                        } else {
                                            toastOptionNotyfi();
                                            toastr["warning"](rs.Messages, "Thông báo");
                                        }
                                    },
                                    error: function (error) {
                                        toastOptionNotyfi();
                                        toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
                                    }
                                });
                            }
                        }
                    });
                } else {
                    toastOptionNotyfi();
                    toastr["warning"]('Không tìm thấy thông tin!', "Thông báo");
                }
            },
            error: function (error) {
                toastOptionNotyfi();
                toastr["error"]('Đã xảy ra lỗi: ' + error.toString(), "Thông báo");
            }
        });

    }
</script>


@code {
    private bool IsActive(string pathSegment)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return currentPath.StartsWith(pathSegment, StringComparison.OrdinalIgnoreCase);
    }
}
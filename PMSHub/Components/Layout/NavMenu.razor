@using Vars
@using ViewModels.Repos.Hubs.IServices

@inject NavigationManager Navigation
@inject IMainService MainService
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme" data-bg-class="bg-menu-theme" >


    <div class="app-brand demo">
        <a href="/" class="app-brand-link">
            <span class="app-brand-logo demo">
                @if (AppViewModels.AppViewModel.Instance.Company == "PhanBach")
                {
                    <img style="width:180px" src="Imgs/PhanBachLogo.png" />
                }
                else
                {
                    <img style="width:120px" src="Imgs/PMSLogo.png" />
                }
                
            </span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none ">
          
            <i class="bx bx-chevron-left bx-sm align-middle"></i>
        </a>
    </div>


    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        <li class="menu-item @(IsActive("home") ? "active" : "")">
            <NavLink href="Home" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home-circle"></i>
                <div data-i18n="Analytics">Trang Chủ</div>
            </NavLink>
        </li>
        @* <li class="menu-item @(IsActive("TheRo") ? "active" : "")"> *@
        @*     <NavLink href="TheRo" class="menu-link"> *@
        @*         <i class="menu-icon tf-icons bx bx-card"></i> *@
        @*         <div data-i18n="Analytics">Thẻ Rổ</div> *@
        @*     </NavLink> *@
        @* </li> *@
        @if (MainService.VmApp.ComName?.ToUpper() == nameof(ComNames.RCQTG) || MainService.VmApp.ComName?.ToUpper() == nameof(ComNames.NV))
        {
            <li class="menu-item @(IsActive("devices") ? "active" : "")">
                <NavLink href="devices" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-devices"></i>
                    <div data-i18n="Analytics">Thiết Bị</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheNhanVien") ? "active" : "")">
                <NavLink href="TheNhanVien" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-id-card"></i>
                    <div data-i18n="Analytics">Thẻ Nhân Viên</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheChucNang") ? "active" : "")">
                <NavLink href="TheChucNang" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-card"></i>
                    <div data-i18n="Analytics">Thẻ Chức Năng</div>
                </NavLink>
            </li>
        }
        else if (MainService.VmApp.ComName?.ToUpper() == nameof(ComNames.HL))
        {
            <li class="menu-item @(IsActive("devices") ? "active" : "")">
                <NavLink href="devices" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-devices"></i>
                    <div data-i18n="Analytics">Thiết Bị</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheNhanVien") ? "active" : "")">
                <NavLink href="TheNhanVien" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-id-card"></i>
                    <div data-i18n="Analytics">Thẻ Nhân Viên</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheChucNang") ? "active" : "")">
                <NavLink href="TheChucNang" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-card"></i>
                    <div data-i18n="Analytics">Thẻ Chức Năng</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheRo") ? "active" : "")">
                <NavLink href="TheRo" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-card"></i>
                    <div data-i18n="Analytics">Thẻ Rổ</div>
                </NavLink>
            </li>
        }
        else if (MainService.VmApp.ComName?.ToUpper() != "")
        {
            <li class="menu-item @(IsActive("devices") ? "active" : "")">
                <NavLink href="devices" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-devices"></i>
                    <div data-i18n="Analytics">Thiết Bị</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("coi-view") ? "active" : "")">
                <NavLink href="coi-view" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-analyse"></i>
                    <div data-i18n="Analytics">Cối</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("coi-tam-view") ? "active" : "")">
                <NavLink href="coi-tam-view" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-layer-plus"></i>
                    <div data-i18n="Analytics">Cối Tạm</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("datmauthefillet") ? "active" : "")">
                <NavLink href="datmauthefillet" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-color-fill"></i>
                    <div data-i18n="Analytics">Đặt Màu Thẻ-Fillet</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("datmauthedinhhinh") ? "active" : "")">
                <NavLink href="datmauthedinhhinh" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-color-fill"></i>
                    <div data-i18n="Analytics">Đặt Màu Thẻ-Định Hình</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("datmauthephuxepkhuon") ? "active" : "")">
                <NavLink href="datmauthephuxepkhuon" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-color-fill"></i>
                    <div data-i18n="Analytics">Đặt Màu Thẻ-Phụ Xếp Khuôn</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("DatNhanVienCongCuXepKhuon") ? "active" : "")">
                <NavLink href="DatNhanVienCongCuXepKhuon" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-street-view"></i>
                    <div data-i18n="Analytics">Đặt Nhân Viên Công Cụ Xếp Khuôn</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheNhanVien") ? "active" : "")">
                <NavLink href="TheNhanVien" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-id-card"></i>
                    <div data-i18n="Analytics">Thẻ Nhân Viên</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheChucNang") ? "active" : "")">
                <NavLink href="TheChucNang" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-card"></i>
                    <div data-i18n="Analytics">Thẻ Chức Năng</div>
                </NavLink>
            </li>
            <li class="menu-item @(IsActive("TheRo") ? "active" : "")">
                <NavLink href="TheRo" class="menu-link">
                    <i class="menu-icon tf-icons bx bx-card"></i>
                    <div data-i18n="Analytics">Thẻ Rổ</div>
                </NavLink>
            </li>
        }
    </ul>
</aside>

@code {
    private bool IsActive(string pathSegment)
    {
        var comname = MainService.VmApp.ComName;
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return currentPath.StartsWith(pathSegment, StringComparison.OrdinalIgnoreCase);
    }
}
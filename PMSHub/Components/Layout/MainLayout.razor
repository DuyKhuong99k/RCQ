@using Blazored.LocalStorage
@using ViewModels.Repos.Hubs.IServices
@inherits LayoutComponentBase
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject ILoginService loginService
@inject IHttpContextAccessor HttpContextAccessor
@using Syncfusion.Blazor.Buttons
@inject IJSRuntime JsRuntime
<style>
    /* Overlay toàn trang */
    #loading {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ffffff; /* nền trắng sạch */
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    z-index: 9999;
    transition: opacity 0.6s ease, visibility 0.6s ease;
    }

    #loading.hidden {
    opacity: 0;
    visibility: hidden;
    }

    /* Logo */
    #loading img {
    max-width: 220px;
    margin-bottom: 30px;
    }

    /* Progress bar */
    .progress-container {
    width: 250px;
    height: 6px;
    background: #e5e7eb; /* xám nhạt */
    border-radius: 4px;
    overflow: hidden;
    }

    .progress-bar {
    height: 100%;
    width: 0%;
    background: #ef4444; /* đỏ logo */
    transition: width 0.3s ease;
    }

    /* Nội dung chính ẩn khi chưa load */
    body:not(.loaded) main {
    visibility: hidden;
    }
</style> 
<!-- Layout wrapper -->
<div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">

        <!-- Menu -->
        <NavMenu/>
        <!-- / Menu -->
        <!-- Layout container -->
        <div class="layout-page">
            @*  <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar" style="margin-bottom:25px"> *@

    protected override Task OnInitializedAsync()
    {



        CoiService.ItemChanged -= CoiService_ItemChanged;
        CoiService.ItemChanged += CoiService_ItemChanged;
        MainService.AlertRequested -= MainService_AlertRequested;
        MainService.AlertRequested += MainService_AlertRequested;
        MessageService.AlertRequested -= MainService_AlertRequested;
        MessageService.AlertRequested += MainService_AlertRequested;
        //CoiViewService = new CoiViewService(CoiService, MessageService);
        CoiViewService.Load();
        buttonContent = expand;
        buttonRefs = new List<ButtonModel>();
        for (var i = 0; i < CoiViewService.Items.Count; i++)
        {
            var item = CoiViewService.Items[i];
            if (item.State == 1)
            {
                item.IsPowerOn = true;
            }

            if (item.State == 2)
            {
                item.IsPowerOn = true;
                item.IsPause = true;
            }

            if (item.State == 3)
            {
                item.IsPowerOn = true;
                item.IsPause = false;
                item.IsRunOut = true;
            }

            if (item.State == -1)
            {
                item.IsPowerOn = false;
                item.IsPause = false;
                item.IsRunOut = false;
            }

            if (item.State == 4)
            {
                item.IsPowerOn = false;
            }

            buttonRefs.Add(new ButtonModel
                {
                    Id = item.Id,
                    Content = buttonContent
                });
        }

        return base.OnInitializedAsync();
    }


    private async void VaoCoi(PLCChiTiet coi, bool isChuyenXuong = false)
    {
        if (datajsJson != "")
        {
            var result = await Handlers.ErrorHandler.HandleAsync(async () =>
            {
                var phieuCans = JsonSerializer.Deserialize<List<PhieuCanChinhXepKhuon>>(datajsJson);
                if (phieuCans != null && phieuCans.Count > 0)
                {
                    var coiMonitor = MainService.VmCoiMonitor.CreateDefaultNew();
                    coiMonitor.NgayNguyenLieu = ngayNguyenLieu;
                    coiMonitor.MaThe = theId;
                    coiMonitor.MaXuong = CoiViewService.XiNghiepSelectedItem?.Ma ?? "";
                    coiMonitor.MaCoi = coi.MaCoi;
                    coiMonitor.NgayGio = DateTime.Now;
                    if (coi.IdMonitor == null)
                    {
                        if (MainService.VmCoiMonitor.Insert(coiMonitor) > 0)
                        {
                            coi.IdMonitor = coiMonitor.Id;
                            MainService.VmCoiMonitor.Add(coiMonitor);
                        }
                        else
                        {
                            await JsRuntime.InvokeVoidAsync("alert", "Không thể tạo phiếu theo dõi!"); // Alert
                        }
                        //coi.IdMonitor = coiMonitor.Id;
                    }

                    foreach (var phieuCan in phieuCans)
                    {
                        phieuCan.MaCoiChinh = coi.MaCoi;
                        phieuCan.MaXuong = coi.MaXuong;
                        phieuCan.MaChatLuong = coi.MaChatLuong;
                        phieuCan.DaQuay = coi.IsPowerOn;
                        phieuCan.ThoiGianQuay = coi.ThoiGianQuay;
                        phieuCan.ChuyenXuong = isChuyenXuong;

                        phieuCan.IdMonitor = coiMonitor.Id;
                        if (coi.TimeRun != null)
                        {
                            phieuCan.NgayBatDauQuay = coi.TimeRun.Value.Date;
                            phieuCan.ThoiGianBatDauQuay = coi.TimeRun.Value.TimeOfDay;
                        }

                        if (coi.PCQuay != null)
                        {
                            phieuCan.MayQuay = coi.PCQuay;
                        }
                    }


                    var nRow = MainService.VmPhieuCanChinhXepKhuon.Update(phieuCans);
                    if (nRow > 0)
                    {
                        var coiTamInfos = phieuCans.Select(x => new Tuple<string, string>(x.MaCoiTam, x.MaMayCan)).Distinct().ToList();


                        foreach (var coiTamInfo in coiTamInfos)
                        {
                            var item = coi.CoiTamInfos.FirstOrDefault(x => x.Item1 == coiTamInfo.Item1 && x.Item2 == coiTamInfo.Item2);
                            if (item == null)
                            {
                                coi.CoiTamInfos.Add(coiTamInfo);
                            }
                        }

                        coi.TrongLuong += phieuCans.Sum(x => x.TrongLuong);
                    }

                    await MayCansService.CommandSendMessageByConnectionId(connectionId, datajsJson);
                    datajsJson = "";
                }
            });
            if (!result.IsSuccess)
            {
                Console.WriteLine(result.Error);
            }
        }
    }


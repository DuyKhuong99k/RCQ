    window.initializeJsInterop = (dotNetHelper) => {
        // Example JavaScript variable


        // Function to detect changes to the JavaScript variable
        function updateVariable(newValue) {

            // Notify Blazor about the change
            dotNetHelper.invokeMethodAsync('UpdateJsDataVariableValue', newValue);
        }

        function updateXuongId(xuongValue) {
            window.xuongIdScript = xuongValue;

            dotNetHelper.invokeMethodAsync('UpdateXuongIdFromJavaScript', null);
        }

        function updateConnectionId(connectionId) {
            dotNetHelper.invokeMethodAsync('UpdateConnectionId', connectionId);
        }

        function updatePCName(pcName) {
            dotNetHelper.invokeMethodAsync('UpdatePCName', pcName);
        }

        function updateNgayNguyenLieu(ngayNguyenLieu) {
            dotNetHelper.invokeMethodAsync('UpdateNgayNguyenLieu', ngayNguyenLieu);
        }

        // Make the updateVariable function available globally
        window.updateConnectionId = updateConnectionId;
        window.updateVariable = updateVariable;
        window.updateXuongId = updateXuongId;
        window.updatePCName = updatePCName;
        window.updateNgayNguyenLieu = updateNgayNguyenLieu;
    };


    // Initialize KioskBoard (default/all options)
    function addClassToElementInputPopupDropdownlist() {

        const element = document.querySelector('.e-input-filter.e-input.e-lib.e-keyboard');
        if (element) {
            element.classList.add('js-virtual-keyboard');
            element.blur();
        }
        const element2 = document.querySelector('.e-input-group.e-control-container.e-control-wrapper.e-input-focus');
        if (element2) {

            element2.blur();
        }

    }

    function removeKeyboard() {
        KioskBoard.removeKeyboardInternal();
    }


@page "/TheNhanVien"
@using Models.Repos.Models
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@using ViewModels.Repos.Hubs.IServices
@using EventArgs = EventArgs
@using FilteringEventArgs = Syncfusion.Blazor.DropDowns.FilteringEventArgs
@using FilterType = Syncfusion.Blazor.Grids.FilterType
@using SelectionMode = Syncfusion.Blazor.Grids.SelectionMode
@using SelectionType = Syncfusion.Blazor.Grids.SelectionType
@using PMSHub.Components.Layout
@rendermode InteractiveServer
@inherits AuthenticatedComponent
@attribute [StreamRendering]
@inject NavigationManager Navigation
@inject IMainService MainService
@inject IMayCansService MayCansService
@inject ICardService cardService
@inject IDeviceViewService DeviceViewService
@inject IJSRuntime JsRuntime
<link rel="stylesheet" href="styles/grid.css" />
<PageTitle>Thẻ Nhân Viên</PageTitle>
<!-- Navbar -->
<TopLayout />
<!-- / Navbar -->
<!-- Content wrapper -->
<div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">
        <h3>Thẻ Nhân Viên</h3>
        <SfGrid DataSource="MainService.VmThe.Items" Height="500" @ref="Grid" AllowSorting="true" AllowMultiSorting="true" TValue="TheTu" AllowFiltering="true" AllowPaging="true" AllowSelection="true">
            <GridPageSettings PageCount="10" PageSize="10" PageSizes="@(new[] { "5", "10", "15", "20", "100", "200", "500" })"></GridPageSettings>
            <GridTemplates>
                <ToolbarTemplate>
                    <SfToolbar>
                        <ToolbarEvents Clicked="ToolbarClickHandler"></ToolbarEvents>
                        <ToolbarItems>
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-refresh icon" Id="refresh" Text="Tải Lại"></ToolbarItem>
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-expand icon" Id="add" Text="Thêm"></ToolbarItem>
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-edit icon" Id="edit" Text="Sửa"></ToolbarItem>
                            @* <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-export-excel icon" Id="ExcelExport" Text="Xuất Excel"></ToolbarItem> *@
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-circle-remove icon" Id="delete" Text="Xóa"></ToolbarItem>
                        </ToolbarItems>
                    </SfToolbar>
                </ToolbarTemplate>
            </GridTemplates>
            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="@nameof(TheTu.NgayGio)" Direction="SortDirection.Descending"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>
            <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
            <GridSelectionSettings AllowDragSelection="true" Mode="SelectionMode.Row" Type="SelectionType.Multiple" EnableSimpleMultiRowSelection="true" CheckboxOnly="true" PersistSelection="true"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
                <GridColumn Field="@nameof(TheTu.MaTheTu)" HeaderText="Id" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="130"></GridColumn>
                <GridColumn Field="@nameof(TheTu.MaNhanVien)" HeaderText="Mã Nhân Viên" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="130" />
                <GridColumn Field="@nameof(TheTu.MaSo)" HeaderText="Mã Số" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="150" />
                <GridColumn Field="@nameof(TheTu.NhanVienName)" HeaderText="Họ Tên" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="150" />
                <GridColumn Field="@nameof(TheTu.NgayGio)" HeaderText="Ngày Giờ" Type="ColumnType.DateTime" Format="dd/MM/yyyy HH:mm:ss" TextAlign="TextAlign.Center" Width="130"></GridColumn>
                <GridColumn Field="@nameof(TheTu.PCName)" HeaderText="PC Name" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="130"></GridColumn>

            </GridColumns>
        </SfGrid>
        <SfDialog Width="500px" Height="600px" ShowCloseIcon="true" IsModal="true" CloseOnEscape="true" @bind-Visible="@IsVisibleAdd">
            <DialogEvents OnOverlayModalClick="@OverlayClick" Closed="Closed"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@(isXoa == false ? "Thêm" : "Xóa")</div>
                </Header>
                <Content>
                    @if (isXoa == false)
                    {
                        <SfDropDownList EnableVirtualization="true" @ref="DropNhanVien" Query="@LocalDataQuery" TValue="string" Placeholder="Nhân Viên" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" CssClass="e-multi-column" TItem="NhanVienDaiThanh" @bind-Value="@cardService.ItemNhanVien.MaNhanVien" DataSource="@MainService.VmNhanVien.Items">
                            <DropDownListFieldSettings Value="MaNhanVien" Text="Name"></DropDownListFieldSettings>
                            <DropDownListEvents TValue="string" TItem="NhanVienDaiThanh" Filtering="OnFiltering_NhanVien" ValueChange="ChangeNhanVien"></DropDownListEvents>
                            <DropDownListTemplates TItem="NhanVienDaiThanh">

                                <HeaderTemplate>

                                    <table>
                                        <tr>
                                            <th>Mã</th>
                                            <th>Mã Hồ Sơ</th>
                                            <th>Tên</th>
                                        </tr>
                                    </table>

                                </HeaderTemplate>

                                <ItemTemplate>

                                    <table>
                                        <tbody>
                                            <tr>

                                                <td>@context.MaNhanVien</td>
                                                <td>@context.MaHoSo</td>
                                                <td>@context.Name</td>

                                            </tr>
                                        </tbody>
                                    </table>

                                </ItemTemplate>

                            </DropDownListTemplates>


                        </SfDropDownList>
                    }

                    <div class="grid-container">
                        <div class="grid-item">
                            <SfDropDownList EnableVirtualization="true" TValue="string" Placeholder="Máy Cân" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" CssClass="e-multi-column" TItem="MayCan" DataSource="@MayCansService.Items" @bind-Value="DeviceViewService.DeviceSelectedId">
                                <DropDownListFieldSettings Value="Id" Text="SubTitle"></DropDownListFieldSettings>
                                <DropDownListTemplates TItem="MayCan">

                                    <HeaderTemplate>

                                        <table>
                                            <tr>
                                                <th>Tên</th>
                                            </tr>
                                        </table>

                                    </HeaderTemplate>

                                    <ItemTemplate>

                                        <table>
                                            <tbody>
                                                <tr>
                                                    <td>@context.SubTitle</td>
                                                </tr>
                                            </tbody>
                                        </table>

                                    </ItemTemplate>

                                </DropDownListTemplates>

                            </SfDropDownList>
                        </div>
                        <div class="grid-item">
                            <SfButton style="margin: 2px; width: 100%;" Disabled="@(DeviceViewService.DeviceCard == null ? false : DeviceViewService.DeviceCard.IsNapThe)" @onclick="() => MayCanStartStop(DeviceViewService.DeviceSelectedId)" CssClass="e-primary">Bắt Đầu</SfButton>
                        </div>
                        <div class="grid-item">
                            <SfButton style="margin: 2px; width: 100%;" Disabled="@(DeviceViewService.DeviceCard == null ? true : !DeviceViewService.DeviceCard.IsNapThe)" @onclick="() => MayCanStartStop(DeviceViewService.DeviceSelectedId)" CssClass="e-primary">Dừng</SfButton>
                        </div>
                    </div>
                    <SfTextBox Placeholder="Thẻ Id" Value="@TheId" ValueChange="@ValueChangeHandler"></SfTextBox>
                    <SfTextBox Placeholder="Thông Báo" Value="@ThongBao"></SfTextBox>
                    <SfGrid DataSource="cardService.ItemsByNhanVien" Height="250px" AllowSorting="true" AllowMultiSorting="true" TValue="TheTu" AllowPaging="true" AllowSelection="true">
                        <GridPageSettings PageCount="10" PageSize="10" PageSizes="@(new[] { "5", "10", "15", "20", "100", "200", "500" })"></GridPageSettings>
                        <GridSortSettings>
                            <GridSortColumns>
                                <GridSortColumn Field="@nameof(TheTu.NgayGio)" Direction="SortDirection.Descending"></GridSortColumn>
                            </GridSortColumns>
                        </GridSortSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(TheTu.MaTheTu)" HeaderText="Id" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="100"></GridColumn>

                            <GridColumn Field="@nameof(TheTu.NgayGio)" HeaderText="Ngày Giờ" Type="ColumnType.DateTime" Format="dd/MM/yyyy HH:mm:ss" TextAlign="TextAlign.Center" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(TheTu.PCName)" HeaderText="PC Name" Type="ColumnType.String" TextAlign="TextAlign.Center"></GridColumn>

                        </GridColumns>
                    </SfGrid>

                </Content>
            </DialogTemplates>
            @* <DialogButtons>
            <DialogButton Content="Close" IsPrimary="true" OnClick="@CloseDialogAdd"/>
            </DialogButtons> *@
        </SfDialog>
        <SfDialog Width="500px" ShowCloseIcon="true" IsModal="true" CloseOnEscape="true" @bind-Visible="@IsVisibleEdit">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>Chọn Nhân Viên</div>
                </Header>
                <Content>
                    <SfDropDownList EnableVirtualization="true" @ref="DropNhanVien" Query="@LocalDataQuery" TValue="string" Placeholder="Nhân Viên" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" CssClass="e-multi-column" TItem="NhanVienDaiThanh" @bind-Value="@cardService.ItemNhanVien.MaNhanVien" DataSource="@MainService.VmNhanVien.Items">
                        <DropDownListFieldSettings Value="MaNhanVien" Text="Name"></DropDownListFieldSettings>
                        <DropDownListEvents TValue="string" TItem="NhanVienDaiThanh" Filtering="OnFiltering_NhanVien" ValueChange="ChangeNhanVien"></DropDownListEvents>
                        <DropDownListTemplates TItem="NhanVienDaiThanh">

                            <HeaderTemplate>

                                <table>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Mã Hồ Sơ</th>
                                        <th>Tên</th>
                                    </tr>
                                </table>

                            </HeaderTemplate>

                            <ItemTemplate>

                                <table>
                                    <tbody>
                                        <tr>

                                            <td>@context.MaNhanVien</td>
                                            <td>@context.MaHoSo</td>
                                            <td>@context.Name</td>

                                        </tr>
                                    </tbody>
                                </table>

                            </ItemTemplate>

                        </DropDownListTemplates>


                    </SfDropDownList>


                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="OK" IsPrimary="true" OnClick="@Edit" />
                <DialogButton Content="Close" IsPrimary="true" OnClick="@CloseDialogAdd" />
            </DialogButtons>
        </SfDialog>

    </div>

    <!-- / Content -->
    <!-- Footer -->
    <FooterLayout />
    <!-- / Footer -->
    <div class="content-backdrop fade"></div>
</div>
<!-- Content wrapper -->


@code {
    private SfGrid<TheTu> Grid;
    private bool IsVisibleAdd;
    private bool IsVisibleEdit;
    private bool isXoa;
    SfDropDownList<string, NhanVienDaiThanh> DropNhanVien;
    private readonly Query LocalDataQuery = new Query().Take(10);
    private string TheId = "";
    private string ThongBao = "";

    private async void Edit()
    {
        var edit = async () =>
        {
            var values = await Grid.GetSelectedRecordsAsync();
            if (values != null && values.Count >= 1)
            {
                if (cardService.ItemNhanVien.MaNhanVien != null && cardService.ItemNhanVien.MaNhanVien.Trim() != "")
                {
                    var nv = MainService.VmNhanVien.Items.FirstOrDefault(x => x.MaNhanVien == cardService.ItemNhanVien.MaNhanVien);
                    if (nv != null)
                    {
                        foreach (var val in values)
                        {
                            val.MaNhanVien = nv.MaNhanVien;
                            val.MaSo = nv.MaHoSo;
                            val.NhanVienName = nv.Name;
                            val.NgayGio = DateTime.Now;
                            val.PCName = MainService.VmApp.PCName;
                        }

                        try
                        {
                            if (MainService.VmThe.Update(values) > 0)
                            {
                                foreach (var val in values)
                                {
                                    var item = MainService.VmThe.Items.FirstOrDefault(x => x.MaTheTu == val.MaTheTu);
                                    if (item != null)
                                    {
                                        var index = MainService.VmThe.Items.IndexOf(item);
                                        MainService.VmThe.Items.RemoveAt(index);
                                        MainService.VmThe.Items.Insert(index, val);
                                    }
                                }

                                IsVisibleEdit = false;
                                await Grid.Refresh();
                            }
                            else
                            {
                                await JsRuntime.InvokeVoidAsync("alert", "Không Thể Cập Nhật!"); // Alert
                            }
                        }
                        catch (Exception e)
                        {
                            Console.WriteLine(e);
                            await JsRuntime.InvokeVoidAsync("alert", e.ToString()); // Alert
                        }
                    }
                    else
                    {
                        await JsRuntime.InvokeVoidAsync("alert", "Nhân Viên Không Tồn Tại!"); // Alert
                    }
                }
                else
                {
                    await JsRuntime.InvokeVoidAsync("alert", "Chưa chọn nhân viên!"); // Alert
                }
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        };
        var result = await Handlers.ErrorHandler.HandleAsync(edit);
        if (!result.IsSuccess)
        {
            var e = result.Error;
            Console.WriteLine(e);
            await JsRuntime.InvokeVoidAsync("alert", e?.ToString()); // Alert
        }
    }

    private void MayCanChangedHandler(object? sender, EventArgs args)
    {
        if (DeviceViewService.DeviceCard != null)
        {
            TheId = DeviceViewService.DeviceCard.NapTheId;
            InvokeAsync(StateHasChanged);
        }
    }

    private async void CloseDialogAdd()
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
    }

    private async void MayCanStartStop(string id)
    {
        if (cardService.ItemNhanVien.MaNhanVien == null && isXoa == false)
        {
            await JsRuntime.InvokeVoidAsync("alert", "Chưa chọn nhân viên!"); // Alert
            return;
        }

        DeviceViewService.DeviceCard = MayCansService.Items.FirstOrDefault(x => x.Id == id);
        DeviceViewService.DeviceSelectedId = id;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = !DeviceViewService.DeviceCard.IsNapThe;
            if (DeviceViewService.DeviceCard.IsNapThe)
            {
                MayCansService.ItemChanged -= MayCanChangedHandler;
                MayCansService.ItemChanged += MayCanChangedHandler;
                await MayCansService.CommandSendMess(DeviceViewService.DeviceCard.Id, "Nạp Thẻ");
            }
            else
            {
                MayCansService.ItemChanged -= MayCanChangedHandler;
                await MayCansService.CommandSendMess(DeviceViewService.DeviceCard.Id, "");
            }


            MayCansService.NotifyItemChanged();
        }
    }

    private void ValueChangeHandler(ChangedEventArgs args)
    {
        if (args.Value.Length >= 10)
        {
            ThongBao = "";
            //JsRuntime.InvokeVoidAsync("alert", args.Value); // Alert
            var nv = MainService.VmNhanVien.Items.FirstOrDefault(x => x.MaNhanVien == cardService.ItemNhanVien.MaNhanVien);
            var the = new TheTu
                {
                    MaTheTu = args.Value,
                    NgayGio = DateTime.Now,
                    PCName = MainService.VmApp.PCName,
                    MaNhanVien = cardService.ItemNhanVien.MaNhanVien,
                    MaSo = nv?.MaHoSo,
                    NhanVienName = nv?.Name
                };
            var mes = cardService.Find(args.Value);
            if (mes == "")
            {
                if (isXoa == false)
                {
                    if (MainService.VmThe.Insert(the) > 0)
                    {
                        cardService.ItemsByNhanVien.Insert(0, the);
                        MainService.VmThe.Items.Add(the);
                        ThongBao = $"Đã Thêm Thẻ! {the.MaTheTu}";
                    }
                    else
                    {
                        ThongBao = $"Không Thể Thêm Thẻ! {the.MaTheTu}";
                    }
                }
                else
                {
                    ThongBao = $"Không Tìm Thấy Thẻ! {the.MaTheTu}";
                }
            }
            else
            {
                if (isXoa == false)
                {
                    ThongBao = mes;
                }
                else
                {
                    if (MainService.VmThe.Delete(the) > 0)
                    {
                        cardService.ItemsByNhanVien.Insert(0, the);
                        var item = MainService.VmThe.Items.FirstOrDefault(x => x.MaTheTu == the.MaTheTu);
                        if (item != null)
                        {
                            MainService.VmThe.Items.Remove(item);
                        }

                        ThongBao = $"Đã Xóa Thẻ! {the.MaTheTu}";
                    }
                    else
                    {
                        ThongBao = $"Không Thể Xóa Thẻ! {the.MaTheTu}";
                    }
                }
            }

            TheId = "";
        }
        //JsRuntime.InvokeVoidAsync("alert", args.Value); // Alert
        //TheId = "ádasd";
    }

    private async Task ToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Id == "refresh")
        {
            MainService.VmThe.Reload();
            await Grid.Refresh();
            await JsRuntime.InvokeVoidAsync("alert", "Thực hiện xong!"); // Alert
        }

        if (args.Item.Id == "add")
        {
            ThongBao = "";
            isXoa = false;
            cardService.ItemNhanVien = new TheTu();
            if (DeviceViewService.DeviceCard != null && DeviceViewService.DeviceSelectedId != "")
            {
                var mayCan = MayCansService.Items.FirstOrDefault(x => x.Id == DeviceViewService.DeviceCard.Id);
                DeviceViewService.DeviceCard.IsNapThe = mayCan.IsNapThe;
            }

            IsVisibleAdd = true;
        }

        if (args.Item.Id == "edit")
        {
            cardService.ItemNhanVien = new TheTu();
            var value = await Grid.GetSelectedRecordsAsync();
            if (value != null && value.Count >= 1)
            {
                IsVisibleEdit = true;
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        }

        if (args.Item.Id == "delete")
        {
            var value = await Grid.GetSelectedRecordsAsync();
            if (value != null && value.Count >= 1)
            {
                var result = await JsRuntime.InvokeAsync<bool>("confirm", $"Xóa {value.Count} thẻ");
                if (result)
                {
                    if (MainService.VmThe.Delete(value) > 0)
                    {

                        foreach (var val in value)
                        {
                            var item = MainService.VmThe.Items.FirstOrDefault(x => x.MaTheTu == val.MaTheTu);
                            if (item != null)
                            {
                                var index = MainService.VmThe.Items.IndexOf(item);
                                MainService.VmThe.Items.RemoveAt(index);
                            }
                        }
                    }
                    else
                    {
                        ThongBao = $"Không Thể Xóa Thẻ!";
                    }
                }
            }
            else
            {
                ThongBao = "";
                isXoa = true;
                cardService.ItemNhanVien = new TheTu();
                if (DeviceViewService.DeviceCard != null && DeviceViewService.DeviceSelectedId != "")
                {
                    var mayCan = MayCansService.Items.FirstOrDefault(x => x.Id == DeviceViewService.DeviceCard.Id);
                    DeviceViewService.DeviceCard.IsNapThe = mayCan.IsNapThe;
                }
                cardService.ItemsByNhanVien.Clear();
                IsVisibleAdd = true;
                //await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        }
    }

    private void OverlayClick(OverlayModalClickEventArgs args)
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
        MayCansService.ItemChanged -= MayCanChangedHandler;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = false;
            MayCansService.NotifyItemChanged();
        }
    }

    private async Task OnFiltering_NhanVien(FilteringEventArgs args)

    {
        args.PreventDefaultAction = true;

        var pre = new WhereFilter();

        var predicate = new List<WhereFilter>();

        predicate.Add(new WhereFilter { Condition = "or", Field = "Name", value = args.Text, Operator = "startswith", IgnoreAccent = true, IgnoreCase = true });
        predicate.Add(new WhereFilter { Condition = "or", Field = "MaHoSo", value = args.Text, Operator = "startswith", IgnoreAccent = true, IgnoreCase = true });
        predicate.Add(new WhereFilter { Condition = "or", Field = "MaNhanVien", value = args.Text, Operator = "startswith", IgnoreAccent = true, IgnoreCase = true });
        pre = WhereFilter.Or(predicate);

        var query = new Query().Where(pre);

        await DropNhanVien.FilterAsync(MainService.VmNhanVien.Items, query);
    }

    public async void ChangeNhanVien(ChangeEventArgs<string, NhanVienDaiThanh> args)
    {
        var result = Handlers.ErrorHandler.Handle(() =>
        {
            cardService.LoadByNhanVien(args.Value);
        });
        if (!result.IsSuccess)
        {
            var e = result.Error;
            Console.WriteLine(e);
            await JsRuntime.InvokeVoidAsync("alert", e?.ToString()); // Alert
        };
    }

    private void Closed(CloseEventArgs obj)
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
        MayCansService.ItemChanged -= MayCanChangedHandler;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = false;
            MayCansService.NotifyItemChanged();
        }
    }

}
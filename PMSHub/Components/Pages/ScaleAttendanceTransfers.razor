@page "/ScaleAttendanceTransfers"
@rendermode InteractiveServer
@inherits AuthenticatedComponent
@using Microsoft.EntityFrameworkCore
@using Models.Repos
@using Models.Repos.Models
@using Services
@using Microsoft.Extensions.Options
@using ViewModels.Repos.Hubs.IServices
@using System.Globalization
@inject ISessionService SessionService
@inject IOptions<ScaleAttendanceOptions> AttendanceOptions

<PageTitle>Chuyển máy chấm công</PageTitle>
<div style="padding:24px;max-width:1100px">
    <h2>Chuyển máy chấm công</h2>
    @if (!ready)
    {
        <p>Đang kiểm tra tài khoản…</p>
    }
    else if (!authorized)
    {
        <p>Chỉ tài khoản quản trị được xác nhận chuyển máy.</p>
    }
    else
    {
        <p>Chọn ca đang mở và máy mới. Giờ chuyển tự ghi theo máy chủ lúc bấm xác nhận (giờ Việt Nam), không cho nhập hoặc sửa; giữ loại ca thường/đêm.</p>
        <button class="btn btn-secondary" disabled="@busy" @onclick="Load">Tải lại</button>
        @if (!string.IsNullOrEmpty(message))
        {
            <p role="status" class="@(isError ? "text-danger" : "text-success")">@message</p>
        }
        <div class="table-responsive" style="margin-top:16px">
            <table class="table table-bordered">
                <thead><tr><th>Chọn</th><th>Thẻ / Nhân viên</th><th>Máy đang làm</th><th>Giờ Vào máy</th><th>Loại ca</th></tr></thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td><input type="radio" name="shift" checked="@(selectedId == row.Id)" @onchange="() => Select(row)" disabled="@busy" /></td>
                            <td>@row.MaChamCong<br />@EmployeeName(row.MaChamCong)</td>
                            <td>@row.MaSoMay — @row.TenMay</td>
                            <td>@row.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@(row.CaDem ? "Ca đêm" : "Ca thường")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (rows.Count == 0) { <p>Không có ca còn hạn để chuyển máy.</p> }
        @if (selectedId != null)
        {
            <div style="display:grid;gap:12px;max-width:600px">
                <label>Máy mới
                    <select class="form-select" @bind="targetMachine" disabled="@busy">
                        <option value="0">Chọn máy HQ</option>
                        @foreach (var machine in machines)
                        {
                            <option value="@machine.Id">@machine.Id — @machine.DisplayName</option>
                        }
                    </select>
                </label>
                <p>Thời điểm chuyển: tự động lấy giờ máy chủ khi xác nhận, không thể chỉnh sửa.</p>
                <label>Lý do chuyển
                    <textarea class="form-control" maxlength="500" @bind="reason" disabled="@busy"></textarea>
                </label>
                <p>Thao tác ghi Ra ở máy cũ và Vào ở máy mới cùng một thời điểm thực hiện, kèm tài khoản quản trị xác nhận và lý do.</p>
                <button class="btn btn-primary" disabled="@(busy || targetMachine == 0 || string.IsNullOrWhiteSpace(reason))" @onclick="Confirm">Xác nhận chuyển máy</button>
            </div>
        }
    }
</div>

@code {
    private bool ready, authorized, busy, isError;
    private int userId, targetMachine;
    private string? selectedId;
    private string reason = "", message = "";
    private List<CheckInOut> rows = new();
    private List<MayCan> machines = new();
    private Dictionary<string, string> names = new();

    protected override Task OnAuthenticatedAsync()
    {
        if (int.TryParse(SessionService.Get("UserId"), out userId))
        {
            using var db = new dbPMScontext();
            authorized = db.NguoiDungs.AsNoTracking().Any(x => x.Id == userId && x.IsAdmin == true && x.IsActive != false);
        }
        ready = true;
        if (authorized) Load();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string EmployeeName(string card) => names.GetValueOrDefault(card, "Chưa xác định");
    private void Select(CheckInOut row)
    {
        selectedId = row.Id;
        targetMachine = 0;
        reason = "";
    }
    private void Load()
    {
        if (!authorized) return;
        try
        {
            using var db = new dbPMScontext();
            var now = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).DateTime;
            rows = ScaleAttendanceTransferService.OpenShifts(db).Where(x => !ScaleAttendanceTransferService.IsExpired(
                x, now, AttendanceOptions.Value.MaxShiftHours)).ToList();
            machines = db.MayCans.AsNoTracking().Where(x => x.WKv == Vars.AppKV.Hq).OrderBy(x => x.Id).ToList();
            names = (from card in db.TheTu.AsNoTracking()
                     join employee in db.NhanVienDaiThanh.AsNoTracking() on card.MaNhanVien equals employee.MaNhanVien
                     select new { card.MaTheTu, employee.Name }).ToList()
                .GroupBy(x => x.MaTheTu).ToDictionary(g => g.Key, g => g.First().Name ?? "");
            selectedId = null;
        }
        catch (Exception)
        {
            isError = true;
            message = "Không tải được danh sách. Kiểm tra kết nối SQL và script bổ sung cột chuyển máy.";
        }
    }
    private async Task Confirm()
    {
        if (!authorized || busy || selectedId == null) return;
        busy = true;
        try
        {
            message = ScaleAttendanceTransferService.Transfer(userId, selectedId, targetMachine,
                reason, AttendanceOptions.Value.MaxShiftHours);
            isError = false;
            Load();
        }
        catch (ArgumentException ex) { isError = true; message = ex.Message; }
        catch (InvalidOperationException ex) { isError = true; message = ex.Message; }
        catch (Exception) { isError = true; message = "Không chuyển được máy. Kiểm tra kết nối SQL và tải lại."; }
        finally { busy = false; }
        await InvokeAsync(StateHasChanged);
    }
}

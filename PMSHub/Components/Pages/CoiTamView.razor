@page "/coitam"
@using ViewModels.Repos.Hubs.IServices
@using Syncfusion.Blazor.Lists
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Inputs
@using PMSHub.Components.Layout
@rendermode InteractiveServer
@attribute [StreamRendering]
 @* @inherits AuthenticatedComponent *@
@inject IJSRuntime JsRuntime
@inject IMainService MainService
<link rel="stylesheet" href="styles/cardcoitam.css" />

<!-- Navbar -->
<TopLayout />
<!-- / Navbar -->
<!-- Content wrapper -->
<div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">
        <h3>CoiTamView</h3>

        @*    @if (MainService.VmCoi.CoiTams.Count <= 0)
        {
        <p>
        <em>Loading... </em>
        </p>
        }
        else
        { *@
        <SfTextBox Placeholder="Filter" Input="@OnInput"></SfTextBox>
        <SfListView @ref="@SfList" DataSource="@FruitsData" ShowHeader="false" EnableVirtualization="true" ShowCheckBox="@IsShowCheckBox" Height="500px">
            <ListViewFieldSettings TValue="DataModel" Id="Id" Text="Text" IsChecked="IsChecked"></ListViewFieldSettings>
            <ListViewTemplates TValue="DataModel">

                <HeaderTemplate>
                    <div class="headerContainer">
                        <span class="fruitHeader">Fruits</span>
                    </div>
                </HeaderTemplate>
                <Template>
                    @{
                        var item = context as DataModel;
                        <SfCard CssClass="sf-card" @onclick="(e => OnSelect(item))" aria-check="@item.IsChecked.ToString()">
                            <CardContent>
                                <div>
                                    <span>@item.Text</span>
                                    <span>@item.Text</span>
                                </div>
                            </CardContent>
                        </SfCard>
                    }

                </Template>

            </ListViewTemplates>
        </SfListView>

        <button class="e-btn" @onclick="@OnSelect">Get Selected Items</button>
        <button class="e-btn" @onclick="@ShowCheckBox">Gchecs</button>
    </div>

    <!-- / Content -->
    <!-- Footer -->
    <FooterLayout />
    <!-- / Footer -->
    <div class="content-backdrop fade"></div>
</div>
<!-- Content wrapper -->
@* } *@

@code {
    DataModel Selected;
    SfListView<DataModel> SfList;
    List<DataModel> FruitsData = new List<DataModel>();
    List<DataModel> FruitsDataOrg = new List<DataModel>();
    List<DataModel> SelectedItems = new List<DataModel>();
    bool IsShowCheckBox = true;
    bool IsSelectMulti = false;
    protected override void OnInitialized()
    {
        base.OnInitialized();

        FruitsData.Add(new DataModel { Text = "Date", Id = "1", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Fig", Id = "2", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apple", Id = "3", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apricot", Id = "4", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Grape", Id = "5", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Strawberry", Id = "6", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Pineapple", Id = "7", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Melon", Id = "8", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Lemon", Id = "9", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Cherry", Id = "10", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Date1", Id = "11", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Fig1", Id = "21", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apple", Id = "31", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apricot", Id = "41", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Grape", Id = "51", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Strawberry", Id = "61", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Pineapple", Id = "71", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Melon", Id = "81", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Lemon", Id = "91", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Cherry", Id = "101", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Date", Id = "111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Fig", Id = "211", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apple", Id = "311", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apricot", Id = "411", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Grape", Id = "511", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Strawberry", Id = "611", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Pineapple", Id = "711", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Melon", Id = "811", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Lemon", Id = "911", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Cherry", Id = "1011", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Date", Id = "1111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Fig", Id = "2111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apple", Id = "3111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Apricot", Id = "4111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Grape", Id = "5111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Strawberry", Id = "6111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Pineapple", Id = "7111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Melon", Id = "8111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Lemon", Id = "9111", IsChecked = false });
        FruitsData.Add(new DataModel { Text = "Cherry", Id = "10111", IsChecked = false });
        FruitsDataOrg = FruitsData;
    }

    async void OnSelect(DataModel listData)
    {
        Selected = listData;
        if (IsSelectMulti == false)
        {
            SelectedItems.Clear();
            SelectedItems.Add(Selected);
            //var items = await SfList.GetCheckedItemsAsync();
            foreach (var dataModel in FruitsData)
            {
                if (dataModel.Id == Selected.Id)
                {
                    dataModel.IsChecked = true;
                }
                else
                {
                    dataModel.IsChecked = false;
                }


            }

            // if (items.Data.Count > 0)
            // {
            //     SfList.DataSource = FruitsData;
            // }

        }
        this.StateHasChanged();
        //await JsRuntime.InvokeVoidAsync("SetAriaSelected");
    }
    void OnInput(InputEventArgs eventArgs)
    {
        FruitsData = FruitsDataOrg.FindAll(e => e.Id.ToLower().StartsWith(eventArgs.Value) || e.Text.ToLower().StartsWith(eventArgs.Value));
    }
    async void ShowCheckBox()
    {
        IsSelectMulti = !IsSelectMulti;
        SelectedItems.Clear();

        foreach (var dataModel in FruitsData)
        {
            dataModel.IsChecked = false;

        }

        SfList.DataSource = FruitsData;

        this.StateHasChanged();
    }
    async void OnSelect()
    {
        var items = await SfList.GetCheckedItemsAsync();
        if (IsSelectMulti == false)
        {
            SelectedItems.Clear();
            SelectedItems.Add(Selected);
            foreach (var dataModel in FruitsData)
            {
                if (dataModel.Id == Selected.Id)
                {
                    dataModel.IsChecked = true;
                }
                else
                {
                    dataModel.IsChecked = false;
                }
            }

            this.StateHasChanged();
        }
        else
        {
            if (items.Data != null)
            {
                SelectedItems = items.Data;
                this.StateHasChanged();
            }
        }

    }
    public class DataModel
    {
        public string Text { get; set; }
        public string Id { get; set; }
        public bool IsChecked { get; set; }
    }

}

                <GridColumn Field="@nameof(TheThanhPham.ThanhPhamFilletName)" HeaderText="Thành Phẩm Fillet"
                            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
                <GridColumn Field="@nameof(TheThanhPham.SizeFilletName)" HeaderText="Size Fillet"
                            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
                <GridColumn Field="@nameof(TheThanhPham.QuyTrinhName)" HeaderText="Quy Trình"

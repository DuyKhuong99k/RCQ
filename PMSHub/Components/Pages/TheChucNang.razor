<h3>Thẻ Chức Năng</h3>
<SfGrid DataSource="MainService.VmTheThanhPham.Items" Height="500" @ref="Grid" AllowSorting="true"
        AllowMultiSorting="true" TValue="TheThanhPham" AllowFiltering="true" AllowPaging="true"
        AllowSelection="true" AllowExcelExport="true">
    <GridPageSettings PageCount="10" PageSize="10" PageSizes="@(new[] { "5", "10", "15", "20", "100", "200", "500" })">
    </GridPageSettings>
    <GridTemplates>
        <ToolbarTemplate>
            <SfToolbar>
                <ToolbarEvents Clicked="ToolbarClickHandler"></ToolbarEvents>
                <ToolbarItems>
                    <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-refresh icon" Id="refresh" Text="Tải Lại">
                    </ToolbarItem>
                    <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-expand icon" Id="add" Text="Thêm"></ToolbarItem>
                    <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-circle-remove icon" Id="delete" Text="Xóa"></ToolbarItem>
                    <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-export-excel icon" Id="ExcelExport" Text="Xuất Excel"></ToolbarItem>
                </ToolbarItems>
            </SfToolbar>
        </ToolbarTemplate>
    </GridTemplates>
    <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
    <GridSelectionSettings AllowDragSelection="true" Mode="SelectionMode.Row" Type="SelectionType.Multiple"
                           EnableSimpleMultiRowSelection="true" CheckboxOnly="true" PersistSelection="true">
    </GridSelectionSettings>
    <GridColumns>
        <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
        <GridColumn Field="@nameof(TheThanhPham.MaThe)" HeaderText="Id" Type="ColumnType.String"
                    TextAlign="TextAlign.Center" Width="130">
        </GridColumn>
        @if (MainService.VmApp.ComName?.ToUpper() == nameof(ComNames.RCQTG))
        {
            <GridColumn Field="@nameof(TheThanhPham.LoaiNguyenLieuName)" HeaderText="Nguyên Liệu"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.ThanhPhamName)" HeaderText="Thành Phẩm"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.SizeName)" HeaderText="Size"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
        }
        else
        {
            <GridColumn Field="@nameof(TheThanhPham.ThanhPhamDHName)" HeaderText="Thành Phẩm Định Hình"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.SizeDHName)" HeaderText="Size Định Hình"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.ThanhPhamFilletName)" HeaderText="Thành Phẩm Fillet"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.SizeFilletName)" HeaderText="Size Fillet"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.QuyTrinhName)" HeaderText="Quy Trình"
            Type="ColumnType.String" TextAlign="TextAlign.Center" Width="120" />


            <GridColumn Field="@nameof(TheThanhPham.ThanhPhamChinhXepKhuonName)" HeaderText="Thành Phẩm Chính Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.SizeChinhXepKhuonName)" HeaderText="Size Chính Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.ChatLuongChinhXepKhuonName)" HeaderText="Chất Lượng Chính Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.ThanhPhamPhuPhamName)" HeaderText="Thành Phẩm Phụ Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.SizePhuXepKhuonName)" HeaderText="Size Phụ Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.ChatLuongPhuXepKhuonName)" HeaderText="Chất Lượng Phụ Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.CoiXepKhuonName)" HeaderText="Cối Xếp Khuôn" Type="ColumnType.String" TextAlign="TextAlign.Center" Width="250" />
            <GridColumn Field="@nameof(TheThanhPham.LoLevel)"
            HeaderText="Lô" Type="ColumnType.Integer" TextAlign="TextAlign.Center"
            Width="120" />
            <GridColumn Field="@nameof(TheThanhPham.STTPhieuPhanCoChiTietT)"
            HeaderText="STT Phiếu Phân Cỡ Chi Tiết" Type="ColumnType.Integer" TextAlign="TextAlign.Center"
            Width="120" />
        }









        <GridColumn Field="@nameof(TheThanhPham.TrongLuongTare)" HeaderText="Tare"
        Type="ColumnType.Decimal" TextAlign="TextAlign.Center" Width="120" />
        <GridColumn AllowEditing="false" Field="@nameof(TheThanhPham.IsZero)" HeaderText="Zero"
        Type="ColumnType.Boolean" TextAlign="TextAlign.Center" Width="120" />
        <GridColumn AllowEditing="false" Field="@nameof(TheThanhPham.IsRestart)" HeaderText="Restart"
        Type="ColumnType.Boolean" TextAlign="TextAlign.Center" Width="120" />

    </GridColumns>
</SfGrid>

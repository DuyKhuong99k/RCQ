        <h3>Thẻ Chức Năng</h3>
        <SfGrid DataSource="MainService.VmTheThanhPham.Items" Height="500" @ref="Grid" AllowSorting="true"
                AllowMultiSorting="true" TValue="TheThanhPham" AllowFiltering="true" AllowPaging="true"
                AllowSelection="true">
            <GridPageSettings PageCount="10" PageSize="10" PageSizes="@(new[] { "5", "10", "15", "20", "100", "200", "500" })">
            </GridPageSettings>
            <GridTemplates>
                <ToolbarTemplate>
                    <SfToolbar>
                        <ToolbarEvents Clicked="ToolbarClickHandler"></ToolbarEvents>
                        <ToolbarItems>
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-refresh icon" Id="refresh" Text="Tải Lại">
                            </ToolbarItem>
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-expand icon" Id="add" Text="Thêm"></ToolbarItem>
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-edit icon" Id="edit" Text="Sửa"></ToolbarItem>
                            @* <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-export-excel icon" Id="ExcelExport" Text="Xuất
                            Excel"></ToolbarItem> *@
                            <ToolbarItem Type="@ItemType.Button" PrefixIcon="e-circle-remove icon" Id="delete" Text="Xóa">
                            </ToolbarItem>
                        </ToolbarItems>
                    </SfToolbar>
                </ToolbarTemplate>
            </GridTemplates>
            <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
            <GridSelectionSettings AllowDragSelection="true" Mode="SelectionMode.Row" Type="SelectionType.Multiple"
                                   EnableSimpleMultiRowSelection="true" CheckboxOnly="true" PersistSelection="true">
            </GridSelectionSettings>

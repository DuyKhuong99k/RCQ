                <GridColumn Field="@nameof(TheThanhPham.TrongLuongTare)" HeaderText="Tare"
                            Type="ColumnType.Decimal" TextAlign="TextAlign.Center" Width="120" />
                <GridColumn AllowEditing="false" Field="@nameof(TheThanhPham.IsZero)" HeaderText="Zero"

                var spxk = MainService.VmSizePhuXepKhuon.Items.FirstOrDefault(x => x.Ma == cardService.ItemChucNang.MaSizePhuXepKhuon);
                var clxk = MainService.VmChatLuong.Items.FirstOrDefault(x => x.Ma == cardService.ItemChucNang.MaChatLuongChinhXepKhuon);
                var cxxk = MainService.VmChieuXaXepKhuon.Items.FirstOrDefault(x => x.Ma == cardService.ItemChucNang.MaChieuXa);
                the = new TheThanhPham
                    {
                        MaThe = args.Value,
                        IsRestart = cardService.ItemChucNang.IsRestart,
                        IsZero = cardService.ItemChucNang.IsZero,
                        STTPhieuPhanCoChiTietT = cardService.ItemChucNang.STTPhieuPhanCoChiTietT,
                        TrongLuongTare = cardService.ItemChucNang.TrongLuongTare,
                        MaThanhPham = cardService.ItemChucNang.MaThanhPham,
                        MaSizeDinhHinh = cardService.ItemChucNang.MaSizeDinhHinh,
                        MaThanhPhamFillet = cardService.ItemChucNang.MaThanhPhamFillet,
                        MaMayLangDa = cardService.ItemChucNang.MaMayLangDa,
                        MaSizeFillet = cardService.ItemChucNang.MaSizeFillet,
                        MaLoaiNguyenLieu = cardService.ItemChucNang.MaLoaiNguyenLieu,
                        MaQuyTrinhT = cardService.ItemChucNang.MaQuyTrinhT,
                        MaThanhPhamPhuPham = cardService.ItemChucNang.MaThanhPhamPhuPham,
                        MaCoiXepKhuon = cardService.ItemChucNang.MaCoiXepKhuon,
                        LoLevel = cardService.ItemChucNang.LoLevel,
                        MaThanhPhamChinhXepKhuon = cardService.ItemChucNang.MaThanhPhamChinhXepKhuon,
                        MaSizeChinhXepKhuon = cardService.ItemChucNang.MaSizeChinhXepKhuon,
                        MaThanhPhamPhuXepKhuon = cardService.ItemChucNang.MaThanhPhamPhuXepKhuon,
                        MaSizePhuXepKhuon = cardService.ItemChucNang.MaSizePhuXepKhuon,
                        MaChatLuongChinhXepKhuon = cardService.ItemChucNang.MaChatLuongChinhXepKhuon,
                        MaChieuXa = cardService.ItemChucNang.MaChieuXa,
                        NgayGio = DateTime.Now,
                        ThanhPhamDHName = tpdh?.Ten,
                        SizeDHName = sdh?.Ten,
                        ThanhPhamFilletName = tpfl?.Ten,
                        QuyTrinhName = t_qt?.Ten,
                        ThanhPhamPhuPhamName = tppp?.Ten,
                        CoiXepKhuonName = cxk?.Ten,
                        ThanhPhamChinhXepKhuonName = tpcxk?.Ten,
                        SizeChinhXepKhuonName = scxk?.Ten,
                        ThanhPhamPhuXepKhuonName = tppxk?.Ten,
                        SizePhuXepKhuonName = spxk?.Ten,
                        ChatLuongChinhXepKhuonName = clxk?.Ten,
                        ChieuXaName = cxxk?.Ten,
                    };
            }

            //JsRuntime.InvokeVoidAsync("alert", args.Value); // Alert
            
            var mes = cardService.Find(args.Value);
            if (mes == "")
            {
                if (isXoa == false)
                {
                    if (MainService.VmTheThanhPham.Insert(the) > 0)
                    {
                        cardService.ItemsByChucNang.Insert(0, the);
                        MainService.VmTheThanhPham.Items.Add(the);
                        ThongBao = $"Đã Thêm Thẻ! {the.MaThe}";
                    }
                    else
                    {
                        ThongBao = $"Không Thể Thêm Thẻ! {the.MaThe}";
                    }
                }
                else
                {
                    ThongBao = $"Không Tìm Thấy Thẻ! {the.MaThe}";
                }
            }
            else
            {
                if (isXoa == false)
                {
                    ThongBao = mes;
                }
                else
                {
                    if (MainService.VmTheThanhPham.Delete(the) > 0)
                    {
                        cardService.ItemsByChucNang.Insert(0, the);
                        var item = MainService.VmTheThanhPham.Items.FirstOrDefault(x => x.MaThe == the.MaThe);
                        if (item != null)
                        {
                            MainService.VmTheThanhPham.Items.Remove(item);
                        }

                        ThongBao = $"Đã Xóa Thẻ! {the.MaThe}";
                    }
                    else
                    {
                        ThongBao = $"Không Thể Xóa Thẻ! {the.MaThe}";
                    }
                }
            }

            TheId = "";
        }
        //JsRuntime.InvokeVoidAsync("alert", args.Value); // Alert
        //TheId = "ádasd";
    }

    private async Task ToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Id == "refresh")
        {
            MainService.VmTheThanhPham.Reload();
            await Grid.Refresh();
            // await JsRuntime.InvokeVoidAsync("alert", "Thực hiện xong!"); Alert
            ToastService.ShowToast("Thực hiện xong!", ToastType.Success);
        }

        if (args.Item.Id == "add")
        {
            ThongBao = "";
            isXoa = false;
            cardService.ItemChucNang = new TheThanhPham();
            if (DeviceViewService.DeviceCard != null && DeviceViewService.DeviceSelectedId != "")
            {
                // var mayCan = MayCansService.Items.FirstOrDefault(x => x.Id == DeviceViewService.DeviceCard.Id);
                var mayCan = MayCansService.Find(DeviceViewService.DeviceCard.Id);
                DeviceViewService.DeviceCard.IsNapThe = mayCan.IsNapThe;
                
            }

            IsVisibleAdd = true;
        }

        

        if (args.Item.Id == "delete")
        {
            var value = await Grid.GetSelectedRecordsAsync();
            if (value != null && value.Count >= 1)
            {
                var result = await JsRuntime.InvokeAsync<bool>("confirm", $"Xóa {value.Count} thẻ");
                if (result)
                {
                    if (MainService.VmTheThanhPham.Delete(value) > 0)
                    {
                        foreach (var val in value)
                        {
                            var item = MainService.VmTheThanhPham.Items.FirstOrDefault(x => x.MaThe == val.MaThe);
                            if (item != null)
                            {
                                var index = MainService.VmTheThanhPham.Items.IndexOf(item);
                                MainService.VmTheThanhPham.Items.RemoveAt(index);
                            }
                        }
                        // Xóa số lượng select record
                        await Grid.ClearSelectionAsync();
                    }
                    else
                    {
                        ThongBao = "Không Thể Xóa Thẻ!";
                    }
                }
            }
            else
            {
                ThongBao = "";
                isXoa = true;
                cardService.ItemChucNang = new TheThanhPham();
                if (DeviceViewService.DeviceCard != null && DeviceViewService.DeviceSelectedId != "")
                {
                    // var mayCan = MayCansService.Items.FirstOrDefault(x => x.Id == DeviceViewService.DeviceCard.Id);
                    var mayCan = MayCansService.Find(DeviceViewService.DeviceCard.Id);
                    DeviceViewService.DeviceCard.IsNapThe = mayCan.IsNapThe;
                }

                cardService.ItemsByChucNang.Clear();
                IsVisibleAdd = true;
                //await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        }

        if (args.Item.Id == "ExcelExport") //Id is combination of Grid's ID and itemname
        {
            var ExportProperties = new ExcelExportProperties();
            ExportProperties.ExportType = ExportType.AllPages;
            ExportProperties.IncludeTemplateColumn = true;
            await Grid.ExportToExcelAsync(ExportProperties);
        }
    }

    private void OverlayClick(OverlayModalClickEventArgs args)
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
        // MayCansService.ItemChanged -= MayCanChangedHandler;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = false;
            MayCansService.NotifyItemChanged(DeviceViewService.DeviceCard);
        }
    }


    private void Closed(CloseEventArgs obj)
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
        // MayCansService.ItemChanged -= MayCanChangedHandler;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = false;
            MayCansService.NotifyItemChanged(DeviceViewService.DeviceCard);
        }
    }


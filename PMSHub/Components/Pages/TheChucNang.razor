    private async void Edit()
    {
        var edit = async () =>
        {
            var values = await Grid.GetSelectedRecordsAsync();
            if (values != null && values.Count >= 1)
            {
                // if (cardService.ItemRo.ColorCode != null && cardService.ItemRo.ColorCode.Trim() != "")
                // {
                foreach (var val in values)
                {
                    val.IsRestart = cardService.ItemChucNang.IsRestart;
                    val.IsZero = cardService.ItemChucNang.IsZero;
                    val.STTPhieuPhanCoChiTietT = cardService.ItemChucNang.STTPhieuPhanCoChiTietT;
                    val.TrongLuongTare = cardService.ItemChucNang.TrongLuongTare;
                    val.MaThanhPham = cardService.ItemChucNang.MaThanhPham;
                    val.MaSizeDinhHinh = cardService.ItemChucNang.MaSizeDinhHinh;
                    val.MaThanhPhamFillet = cardService.ItemChucNang.MaThanhPhamFillet;
                    val.MaMayLangDa = cardService.ItemChucNang.MaMayLangDa;
                    val.MaSizeFillet = cardService.ItemChucNang.MaSizeFillet;
                    val.MaQuyTrinhT = cardService.ItemChucNang.MaQuyTrinhT;
                    val.MaThanhPhamPhuPham = cardService.ItemChucNang.MaThanhPhamPhuPham;
                    val.NgayGio = cardService.ItemChucNang.NgayGio;
                }

                try
                {
                    if (MainService.VmTheThanhPham.Update(values) > 0)
                    {
                        foreach (var val in values)
                        {
                            var item = MainService.VmTheThanhPham.Items.FirstOrDefault(x => x.MaThe == val.MaThe);
                            if (item != null)
                            {
                                var index = MainService.VmTheThanhPham.Items.IndexOf(item);
                                MainService.VmTheThanhPham.Items.RemoveAt(index);
                                @* MainService.VmTheRo.Items.Insert(index, val); *@
                            }
                        }

                        IsVisibleEdit = false;
                        await Grid.Refresh();
                    }
                    else
                    {
                        await JsRuntime.InvokeVoidAsync("alert", "Không Thể Cập Nhật!"); // Alert
                    }
                }
                catch (Exception e)
                {
                    Console.WriteLine(e);
                    await JsRuntime.InvokeVoidAsync("alert", e.ToString()); // Alert
                }
                // }
                // else
                // {
                //     await JsRuntime.InvokeVoidAsync("alert", "Chưa chọn nhân viên!"); // Alert
                // }
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        };
        var result = await Handlers.ErrorHandler.HandleAsync(edit);
        if (!result.IsSuccess)
        {
            var e = result.Error;
            Console.WriteLine(e);
            await JsRuntime.InvokeVoidAsync("alert", e.ToString()); // Alert
        }
    }

    private void MayCanChangedHandler(object? sender, EventArgs args)
    {
        if (DeviceViewService.DeviceCard != null)
        {
            TheId = DeviceViewService.DeviceCard.NapTheId;
            InvokeAsync(StateHasChanged);
        }
    }

    private async void CloseDialogAdd()
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
    }

    private async void MayCanStartStop(string id)
    {
        // if (cardService.ItemRo.ColorCode == null && isXoa == false)
        // {
        //     await JsRuntime.InvokeVoidAsync("alert", "Chưa chọn Màu!"); // Alert
        //     return;
        // }

        DeviceViewService.DeviceCard = MayCansService.Items.FirstOrDefault(x => x.Id == id);
        DeviceViewService.DeviceSelectedId = id;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = !DeviceViewService.DeviceCard.IsNapThe;
            if (DeviceViewService.DeviceCard.IsNapThe)
            {
                MayCansService.ItemChanged -= MayCanChangedHandler;
                MayCansService.ItemChanged += MayCanChangedHandler;
                await MayCansService.CommandSendMess(DeviceViewService.DeviceCard.Id, "Nạp Thẻ");
            }
            else
            {
                MayCansService.ItemChanged -= MayCanChangedHandler;
                await MayCansService.CommandSendMess(DeviceViewService.DeviceCard.Id, "");
            }


            MayCansService.NotifyItemChanged();
        }
    }

    private void ValueChangeHandler(ChangedEventArgs args)
    {
        if (args.Value.Length >= 10)
        {
            ThongBao = "";
            //JsRuntime.InvokeVoidAsync("alert", args.Value); // Alert
            var the = new Models.Repos.Models.TheThanhPham()
                {
                    MaThe = args.Value,
                    IsRestart = cardService.ItemChucNang.IsRestart,
                    IsZero = cardService.ItemChucNang.IsZero,
                    STTPhieuPhanCoChiTietT = cardService.ItemChucNang.STTPhieuPhanCoChiTietT,
                    TrongLuongTare = cardService.ItemChucNang.TrongLuongTare,
                    MaThanhPham = cardService.ItemChucNang.MaThanhPham,
                    MaSizeDinhHinh = cardService.ItemChucNang.MaSizeDinhHinh,
                    MaThanhPhamFillet = cardService.ItemChucNang.MaThanhPhamFillet,
                    MaMayLangDa = cardService.ItemChucNang.MaMayLangDa,
                    MaSizeFillet = cardService.ItemChucNang.MaSizeFillet,
                    MaQuyTrinhT = cardService.ItemChucNang.MaQuyTrinhT,
                    MaThanhPhamPhuPham = cardService.ItemChucNang.MaThanhPhamPhuPham,
                    NgayGio = DateTime.Now
                };
            var mes = cardService.Find(args.Value);
            if (mes == "")
            {
                if (isXoa == false)
                {
                    if (MainService.VmTheThanhPham.Insert(the) > 0)
                    {
                        cardService.ItemsByChucNang.Insert(0, the);
                        MainService.VmTheThanhPham.Items.Add(the);
                        ThongBao = $"Đã Thêm Thẻ! {the.MaThe}";
                    }
                    else
                    {
                        ThongBao = $"Không Thể Thêm Thẻ! {the.MaThe}";
                    }
                }
                else
                {
                    ThongBao = $"Không Tìm Thấy Thẻ! {the.MaThe}";
                }
            }
            else
            {
                if (isXoa == false)
                {
                    ThongBao = mes;
                }
                else
                {
                    if (MainService.VmTheThanhPham.Delete(the) > 0)
                    {
                        cardService.ItemsByChucNang.Insert(0, the);
                        var item = MainService.VmTheThanhPham.Items.FirstOrDefault(x => x.MaThe == the.MaThe);
                        if (item != null)
                        {
                            MainService.VmTheThanhPham.Items.Remove(item);
                        }

                        ThongBao = $"Đã Xóa Thẻ! {the.MaThe}";
                    }
                    else
                    {
                        ThongBao = $"Không Thể Xóa Thẻ! {the.MaThe}";
                    }
                }
            }

            TheId = "";
        }
        //JsRuntime.InvokeVoidAsync("alert", args.Value); // Alert
        //TheId = "ádasd";
    }

    private async Task ToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Id == "refresh")
        {
            MainService.VmTheThanhPham.Reload();
            await Grid.Refresh();
            await JsRuntime.InvokeVoidAsync("alert", "Thực hiện xong!"); // Alert
        }

        if (args.Item.Id == "add")
        {
            ThongBao = "";
            isXoa = false;
            cardService.ItemChucNang = new Models.Repos.Models.TheThanhPham();
            if (DeviceViewService.DeviceCard != null && DeviceViewService.DeviceSelectedId != "")
            {
                var mayCan = MayCansService.Items.FirstOrDefault(x => x.Id == DeviceViewService.DeviceCard.Id);
                DeviceViewService.DeviceCard.IsNapThe = mayCan.IsNapThe;
            }

            IsVisibleAdd = true;
        }

        if (args.Item.Id == "edit")
        {
            cardService.ItemChucNang = new Models.Repos.Models.TheThanhPham();
            var value = await Grid.GetSelectedRecordsAsync();
            if (value != null && value.Count >= 1)
            {
                IsVisibleEdit = true;
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        }

        if (args.Item.Id == "delete")
        {
            var value = await Grid.GetSelectedRecordsAsync();
            if (value != null && value.Count >= 1)
            {
                var result = await JsRuntime.InvokeAsync<bool>("confirm", $"Xóa {value.Count} thẻ");
                if (result)
                {
                    if (MainService.VmTheThanhPham.Delete(value) > 0)
                    {
                        foreach (var val in value)
                        {
                            var item = MainService.VmTheThanhPham.Items.FirstOrDefault(x => x.MaThe == val.MaThe);
                            if (item != null)
                            {
                                var index = MainService.VmTheThanhPham.Items.IndexOf(item);
                                MainService.VmTheThanhPham.Items.RemoveAt(index);
                            }
                        }
                    }
                    else
                    {
                        ThongBao = "Không Thể Xóa Thẻ!";
                    }
                }
            }
            else
            {
                ThongBao = "";
                isXoa = true;
                cardService.ItemChucNang = new Models.Repos.Models.TheThanhPham();
                if (DeviceViewService.DeviceCard != null && DeviceViewService.DeviceSelectedId != "")
                {
                    var mayCan = MayCansService.Items.FirstOrDefault(x => x.Id == DeviceViewService.DeviceCard.Id);
                    DeviceViewService.DeviceCard.IsNapThe = mayCan.IsNapThe;
                }

                cardService.ItemsByChucNang.Clear();
                IsVisibleAdd = true;
                //await JsRuntime.InvokeVoidAsync("alert", "Không có dữ liệu được chọn!"); // Alert
            }
        }
    }

    private void OverlayClick(OverlayModalClickEventArgs args)
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
        MayCansService.ItemChanged -= MayCanChangedHandler;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = false;
            MayCansService.NotifyItemChanged();
        }
    }


    private void Closed(CloseEventArgs obj)
    {
        IsVisibleAdd = false;
        IsVisibleEdit = false;
        MayCansService.ItemChanged -= MayCanChangedHandler;

        if (DeviceViewService.DeviceCard != null)
        {
            DeviceViewService.DeviceCard.IsNapThe = false;
            MayCansService.NotifyItemChanged();
        }
    }


@page "/api/loginlocal/"
@using Blazored.LocalStorage
@using Models.Repos.Models
@using PMSHub.Components.Layout
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Vars.Hubs
@using ViewModels.Repos.Hubs.IServices
@layout ErrorLayout
@rendermode InteractiveServer
@inject IMainService MainService
@inject IJSRuntime jsRuntime
@inject ILoginService loginService
@inject NavigationManager Navigation
@inject ISessionService SessionService
@inject IMessageService MessageService
@inject ILocalStorageService LocalStorage
@inject IDeviceViewService DeviceViewService ;
@inject IJSRuntime JsRuntime
@inject IToastService ToastService
@inherits AuthenticatedComponent


<PageTitle>Đăng Nhập</PageTitle>

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">
            <!-- Register -->
            <div class="card">
                <div class="card-body">
                    <!-- Logo -->
                    <div class="app-brand justify-content-center">
                        <a href="index.html" class="app-brand-link gap-2">
                            <span class="app-brand-logo demo">
                                <img style="width: 180px" src="imgs/PhanBachLogo.png"/>
                            </span>
                        </a>
                    </div>
                    <!-- /Logo -->
                    <h4 class="mb-2">Chào mừng đến với PMHub</h4>
                    <p class="mb-4">Vui lòng đăng nhập để bất đầu!</p>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label" for="password">Xưởng</label>
                        </div>
                        <div class="input-group input-group-merge">
                            <SfDropDownList TValue="XiNghiep" Placeholder="Xí Nghiệp" FloatLabelType="FloatLabelType.Auto" TItem="XiNghiep" @bind-Value="@MainService.VmXiNghiep.SelectedItem" DataSource="@MainService.VmXiNghiep.Items">
                                <DropDownListEvents TItem="XiNghiep" TValue="XiNghiep" ValueChange="xiNghiepValueChange"/>
                                <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tài khoản</label>
                        <input type="text"
                        class="form-control"
                        id="txtUsername"
                        @bind="userName"
                        name="username"
                        placeholder="Nhập tài khoản"
                        autofocus
                        autocomplete="off" @onkeyup="keyUpEvent" />
                    </div>
                    <div class="mb-3 form-password-toggle">
                        <div class="d-flex justify-content-between">
                            <label class="form-label" for="password">Mật khẩu</label>
                        </div>
                        <div class="input-group input-group-merge">
                            <input type="password"
                            id="txtPassword"
                            @bind="passWord"
                            class="form-control"
                            name="password"
                            placeholder="*****"
                            aria-describedby="password" autocomplete="off" @onkeyup="keyUpEvent"/>
                            <span class="input-group-text cursor-pointer">
                                <i class="bx bx-hide"></i>
                            </span>
                        </div>
                    </div>
                    @* 
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember-me" />
                            <label class="form-check-label" for="remember-me"> Giữ Phiên Đăng Nhập </label>
                        </div>
                    </div> *@
                    <div class="mb-3">
                        <div class="col-12">
                            <button @onclick="DoLogin" class="btn btn-primary w-100" type="submit" id="loginBtn">
                                <div class=" align-items-center">
                                    <span id="txtDangNhap">Đăng Nhập</span>
                                    <div id="loadingIndicator" class=" spinner-border text-secondary" role="status" style="display: none;">
                                        <span class="visually-hidden">Đang tải...</span>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    #toast_default .e-meeting::before {
    content: "\e705";
    font-size: 17px;
    }


</style>


                    <div class="mb-3">
                        <div class="col-12">
                            <button @onclick="DoLogin" class="btn btn-primary w-100" type="submit" id="loginBtn">
                                <div class=" align-items-center">
                                    <span id="txtDangNhap">Đăng Nhập</span>
                                    <div id="loadingIndicator" class=" spinner-border text-secondary" role="status" style="display: none;">
                                        <span class="visually-hidden">Đang tải...</span>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Lấy giá trị XuongId từ LocalStorage
            //var xuongId = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "XuongId");
            var xuongId = await LocalStorage.GetItemAsync<string>("XuongId");
            if (!string.IsNullOrEmpty(xuongId))
            {
                // Gán giá trị vào SelectedItem trong ViewModel
                MainService.VmXiNghiep.SelectedItem = MainService.VmXiNghiep.Items.FirstOrDefault(x => x.Ma == xuongId);
            }
        }
    }

    private string userName { get; set; }
    private string passWord { get; set; }
    private async void xiNghiepValueChange(ChangeEventArgs<XiNghiep, XiNghiep> obj)
    {
        try
        {
            //await JsRuntime.InvokeVoidAsync("SetXuongId", obj.Value.Ma);
            SessionService.Set("XuongId", obj.Value.Ma);
            await LocalStorage.SetItemAsync("XuongId", obj.Value.Ma);
            
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            //throw;
        }
    }
    private void ReloadPage()
    {
        // Lấy URL hiện tại và buộc tải lại trang
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
    private async Task DoLogin()
    {
        try
        {
            if (loginService.LoginLocal(userName, passWord))
            {
                await LocalStorage.SetItemAsync("PageReloadKey", "false");
                Navigation.NavigateTo("/Home", true);
                
            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
        }
    }
    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DoLogin(); // Gọi hàm DoLogin khi nhấn Enter
        }
    }

                        </div>
                        <div class="input-group input-group-merge">

                           @*  <SfDropDownList TValue="XiNghiep" Placeholder="Xí Nghiệp" FloatLabelType="FloatLabelType.Auto" TItem="XiNghiep" @bind-Value="@MainService.VmXiNghiep.SelectedItem" DataSource="@MainService.VmXiNghiep.Items">

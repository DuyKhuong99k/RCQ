@code {
    private List<SfButton> buttonRefs;

    protected override void OnInitialized()
    {
        buttonRefs = new List<SfButton>();
        for (var i = 0; i < MayCanService.Items.Count; i++)
        {
            buttonRefs.Add(new SfButton() { Content = "Expand" });
        }
    }

    void ExpandHandler(int index)
    {
        var button = buttonRefs[index];
        var content = button.Content;
        button.Content = "";
        button.Content = content == "Expand" ? "Collapse" : "Expand";
    }

} *@

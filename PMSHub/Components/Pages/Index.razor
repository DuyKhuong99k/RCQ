@page "/"
@page "/Home"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using PMSHub.Navigation

@inherits AuthenticatedComponent
@code {
    protected override Task OnAuthenticatedAsync()
    {
        // Keep old root/Home bookmarks, but redirect only after the session check succeeds.
        Navigation.NavigateTo(HubRoutes.Default, forceLoad: true);
        return Task.CompletedTask;
    }

}

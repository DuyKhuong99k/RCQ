                                Format="N2"
                                TextAlign="TextAlign.Right"
                                Width="140" />

                    <GridColumn Field="DinhMucYeuCau"
                                HeaderText="ĐM Yêu Cầu"
                                Format="N2"
                                TextAlign="TextAlign.Right"

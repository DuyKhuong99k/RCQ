    protected override Task OnInitializedAsync()
    {
        var _userId = SessionService.Get("UserId");
        if (_userId != null)
        {
            userId = int.Parse(_userId);
        }

        MayCanService.ItemChanged -= MayCanChangedHandler;
        MayCanService.ItemChanged += MayCanChangedHandler;
        MainService.AlertRequested -= AlertRequestedHandler;
        MainService.AlertRequested += AlertRequestedHandler;
        DeviceViewService.Items.Clear();
        if (LoginService.IsUserAuthenticated())
        {
            DeviceViewService.Load(userId);
        }


        buttonContent = expand;
        buttonRefs = new List<ButtonModel>();
        for (var i = 0; i < DeviceViewService.Items.Count; i++)
        {
            var item = DeviceViewService.Items[i];
            buttonRefs.Add(new ButtonModel
                {
                    Id = item.Id,
                    Content = buttonContent
                });
        }

        return base.OnInitializedAsync();
    }

    private void AlertRequestedHandler(string obj)
    {
        jsRuntime.InvokeVoidAsync("alert", obj);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void MayCanChangedHandler(object? sender, EventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    void ExpandHandler(string id)
    {
        var button = buttonRefs.FirstOrDefault(x => x.Id == id);
        if (button != null)
        {
            var content = button.Content;
            button.Content = "";
            buttonContent = content == expand ? collapse : expand;
            button.Content = buttonContent;
        }
    }


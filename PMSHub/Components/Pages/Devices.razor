    private async void CloseDialogLo()
    {
        var hander = await ErrorHandler.HandleAsync(async () =>
        {
            var mayCan = SelectedItems.FirstOrDefault();
            var id = mayCan?.Id;
            if (id != null)
            {
                if (MainService.VmApp.ComName == nameof(ComNames.HL))
                {
                    await MayCanService.CommandSetLo(id, MainService.VmLoHq.SelectedItem);
                }
                else
                {
                    await MayCanService.CommandSetLo(id, MainService.VmLo.SelectedItem);
                }
            }
        });
        if (!hander.IsSuccess)
        {
            ToastService.ShowToast(hander?.Error?.Message, ToastType.Error);
        }

        IsVisibleLo = false;
    }

    private void OpenDialogThanhPham(MayCan _mayCan)
    {
        SelectedItems.Clear();
        SelectedItems.Add(_mayCan);

        var mayCan = SelectedItems.FirstOrDefault();
        if (mayCan != null)
        {
            if (mayCan.WKv == AppKV.BTPFillet || mayCan.WKv == AppKV.BTPFilletv2 || mayCan.WKv == AppKV.TPFillet || mayCan.WKv == AppKV.TPFilletv2)
            {
                IsVisibleThanhPhamFillet = true;
            }
            else if (mayCan.WKv == AppKV.BTPDinhHinh || mayCan.WKv == AppKV.TPDinhHinh)
            {
                MainService.VmThanhPhamDinhHinh.SelectedItem = MainService.VmThanhPhamDinhHinh.Items.FirstOrDefault();
                if (MainService.VmApp.ComName == nameof(ComNames.NV))
                {
                    var xiNghiep = MainService.VmXiNghiep.Items.FirstOrDefault(x => x.Ma == mayCan.MaXuong);
                    if (xiNghiep != null)
                    {
                        var thanhPhamItems = MainService.VmThanhPhamDinhHinh.Items.Where(x => x.CodeId == xiNghiep.CodeId || (x.CodeId != null && x.CodeId.Trim() == "")).ToList();
                        MainService.VmThanhPhamDinhHinh.UsedItems.Clear();
                        foreach (var item in thanhPhamItems)
                        {
                            MainService.VmThanhPhamDinhHinh.UsedItems.Add(item);
                        }
                    }
                }

                IsVisibleThanhPhamDinhHinh = true;
            }
            else if (mayCan.WKv == AppKV.XepKhuon || mayCan.WKv == AppKV.XepKhuonRaCoi)
            {
                IsVisibleThanhPhamXepKhuon = true;
            }
            else if (mayCan.WKv == AppKV.XepKhuonPhu)
            {
                IsVisibleSizeXepKhuonPhu = true;
            }
            else if (mayCan.WKv == AppKV.Hq)
            {
                IsVisibleThanhPhamHq = true;
            }
            else if (mayCan.WKv == AppKV.NguyenLieu)
            {
                IsVisibleThanhPhamNguyenLieu = true;
            }
        }
    }


                   @*  <GridColumn Field="MaNhanVienPhucVu" HeaderText="NV Phục Vụ" Width="140" />
                    <GridColumn Field="MaNhanVienBanKiem" HeaderText="NV Ban Kiểm" Width="150" /> *@


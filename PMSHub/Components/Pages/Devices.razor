@page "/Devices"
@rendermode InteractiveServer
@inject IJSRuntime jsRuntime
@inject NavigationManager Navigation
@inject IMayCansService MayCanService
@inject IMainService MainService
@inject IDeviceViewService DeviceViewService
@inject ILoginService LoginService
@inject IConverterService ConverterService
@inject ISessionService SessionService
@inject ICoiService CoiService
@inject ILocalStorageService LocalStorage
@inject IToastService ToastService
@inject HttpClient Http
@attribute [StreamRendering]
@using Blazored.LocalStorage
@using Handlers
@using Models.Repos.A_Model
@using Models.Repos.Models
@using MvvmHelpers
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using ToolsEx
@using Vars
@using Vars.Hubs
@using ViewModels.Repos.Hubs.IServices
@using Action = Action
@using FilterType = Syncfusion.Blazor.DropDowns.FilterType
@inherits AuthenticatedComponent
@implements IDisposable

<link rel="stylesheet" href="styles/card.css"/>
<PageTitle>Devices</PageTitle>
<!-- Navbar -->
@* <TopLayout /> *@
<!-- / Navbar -->
<!-- Content wrapper -->
@* <div class="content-wrapper"> *@
@*     <!-- Content --> *@

@*     <div class="container-xxl flex-grow-1 container-p-y"> *@
<h1>Danh Sách Thiết Bị</h1>
<div>
    <SfButton style="margin: 2px;" CssClass="e-primary" @onclick="() => OpenDialogReload()">Tải Lại</SfButton>

</div>

@if (MayCanService.Items.Count <= 0)
{
    <p>
        <em>Loading... </em>
    </p>
}
else
{
    <SfListBox TValue="List<MayCan>" DataSource="@DeviceViewService.Items" TItem="MayCan" @bind-Value="@SelectedItems"
               AllowFiltering=true FilterType=" FilterType.Contains">
        @* <ListBoxFieldSettings Text="Id" Value="Id"></ListBoxFieldSettings> *@
        <ListBoxFieldSettings GroupBy="WKv" Text="SubTitle" Value="Id"/>
        <ListBoxTemplates TItem="MayCan">
            <ItemTemplate>
                @{
                    var mayCan = context;
                    var _buttonContent = buttonRefs.FirstOrDefault(x => x.Id == mayCan.Id)?.Content;
                    <SfCard class="sf-card ">
                        <CardHeader Title="@mayCan.Id">
                            <SubTitle>
                                <table style="margin-bottom: 10px;">
                                    <tr>
                                        <td>
                                            <div class="text">@mayCan.SubTitle</div>
                                            @if (mayCan.IsNapThe)
                                            {
                                                <div class="text">Đang Nạp Thẻ</div>
                                            }
                                            @if (mayCan.ErrorString != null && mayCan.ErrorString != "")
                                            {
                                                <div>
                                                    <SfTextBox Value="@mayCan.ErrorString"></SfTextBox>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="text-right"
                                                 style="color: @(mayCan.IsConnected ? "yellowgreen" : "grey") !important; font-size: 24px;">
                                                &#9865;
                                            </div>
                                        </td>
                                        @* <td>
                                             <div class="text-right" style="color: @(mayCan.IsActive ? "yellowgreen" : "grey") !important; font-size: 24px;">@(mayCan.IsActive ? "\u2713" : "\u2715")</div>

                                         </td> *@
                                        <td>
                                            @* Disabled="@(!mayCan.IsConnected)" *@
                                            <SfButton style="width: 100%"
                                                      CssClass="e-primary" @onclick="() => OpenDialogHieuChinh()">
                                                &#9881;
                                            </SfButton>

                                        </td>
                                        @if (mayCan.IsNapThe)
                                        {
                                            <td>

                                                <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                          CssClass="e-primary"
                                                          @onclick="() => ExecuteAction(() => MayCanService.CommandSetNapThe(mayCan.Id, true))">
                                                    Thoát Nạp Thẻ
                                                </SfButton>

                                            </td>
                                        }
                                    </tr>
                                </table>
                            </SubTitle>
                        </CardHeader>

                        <CardContent>
                            <table style="margin-bottom: 10px;">
                                @if (mayCan.WKv == AppKV.XepKhuon || mayCan.WKv == AppKV.XepKhuonRaCoi || mayCan.WKv == AppKV.XepKhuonPhu)
                                {
                                    <tr>
                                        <td colspan="4" style="width: 100px">
                                            <SfDatePicker TValue="DateTime" FloatLabelType="FloatLabelType.Auto"
                                                          Placeholder='Ngày Nguyên Liệu'
                                                          @bind-Value="@mayCan.NgayNguyenLieu"
                                                          Max="@MainService.VmApp.DateTimeNow"></SfDatePicker>

                                        </td>
                                    </tr>
                                }
                                @if (mayCan.WKv == AppKV.XepKhuonRaCoi)
                                {
                                    <tr>
                                        <td colspan="3" style="width: 100px">

                                            <SfNumericTextBox ValidateDecimalOnType="true" style="width: 100%"
                                                              Step="0.01M"
                                                              ShowSpinButton="false" TValue="decimal?"
                                                              @bind-Value="@mayCan.ThamSoTangTrong" Locale="en-US"
                                                              Readonly="true" FloatLabelType="FloatLabelType.Auto"
                                                              Placeholder='Tham Số Tăng Trọng'></SfNumericTextBox>
                                        </td>
                                        <td>
                                            <SfButton style="width: 100%"
                                                      CssClass="e-primary"
                                                      @onclick="() => OpenDialogThamSoTangTrong (mayCan)">Set
                                            </SfButton>
                                        </td>
                                    </tr>
                                }
                                <tr>

                                    <td style="width: 100px">
                                        <span class="text">Lô</span>

                                    </td>
                                    <td colspan="2">
                                        <span style="width: 100%" class="text">@mayCan.MaLo</span>

                                    </td>
                                    <td>
                                        @if (mayCan.WKv == AppKV.TPDinhHinh && MainService.VmApp.ComName == nameof(ComNames.NV))
                                        {
                                            <div
                                                style="display: grid; grid-column-gap: 2px; grid-template-columns: 50% 50%;">
                                                <div
                                                    style="display: grid; grid-column-gap: 0px; grid-template-columns: auto auto; align-items : center;">
                                                    <label>Sản Lượng</label>
                                                    <SfSwitch Checked="@mayCan.IsChiSangLuong" 
                                                              CheckedChanged="@(async (bool value) => await OnChiSanLuongChanged(mayCan, value))">
                                                    </SfSwitch>
                                                </div>
                                                <div
                                                    style="display: grid; grid-column-gap: 1px; grid-template-columns: auto auto;">
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                                  CssClass="e-primary"
                                                                  @onclick="() => MayCanService.CommandGetLo(mayCan.Id)">
                                                            Get
                                                        </SfButton>
                                                    </div>
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                                  CssClass="e-primary"
                                                                  @onclick="() => OpenDialogLo(mayCan)">Set
                                                        </SfButton>
                                                    </div>
                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: 50% 50%;">

                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetLo(mayCan.Id)">Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogLo(mayCan)">Set
                                                    </SfButton>
                                                </div>

                                            </div>
                                        }
                                        @* <div *@
                                        @*     style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;"> *@
                                        @*      *@
                                        @*     <div> *@
                                        @*         <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" *@
                                        @*                   CssClass="e-primary" *@
                                        @*                   @onclick="() => MayCanService.CommandGetLo(mayCan.Id)">Get *@
                                        @*         </SfButton> *@
                                        @*     </div> *@
                                        @*     <div> *@
                                        @*         <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" *@
                                        @*                   CssClass="e-primary" @onclick="() => OpenDialogLo(mayCan)">Set *@
                                        @*         </SfButton> *@
                                        @*     </div> *@
                                        @* </div> *@
                                    </td>
                                </tr>
                                @if (mayCan.WKv == AppKV.Hq)
                                {
                                    <tr>
                                        <td>
                                            <span class="text">Nguyên Liệu</span>

                                        </td>
                                        <td colspan="2">
                                            <span style="width: 100%"
                                                  class="text">@(ConverterService.LoaiNguyenLieuToName(mayCan.MaLoaiNguyenLieu))</span>

                                        </td>
                                        <td>
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetNguyenLieu(mayCan.Id)">
                                                        Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogNguyenLieu(mayCan)">Set
                                                    </SfButton>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td>
                                        <span class="text">Thành Phẩm</span>

                                    </td>
                                    <td colspan="2">
                                        <span style="width: 100%"
                                              class="text">@(ConverterService.ThanhPhamToName(mayCan.MaThanhPham, mayCan.WKv))</span>

                                    </td>
                                    <td>
                                        @if (mayCan.WKv == AppKV.TPDinhHinh && MainService.VmApp.ComName == nameof(ComNames.NV))
                                        {
                                            <div
                                                style="display: grid; grid-column-gap: 2px; grid-template-columns: 50% 50%;">
                                                <div
                                                    style="display: grid; grid-column-gap: 0px; grid-template-columns: auto auto; align-items: center;">
                                                    <label>Xác Định</label>
                                                    @*<SfSwitch @bind-Checked="@mayCan.IsXacDinhLoaiThanhPham"></SfSwitch>*@
                                                    <SfSwitch Checked="@mayCan.IsXacDinhLoaiThanhPham"
                                                              CheckedChanged="@(async (bool value) => await OnXacDinhChanged(mayCan, value))">
                                                    </SfSwitch>
                                                </div>
                                                <div
                                                    style="display: grid; grid-column-gap: 1px; grid-template-columns: auto auto;">
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                                  CssClass="e-primary"
                                                                  @onclick="() => MayCanService.CommandGetThanhPham(mayCan.Id)">
                                                            Get
                                                        </SfButton>
                                                    </div>
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                                  CssClass="e-primary"
                                                                  @onclick="() => OpenDialogThanhPham(mayCan)">Set
                                                        </SfButton>
                                                    </div>
                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: 50% 50%;">

                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetThanhPham(mayCan.Id)">
                                                        Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogThanhPham(mayCan)">Set
                                                    </SfButton>

                                                </div>

                                            </div>
                                        }

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="text">Size</span>

                                    </td>
                                    <td colspan="2">
                                        <span style="width: 100%"
                                              class="text">@(ConverterService.SizeToName(mayCan.MaSize, mayCan.WKv))</span>

                                    </td>
                                    <td>
                                        <div
                                            style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                            <div>
                                                <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                          CssClass="e-primary"
                                                          @onclick="() => MayCanService.CommandGetSize(mayCan.Id)">Get
                                                </SfButton>
                                            </div>
                                            <div>
                                                <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                          CssClass="e-primary" @onclick="() => OpenDialogSize(mayCan)">
                                                    Set
                                                </SfButton>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                @if (mayCan.WKv == AppKV.NguyenLieu)
                                {
                                    <tr>
                                        <td>
                                            <span class="text">Ao</span>

                                        </td>
                                        <td colspan="2">
                                            <span style="width: 100%"
                                                  class="text">@(ConverterService.AoToName(mayCan.MaAo))</span>

                                        </td>
                                        <td>
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetAo(mayCan.Id)">Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogAo(mayCan)">Set
                                                    </SfButton>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span class="text">Phương Tiện</span>

                                        </td>
                                        <td colspan="2">
                                            <span style="width: 100%"
                                                  class="text">@(ConverterService.PhuongTienToName(mayCan.MaPhuongTien))</span>

                                        </td>
                                        <td>
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetPhuongTien(mayCan.Id)">
                                                        Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogPhuongTien(mayCan)">Set
                                                    </SfButton>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (mayCan.WKv == AppKV.XepKhuon || mayCan.WKv == AppKV.XepKhuonRaCoi || mayCan.WKv == AppKV.XepKhuonPhu)
                                {
                                    <tr>
                                        <td>
                                            <span class="text">Chiếu Xạ</span>

                                        </td>
                                        <td colspan="2">
                                            <span style="width: 100%"
                                                  class="text">@(ConverterService.ChieuXaToName(mayCan.MaChieuXa))</span>

                                        </td>
                                        <td>
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetChieuXa(mayCan.Id)">
                                                        Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogChieuXa(mayCan)">Set
                                                    </SfButton>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span class="text">Chất Lượng</span>

                                        </td>
                                        <td colspan="2">
                                            <span style="width: 100%"
                                                  class="text">@(ConverterService.ChatLuongXepKhuonToName(mayCan.MaChatLuong))</span>

                                        </td>
                                        <td>
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetChatLuong(mayCan.Id)">
                                                        Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogChatLuong(mayCan)">Set
                                                    </SfButton>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (mayCan.WKv == AppKV.XepKhuon || mayCan.WKv == AppKV.XepKhuonRaCoi || mayCan.WKv == AppKV.XepKhuonPhu)
                                {
                                    <tr>
                                        <td>
                                            <span class="text">Cối</span>

                                        </td>
                                        <td colspan="2">
                                            <span style="width: 100%"
                                                  class="text">@(ConverterService.CoiToName(mayCan.MaCoi))</span>

                                        </td>
                                        <td>
                                            <div
                                                style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => MayCanService.CommandGetCoi(mayCan.Id)">
                                                        Get
                                                    </SfButton>
                                                </div>
                                                <div>
                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                              CssClass="e-primary"
                                                              @onclick="() => OpenDialogCoi(mayCan)">Set
                                                    </SfButton>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td>
                                        <span class="text">Tare</span>

                                    </td>
                                    <td colspan="2">
                                        <SfNumericTextBox ValidateDecimalOnType="true" style="width: 100%" Step="0.01M"
                                                          ShowSpinButton="false" TValue="decimal?"
                                                          @bind-Value="@mayCan.TrongLuongTare"
                                                          Readonly="false"></SfNumericTextBox>


                                    </td>

                                    <td>
                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                  CssClass="e-primary" @onclick="() => OpenDialogTare(mayCan)">Tare
                                        </SfButton>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="text">Zero</span>

                                    </td>
                                    <td colspan="2">
                                    </td>
                                    <td>
                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%"
                                                  CssClass="e-primary"
                                                  @onclick="() => ExecuteAction(() => MayCanService.CommandZero(mayCan.Id))">
                                            Zero
                                        </SfButton>
                                    </td>
                                </tr>
                            </table>
                            @if (_buttonContent == collapse)
                            {
                                <div>
                                    <table>
                                        <tr>
                                            <td colspan="2"
                                                style="background-color: @(string.IsNullOrEmpty(mayCan.ColorString) ? "transparent" : mayCan.ColorString)">
                                                <SfTextBox Value="@mayCan.ThongBao"></SfTextBox>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <span class="text">Trọng Lượng: </span>
                                            </td>
                                            <td colspan="2"
                                                style="background-color: @(mayCan.IsStated ? "greenyellow" : "transparent")">
                                                <SfNumericTextBox style="width: 100%" ShowSpinButton="false"
                                                                  TValue="decimal"
                                                                  @bind-Value="@mayCan.TrongLuong"></SfNumericTextBox>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                <span class="text">Thẻ: </span>
                                            </td>
                                            <td colspan="2">
                                                <SfTextBox Value="@mayCan.TheView"></SfTextBox>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                <span class="text">Nhân Viên: </span>
                                            </td>
                                            <td>
                                                <SfTextBox Value="@mayCan.MaHoSo"></SfTextBox>
                                            </td>

                                        </tr>
                                    </table>
                                    <div>
                                        <SfGrid DataSource="@mayCan.Items" Height="320px" AllowResizing="true">
                                            <GridColumns>
                                                @if (mayCan.WKv == AppKV.NguyenLieu)
                                                {
                                                    <GridColumn Field="ThoiGianCan" HeaderText="Ngày Giờ"
                                                                TextAlign="TextAlign.Center"
                                                                Format="dd/MM/yyyy HH:mm:ss" Width="150"
                                                                Type="ColumnType.DateTime"/>
                                                    <GridColumn Field="MSL" HeaderText="Lô" TextAlign="TextAlign.Center"
                                                                Width="90"></GridColumn>
                                                    <GridColumn Field="MaLoaiThanhPham" AutoFit="true"
                                                                HeaderText="Thành Phẩm"
                                                                MinWidth="100">
                                                        <Template Context="columContextTP">

                                                            @{
                                                                var a = columContextTP.GetPropValueOrDefault<string>("MaLoaiThanhPham", ""); //(columContextTP as dynamic)?.MaThanhPham;
                                                                @ConverterService.ThanhPhamToName(a, mayCan.WKv)
                                                                ;
                                                            }

                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field="MaSize" HeaderText="Size" Width="100"
                                                                TextAlign="TextAlign.Center">
                                                        <Template Context="columContextSize">

                                                            @{
                                                                var a = columContextSize.GetPropValueOrDefault<string>("MaSize", ""); //(columContextSize as dynamic)?.MaSize;
                                                                @ConverterService.SizeToName(a, mayCan.WKv)
                                                                ;
                                                            }

                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field="MaAo" HeaderText="Ao" Width="100"
                                                                TextAlign="TextAlign.Center">
                                                        <Template Context="columnContexAo">

                                                            @{
                                                                var a = columnContexAo.GetPropValueOrDefault<string>("MaAo", ""); //(columContextSize as dynamic)?.MaSize;
                                                                @ConverterService.AoToName(a)
                                                                ;
                                                            }

                                                        </Template>
                                                    </GridColumn>
                                                    <GridColumn Field="MaPhuongTien" HeaderText="Phương Tiện"
                                                                Width="100" TextAlign="TextAlign.Center">
                                                        <Template Context="columnContexPhuongTien">

                                                            @{
                                                                var a = columnContexPhuongTien.GetPropValueOrDefault<string>("MaPhuongTien", ""); //(columContextSize as dynamic)?.MaSize;
                                                                @ConverterService.PhuongTienToName(a)
                                                                ;
                                                            }

                                                        </Template>
                                                    </GridColumn>
                                                }
                                                else
                                                {
                                                    if (mayCan.WKv == AppKV.Hq)
                                                    {
                                                        <GridColumn Field="NgayGio" HeaderText="Ngày Giờ"
                                                                    TextAlign="TextAlign.Center"
                                                                    Format="dd/MM/yyyy HH:mm:ss" Width="150"
                                                                    Type="ColumnType.DateTime"/>
                                                    }
                                                    else if (mayCan.WKv == AppKV.TPFillet)
                                                    {
                                                        <GridColumn Field="ThoiGianCan" HeaderText="Ngày Giờ"
                                                                    Width="150">
                                                            <Template Context="_context">

                                                                @{
                                                                    var a = _context.GetPropValueOrDefault<TimeSpan?>("ThoiGianCan", null) ?? TimeSpan.Zero;
                                                                    @a.ToString(@"hh\:mm\:ss")
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MSL" HeaderText="Lô"
                                                                    TextAlign="TextAlign.Center"
                                                                    Width="90"></GridColumn>
                                                    }
                                                    else
                                                    {
                                                        <GridColumn Field="STT" HeaderText="STT"
                                                                    TextAlign="TextAlign.Center" Width="70"/>
                                                        <GridColumn Field="MaLo" HeaderText="Lô"
                                                                    TextAlign="TextAlign.Center"
                                                                    Width="90"></GridColumn>
                                                    }

                                                    <GridColumn Field="MaNhanVien" HeaderText="Mã Số" Width="70">
                                                        <Template Context="columContextNhanVien">

                                                            @{
                                                                var a = columContextNhanVien.GetPropValueOrDefault<string>("MaNhanVien", ""); //((columContextNhanVien as dynamic)?.MaNhanVien)??"";
                                                                @ConverterService.NhanVienToMaHoSo(a)
                                                                ;
                                                            }

                                                        </Template>
                                                    </GridColumn>
                                                    if (mayCan.WKv == AppKV.Hq)
                                                    {
                                                        <GridColumn Field="MaLoaiNguyenLieu" HeaderText="Nguyên Liệu"
                                                                    Width="120">
                                                            <Template Context="columContextNguyenLieu">

                                                                @{
                                                                    var a = columContextNguyenLieu.GetPropValueOrDefault<string>("MaLoaiNguyenLieu", "");
                                                                    @ConverterService.LoaiNguyenLieuToName(a)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                    }

                                                    if (mayCan.WKv == AppKV.XepKhuon)
                                                    {
                                                        <GridColumn Field="MaThanhPhamChinh" HeaderText="Thành Phẩm"
                                                                    Width="150">
                                                            <Template Context="columContextTPXepKhuon">

                                                                @{
                                                                    var a = columContextTPXepKhuon.GetPropValueOrDefault<string>("MaThanhPhamChinh", ""); //(columContextTP as dynamic)?.MaThanhPham;
                                                                    @ConverterService.ThanhPhamToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MaSizeChinh" HeaderText="Size" Width="100"
                                                                    TextAlign="TextAlign.Center">
                                                            <Template Context="columContextSizeXepKhuon">

                                                                @{
                                                                    var a = columContextSizeXepKhuon.GetPropValueOrDefault<string>("MaSizeChinh", ""); //(columContextSize as dynamic)?.MaSize;
                                                                    @ConverterService.SizeToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                    }
                                                    else if (mayCan.WKv == AppKV.XepKhuonRaCoi)
                                                    {
                                                        <GridColumn Field="MaThanhPham" HeaderText="Thành Phẩm"
                                                                    Width="150">
                                                            <Template Context="columContextTPXepKhuon">

                                                                @{
                                                                    var a = columContextTPXepKhuon.GetPropValueOrDefault<string>("MaThanhPham", ""); //(columContextTP as dynamic)?.MaThanhPham;
                                                                    @ConverterService.ThanhPhamToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MaSize" HeaderText="Size" Width="100"
                                                                    TextAlign="TextAlign.Center">
                                                            <Template Context="columContextSizeXepKhuon">

                                                                @{
                                                                    var a = columContextSizeXepKhuon.GetPropValueOrDefault<string>("MaSize", ""); //(columContextSize as dynamic)?.MaSize;
                                                                    @ConverterService.SizeToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                    }

                                                    else if (mayCan.WKv == AppKV.TPFillet)
                                                    {
                                                        <GridColumn Field="MaLoaiThanhPham" HeaderText="Thành Phẩm"
                                                                    Width="150">
                                                            <Template Context="columContextTP">

                                                                @{
                                                                    var a = columContextTP.GetPropValueOrDefault<string>("MaLoaiThanhPham", ""); //(columContextTP as dynamic)?.MaThanhPham;
                                                                    @ConverterService.ThanhPhamToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MaSize" HeaderText="Size" Width="100"
                                                                    TextAlign="TextAlign.Center">
                                                            <Template Context="columContextSize">

                                                                @{
                                                                    var a = columContextSize.GetPropValueOrDefault<string>("MaSize", ""); //(columContextSize as dynamic)?.MaSize;
                                                                    @ConverterService.SizeToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                    }
                                                    else
                                                    {
                                                        <GridColumn Field="MaThanhPham" HeaderText="Thành Phẩm"
                                                                    Width="150">
                                                            <Template Context="columContextTP">

                                                                @{
                                                                    var a = columContextTP.GetPropValueOrDefault<string>("MaThanhPham", ""); //(columContextTP as dynamic)?.MaThanhPham;
                                                                    @ConverterService.ThanhPhamToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MaSize" HeaderText="Size" Width="100"
                                                                    TextAlign="TextAlign.Center">
                                                            <Template Context="columContextSize">

                                                                @{
                                                                    var a = columContextSize.GetPropValueOrDefault<string>("MaSize", ""); //(columContextSize as dynamic)?.MaSize;
                                                                    @ConverterService.SizeToName(a, mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                    }
                                                }
                                                @{
                                                    if (mayCan.WKv == AppKV.TPDinhHinh || mayCan.WKv == AppKV.TPFilletv2)
                                                    {
                                                        <GridColumn Field="TrongLuongTra" HeaderText="TL Trả"
                                                                    TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                        <GridColumn Field="TrongLuongNhan" HeaderText="TL Nhận"
                                                                    TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                        <GridColumn Field="DinhMucThucTe" HeaderText="Định Mức"
                                                                    Format="0.00" TextAlign="TextAlign.Right"
                                                                    Width="90"></GridColumn>
                                                    }
                                                    else
                                                    {
                                                        <GridColumn Field="TrongLuong" HeaderText="TL"
                                                                    TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                    }
                                                }

                                            </GridColumns>
                                        </SfGrid>
                                    </div>

                                </div>
                            }
                        </CardContent>
                        <CardContent EnableSeparator="true"></CardContent>
                        <CardFooter>
                            <CardFooterContent>
                                <SfButton style="margin-top: 10px; width: 100px;" CssClass="e-info"
                                          @onclick="() => ExpandHandler(mayCan.Id)">@(_buttonContent)</SfButton>
                            </CardFooterContent>
                        </CardFooter>
                    </SfCard>
                }

            </ItemTemplate>
        </ListBoxTemplates>
    </SfListBox>
}

<SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleTare">

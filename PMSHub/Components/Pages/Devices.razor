                    <GridColumn Field="TrongLuongTra"
                                HeaderText="TL Trả"
                                Format="N2"
                                TextAlign="TextAlign.Right"
                                Width="130" />

                    <GridColumn Field="TrongLuongTare"
                                HeaderText="Tare"
                                Format="N2"
                                TextAlign="TextAlign.Right"

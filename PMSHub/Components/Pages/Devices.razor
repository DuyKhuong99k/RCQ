    private async Task OnChiSanLuongChanged(MayCan mayCan, bool newValue)
    {
        // Cập nhật UI ngay lập tức để người dùng thấy phản hồi
        mayCan.IsChiSangLuong = newValue;
        StateHasChanged(); // Bắt buộc UI refresh

        try
        {
            await MayCanService.CommandSetChiSanLuong(mayCan.Id, newValue);
        }
        catch (Exception ex)
        {
            // Nếu service call thất bại, revert lại giá trị cũ
            mayCan.IsChiSangLuong = !newValue;
            StateHasChanged();

            // Hiển thị thông báo lỗi nếu cần
            // await ShowErrorMessage(ex.Message);
        }
    }


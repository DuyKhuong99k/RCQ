@page "/Devices"
@using PMSHub.Components.Layout
@rendermode InteractiveServer
@inject IJSRuntime jsRuntime
@inject NavigationManager Navigation
@inject IMayCansService MayCanService
@inject IMainService MainService
@inject IDeviceViewService DeviceViewService
@inject ILoginService LoginService
@inject IConverterService ConverterService
@inject ISessionService SessionService
@inject ICoiService CoiService
@inject HttpClient Http
@attribute [StreamRendering]
@using System.Text
@using System.Text.Json
@using Models.Repos.Models
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Vars
@using ViewModels.Repos.Hubs.IServices
@using Action = Action
@using FilterType = Syncfusion.Blazor.DropDowns.FilterType
@inherits AuthenticatedComponent
@implements IDisposable

<link rel="stylesheet" href="styles/card.css" />
<PageTitle>Devices</PageTitle>
<!-- Navbar -->
<TopLayout />
<!-- / Navbar -->
<!-- Content wrapper -->
<div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">
        <h1>Danh Sách Thiết Bị</h1>
        <div>
            <SfButton style="margin: 2px;" CssClass="e-primary" @onclick="() => OpenDialogReload()">Tải Lại</SfButton>

        </div>

        @if (MayCanService.Items.Count <= 0)
        {
            <p>
                <em>Loading... </em>
            </p>
        }
        else
        {
            <SfListBox TValue="List<MayCan>" DataSource="@DeviceViewService.Items" TItem="MayCan" @bind-Value="@SelectedItems" AllowFiltering=true FilterType=" FilterType.Contains">
                @* <ListBoxFieldSettings Text="Id" Value="Id"></ListBoxFieldSettings> *@
                <ListBoxFieldSettings GroupBy="WKv" Text="SubTitle" Value="Id" />
                <ListBoxTemplates TItem="MayCan">
                    <ItemTemplate>
                        @{
                            var mayCan = context;
                            var _buttonContent = buttonRefs.FirstOrDefault(x => x.Id == mayCan.Id)?.Content;
                            <SfCard class="sf-card ">
                                <CardHeader Title="@mayCan.Id">
                                    <SubTitle>
                                        <table style="margin-bottom: 10px;">
                                            <tr>
                                                <td>
                                                    <div class="text">@mayCan.SubTitle</div>
                                                    @if (mayCan.IsNapThe)
                                                    {
                                                        <div class="text">Đang Nạp Thẻ</div>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="text-right" style="color: @(mayCan.IsConnected ? "yellowgreen" : "grey") !important; font-size: 24px;">&#9865;</div>
                                                </td>
                                                <td>
                                                    <div class="text-right" style="color: @(mayCan.IsActive ? "yellowgreen" : "grey") !important; font-size: 24px;">@(mayCan.IsActive ? "\u2713" : "\u2715")</div>

                                                </td>
                                                <td>

                                                    <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogHieuChinh()">&#9881;</SfButton>

                                                </td>
                                                @if (mayCan.IsNapThe)
                                                {
                                                    <td>

                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => ExecuteAction(() => MayCanService.CommandSetNapThe(mayCan.Id, true))">Thoát Nạp Thẻ</SfButton>

                                                    </td>
                                                }
                                            </tr>
                                        </table>
                                    </SubTitle>
                                </CardHeader>

                                <CardContent>
                                    <table style="margin-bottom: 10px;">

                                        <tr>
                                            <td style="width: 100px">
                                                <span class="text">Lô</span>

                                            </td>
                                            <td colspan="2">
                                                <span style="width: 100%" class="text">@mayCan.MaLo</span>

                                            </td>
                                            <td>

                                                <div style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => MayCanService.CommandGetLo(mayCan.Id)">Get</SfButton>
                                                    </div>
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogLo(mayCan)">Set</SfButton>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <span class="text">Thành Phẩm</span>

                                            </td>
                                            <td colspan="2">
                                                <span style="width: 100%" class="text">@(ConverterService.ThanhPhamToName(mayCan.MaThanhPham, mayCan.WKv))</span>

                                            </td>
                                            <td>
                                                <div style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => MayCanService.CommandGetThanhPham(mayCan.Id)">Get</SfButton>
                                                    </div>
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogThanhPham(mayCan)">Set</SfButton>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <span class="text">Size</span>

                                            </td>
                                            <td colspan="2">
                                                <span style="width: 100%" class="text">@(ConverterService.SizeToName(mayCan.MaSize, mayCan.WKv))</span>

                                            </td>
                                            <td>
                                                <div style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => MayCanService.CommandGetSize(mayCan.Id)">Get</SfButton>
                                                    </div>
                                                    <div>
                                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogSize(mayCan)">Set</SfButton>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        @if (mayCan.WKv == AppKV.XepKhuon || mayCan.WKv == AppKV.XepKhuonRaCoi)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="text">Chiếu Xạ</span>

                                                </td>
                                                <td colspan="2">
                                                    <span style="width: 100%" class="text">@(ConverterService.ChieuXaToName(mayCan.MaChieuXa))</span>

                                                </td>
                                                <td>
                                                    <div style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                        <div>
                                                            <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => MayCanService.CommandGetChieuXa(mayCan.Id)">Get</SfButton>
                                                        </div>
                                                        <div>
                                                            <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogChieuXa(mayCan)">Set</SfButton>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <span class="text">Chất Lượng</span>

                                                </td>
                                                <td colspan="2">
                                                    <span style="width: 100%" class="text">@(ConverterService.ChatLuongXepKhuonToName(mayCan.MaSize))</span>

                                                </td>
                                                <td>
                                                    <div style="display: grid; grid-column-gap: 4px; grid-template-columns: auto auto;">
                                                        <div>
                                                            <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => MayCanService.CommandGetChatLuong(mayCan.Id)">Get</SfButton>
                                                        </div>
                                                        <div>
                                                            <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogChatLuong(mayCan)">Set</SfButton>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td>
                                                <span class="text">Tare</span>

                                            </td>
                                            <td colspan="2">
                                                <SfNumericTextBox ValidateDecimalOnType="true" style="width: 100%" Step="0.01M" ShowSpinButton="false" TValue="decimal?" @bind-Value="@mayCan.TrongLuongTare" Readonly="false"></SfNumericTextBox>


                                            </td>

                                            <td>
                                                <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => OpenDialogTare(mayCan)">Tare</SfButton>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <span class="text">Zero</span>

                                            </td>
                                            <td colspan="2">
                                            </td>
                                            <td>
                                                <SfButton Disabled="@(!mayCan.IsConnected)" style="width: 100%" CssClass="e-primary" @onclick="() => ExecuteAction(() => MayCanService.CommandZero(mayCan.Id))">Zero</SfButton>
                                            </td>
                                        </tr>
                                    </table>
                                    @if (_buttonContent == collapse)
                                    {
                                        <div>
                                            <table>
                                                <tr>
                                                    <td colspan="2" style="background-color: @(string.IsNullOrEmpty(mayCan.ColorString) ? "transparent" : mayCan.ColorString)">
                                                        <SfTextBox Value="@mayCan.ThongBao"></SfTextBox>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <span class="text">Trọng Lượng: </span>
                                                    </td>
                                                    <td colspan="2" style="background-color: @(mayCan.IsStated ? "greenyellow" : "transparent")">
                                                        <SfNumericTextBox style="width: 100%" ShowSpinButton="false" TValue="decimal" @bind-Value="@mayCan.TrongLuong"></SfNumericTextBox>
                                                    </td>

                                                </tr>
                                                <tr>
                                                    <td>
                                                        <span class="text">Thẻ: </span>
                                                    </td>
                                                    <td colspan="2">
                                                        <SfTextBox Value="@mayCan.TheView"></SfTextBox>
                                                    </td>

                                                </tr>
                                                <tr>
                                                    <td>
                                                        <span class="text">Nhân Viên: </span>
                                                    </td>
                                                    <td>
                                                        <SfTextBox Value="@mayCan.MaHoSo"></SfTextBox>
                                                    </td>

                                                </tr>
                                            </table>
                                            <div>
                                                <SfGrid DataSource="@mayCan.Items" Height="320px">
                                                    <GridColumns>
                                                        <GridColumn Field="STT" HeaderText="STT" TextAlign="TextAlign.Center" Width="70">

                                                        </GridColumn>
                                                        <GridColumn Field="MaNhanVien" HeaderText="Mã Số" Width="70">
                                                            <Template Context="columContextNhanVien">

                                                                @{
                                                                    var a = (columContextNhanVien as dynamic)?.MaNhanVien;
                                                                    @ConverterService.NhanVienToMaHoSo(a.ToString())
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MaThanhPham" HeaderText="Thành Phẩm" Width="150">
                                                            <Template Context="columContextTP">

                                                                @{
                                                                    var a = (columContextTP as dynamic)?.MaThanhPham;
                                                                    @ConverterService.ThanhPhamToName(a.ToString(), mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        <GridColumn Field="MaSize" HeaderText="Size" Width="100" TextAlign="TextAlign.Center">
                                                            <Template Context="columContextSize">

                                                                @{
                                                                    var a = (columContextSize as dynamic)?.MaSize;
                                                                    @ConverterService.SizeToName(a.ToString(), mayCan.WKv)
                                                                    ;
                                                                }

                                                            </Template>
                                                        </GridColumn>
                                                        @{
                                                            if (mayCan.WKv == AppKV.TPDinhHinh)
                                                            {
                                                                <GridColumn Field="TrongLuongTra" HeaderText="TL Trả" TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                                <GridColumn Field="TrongLuongNhan" HeaderText="TL Nhận" TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                                <GridColumn Field="DinhMucThucTe" HeaderText="Định Mức" Format="0.00" TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                            }
                                                            else if (mayCan.WKv == AppKV.BTPDinhHinh)
                                                            {
                                                                <GridColumn Field="TrongLuong" HeaderText="TL" TextAlign="TextAlign.Right" Width="90"></GridColumn>
                                                            }
                                                        }

                                                    </GridColumns>
                                                </SfGrid>
                                            </div>

                                        </div>
                                    }
                                </CardContent>
                                <CardContent EnableSeparator="true"></CardContent>
                                <CardFooter>
                                    <CardFooterContent>
                                        <SfButton Disabled="@(!mayCan.IsConnected)" style="margin-top: 10px; width: 100px;" CssClass="e-info" @onclick="() => ExpandHandler(mayCan.Id)">@(_buttonContent)</SfButton>
                                    </CardFooterContent>
                                </CardFooter>
                            </SfCard>
                        }

                    </ItemTemplate>
                </ListBoxTemplates>
            </SfListBox>
        }

        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleTare">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@item.SubTitle</div>
                </Header>
                <Content>
                    <SfNumericTextBox ValidateDecimalOnType="true" Step="0.01M" style="width: 100%" ShowSpinButton="true" TValue="decimal?" @bind-Value="@item.TrongLuongTare" Readonly="false"></SfNumericTextBox>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="() => MayCanService.CommandTare(item.Id, item.TrongLuongTare)" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleLo">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfComboBox TValue="string" Placeholder="Chọn Lô" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="string" @bind-Value="@MainService.VmLo.SelectedItem" DataSource="@MainService.VmLo.Items" />
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogLo" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleThanhPhamFillet">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaThanhPhamFillet" Placeholder="Chọn Thành Phẩm" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaThanhPhamFillet" @bind-Value="@MainService.VmThanhPhamFillet.SelectedItem" DataSource="@MainService.VmThanhPhamFillet.UsedItems">
                        <DropDownListEvents TItem="MaThanhPhamFillet" TValue="MaThanhPhamFillet" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogThanhPham" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleThanhPhamXepKhuon">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaThanhPhamChinhXepKhuon" Placeholder="Chọn Thành Phẩm" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaThanhPhamChinhXepKhuon" @bind-Value="@MainService.VmThanhPhamChinhXepKhuon.SelectedItem" DataSource="@MainService.VmThanhPhamChinhXepKhuon.UsedItems">
                        <DropDownListEvents TItem="MaThanhPhamChinhXepKhuon" TValue="MaThanhPhamChinhXepKhuon" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogThanhPham" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleSizeFillet">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaSizeFillet" Placeholder="Chọn Size" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaSizeFillet" @bind-Value="@MainService.VmSizeFillet.SelectedItem" DataSource="@MainService.VmSizeFillet.UsedItems">
                        <DropDownListEvents TItem="MaSizeFillet" TValue="MaSizeFillet" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogSize" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleSizeXepKhuon">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaSizeChinhXepKhuon" Placeholder="Chọn Size" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaSizeChinhXepKhuon" @bind-Value="@MainService.VmSizeChinhXepKhuon.SelectedItem" DataSource="@MainService.VmSizeChinhXepKhuon.UsedItems">
                        <DropDownListEvents TItem="MaSizeChinhXepKhuon" TValue="MaSizeChinhXepKhuon" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogSize" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleThanhPhamDinhHinh">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaThanhPhamDinhHinh" Placeholder="Chọn Thành Phẩm" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaThanhPhamDinhHinh" @bind-Value="@MainService.VmThanhPhamDinhHinh.SelectedItem" DataSource="@MainService.VmThanhPhamDinhHinh.UsedItems" EnablePersistence="true">
                        <DropDownListEvents TItem="MaThanhPhamDinhHinh" TValue="MaThanhPhamDinhHinh" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogThanhPham" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleSizeDinhHinh">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaSizeDinhHinh" Placeholder="Chọn Size" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaSizeDinhHinh" @bind-Value="@MainService.VmSizeDinhHinh.SelectedItem" DataSource="@MainService.VmSizeDinhHinh.UsedItems">
                        <DropDownListEvents TItem="MaSizeDinhHinh" TValue="MaSizeDinhHinh" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogSize" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleChieuXa">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaChieuXaXepKhuon" Placeholder="Chọn Chiếu Xạ" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaChieuXaXepKhuon" @bind-Value="@MainService.VmChieuXaXepKhuon.SelectedItem" DataSource="@MainService.VmChieuXaXepKhuon.UsedItems">
                        <DropDownListEvents TItem="MaChieuXaXepKhuon" TValue="MaChieuXaXepKhuon" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogChieuXa" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleChatLuong">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDropDownList TValue="MaChatLuongXepKhuon" Placeholder="Chọn Chiếu Xạ" FloatLabelType="FloatLabelType.Auto" AllowFiltering="true" TItem="MaChatLuongXepKhuon" @bind-Value="@MainService.VmChatLuong.SelectedItem" DataSource="@MainService.VmChatLuong.UsedItems">
                        <DropDownListEvents TItem="MaChatLuongXepKhuon" TValue="MaChatLuongXepKhuon" OnOpen="BeforeOpen" Closed="ClosedHanlder" />
                        <DropDownListFieldSettings Value="Ma" Text="Ten"></DropDownListFieldSettings>
                    </SfDropDownList>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="@CloseDialogChatLuong" />
            </DialogButtons>

        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" @bind-Visible="@IsVisibleSelectedDate">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>
                    <div>@SelectedItems.FirstOrDefault()?.SubTitle</div>
                </Header>
                <Content>
                    <SfDatePicker TValue="DateTime?" Value='@DateValue' Placeholder='Chọn Ngày'></SfDatePicker>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Xác Nhận" IsPrimary="true" OnClick="() => PhieuCanSync(SelectedItems.FirstOrDefault()?.IPAddr)" />
            </DialogButtons>
        </SfDialog>
        <SfDialog Width="400px" IsModal="true" CloseOnEscape="true" @bind-Visible="@IsVisibleReload">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>

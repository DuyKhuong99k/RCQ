    protected override Task OnInitializedAsync()
    {
        var _userId = SessionService.Get("UserId");
        var xuongId = SessionService.Get("XuongId");
        if (!string.IsNullOrEmpty(xuongId))
        {
            // Gán giá trị vào SelectedItem trong ViewModel
            var xiNghiep = MainService.VmXiNghiep.Items.FirstOrDefault(x => x.Ma == xuongId);
            DeviceViewService.XiNghiep = xiNghiep;
        }

        if (_userId != null)
        {
            userId = int.Parse(_userId);
        }

        DeviceViewService.DevicesChanged -= MayCanChangedHandler;
        DeviceViewService.DevicesChanged += MayCanChangedHandler;
        MainService.AlertRequested -= AlertRequestedHandler;
        MainService.AlertRequested += AlertRequestedHandler;
        DeviceViewService.Items.Clear();
        if (LoginService.IsUserAuthenticated())
        {
            DeviceViewService.Load(userId);
        }


        buttonContent = expand;
        buttonRefs = new List<ButtonModel>();
        for (var i = 0; i < DeviceViewService.Items.Count; i++)
        {
            var item = DeviceViewService.Items[i];
            buttonRefs.Add(new ButtonModel
            {
                Id = item.Id,
                Content = buttonContent
            });
        }

        KhuVucs = Enum.GetValues(typeof(AppKV)).Cast<AppKV>().ToList();
        AppTypes = Enum.GetValues(typeof(AppType)).Cast<AppType>().ToList();
        return base.OnInitializedAsync();
    }

    private void AlertRequestedHandler(string obj)
    {
        // jsRuntime.InvokeVoidAsync("alert", obj);

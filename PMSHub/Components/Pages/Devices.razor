    private async void CloseDialogNguyenLieu(MouseEventArgs obj)
    {
        var mayCan = SelectedItems.FirstOrDefault();
        if (mayCan != null)
        {
            var hander = await ErrorHandler.HandleAsync(async () =>
            {
                var id = mayCan?.Id;
                if (id != null) await MayCanService.CommandSetNguyenLieu(id, MainService.VmNguyenLieuHq.SelectedItem?.Id ?? "", MainService.VmNguyenLieuHq.SelectedItem?.Ten ?? "");
            });
            if (!hander.IsSuccess)
            {
                ToastService.ShowToast(hander?.Error?.Message, ToastType.Error);
            }

            IsVisibleNguyenLieu = false;
        }
    }


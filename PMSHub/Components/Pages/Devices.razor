    private async void MayCanChangedHandler(object? sender, EventArgs args)
    {
        var now = DateTime.Now;
        if (now - _lastUpdate < _debounceInterval)
            return;

        _lastUpdate = now;
        await InvokeAsync(StateHasChanged);
    }

    void ExpandHandler(string id)
    {
        var button = buttonRefs.FirstOrDefault(x => x.Id == id);
        if (button != null)
        {
            var content = button.Content;
            button.Content = "";
            buttonContent = content == expand ? collapse : expand;
            button.Content = buttonContent;
        }
    }


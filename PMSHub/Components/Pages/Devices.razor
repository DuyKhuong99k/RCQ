    private async Task OpenIp(string? ip)
    {
        try
        {
            if (!string.IsNullOrEmpty(ip))
            {
                var url = $"http://{ip}";
                await jsRuntime.InvokeVoidAsync("open", url, "_blank");
            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            ToastService.ShowToast($"Lỗi khi mở trang {ip}", ToastType.Error);
        }
    }



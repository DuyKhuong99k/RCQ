@page "/api/login/{parameter1}/{parameter2}"
@inject NavigationManager Navigation
@code {
    [Parameter] public string Parameter1 { get; set; }
    [Parameter] public string Parameter2 { get; set; }

    protected override void OnInitialized()
    {
        // Dự phòng điều hướng Blazor nội bộ: URL cũ không tạo hoặc đổi phiên.
        Navigation.NavigateTo("/api/loginlocal/", forceLoad: true);
    }
}

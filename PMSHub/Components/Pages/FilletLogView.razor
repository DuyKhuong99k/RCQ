                    var idBTPSet = new HashSet<string>(BTPItems.Select(x => x.Id));
                    var idTPSet = new HashSet<string>(TPItems.Select(x => x.Id));
                   
                        foreach (var item in listBtp)
                            if (!idBTPSet.Contains(item.Id))
                            {
                                incBTPItems.Enqueue(item);
                                if (incBTPItems.Count > 100) incBTPItems.TryDequeue(out _);
                            }

                        foreach (var item in listTp)
                            if (!idTPSet.Contains(item.Id))
                            {
                                incTPItems.Enqueue(item);
                                if (incTPItems.Count > 100) incTPItems.TryDequeue(out _);
                            }

                      
                    

                    enqueuedIds.Clear();
                    if (DateTime.Today != currentDate)
                    {
                        currentDate = DateTime.Today;
                        lock (syncLock)
                        {
                            BTPItems.Clear();
                            TPItems.Clear();
                            incBTPItems.Clear();
                            incTPItems.Clear();
                            enqueuedIds.Clear();
                        }

                        //InvokeAsync(StateHasChanged);
                    }

                    await Task.Delay(10000);
                }
            }
            catch (Exception e)
            {
                var o = new ToastOption
                {
                    Title = "Thông Báo",
                    Content = $"Worker {e.ToString()}"
                };
                o.SetType(ToastType.Error);

                ToastService.ShowToast(o);
            }
        });
    }


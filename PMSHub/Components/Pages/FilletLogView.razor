    private void StartMayCanWorker()
    {
        if (isRunning) return;
        isRunning = true;

        Task.Run(async () =>
        {
            try
            {
                const int maxBatchSize = 1000;
                while (true)
                {
                    int processed = 0;
                    var listBtp = MainService.VmPhieuCanBtpFilletv2.GetsLastMinutes<PhieuCanBTPFilletv2>(5); //MayCanService.GetBTPDinhHinh();

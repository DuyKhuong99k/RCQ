    private async Task FlushBatch<T>(ConcurrentQueue<T> sourceQueue, Action<List<T>> setTargetList, Func<ObservableCollection<T>> getTargetList, int maxBatchSize = 1000, int maxTotalItems = 1000)
    {
        int processed = 0;
        var batch = new List<T>();

        while (processed < maxTotalItems)
        {
            var subBatch = new List<T>();

            while (subBatch.Count < maxBatchSize && sourceQueue.TryDequeue(out var item))
            {
                subBatch.Add(item);
            }

            if (subBatch.Any())
            {
                var currentList = subBatch.Distinct().ToList();
                batch.AddRange(currentList);
                processed += currentList.Count;
            }
            else break;
        }

        if (processed > 0)
        {
            var currentList = getTargetList();
            var merged = batch.Concat(currentList).Take(maxTotalItems).ToList();
            setTargetList(merged);
            //InvokeAsync(StateHasChanged);
        }
    }

